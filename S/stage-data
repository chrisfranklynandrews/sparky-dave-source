  QUIT 20
ENDIF

; The area files (the levels plan, step 4: python tools/build_assets.py writes them from manifest.AREAS;
; release_check.py checks this list against the manifest). The game does not read them yet.
IF NOT EXISTS sparky-dave:compiled/data/areas
  MAKEDIR sparky-dave:compiled/data/areas
ENDIF
COPY sparky-dave:game/assets/areas/world1-1.bin TO sparky-dave:compiled/data/areas CLONE QUIET
