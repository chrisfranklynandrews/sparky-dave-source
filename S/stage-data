; Copy the game's data files next to the compiled programs, where the game looks for them
; (PROGDIR:data), and the launcher script beside them. The compile scripts run this; the release
; archive carries the same drawer (make-release copies compiled/data). The files are generated by
; python tools/build_assets.py on the PC. Only the ten the game loads are copied (a stray file in
; game/assets, such as a proof's picture, must not reach a release); the list is checked
; against the source by python tools/release_check.py.

IF NOT EXISTS sparky-dave:compiled/data
  MAKEDIR sparky-dave:compiled/data
ENDIF
; Anything left from an earlier run goes first: the area files before the drawer that holds them, because
; DELETE will not take a drawer that is not empty.
DELETE sparky-dave:compiled/data/areas/#? QUIET
DELETE sparky-dave:compiled/data/areas-allstars/#? QUIET
DELETE sparky-dave:compiled/data/#? QUIET

COPY sparky-dave:game/assets/tiles-all.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/game-objects.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/items-16x16.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/enemies.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/hud-objects.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/items-4x8.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/title-logo.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/title-panel.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/mario-small.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/mario-big.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/mario-small-all-stars.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/mario-big-all-stars.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/mario-big-swim-all-stars.iff TO sparky-dave:compiled/data CLONE QUIET
