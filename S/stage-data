COPY sparky-dave:game/assets/jukebox-scenes-allstars.bin TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/tiles-allstars-over.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/tiles-allstars-under.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/items16-allstars-under.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/enemies-allstars-under.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/tiles-allstars-water.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/items16-allstars-water.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/enemies-allstars-water.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/tiles-allstars-castle.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/items16-allstars-castle.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/enemies-allstars-castle.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/game-objects-allstars.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/items-16x16-allstars.iff TO sparky-dave:compiled/data CLONE QUIET
COPY sparky-dave:game/assets/enemies-allstars.iff TO sparky-dave:compiled/data CLONE QUIET
