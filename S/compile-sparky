; Compile Sparky Dave with AmiBlitz 3.13.

FAILAT 21

DELETE sparky-dave:game/compile.log QUIET
DELETE sparky-dave:compiled/SparkyDaveDev QUIET

execute sparky-dave:S/stage-data
IF ERROR
  QUIT 20
ENDIF

Work:AmiBlitz3.13/AmiBlitz3 -s sparky-dave:game/SparkyDave.ab3 -e sparky-dave:compiled/SparkyDaveDev -v 2 > sparky-dave:game/compile.log

; The compiler does not always return an error code when it finds errors, so the three
; checks are the return code, the log (an error is a "Compiler Error" line) and the program,
; which was deleted above.
IF ERROR
  ECHO "Compilation failed"
  TYPE sparky-dave:game/compile.log
  QUIT 20
ENDIF

SEARCH sparky-dave:game/compile.log "Compiler Error" QUIET
IF NOT WARN
  ECHO "Compilation failed"
  TYPE sparky-dave:game/compile.log
  QUIT 20
ENDIF

IF NOT EXISTS sparky-dave:compiled/SparkyDaveDev
  ECHO "Compilation failed: no program was made"
  TYPE sparky-dave:game/compile.log
  QUIT 20
ENDIF

ECHO "Compiled with no errors"

IF EXISTS sparky-dave:game/compile.log
  TYPE sparky-dave:game/compile.log
ENDIF