;; =======================================================
;; PHYSICS AND TIMING CONSTANTS -- NTSC
;; =======================================================
;; The numbers that differ between the two builds, here the NTSC cartridge's own (60 sim ticks
;; a second). What each constant is, its ROM label and both variants' values are in
;; the main project's PHYSICS_VARIANTS note. tools/build_variant.py copies this file, or the PAL one, over
;; sparkydave.physics.ab3, which is the one the game includes: edit the variant files, never the copy.

; The sim's tick rate.
#SIM_HZ = 60

; Walking and running limits.
#MARIO_MAX_WALK = 24
#MARIO_MAX_RUN  = 40

; Friction.
#MARIO_FRIC_HIGH = 0
#MARIO_FRIC_WALK = $98
#MARIO_FRIC_TURN = $d0
#MARIO_FRIC_FAST = $e4

; The jump, by band; the fall force before any jump.
#MARIO_JUMP_FAST        = -5
#MARIO_JUMP_SLOW        = -4
#MARIO_JUMP_INITFORCE_0 = 0
#MARIO_JUMP_INITFORCE_1 = 0
#MARIO_JUMP_INITFORCE_2 = 0
#MARIO_FALL_MAX         = 4
#MARIO_GRAV_RISE_1      = $1e
#MARIO_GRAV_RISE_0      = $20
#MARIO_GRAV_RISE_2      = $28
#MARIO_GRAV_FALL_INIT   = $28
#MARIO_GRAV_FALL_1      = $60
#MARIO_GRAV_FALL_0      = $70
#MARIO_GRAV_FALL_2      = $90

; Speed cutoffs.
#MARIO_SPD_SKIDGFX  = 9
#MARIO_SPD_SKIDSTOP = 11
#MARIO_SPD_ANIM     = 14
#MARIO_SPD_JUMPWALK = 16
#MARIO_SPD_AIR      = 25
#MARIO_SPD_JUMPFAST = 25
#MARIO_SPD_RUNFLAG  = 28
#MARIO_SPD_FASTFRIC = 33

; Walk frame timing.
#MARIO_ANIM_FAST = 2
#MARIO_ANIM_MID  = 4
#MARIO_ANIM_SLOW = 7

;; Jump forgiveness windows (not the cartridge's): low about 50 ms and 70 ms, medium about 100 ms
;; and 130 ms, high about 150 ms and 200 ms.
#JUMP_BUFFER_LOW_TICKS  = 3
#COYOTE_LOW_TICKS       = 4
#JUMP_BUFFER_TICKS      = 6
#COYOTE_TICKS           = 8
#JUMP_BUFFER_HIGH_TICKS = 9
#COYOTE_HIGH_TICKS      = 12

; Floor tolerance.
#MT_FEET_MIN_SUBTILE = 5

; The timers, and the block bounce.
#BLOCK_BOUNCE_SPEED      = -2
#GOOMBA_SQUASH_INTERVALS = 2
#MARIO_BLOCKBOUNCE       = 16
#KOOPA_REVIVE_INTERVALS  = 16
#INTERVAL_PERIOD         = 21
#HUD_TIME_TICKS          = 24
#PIPE_TICKS              = 48
#PLANT_WAIT_TICKS        = 64
#BLOCK_BOUNCE_GRAVITY    = $50

; Enemies.
#ENEMY_WALK_SPEED = 8
#SHELL_SPEED      = 48
#LIFT_SPEED       = 240
#LIFT_RIGHT_SPEED = 256

;; How far into a lift's top Mario's feet may be and still land on it (ProcLPlatCollisions, smbdis 11797: `cmp #$06`). One tick
;; must not carry his feet from above the top to past it: at most his top fall (4 px and a carry, 5) and an up lift's (0 or 1) here.
#LIFT_LAND_WINDOW = 6

;; The jumpspring (JumpspringHandler, smbdis 6628; ChkForLandJumpSpring, 12248): the speed it gives Mario without and with A pressed
;; during its squash (whole pixels a tick, up negative), and the rise force he leaves it with.
#SPRING_FORCE_A    = -12
#SPRING_FORCE      = -7
#SPRING_RISE_FORCE = $70

; Fireballs.
#FIREBALL_SPEED_X  = 64
#FIREBALL_GRAVITY  = 80
#FIREBALL_FALL_MAX = 768
#FIREBALL_START_VY = 1024

;; Swimming (a water area). A stroke's rise, fall and start force and its speed
;; (JumpMForceData, FallMForceData, InitMForceData and PlayerYSpdData, entry 5), the same in a whirlpool (entry 6), the force
;; above the surface (ProcSwim), the ticks a stroke may follow another while he still rises (JumpSwimTimer), the whirlpool's
;; pull (WhirlpoolActivate) and the sea floor's top speed (MaxRightXSpdData, entry 2, only a water area's).
;; The NTSC cartridge's own numbers.
#SWIM_SPEED         = -2
#WHIRL_SPEED        = -1
#WHIRL_INITFORCE    = $00
#WHIRL_RISE_FORCE   = $04
#WHIRL_FALL_FORCE   = $09
#SWIM_FALL_FORCE    = $0a
#SWIM_RISE_FORCE    = $0d
#MARIO_MAX_SEAFLOOR = 16
#WHIRL_PULL_FORCE   = $10
#SWIM_SURFACE_FORCE = $18
#SWIM_STROKE_TICKS  = 32
#SWIM_INITFORCE     = $80

;; The Bloober (the main project's OBJECT_SYSTEM note, "The Bloober"): the mask of the random bits that must
;; all be clear for it to aim afresh (BlooberBitmasks, entry 0: hard mode's entry 1 is not built), how near Mario's y it comes
;; before its next swim (ChkNearPlayer's adc), the ticks between its swim's speed steps (ProcSwimmingB's every eighth frame), a swim
;; speed of 1 in sixteenths of a pixel a tick (2 is twice it), its float down in sixteenths a tick (a pixel every other frame), and a
;; beaten one's first speed (SetStun: the cartridge's -1 px a tick, SetStun's $ff, in 256ths)
;; and its fall (MoveEnemySlowVert: the force, and the top speed in 256ths).
;; The NTSC cartridge's own numbers.
#BLOOBER_STUN_SPEED  = -256
#BLOOBER_SWIM_TICKS  = 8
#BLOOBER_FLOAT_SPEED = 8
#BLOOBER_FALL_FORCE  = $0f
#BLOOBER_NEAR_Y      = 16
#BLOOBER_SPEED_STEP  = 16
#BLOOBER_AIM_MASK    = $3f
#BLOOBER_FALL_MAX    = 512

;; The swimming Cheep-Cheep and its frenzy: the grey one's and the red one's swim left in 256ths of a
;; pixel a tick (SwimCCXMoveData), its bob up and down in 256ths (MoveSwimmingCheepCheep's $20), the ticks between two of the frenzy's
;; Cheep-Cheeps (FrenzyEnemyTimer's $20) and between its two pictures (EnemyAnimTimingBMask's $08).
;; The NTSC cartridge's own numbers (the PAL listing has the same).
#CHEEP_FRAME_TICKS = 8
#CHEEP_BOB_SPEED   = $20
#FRENZY_TICKS      = 32
#CHEEP_SPEED_GREY  = $40
#CHEEP_SPEED_RED   = $80

;; The flying Cheep-Cheeps (smbdis 8419 InitFlyingCheepCheep, 9922 MoveFlyingCheepCheep, 7704 ImposeGravity): the
;; launch's speed (whole pixels a tick, up), the gravity in 256ths a tick (its top fall speed in whole pixels), the nudge to the speed's
;; fraction near some heights (PRandomSubtracter), the sideways speeds in sixteenths (FlyCCXSpeedData) and the frenzy's timers
;; (FlyCCTimerData); beaten, the stun's speed up (SetStun's $fd) and the fall (MoveJ_EnemyVertically: $1c, top speed 3).
;; The NTSC cartridge's own numbers.
#FLY_CHEEP_LAUNCH       = -5
#FLY_CHEEP_STUN_SPEED   = -3
#FLY_CHEEP_BEATEN_MAX   = 3
#FLY_CHEEP_FALL_MAX     = 5
#FLY_CHEEP_SPEED_1      = 5
#FLY_CHEEP_SPEED_2      = 6
#FLY_CHEEP_SPEED_7      = 12
#FLY_CHEEP_GRAVITY      = 13
#FLY_CHEEP_SPEED_0      = 14
#FLY_CHEEP_SPEED_3      = 14
#FLY_CHEEP_NUDGE        = 16
#FLY_CHEEP_SPEED_6      = 16
#FLY_CHEEP_TIMER_0      = 16
#FLY_CHEEP_SPEED_11     = 20
#FLY_CHEEP_SPEED_10     = 24
#FLY_CHEEP_BEATEN_FORCE = $1c
#FLY_CHEEP_SPEED_4      = 28
#FLY_CHEEP_SPEED_8      = 30
#FLY_CHEEP_SPEED_5      = 32
#FLY_CHEEP_TIMER_2      = 32
#FLY_CHEEP_SPEED_9      = 34
#FLY_CHEEP_TIMER_3      = 72
#FLY_CHEEP_TIMER_1      = 96

;; The firebars (smbdis 8366 FirebarSpinSpdData): the spin, in 256ths of a 32nd of a turn a tick, slow
;; ($1b, $1d, $1f) and fast ($1c, $1e).
;; The NTSC cartridge's own numbers.
#FIREBAR_SPEED_SLOW = $28
#FIREBAR_SPEED_FAST = $38

;; The Podoboo (smbdis 9187 MovePodoboo, 7642 MoveJ_EnemyVertically): its leap's speed (whole pixels a tick,
;; up) and the 256ths the random byte (with d7 set) gives it, ((byte OR $80)*#PODOBOO_FORCE_TIMES)/5 - #PODOBOO_FORCE_LESS; the gravity in
;; 256ths a tick and its top fall speed; a Starman's knock's speed up (SetStun's $fd).
;; The NTSC cartridge's own numbers (the PAL listing has the same).
#PODOBOO_LAUNCH      = -7
#PODOBOO_STUN_SPEED  = -3
#PODOBOO_FORCE_LESS  = 0
#PODOBOO_FALL_MAX    = 3
#PODOBOO_FORCE_TIMES = 5
#PODOBOO_FORCE       = $1c

;; The platform that moves up and down (1-3's; smbdis 10896 YMovingPlatform, 7673 MovePlatformUp
;; and MovePlatformDown, 7704 ImposeGravity; StepSwing{}): the pull in 256ths of a pixel a tick, down while it is above its centre and
;; the down force less the up force from its centre on, and its top speed (whole pixels; not reached, it tops out under 2 px a tick).
;; The NTSC cartridge's own.
#VPLAT_SPEED_MAX  = 3
#VPLAT_DOWN_FORCE = 5
#VPLAT_UP_FORCE   = 10

;; The swing's creep (YMovingPlatform, ProcMoveRedPTroopa; StepSwing{}): with no speed and above its top, a swinging platform or Red
;; Paratroopa moves down a pixel on the ticks whose low bits under this mask are clear.
;; The NTSC cartridge's own: every eighth frame (FrameCounter AND 7).
#SWING_CREEP_MASK = 7

;; The Red Paratroopa (1-3's; smbdis 9377 ProcMoveRedPTroopa, 7611 MoveRedPTroopaUp and Down, 7704
;; ImposeGravity; StepSwing{}): the pull in 256ths of a pixel a tick, down while it is above its centre and the down force less the up
;; force from its centre on, and its top speed (whole pixels; not reached, it tops out under 1.3 px a tick).
;; The NTSC cartridge's own.
#RED_PARA_SPEED_MAX  = 2
#RED_PARA_DOWN_FORCE = 3
#RED_PARA_UP_FORCE   = 6

;; The platform that sways from side to side (smbdis 10927 XMovingPlatform, 9423 XMoveCntr_Platform, 9443
;; MoveWithXMCntrs): its counters step #XPLAT_STEP_RATE 64ths of a step a tick, and its speed is the secondary counter times
;; #XPLAT_SPEED, in 256ths of a pixel a tick.
;; The NTSC cartridge's own: a step every fourth frame (16), the speed the secondary counter in sixteenths (16 256ths).
#XPLAT_STEP_RATE = 16
#XPLAT_SPEED     = 16

;; Bowser (smbdis 8504 InitBowser, 10151 BowserControl, 7635 MoveEnemySlowVert): his pacing step (on the
;; ticks #BOWSER_STEP_RATE 64ths reach a whole step: every fourth frame), his turn to face left (#BOWSER_FACE_RATE: every sixteenth), the
;; feet's and the chase's timers, the fire breath's first wait and the mouth's, his gravity and top fall speed, his jump (speed and its
;; 256ths), the Starman's knock; the jump's waits (PRandomRange as a timer) and the flame's waits (FlameTimerData).
;; The NTSC cartridge's own numbers.
#BOWSER_STUN_SPEED   = -3
#BOWSER_JUMP_SPEED   = -2
#BOWSER_JUMP_FORCE   = 0
#BOWSER_FALL_MAX     = 2
#BOWSER_FACE_RATE    = 4
#BOWSER_FORCE        = 15
#BOWSER_STEP_RATE    = 16
#BOWSER_WAIT_2       = 17
#BOWSER_FEET_TICKS   = 32
#BOWSER_CHASE_TICKS  = 32
#BOWSER_MOUTH_TICKS  = 32
#BOWSER_WAIT_0       = 33
#BOWSER_WAIT_3       = 49
#BOWSER_FLAME_WAIT_1 = 64
#BOWSER_FLAME_WAIT_5 = 64
#BOWSER_FLAME_WAIT_6 = 64
#BOWSER_WAIT_1       = 65
#BOWSER_FLAME_WAIT_0 = 191
#BOWSER_FLAME_WAIT_2 = 191
#BOWSER_FLAME_WAIT_3 = 191
#BOWSER_FLAME_WAIT_4 = 191
#BOWSER_FLAME_WAIT_7 = 191
#BOWSER_FIRE_FIRST   = 223

;; The firebars' flicker (the main project's OPTIMISATION note, entry 16): with this many bars in view or more, a frame draws only every other ball of
;; each, the other half on the next (each bitmap of the pair always the same half), so each ball shows every other frame.
;; NTSC: with 2 bars in view each frame draws every other ball, the other half the next (the NES's own answer to too many sprites).
;; 2, not 3: without it the end of 2-4 (two bars, the lifts, a Podoboo, Bowser's flame, the Starman) runs 263 to 270 lines, past NTSC's 262.
#FIREBAR_FLICKER_BARS = 2

;; Bowser's flame (smbdis 8554 InitBowserFlame, 10324 ProcBowserFlame): its sideways force in
;; 256ths a tick (taken from its force each tick, a pixel more when it borrows, as well as the pixel), its steps up or down to its
;; height (in 64ths a tick), the frenzy's wait after the flame wait, and how often its picture turns (in 64ths of a turn a tick).
;; The NTSC cartridge's own: 1 px and $40 256ths a frame, a step a frame, $20 frames, its picture turned every 2 frames.
#FLAME_FRENZY_EXTRA = 32
#FLAME_PICTURE_RATE = 32
#FLAME_FORCE        = 64
#FLAME_STEP_RATE    = 64

;; The bridge's collapse (smbdis 10095 RemoveBridge): ticks between its pieces.
;; The NTSC cartridge's own: a piece every 4 frames.
#BRIDGE_STEP_TICKS = 4

;; The castle's end (smbdis 1144 PlayerVictoryWalk, 1176 PrintVictoryMessages): the view's own scroll
;; to the retainer's page (256ths a tick over 1 px), and the ticks from the first message to the second and to the end timer.
;; The NTSC cartridge's own: 1.5 px a frame, the second message 128 frames on, the end timer at 256.
#CASTLE_SCROLL_FRACTION = 128
#CASTLE_MSG_SECOND      = 128
#CASTLE_MSG_END         = 256

;; The air bubbles: the shared timer between two, long or short by a random bit (BubbleTimerData), and the
;; rise in 256ths of a pixel a tick, fast or slow by a random bit (Bubble_MForceData).
;; The NTSC cartridge's own numbers (the PAL listing has the same).
#BUBBLE_TICKS_SHORT = 32
#BUBBLE_TICKS_LONG  = 64
#BUBBLE_RISE_SLOW   = $50
#BUBBLE_RISE_FAST   = $ff

;; The title's attract mode (not the cartridge's): the camera's step in 1/256 px a tick, the hold
;; on the castle (2 s) and the black cover after it (half a second). The step is a whole pixel in
;; both builds (50 px a second on PAL, 60 on NTSC): with the front at fractions of a pixel the title
;; overlay moves side to side.
#ATTRACT_BLANK_TICKS = 30
#ATTRACT_HOLD_TICKS  = 120
#ATTRACT_STEP        = 256

;; END OF PHYSICS AND TIMING CONSTANTS -- NTSC
