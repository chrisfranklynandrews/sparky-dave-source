;; Jump forgiveness (sparkydave.player.blitz.ab3, TryStartJump{}): the windows in ticks (0 is off)
;; and the countdowns. The windows follow the two levels (#FORGIVENESS_*, the options page),
;; ApplyForgiveness{} sets them: at the start, and on a change.
Dim forgivenessLevel.w(1)
forgivenessLevel(#FORGIVENESS_BUFFER) = #FORGIVENESS_DEFAULT
forgivenessLevel(#FORGIVENESS_COYOTE) = #FORGIVENESS_DEFAULT
;; Every level's name and window in one place: forgivenessWindowTicks(setting, level), the variant's
;; lengths (0 is off, the cartridge's behaviour).
Dim forgivenessName$(#FORGIVENESS_LEVELS - 1)
forgivenessName$(#FORGIVENESS_OFF) = "OFF"
forgivenessName$(#FORGIVENESS_LOW) = "LOW"
forgivenessName$(#FORGIVENESS_MEDIUM) = "MEDIUM"
forgivenessName$(#FORGIVENESS_HIGH) = "HIGH"
Dim forgivenessWindowTicks.w(1, #FORGIVENESS_LEVELS - 1)
forgivenessWindowTicks(#FORGIVENESS_BUFFER, #FORGIVENESS_OFF) = 0
forgivenessWindowTicks(#FORGIVENESS_BUFFER, #FORGIVENESS_LOW) = #JUMP_BUFFER_LOW_TICKS
forgivenessWindowTicks(#FORGIVENESS_BUFFER, #FORGIVENESS_MEDIUM) = #JUMP_BUFFER_TICKS
forgivenessWindowTicks(#FORGIVENESS_BUFFER, #FORGIVENESS_HIGH) = #JUMP_BUFFER_HIGH_TICKS
forgivenessWindowTicks(#FORGIVENESS_COYOTE, #FORGIVENESS_OFF) = 0
forgivenessWindowTicks(#FORGIVENESS_COYOTE, #FORGIVENESS_LOW) = #COYOTE_LOW_TICKS
forgivenessWindowTicks(#FORGIVENESS_COYOTE, #FORGIVENESS_MEDIUM) = #COYOTE_TICKS
forgivenessWindowTicks(#FORGIVENESS_COYOTE, #FORGIVENESS_HIGH) = #COYOTE_HIGH_TICKS
