;; and not scrolled half past; cleared with the stamp of the playfields.
warpCameraLocked.w = False
warpCameraLockX.w = 0
;; A castle's scroll lock (the cartridge's ScrollLock, the area's ScrollLock object, 2-4's at x 2384): the view's right edge goes no
