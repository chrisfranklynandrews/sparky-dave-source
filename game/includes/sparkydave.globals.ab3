firebarTable(88) = 78
firebarTable(89) = 80
firebarTable(90) = 0
firebarTable(91) = 17
firebarTable(92) = 34
firebarTable(93) = 49
firebarTable(94) = 62
firebarTable(95) = 73
firebarTable(96) = 81
firebarTable(97) = 86
firebarTable(98) = 88
firebarMirror(0) = $01
firebarMirror(1) = $03
firebarMirror(2) = $02
firebarMirror(3) = $00
firebarSpeed(0) = #FIREBAR_SPEED_SLOW
firebarSpeed(1) = #FIREBAR_SPEED_FAST
firebarSpeed(2) = #FIREBAR_SPEED_SLOW
firebarSpeed(3) = #FIREBAR_SPEED_FAST
firebarSpeed(4) = #FIREBAR_SPEED_SLOW
firebarWay(0) = 0
firebarWay(1) = 0
firebarWay(2) = $10
firebarWay(3) = $10
firebarWay(4) = 0
;; Bowser's state (constants.ab3, "BOWSER"): one Bowser at a time, as the cartridge's. The jump's waits and the flame's, by variant, and
;; the pacing distances (both PRandomRange's).
bowserOrigX.w = 0
bowserMaxRange.w = 0
bowserFeetCounter.w = 0
bowserBodyControls.w = 0
bowserFireBreathTimer.w = 0
bowserFlameTimerCtrl.w = 0
bowserHitPoints.w = 0
Dim bowserWait.w(3)
Dim bowserRange.w(3)
Dim bowserFlameWait.w(7)
bowserWait(0) = #BOWSER_WAIT_0
bowserWait(1) = #BOWSER_WAIT_1
bowserWait(2) = #BOWSER_WAIT_2
bowserWait(3) = #BOWSER_WAIT_3
bowserRange(0) = #BOWSER_RANGE_0
bowserRange(1) = #BOWSER_RANGE_1
bowserRange(2) = #BOWSER_RANGE_2
bowserRange(3) = #BOWSER_RANGE_3
bowserFlameWait(0) = #BOWSER_FLAME_WAIT_0
bowserFlameWait(1) = #BOWSER_FLAME_WAIT_1
bowserFlameWait(2) = #BOWSER_FLAME_WAIT_2
bowserFlameWait(3) = #BOWSER_FLAME_WAIT_3
bowserFlameWait(4) = #BOWSER_FLAME_WAIT_4
bowserFlameWait(5) = #BOWSER_FLAME_WAIT_5
bowserFlameWait(6) = #BOWSER_FLAME_WAIT_6
bowserFlameWait(7) = #BOWSER_FLAME_WAIT_7
; Bowser's flame's heights (FlameYPosData), by its random byte's two low bits.
Dim flameHeights.w(3)
flameHeights(0) = $90
flameHeights(1) = $80
flameHeights(2) = $70
flameHeights(3) = $90
firebarBallX.w = 0
firebarBallY.w = 0
;; Every part's offset at every angle, worked out once here (GetFirebarPosition's quadrant fold and mirroring), so a ball is two array
;; reads in the touch and the draw instead of the arithmetic for 6 balls a bar twice a tick (tens of raster lines on NTSC): x and y of
;; part p at spin state s at index s*#FIREBAR_LONG_PARTS + p.
Dim firebarOffsetX.w(32*#FIREBAR_LONG_PARTS - 1)
Dim firebarOffsetY.w(32*#FIREBAR_LONG_PARTS - 1)
firebarFillQuarter.w = 0
For firebarFillState.w = 0 To 31
  firebarFillQuarter = firebarFillState/8
  For firebarFillPart.w = 0 To #FIREBAR_LONG_PARTS - 1
    firebarFillFoldX.w = firebarFillState AND 15
    If firebarFillFoldX >= 9 Then firebarFillFoldX = 16 - firebarFillFoldX
    firebarFillFoldY.w = (firebarFillState + 8) AND 15
    If firebarFillFoldY >= 9 Then firebarFillFoldY = 16 - firebarFillFoldY
    firebarFillIndex.w = firebarFillState*#FIREBAR_LONG_PARTS + firebarFillPart
    firebarOffsetX(firebarFillIndex) = firebarTable(firebarFillPart*9 + firebarFillFoldX)
    firebarOffsetY(firebarFillIndex) = firebarTable(firebarFillPart*9 + firebarFillFoldY)
    If (firebarMirror(firebarFillQuarter) AND 1) = 0 Then firebarOffsetX(firebarFillIndex) = -firebarOffsetX(firebarFillIndex)
    If (firebarMirror(firebarFillQuarter) AND 2) = 0 Then firebarOffsetY(firebarFillIndex) = -firebarOffsetY(firebarFillIndex)
  Next
Next
;; The air bubbles (UpdateBubbles{}): each one's x and y (y -1: none, the cartridge's $f8), its rise's 256ths carried, and the shared
;; timer (AirBubbleTimer).
Dim bubbleX.w(#BUBBLE_SLOTS - 1)
Dim bubbleY.w(#BUBBLE_SLOTS - 1)
Dim bubbleFraction.w(#BUBBLE_SLOTS - 1)
For bubbleIndex = 0 To #BUBBLE_SLOTS - 1
  bubbleY(bubbleIndex) = -1
