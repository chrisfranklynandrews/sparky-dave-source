firebarTable(26) = 24
firebarTable(27) = 0
firebarTable(28) = 6
firebarTable(29) = 12
firebarTable(30) = 18
firebarTable(31) = 22
firebarTable(32) = 26
firebarTable(33) = 29
firebarTable(34) = 31
firebarTable(35) = 32
firebarTable(36) = 0
firebarTable(37) = 7
firebarTable(38) = 15
firebarTable(39) = 22
firebarTable(40) = 28
