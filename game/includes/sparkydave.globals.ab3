;; or music. A pit or the clock still kills him.
debugInvincible.w = False
oldF7.w = False
oldF8.w = False
oldF9.w = False
Dim transitionLabel$(#TRANSITION_LOG_MAX - 1)
Dim transitionTime.l(#TRANSITION_LOG_MAX - 1)
transitionCount.w = 0
transitionDropped.w = 0
; Cells the last stamp did not draw because their GID was above #STAMP_GID_MAX (BuildStampLists{}).
stampSkipped.w = 0
;; The pause: the game is frozen while gamePaused is True; pauseTimer is the lockout after a
;; press; pauseStartHeld is the Start key as it was last tick (only a fresh press counts).
gamePaused.w = False
;; The controls: the keyboard's (#KEYBOARD_*) and the joysticks' (#JOYSTICK_*). menuAxisHeld() is the stick or the arrow keys as
;; they were last tick on a menu, for each axis (#MENU_AXIS_*: -1 up or left, 0, 1 down or right),
;; so that a hold moves or changes once.
keyboardMode.w = #KEYBOARD_TWO_KEY
joystickMode.w = #JOYSTICK_TWO_BUTTON
; The joystick as UpdateJoystick{} read it this frame: its stick (-1, 0 or 1 on each axis) and Joyb's buttons (1 button 1, 2 button 2).
joystickX.w = 0
joystickY.w = 0
joystickButtonBits.w = 0
Dim menuAxisHeld.w(1)
; The course-clear lines' x in the view (CutCourseClearText{}), each centred on its length.
Dim courseClearLineX.w(1)
;; Redefinable keys: keyMap() is the raw key for each #KEY_* action; redefineMap() holds the new
;; choices while the redefine screen is up (committed at the end, dropped by Esc); keyNames$() is
;; each raw code's name, and keyActionNames$() each action's. settingsDirty is True when the
;; controls or the keys differ from the file; settingsPath$ is that file. redefineActive is True
;; while the screen is up, redefineIndex the action being asked for, redefineKeyDown() each key as it
;; was at the last scan (only a fresh press counts), redefineMessage$ a refusal to show, and
;; escapeGuard an Esc that has done its one thing (one press, one action, until it is let go).
Dim keyMap.w(#KEY_COUNT)
Dim redefineMap.w(#KEY_COUNT)
Dim keyNames$(#KEY_LAST)
Dim keyActionNames$(#KEY_COUNT)
;; Debug mode: the debug keys and the two reports, switched on by the parameter debug
;; (sparkydave.init.ab3), and the folder the reports are written to.
debugMode.w = False
reportDir$ = "PROGDIR:"
; Every level on the title's LEVEL row without debug mode, for testing a level at full speed: the parameter levels.
allLevelsOpen.w = False
; Where the game's data files are: a data drawer next to the program (Bthe main project's UILD note).
dataDir$ = "PROGDIR:data/"
settingsPath$ = "PROGDIR:SparkyDave.settings"
settingsDirty.w = False
redefineActive.w = False
redefineIndex.w = 0
Dim redefineKeyDown.w(#KEY_LAST)
redefineMessage$ = ""
escapeGuard.w = False
