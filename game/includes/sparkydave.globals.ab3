coyoteWindow.w = #COYOTE_TICKS
jumpBufferTimer.w = 0
coyoteTimer.w = 0
;; Continues: the options page's choice (saved), each choice's name and number of continues (#CONTINUES_INFINITE for
;; no limit), and how many this game has used (0 at a new game: RestartLevel{True}). What is left is the number less those used
;; (ContinuesLeft{}), so a choice changed mid-game counts at once.
continuesChoice.w = #CONTINUES_DEFAULT
continuesUsed.w = 0
Dim continuesName$(#CONTINUES_CHOICES - 1)
Dim continuesAllowed.w(#CONTINUES_CHOICES - 1)
continuesName$(0) = "NONE"
continuesAllowed(0) = 0
