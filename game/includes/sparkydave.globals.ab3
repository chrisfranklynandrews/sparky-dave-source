; playerIsBig is set by the resize routine (#PLAYER_ST_RESIZE), not by a key.
playerIsBig.w = False
;; The cartridge's CrouchingFlag (smbdis 5875, the main project's PLAYER_HITBOX note): True
;; while a big Mario on the ground holds Down, and left as it is in the air. It picks the small
;; probe set and box, the crouch frame, and stops fireballs and walking.
playerCrouching.w = False

;; Grow/shrink. The target size is latched up front; playerResizeTimer counts the ticks of the
;; hold. worldFreezeTicks is the cartridge's master timer (TimerControl): while it is not zero
;; the enemies and the timers stand still. playerSizeAnimTicks counts down the alternating
;; picture (it can outlast the hold: a hit Mario is free while it shows), and
;; playerSizeAnimGrow says which of the two patterns it is.
playerResizeToBig.w = False
playerResizeTimer.w = 0
worldFreezeTicks.w = 0
playerSizeAnimTicks.w = 0
playerSizeAnimGrow.w = False

;; Resolved once per head check from playerIsBig, so the bump path and the
;; collision test cannot disagree about where Mario's head is.
headProbeY.w = 2

;; Player-vs-object bounding box: moving items, Goombas and Koopas read it. See
;; the main project's OBJECT_SYSTEM note and the main project's PLAYER_HITBOX note section 5.
boundBoxLeft.w = 0
boundBoxTop.w = 0
boundBoxRight.w = 0
boundBoxBottom.w = 0
oldF1.w = False

;; Blocked input direction for the coming frame, the engine's Player_CollisionBits.
;; Written by ImpedePlayerMove{} on a wall hit and reset to $ff after the button
;; read in UpdatePlayer{} -- after ReadPlayerButtons{} so the previous frame's
;; mask is applied, but before CheckPlayerSides{} writes the next one. The pole
;; and resize branches, which return before ReadPlayerButtons{}, reset it
;; themselves so a mask from a grab/mushroom tick does not survive the whole
;; slide or resize. ApplyCollisionButtonMask{} then ANDs it into playerButtons.
;; Only the low byte is read: bit 0 = RIGHT ($01), bit 1 = LEFT ($02), and the
;; B and A bits pass through untouched because the cartridge ANDs the same byte
;; into the whole joypad read.
playerCollisionBits.w = $ff


