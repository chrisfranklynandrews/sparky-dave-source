firebarTable(7) = 7
firebarTable(8) = 8
firebarTable(9) = 0
firebarTable(10) = 3
firebarTable(11) = 6
firebarTable(12) = 9
firebarTable(13) = 11
firebarTable(14) = 13
firebarTable(15) = 14
firebarTable(16) = 15
