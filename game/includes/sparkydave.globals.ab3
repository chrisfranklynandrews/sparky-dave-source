Dim flyCheepNudgeHeight.w(15)
Dim flyCheepSpeed.w(11)
Dim flyCheepTimer.w(3)
flyCheepPosition(0) = $80
flyCheepPosition(1) = $30
flyCheepPosition(2) = $40
flyCheepPosition(3) = $80
