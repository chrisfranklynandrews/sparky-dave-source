;; =======================================================
;; GLOBALS
;; =======================================================

;; Fast RAM at launch, read first, before any Dim: the library allocates every array from any memory (MEMF_PUBLIC,
;; arrayslib.ab3), so Fast RAM when the machine has it. AvailMem_(4) is MEMF_FAST, AvailMem_($20004) its largest block.
fastRamLaunch.l = AvailMem_(4)
fastRamLaunchLargest.l = AvailMem_($20004)

quitFlag.w = False
; Non-zero when a level could not be begun (its area files are not good): the game stops, and says so on leaving.
levelLoadFailCode.w = 0
;; The highest level (an index into the level table) the player has got to, which the settings file keeps, and the level the
;; title's LEVEL row chose for the next new game (a choice for this run only: it is not saved).
levelReached.w = 0
startLevelChosen.w = 0
videoIsNtsc.w = False
simAccumulator.w = 0
simStepNumerator.w = #SIM_HZ
simStepDenominator.w = #SIM_HZ
soundAccumulator.w = 0
soundStepDenominator.w = #SIM_HZ_PAL
mapWidth.w = 0
displayBitmap.w = #PLAY_BM_A
drawBitmap.w = #PLAY_BM_B
drawBuffer.w = #BOB_BUF_B
cameraX.q = 0
scrollX.q = 0
;; The back playfield's display x (the clouds' band) and the hills' band's x: the camera's scrollX
;; times the preset's rates, wrapped into the 768 px strip (BuildRenderView{}).
backScrollX.q = 0
hillScrollX.q = 0
;; The speed presets, the clouds' and the hills' share of the camera's movement (constants.ab3,
;; #PARALLAX_PRESETS): 1 and 1 is the cartridge's picture.
parallaxPreset.w = #PARALLAX_DEFAULT
;; The world's scroll is in whole pixels (True) or with the camera's 1/256 fraction (False). A front at
;; fractions of a pixel moves the back playfield by a pixel (the main project's AMIGA_RENDERER note, "The overlay"), so whole pixels are used.
;; Del switches it in debug mode, to compare the two.
wholePixelScroll.w = True
oldDel.w = False
Dim parallaxCloudRate.q(#PARALLAX_PRESETS - 1)
Dim parallaxHillRate.q(#PARALLAX_PRESETS - 1)
parallaxCloudRate(0) = 1
parallaxHillRate(0) = 1
parallaxCloudRate(1) = 0.5
parallaxHillRate(1) = 0.75
parallaxCloudRate(2) = 0.25
parallaxHillRate(2) = 0.5
parallaxCloudRate(3) = 0.125
parallaxHillRate(3) = 0.5
parallaxCloudRate(4) = 0
parallaxHillRate(4) = 0.5
parallaxCloudRate(5) = 0.25
parallaxHillRate(5) = 0.75
oldF10.w = False
;; The world bitmap check (F10 in debug mode, CheckWorldBitmaps{} in sparkydave.map.blitz.ab3; the report, WriteBitmapCheckReport{}):
;; for each press, what was on show and how many words differed; for each word kept, the press, the bitmap (0 or 1), the cell's
;; column, the pixel row in the world, the plane, the word the atlas wants and the word found.
oldCheckKey.w = False
checkPressCount.w = 0
checkWordCount.w = 0
Dim checkPressLevel.w(#BITMAP_CHECK_PRESSES - 1)
Dim checkPressArea.w(#BITMAP_CHECK_PRESSES - 1)
Dim checkPressCamera.l(#BITMAP_CHECK_PRESSES - 1)
Dim checkPressDrawBitmap.w(#BITMAP_CHECK_PRESSES - 1)
Dim checkPressQueued.w(#BITMAP_CHECK_PRESSES - 1)
Dim checkPressWords.l(#BITMAP_CHECK_PRESSES - 1)
Dim checkPressSkipped.w(#BITMAP_CHECK_PRESSES - 1)
Dim checkWordPress.w(#BITMAP_CHECK_MAX - 1)
Dim checkWordBitmap.w(#BITMAP_CHECK_MAX - 1)
Dim checkWordColumn.w(#BITMAP_CHECK_MAX - 1)
Dim checkWordRow.w(#BITMAP_CHECK_MAX - 1)
Dim checkWordPlane.w(#BITMAP_CHECK_MAX - 1)
Dim checkWordWanted.w(#BITMAP_CHECK_MAX - 1)
Dim checkWordFound.w(#BITMAP_CHECK_MAX - 1)
;; The whole-area part of the check: each press's strays (IsStrayWord{}), and each one kept: the press, the bitmap, the column, the
;; pixel row, the plane and the word wanted. strayWanted is IsStrayWord{}'s word wanted, left for its caller.
strayWanted.w = 0
checkStrayCount.w = 0
Dim checkPressStrays.w(#BITMAP_CHECK_PRESSES - 1)
Dim checkStrayPress.w(#BITMAP_CHECK_STRAYS - 1)
Dim checkStrayBitmap.w(#BITMAP_CHECK_STRAYS - 1)
Dim checkStrayColumn.w(#BITMAP_CHECK_STRAYS - 1)
Dim checkStrayRow.w(#BITMAP_CHECK_STRAYS - 1)
Dim checkStrayPlane.w(#BITMAP_CHECK_STRAYS - 1)
Dim checkStrayWanted.w(#BITMAP_CHECK_STRAYS - 1)
;; The watch (WatchWorldBitmaps{}, switched by F10): whether it is on, its frame count (from 1) and frames on, the next pixel row
;; to look at, the frame each row was last looked at (-1: not since the watch went on) and the columns it covered, and the ring of each frame's state
;; (#WATCH_FIELDS numbers, the frame's at (frame MOD #WATCH_RING)*#WATCH_FIELDS). For each candidate word: when it was first seen,
;; the frame its row was last seen clean, the bitmap, column, pixel row, plane, the word wanted, the camera, the frame it was seen
;; again in the same place (0 not yet: only those are strays), and a copy of the ring at the first sighting. The candidates seen
;; and the strays among them are counted.
watchOn.w = False
watchFrame.l = 0
watchFramesOn.l = 0
watchNextRow.w = 0
watchFoundCount.w = 0
watchFoundTotal.w = 0
Dim watchRowFrame.l(#WATCH_PIXEL_ROWS - 1)
Dim watchRowFirst.w(#WATCH_PIXEL_ROWS - 1)
Dim watchRowLast.w(#WATCH_PIXEL_ROWS - 1)
Dim watchRing.l(#WATCH_RING*#WATCH_FIELDS - 1)
Dim watchFoundFrame.l(#WATCH_MAX - 1)
Dim watchFoundSince.l(#WATCH_MAX - 1)
Dim watchFoundBitmap.w(#WATCH_MAX - 1)
Dim watchFoundColumn.w(#WATCH_MAX - 1)
Dim watchFoundRow.w(#WATCH_MAX - 1)
Dim watchFoundPlane.w(#WATCH_MAX - 1)
Dim watchFoundWanted.w(#WATCH_MAX - 1)
Dim watchFoundCamera.l(#WATCH_MAX - 1)
Dim watchFoundConfirmed.l(#WATCH_MAX - 1)
watchConfirmedTotal.w = 0
Dim watchFoundRing.l(#WATCH_MAX*#WATCH_RING*#WATCH_FIELDS - 1)
;; The stamp repair (RepairStampedBitmaps{}, every stamp; kept in debug mode): the stamps checked, whether the tile set changed since the
;; last stamp (EnsureTileSet{} sets it), and for each stamp with words differing: its number, the level, the area, the area's type,
;; the tile set flag and the words differing. For each word kept: its stamp, the column, the pixel row, the plane, whether a word
;; is wanted there (False: a cell the stamp does not draw), the word wanted and the word in each bitmap.
stampCheckTotal.l = 0
tileSetJustChanged.w = False
stampBadCount.w = 0
stampWordCount.w = 0
Dim stampBadNumber.l(#STAMP_CHECK_STAMPS - 1)
Dim stampBadLevel.w(#STAMP_CHECK_STAMPS - 1)
Dim stampBadArea.w(#STAMP_CHECK_STAMPS - 1)
Dim stampBadType.w(#STAMP_CHECK_STAMPS - 1)
