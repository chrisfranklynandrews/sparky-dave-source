Dim stampWordFoundB.w(#STAMP_CHECK_WORDS - 1)
;; The band split's state (sparkydave.parallax.blitz.ab3): the back's plane addresses and bytes a
;; row, the BPLCON1 tables (by fine position, 0 to 255 quarter pixels), the copper list's custom
;; area, whether poking it is safe, and the hills' last 64 px block.
Dim backPlane.l(3)
backBytesPerRow.l = 0
Dim frontScrollPart.l(255)
Dim backScrollPart.l(255)
bandCustoms.l = 0
;; List 2's custom area (the same strings as list 1's, #BAND_LINE_AWAY lines in), and the HUD-away state: the lists
;; on show (True: list 2, the HUD gone) and the lists wanted this frame (HudAwayNeeded{}).
bandCustomsAway.l = 0
hudAwayShown.w = False
hudAwayWanted.w = False
;; Which scenery kind's strip the back playfield's bitmap holds (#SCENERY_*), or -1 when it holds none of them: at start, and
;; when the title or pause overlay has used it as its canvas (EnsureBackStrip{}).
backStampedKind.w = -1
; The HUD's copy in the back bitmap (UpdateHudMirror{}) is stale: the HUD band changed, or the back was stamped afresh or used as a canvas.
hudMirrorStale.w = False
;; Debug only (the frame time report): the copies of the HUD into the world bitmap and the cuts of Mario at the top of the bitmap,
;; how many, the raster lines they took in all and the worst one.
hudStampTimed.l = 0
; The frame each of Mario's cut-short shapes (#PLAYER_CLIP_SLOTS) holds, plus one: 0 is none.
Dim playerClipFrame.w(#PLAYER_CLIP_SLOTS - 1)
