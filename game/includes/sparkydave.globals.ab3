firebarTable(50) = 39
firebarTable(51) = 44
firebarTable(52) = 47
firebarTable(53) = 48
firebarTable(54) = 0
firebarTable(55) = 11
firebarTable(56) = 21
firebarTable(57) = 31
firebarTable(58) = 39
firebarTable(59) = 46
firebarTable(60) = 51
firebarTable(61) = 55
firebarTable(62) = 56
firebarTable(63) = 0
firebarTable(64) = 12
firebarTable(65) = 24
firebarTable(66) = 36
firebarTable(67) = 45
firebarTable(68) = 53
firebarTable(69) = 59
firebarTable(70) = 62
firebarTable(71) = 64
firebarTable(72) = 0
firebarTable(73) = 14
firebarTable(74) = 27
firebarTable(75) = 40
firebarTable(76) = 50
