playerScreenX.q = 0
playerJumpOriginY.w = 0
sideCollisionTimer.w = 0
blockBounceTimer.w = 0

;; Block bump. #MARIO_BLOCKBOUNCE is both the animation clock and the re-bump
;; lockout, so one timer drives both. The bump cell stays solid in
;; metatileBuffer for the whole bump; only mapBuffer changes (0 during the bob,
;; the settled value at the end). One bump at a time, like the ROM.
;;
;; blockBumpOffset: the Y offset of the bob, indexed by
;; #MARIO_BLOCKBOUNCE - blockBounceTimer. Rest -> pop -> rest, zero at both
;; ends so the hand-off from the last bob frame to the stamped settled tile is
;; seamless. The cartridge's own bounce (the main project's OBJECT_SYSTEM note, "The block bump"):
;; speed -2, then ImposeGravity{} with force $50 a tick, played out from smbdis 7660 and 7704. It
;; peaks 8 px up and is back at rest on the 14th tick; the last two entries are rest for the
;; 16 tick lockout.
Dim blockBumpOffset.w(#MARIO_BLOCKBOUNCE - 1)
;; Played out the way the cartridge does it (BumpBlock, smbdis 7316, and ImposeGravity, 7704): the
;; block starts at speed #BLOCK_BOUNCE_SPEED with no fractional force; each tick its fraction takes
;; the force (a carry moves it a pixel further), then the force takes the gravity (a carry makes
;; the speed a step slower on the way up). It is back at rest after about 14 ticks (NTSC), and
;; the rest of the lockout is rest.
blockBumpOffset(0) = 0
bumpTableSpeed.w = #BLOCK_BOUNCE_SPEED
bumpTableForce.w = 0
bumpTableFraction.w = 0
bumpTablePosition.w = 0
For bumpTableStep.w = 1 To #MARIO_BLOCKBOUNCE - 1
  bumpTableSum.w = bumpTableFraction + bumpTableForce
  bumpTableCarry.w = 0
  If bumpTableSum >= 256
    bumpTableSum = bumpTableSum - 256
    bumpTableCarry = 1
  EndIf
  bumpTableFraction = bumpTableSum
  bumpTablePosition = bumpTablePosition + bumpTableSpeed + bumpTableCarry
  bumpTableForce = bumpTableForce + #BLOCK_BOUNCE_GRAVITY
  If bumpTableForce >= 256
    bumpTableForce = bumpTableForce - 256
    bumpTableSpeed = bumpTableSpeed + 1
  EndIf
  blockBumpOffset(bumpTableStep) = 0
  If bumpTablePosition < 0 Then blockBumpOffset(bumpTableStep) = 0 - bumpTablePosition
Next
blockBumpActive.w = False
blockBumpCell.w = 0
;; #MT_EMPTY, by value: its named constant is defined in the metatile include,
;; which comes after this file in the flatten.
blockBumpClass.w = 0
blockBumpGid.w = 0

;; Flagpole. The pole is a third player state, after ground and air. It bypasses the audited movement path
;; entirely rather than being a mode inside it.
playerState.w = #PLAYER_ST_FREE
playerPoleTimer.w = 0
flagState.w = #FLAG_ST_IDLE
;; Ticks until the slide sound is queued after the grab (the cartridge queues it a frame after
