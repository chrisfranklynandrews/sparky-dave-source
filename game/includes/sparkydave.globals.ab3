frameTimeCrossings.l = 0
frameTimeHidden.l = 0
frameTimeVblanksNow.l = 0
frameTimeCrossNow.l = 0
;; The whole loop by the same count, start to start: the display frames the last pass took (1 at full rate), so a pass that
;; waited a frame more after its work (the VWait, the lists' switch) is seen too. frameTimeLongLoops counts those of 2 or more,
;; frameTimeLongLoopsFit those whose work had not run into the next frame; frameTimeLoopFrames is shown in the slow-frame log.
frameTimeTodLastStart.l = -1
frameTimeLoopFrames.l = 0
frameTimeLongLoops.l = 0
frameTimeLongLoopsFit.l = 0
frameTimeLoopTotal.l = 0
