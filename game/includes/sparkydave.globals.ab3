frameTimeHudLine.l = 0
frameTimeWorldSum.l = 0
frameTimeHudSum.l = 0
frameTimeRestSum.l = 0
frameTimeWorldMax.l = 0
frameTimeHudMax.l = 0
frameTimeRestMax.l = 0
;; The sim segment's own marks: before RunSimTicks{} and after it (the sound follows).
;; The objects and enemies are timed inside UpdatePlayer{} (ObjectsTimeBegin{} and ObjectsTimeEnd{},
;; sparkydave.timing-marks.blitz.ab3), added up over the frame's ticks into frameTimeObjectsLines.
;; The ...Now values are this frame's, for the slow-frame log.
frameTimeTicksLine.l = 0
;; The CIA-A frame count (its time of day's low byte) at each mark, the ground truth the beam cannot give: a part of the loop
;; longer than a frame wraps the beam and reads short, but the count moves. A frame whose count moved between its start and its
;; end ran into the next display frame; frameTimeCrossings counts them, frameTimeHidden those the line count called in budget.
frameTimeTodStart.l = 0
frameTimeTodTicks.l = 0
frameTimeTodSound.l = 0
