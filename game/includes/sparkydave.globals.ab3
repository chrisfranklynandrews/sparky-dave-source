;; The firebars' tables (smbdis 9678 FirebarPosLookupTbl, 9691 FirebarMirrorData, 8366 FirebarSpinSpdData and FirebarSpinDirData): the
;; offsets by part (9 a part: one quadrant's 0 to 8), the mirroring by quarter turn (bit 0 x to the right, bit 1 y down), and each kind's
;; speed and way (0 clockwise, $10 counter-clockwise). firebarBallX and firebarBallY are FirebarBallOffset{}'s answer.
Dim firebarTable.w(98)
Dim firebarMirror.w(3)
Dim firebarSpeed.w(4)
Dim firebarWay.w(4)
firebarTable(0) = 0
firebarTable(1) = 1
firebarTable(2) = 3
firebarTable(3) = 4
firebarTable(4) = 5
firebarTable(5) = 6
