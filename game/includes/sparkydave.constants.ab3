;; =======================================================
;; CONSTANTS
;; =======================================================

#RAW_KEY_JUMP  = $40
#RAW_KEY_START = $44 ; Return, the cartridge's Start button
#RAW_KEY_ESC   = $45
#RAW_KEY_UP    = $4c
#RAW_KEY_DOWN  = $4d
#RAW_KEY_RIGHT = $4e
#RAW_KEY_LEFT  = $4f
#RAW_KEY_F1    = $50
#RAW_KEY_F2    = $51
#RAW_KEY_F3    = $52
#RAW_KEY_RUN   = $63
#RAW_KEY_ALT   = $64
#RAW_KEY_RALT  = $65

;; Debug keys (debug mode only): F4 makes Mario big, F5 makes him small, F3 plays the shell-chain scene, F7 switches invincibility
;; and F8 gives the Starman. Del switches the world's scroll between whole pixels and fractions. A player can never choose one of
;; these for an action: the redefine screen refuses every function key, Del and Help.
;;
;; These are Amiga raw key codes, which follow the keyboard's matrix, not the alphabet: $20 is A, $21 S, $22 D, $23 F ... $31 Z ...
;; $42 is Tab, not B. Space is $40, Esc $45, F1 $50.
#RAW_KEY_DEL        = $46
#RAW_KEY_BIG        = $53
#RAW_KEY_SMALL      = $54
#RAW_KEY_INVINCIBLE = $56
#RAW_KEY_STAR       = $57
#RAW_KEY_F9         = $58
#RAW_KEY_F10        = $59
#RAW_KEY_HELP       = $5F

;; The display's type words. #COPPER_FLAGS ($11014) is 4 planes, smooth scroll, AGA colours and fetch mode 1 (32 bit). Fetch mode 1
;; leaves the two sprite channels that Mario's attached 15 colour sprite needs; fetch mode 3 would leave only one (the guide warns that
;; sprites and fetch mode 3 do not mix well). Fetch blocks are 32 pixels wide (#FINE_MASK, the band's maths). Each displayed bitmap
;; is a multiple of 64 pixels wide and #FETCH_GUARD pixels wider than the view or the map, because the fetch can run up to
;; #FETCH_GUARD pixels past the view.
;; The world list is dual playfield: #WORLD_FLAGS is #COPPER_FLAGS with 8 planes and the dual playfield bit ($20). The front playfield
;; is the world and its bobs; the back is the clouds and hills (#BACK_BM), in palette entries 16 to 31. BPLCON3's PF2OF is 8 by
;; default, and DisplayControls XORs its BPLCON3 argument, so #PLAYFIELD2_OFFSET_16 makes it 16 when given once, before CreateDisplay.
;; A second call would flip it back: DisplayControls is a toggle (the main project's BLITZ_CONVENTIONS note). The HUD list loads all 32 colours.
;; #PLAYFIELD2_PRIORITY flips BPLCON2's PF2PRI, putting the back playfield in front of the front one for the title overlay
;; (SetOverlayFront{}, sparkydave.parallax.blitz.ab3; the main project's AMIGA_RENDERER note, "The overlay").
#COPPER_SPRITES       = 0
#PLAYFIELD_PLANES     = 4
#COPPER_COLORS        = 32
#FETCH_GUARD          = 64
#PLAYFIELD2_PRIORITY  = $40
#PLAYFIELD2_OFFSET_16 = $1c00
#COPPER_FLAGS         = $11014
#WORLD_FLAGS          = $11038

;; Two stacked Copper lists: a fixed HUD band, then the scrolling world. The Blitz guide requires at least 3 lines between lists, so
;; the world list starts #LIST_GAP lines under the HUD band. Together the two lists cover 227 lines. They start at line #HUD_YPOS_PAL
;; (44, the top of the standard PAL window), or on an NTSC machine at #HUD_YPOS_NTSC (32): an NTSC window is 200 lines with overscan to
;; about line 261, so 227 lines fit only by starting higher. 32 is measured: 30 or less loses the top, 36 or more runs past the last line.
;; Palette entry 0 is the sky blue, which hides the 3 line seam.
;; The world list shows #VIEW_H (208) lines from bitmap row #VIEW_TOP (32), set through DisplayBitMap's y: the map's top two rows are
;; the NES status bar area, which the HUD band replaces. #WORLD_H is #MAP_H*#TILE, from the generated level meta (included after this
;; file; python tools/build_assets.py). The world bitmaps are #SURFACE_H tall: one extra tile row, so a blit that lands just below the
;; map, such as a falling Mario, stays inside the bitmap.
#HUD_BAND_BM = 10

;; The safe margin: nothing that must be read sits within this many pixels of the view's left and right edges, because a different
;; monitor, an emulator or a handheld may crop a little. The HUD text starts and ends inside it.
#SAFE_MARGIN = 8

;; Screen layout rows. The redefine-keys screen's list starts at #KEYS_LIST_Y. The title screen's rows (sparkydave.cover.blitz.ab3)
;; start with the menu line at #TITLE_MENU_Y, and each row after it is a line (#TITLE_LINE) or a gap (#TITLE_GAP) below the one before.
;; Everything is centred in the view by DrawTextCentredAt{} (at the overlay page's x), so no x is worked out by hand.
#LIST_GAP      = 3
#TITLE_LINE    = 16
#HUD_H         = 16
#TITLE_GAP     = 24
#HUD_YPOS_NTSC = 32
#VIEW_TOP      = 32
#HUD_YPOS_PAL  = 44
#KEYS_LIST_Y   = 48
#TITLE_MENU_Y  = 144
#VIEW_H        = 208
#SURFACE_H     = 256
;; Apart from the front pair's extra tile row (#SURFACE_H), no displayed bitmap has spare rows under its picture: the display window
;; closes under the picture (the main project's AMIGA_RENDERER note, "The window's lines"), so such rows would never be shown, and leaving them out
;; saves Chip RAM. Some draws end exactly on a bitmap's last row (the menu hint, the jukebox readout and the palette page's scene, all
;; ending on row 239 of #WORLD_H), and Blit and Block are not clipped: a draw moved lower, or a list made longer (#KEY_COUNT), writes
;; past the bitmap into the next Chip RAM allocation, so check it against the bitmap's height first. If garbage ever shows under a
;; picture, a missing spare row is the likely cause.

; The view's width in lores pixels: the cartridge's own screen, 256, centred in the 320 wide hardware display. The same in both looks.
#VIEW_W = 256

;; The cartridge's screen width, the number the cartridge's own rules are written in. It is defined from #VIEW_W so the two cannot
;; differ; the separate name marks code that follows the cartridge's arithmetic.
#NES_VIEW_W = #VIEW_W

;; The five DisplayAdjust numbers for that width (the main project's AMIGA_RENDERER note, "The display window"): the fetch's width in bytes, its
;; start and stop in colour clocks, and the window's start and stop in pixels. The fetch is the library's own 320 pixels (start and
;; stop 0, fetch mode 1), and the window is 32 pixels in on each side (31 and -33), which cuts the picture to 256. A narrower fetch
;; shows blue at the left edge and jumps while scrolling.
#DISPLAY_DIWSTOP  = -33
#DISPLAY_DDFSTOP  = 0
#DISPLAY_DDFSTART = 0
#DISPLAY_FETCHWID = 0
#DISPLAY_DIWSTART = 31

;; The line byte of the library's DIWSTOP ($70c1: line $170, past the frame's last line). With DIWSTRT's line 0 that window covers the
;; whole frame and fills it with pen 0 above and below the picture. SparkyDave.ab3 adds to both so the window covers the picture's lines only.
#LIBRARY_DIWSTOP_LINE = $70

;; The lead-in, added to every x the game hands to the display (DisplayBitMap) so that a bitmap's pixel 0 is on the screen's left edge.
;; The window (DIWSTRT 31) starts 32 pixels in from the first fetched block, and the fetch start moves in whole blocks, so no DDF start
;; can centre it. The display x is therefore negative at the camera's left edge, and the 32 bitmap pixels left of x 0 are the ones the
;; window cuts. A front x is never left negative where the band is used (ShowWorldLists{}, the overlay pages, the attract start).
#SCROLL_BIAS = -32

;; The black cover's sub-pixel phase, added to the cover's front x under the options, pause, jukebox and palette pages. The library's
;; table gives a whole x the quarter-pixel bits 3, while the page and the world have 0, and two playfields a fraction apart show the
;; page half a pixel off on some lines, or shimmering, depending on the emulator. 0.75 lines the front's quarter bits up with the page's
;; (the main project's AMIGA_RENDERER note, "The overlay"). It is a macro, not a # constant, because a constant cannot hold a fraction ("Illegal
;; constant expression"); a macro is text put in wherever !COVER_PHASE_X is written (Amiblitz3.guide, 2.10 Macros).
Macro COVER_PHASE_X:0.75:End Macro

;; Column positions (x in pixels on the view or on the overlay page): the redefine-keys list (the mushroom cursor, the action, the
;; key's name; the longest name, PAD RPAREN, is 80 wide), the palette page's scene (big Mario, small Mario, a Goomba, a Koopa, each
;; 16 wide) and the options, pause, palette and jukebox pages (the cursor, the labels, the values). The value column has room for 16
;; glyphs before #VIEW_W, which is why the joystick texts and the jukebox's volume labels are short.
#MENU_LABEL_X      = 16
#KEYS_CURSOR_X     = 40
#PAL_PAGE_BIG_X    = 40
#KEYS_ACTION_X     = 64
#MENU_VALUE_X      = 128
#KEYS_NAME_X       = 144
#PAL_PAGE_SMALL_X  = 152
#PAL_PAGE_GOOMBA_X = 184
#PAL_PAGE_KOOPA_X  = 216

;; HUD glyph sheet, hud-objects.iff: 44 cells of 8x8, 352x8. Glyph g is cut into
;; shape slot #HUD_SHAPE_BASE + g. Cells: 0-9 digits, 10-35 A-Z, 36 dash,
;; 37 small x, 38 exclaim, 39 dot, 40 copyright, 41 mushroom, 42 crown, 43 coin.
#HUD_BM        = 8
#HUD_G_DASH    = 36
#HUD_G_X       = 37
#HUD_G_EXCLAIM = 38
#HUD_G_COIN    = 43

;; Pre-cut actor shapes (sparkydave.shapes.blitz.ab3), one shape slot per animation frame. Slots 0 to 7 are single-use shapes and
;; 44 to 87 the HUD's glyphs. From 145 on each enemy, item and screen has its own range (its block below says which). `Max Shape` in
;; the header of SparkyDave.ab3 must be at least one past the highest slot used.
;;   8 to 21  small Mario facing right       22 to 35  small Mario facing left
;;   36 to 38 Goomba                         39 to 41  mushroom, items cells 29 to 31
;;   88 to 106 big Mario right               107 to 125 big Mario left
;;   126 to 133 coin, items cells 42 to 49   134 to 137 brick chunks (below)
;;   138 to 143 score digits, 144 the "1UP" (floating numbers, below)
#PRE_GOOMBA_FRAMES   = 3
#PRE_MUSHROOM_FRAMES = 3
#PRE_SMALL_R         = 8
#PRE_COIN_FRAMES     = 8
#PRE_SMALL_FRAMES    = 14
#PRE_BIG_FRAMES      = 19
#PRE_SMALL_L         = 22
#PRE_MUSHROOM_CELL   = 29
#PRE_GOOMBA          = 36
#PRE_MUSHROOM        = 39
#PRE_BIG_R           = 88
#PRE_BIG_L           = 107
#PRE_COIN            = 126

;; Brick chunks (sparkydave.debris.blitz.ab3). One 8x8 fragment, the top left
;; quarter of the items sheet's brick_debris cell (#DEBRIS_ITEM_CELL), in four
;; flip variants (bit 0 flips X, bit 1 flips Y), cut once at start into slot
;; #DEBRIS_SHAPE + variant; all four pieces share it, as on the cartridge. Pieces
;; are 0 upper-left, 1 upper-right, 2 lower-left, 3 lower-right. Speeds are 8.8
;; fixed point pixels per sim tick, the cartridge's (smbdis SpawnBrickChunks 7416,
;; ImposeGravityBlock 7660): upper pair -6, lower pair -4 and 8 px lower, gravity
;; 80/256 a tick, terminal 8, one pixel a tick sideways, spin every 4 ticks.
;; #DEBRIS_SETS is the two block-object slots the cartridge alternates between.
#DEBRIS_UPPER_SPEED = -1536
#DEBRIS_LOWER_SPEED = -1024
#DEBRIS_SETS        = 2
#DEBRIS_PIECES      = 4
#DEBRIS_VARIANTS    = 4
#DEBRIS_SPIN_TICKS  = 4
#DEBRIS_SIZE        = 8
#DEBRIS_ITEM_CELL   = 27
#DEBRIS_GRAVITY     = 80
#DEBRIS_SHAPE       = 134
#DEBRIS_TERMINAL    = 2048
;; HUD values. One HUD time unit is #HUD_TIME_TICKS sim ticks (sparkydave.physics.ab3). The points are the original game's but have
;; not been checked against the cartridge.
#HUD_GLYPHS     = 44
#HUD_SHAPE_BASE = 44
#SCORE_BRICK    = 50
#SCORE_STOMP    = 100
#SCORE_COIN     = 200
#HUD_SHEET_W    = 352
#HUD_TIME_START = 400
#SCORE_POWER_UP = 1000
#HUD_SCORE_MAX  = 999999

;; The HUD's digit positions, for redrawing only the digits that changed (UpdateHud{}): the
;; score's 6, the coins' 2 and the time's 3, each number's first slot.
#HUD_SLOT_SCORE  = 0
#HUD_SLOT_COINS  = 6
#HUD_SLOT_TIME   = 8
#HUD_DIGIT_SLOTS = 11

; Chip RAM report (debug mode only), see sparkydave.memory.ab3.
#MEM_SAMPLE_FRAMES = 64

;; The machine checks' numbers (the CPU, the chipset, the least Fast and Chip RAM) are in sparkydave.machine.ab3, with
;; the checks, so the launcher's helper DetectVideo can include them without this file.

;; Twice the microseconds of one raster line (63.5), so lines * #RASTER_LINE_US_X2 / 2 is
;; microseconds in the frame time report (sparkydave.reports.ab3).
#RASTER_LINE_US_X2 = 127

; Frame time report (debug mode only), see sparkydave.frametime.blitz.ab3.
#PERF_LINES_NTSC = 262
#PERF_LINES_PAL  = 312

;; The slow-frame log in that report: up to #SLOW_LOG_MAX of the heaviest frames of at least #SLOW_LOG_LINES lines, each with what was
;; on screen. It holds 80 so that a long heavy stretch (2-4 with the Starman) does not crowd out the odd slow frame.
#SLOW_LOG_MAX   = 80
#SLOW_LOG_LINES = 200

; The display stretch's log (FrameTimeAfterDisplay{}): its slowest passes kept.
#DISPLAY_LOG_MAX = 16

;; The world bitmap check (F10 in debug mode, CheckWorldBitmaps{}): how many differing words and how many presses are kept for the
;; report at exit (a press after the last is still counted, but its words are not kept). The watch it switches on (WatchWorldBitmaps{}):
;; the world's pixel rows checked each frame (kept small: 8 rows across the view cost about 70 raster lines), the candidates kept (a
;; stray is one seen again in the same place a sweep later), the columns checked past the view's right edge, the numbers kept for each
;; frame, the strays the whole-area check keeps, the frames of state kept in its ring (more than a sweep's), and the world's pixel rows
;; (#MAP_H*#TILE; the level meta is included later). The stamp repair (RepairStampedBitmaps{}, debug mode only): the stamps with
;; differing words kept, and the words kept.
#WATCH_ROWS_A_FRAME   = 2
#WATCH_MAX            = 8
#BITMAP_CHECK_PRESSES = 16
#WATCH_AHEAD_COLUMNS  = 16
#WATCH_FIELDS         = 16
#STAMP_CHECK_STAMPS   = 32
#BITMAP_CHECK_STRAYS  = 64
#WATCH_RING           = 128
#STAMP_CHECK_WORDS    = 200
#WATCH_PIXEL_ROWS     = 240
#BITMAP_CHECK_MAX     = 400

;; The transition log (sparkydave.timing-marks.blitz.ab3) keeps this many marks; the report
;; says how many it had to drop.
#TRANSITION_LOG_MAX = 300

;; The highest tile GID the playfield stamp groups by (BuildStampLists{}); the NES atlas has 174. A cell above it is not drawn, and
;; the report says how many were skipped.
#STAMP_GID_MAX = 1023

;; The development keys and the two reports work only when the program is started with the parameter debug (`SparkyDave debug`; the
;; variable debugMode, sparkydave.init.ab3), so the program that is tested is the program that is shipped (the main project's INPUT note,
;; "Debug keys"). F1 (reset the game) is not a debug key.

;; Jump forgiveness: NOT the cartridge's (the main project's PLAYER_PHYSICS note, "Jump forgiveness"). A jump
;; pressed a few ticks too early is remembered and fires on landing (jump buffering), and one
;; pressed a few ticks too late, just after walking off a ledge, still jumps (coyote time). The
;; windows are in the physics variant files, one per level: #JUMP_BUFFER_LOW_TICKS,
;; #JUMP_BUFFER_TICKS (medium) and #JUMP_BUFFER_HIGH_TICKS, and the same three for #COYOTE_*. Each
;; of the two is a setting on the options page: off is the cartridge's behaviour exactly.
#FORGIVENESS_OFF     = 0
#FORGIVENESS_LOW     = 1
#FORGIVENESS_MEDIUM  = 2
#FORGIVENESS_DEFAULT = 2

;; The two forgiveness settings, the first index of forgivenessLevel() and forgivenessWindowTicks().
;; #OPT_JUMP_BUFFER and #OPT_COYOTE (the options page's rows) follow the same order.
#FORGIVENESS_BUFFER = 0
#FORGIVENESS_COYOTE = 1
#FORGIVENESS_HIGH   = 3
#FORGIVENESS_LEVELS = 4

;; Continues: not the cartridge's. The options page's CONTINUES setting is one of #CONTINUES_CHOICES (continuesChoice, saved: NONE, 1,
;; 2, 5, 10, INFINITE; continuesAllowed() holds each one's number, #CONTINUES_INFINITE for the last). While a game has continues left,
;; its game over offers one, which carries on from where Mario died with the score and coins kept and the lives restored.
#CONTINUES_INFINITE = -1
#CONTINUES_DEFAULT  = 0
#CONTINUES_CHOICES  = 6

;; The controls (the main project's INPUT note, "Controls"): two settings on the options page; the keyboard and the joystick port are both always
;; read. KEYBOARD (keyboardMode): 2 key is classic (the run key and the fire key each do both, as the cartridge's B button does); 3 key
;; is split (run and fire apart). JOYSTICK (joystickMode): 2 button, button 1 (a pad's red) jumps and button 2 (blue) runs and fires;
;; 1 button, stick up jumps and the button runs and fires. A CD32 pad is read as a 2 button joystick.
#KEYBOARD_TWO_KEY    = 0
#JOYSTICK_TWO_BUTTON = 0
#KEYBOARD_THREE_KEY  = 1
#JOYSTICK_ONE_BUTTON = 1
#KEYBOARD_MODES      = 2
#JOYSTICK_MODES      = 2
;; Settings files older than SPARKYKEYS11 hold a single controls number, converted by OldControlsKeyboard{} and OldControlsJoystick{}:
;; 0 keyboard 2 key, 1 keyboard 3 key, 2 joystick 1 button, 3 joystick 2 button, 4 CD32 pad.
#OLD_CONTROLS_KEYS_SPLIT = 1
#OLD_CONTROLS_JOY_ONE    = 2
#OLD_CONTROLS_COUNT      = 5

;; Redefinable keys (the main project's INPUT note, "Redefinable keys"): the eight actions in keyMap() order, and the highest raw code a key can
;; have (the Right Amiga key). #SAVE_DELAY_FRAMES is the wait after the settings are written, before Blitz mode takes the machine back
;; (the guide's "QAmiga mode").
#KEY_LEFT  = 0
#KEY_RIGHT = 1
#KEY_JUMP  = 2
#KEY_DOWN  = 3
#KEY_RUN   = 4
#KEY_FIRE  = 5
#KEY_UP    = 6
#KEY_PAUSE = 7
#KEY_COUNT = 8
;; How many actions older settings files have keys for: files before SPARKYKEYS6 run from left to fire (no #KEY_UP), and files before
;; SPARKYKEYS10 from left to up (no #KEY_PAUSE). A missing key gets its default (DefaultUpKey{}, DefaultPauseKey{}).
#KEY_COUNT_OLD          = 6
#KEY_COUNT_BEFORE_PAUSE = 7
#RAW_KEY_PAUSE          = $19
#SAVE_DELAY_FRAMES      = 50
#KEY_LAST               = $67

;; The offset of pr_WindowPtr in a struct Process (dos/dosextens.h). Setting it to -1 turns off system requesters
;; (SystemRequestersOff{}, sparkydave.settings.ab3).
#PR_WINDOWPTR = 184

;; The joystick port, the only port read (UpdateJoystick{}): Blitz's port 1, which is the Amiga's port 2. The mouse port is not read,
;; because a test to tell a mouse from a stick there can mistake a pad (the A500 Mini's) for a mouse.
#JOY_PORT = 1

;; The most a packed area file's body can exceed its unpacked word count (tools/area_bin.py, PACK_MAX_EXTRA_WORDS, checked by the
;; build): one first run for each of its three sections. The loader's buffer allows for it (packedAreaWords(), sparkydave.areaload.ab3).
#AREA_PACK_EXTRA_WORDS = 9

; The sound engine's tick switch: 0 leaves the engine idle, to compare frame times with and without sound.
#SOUND_ON = 1

;; The sound engine runs at the NES's 60 ticks a second on either machine (RunSoundTicks{}), so the
;; music and the effects keep their tempo and pitch whatever the sim's rate is.
#SOUND_HZ = 60

;; The pause (smbdis 851): after a press, #PAUSE_LOCKOUT_TICKS ticks ($2b) before another
;; is taken.
#PAUSE_LOCKOUT_TICKS = 43

;; Render margin either side of the view: an object is drawn while any part of
;; it is within this many pixels of the view. Covers a 16 px sprite, fine scroll
;; and a frame of movement. Render only: simulation and despawn ignore it.
#VIEW_GUARD = 32

;; Big Mario: 19 frames of 16x32, bitmap slot 5, shape slot 3.
;;
;; Frames 0-4 and 6-14 are the same in both sheets. Frame 5 is DEATH on Small Mario and CROUCH on Big;
;; those states never meet (a dead Mario is not big, and small cannot crouch), so #MARIO_F_* drives both.
;; Big has one swim frame Small does not: 14. Frames 15-18 are not used (15 is a Small Mario left in the
;; big row, 16-18 are alternative walks). Names from game-data/derived/mario-big-contact.json.
#MARIO_BIG_SHAPE  = 3
#MARIO_BIG_BM     = 5
#MARIO_F_CROUCH   = 5
#MARIO_BIG_FRAMES = 19
#MARIO_BIG_H      = 32
#MARIO_BIG_W      = 304

;; The 52-tile item sheet is a separate bitmap because its natural width is
;; larger than the small Game Objects sheet. Its shape size comes from the
;; authored object box in #ITEM_W/_H, not from #TILE, so the sheet and the
;; map cannot disagree about how big a mushroom is.
#ITEMS_SHAPE   = 4
#ITEMS_BM      = 6
#ITEMS_SHEET_H = 16
#ITEMS_SHEET_W = 992

;; Shape slots: 0 tile, 1 small Mario, 2 flag, 3 big Mario, 4 items. The bump
;; bob blits a map tile as a moving cookie, so it needs its own slot. The
;; item occluder re-stamps the releasing cell's tile as a plain Block, so
;; it keeps a third tile slot: it must not reuse #BUMP_SHAPE, because the
;; player can bump another block during the rise and the bob owns that slot.
#BUMP_SHAPE    = 5
#OCCLUDE_SHAPE = 6

;; The pipe occluder's tiles (sparkydave.pipes.blitz.ab3): each cell of the pipe Mario is in is
;; cut once when the pipe move starts, into its own slot from #PIPE_OCCLUDE_SHAPE, so a frame
;; only Blocks. #PIPE_OCCLUDE_MAX cells at most: 2x4 down, 3x2 into the side pipe, 2x4 up.
;; Slots 203 to 210, after the floating numbers' 193 to 202.
#PIPE_OCCLUDE_MAX   = 8
#PIPE_OCCLUDE_SHAPE = 203

;; The course-clear screen's two lines of text, each composed once into one shape (CutCourseClearText{}), slots 211 and 212, so the
;; screen costs two blits a frame instead of 24 glyph blits while it waits for Return (the main project's OPTIMISATION note).
#COURSE_TEXT_SHAPE = 211

;; The mushroom walks one pixel a tick, as the cartridge's items do. Whole
;; pixels, not sixteenths: it is not on the player's friction curve.
#MUSHROOM_SPEED       = 1
#ITEM_FIXED_DIRECTION = 1
#ITEM_W               = 16
#ITEM_H               = 16
#MUSHROOM_SPRITE      = 29

;; The 1-UP is the mushroom drawn in green (items cell 30), and a hidden block
;; releases it. The cartridge clears Hidden1UpFlag when the level decoder reaches
;; the block, and sets it only on a new game (smbdis 1041, 4172-4176), so after a
;; death the block is gone from the level. #HIDDEN_ONEUP_ONCE = 1 keeps that; 0
;; brings the block back on every life. Must match ONEUP_SPRITE in manifest.py.
#HIDDEN_ONEUP_ONCE = 1
#ONEUP_SPRITE      = 30

;; Vertical motion for the block-item spawn, in two phases.
;;
;; Rise: the mushroom spawns fully inside the block, top flush with the block's
;; top, and rises #ITEM_H over exactly one real second -- simStepNumerator
;; ticks, the clock rate in the main project's TIMING note -- on a fixed per-tick step and
;; ignoring gravity. The rise ends with the bottom flush with the block's top,
;; and from there the mushroom rests on the block's top, walks at
;; #MUSHROOM_SPEED, and falls off the edge when its foot probe clears solid.
;;
;; Fall: constant gravity in 1/256 px subpixel units, the same
;; playerMoveForceY/playerFractionY pattern the player's integrator uses
;; (sparkydave.player.blitz.ab3), rather than whole pixels: objVelY()
;; is 1/256 px per tick. NTSC-derived values; the PAL clock applies the same
;; per-tick values at 50 ticks/s.
;; The cartridge's MoveD_EnemyVertically gives a falling power-up $3d (61) a tick and a cap of 3 px a
;; tick (smbdis 7599, 7637, 7704). Goombas and Koopas fall under the same routine and numbers: see
;; #GOOMBA_GRAVITY and #GOOMBA_FALL_MAX.
#MUSHROOM_GRAVITY  = 61
#MUSHROOM_FALL_MAX = 768

;; Coin (block-spawned only). The coin pops up from the ? block, spins
;; for a short time, then auto-collects. No walking or falling like the
;; mushroom. Uses the items-16x16 sheet: coin_1/2/3 (indices 42-44) for
;; the idle spin, coin_turning_1-4 (indices 45-48) for the pop animation.
#COIN_ANIM_SPEED = 4
;; Colour cycling (sparkydave.palette.blitz.ab3, the main project's PALETTE note). Pen 12 is the glint colour: the `?` block, the floating coins
;; and the HUD coin icon are drawn in it, and one palette entry rewritten every #CYCLE_TICKS ticks through #CYCLE_STEPS colours moves
;; them all together, as the cartridge's ColorRotation does (smbdis 8000s). Pens 13 to 15 are Mario's, recoloured for Fire Mario and
;; the Starman. #PALETTE_SAFE_LINE is the beam line the palette must not be rewritten before: the HUD list loads it at line 44.
#CYCLE_STEPS = 6
#CYCLE_TICKS = 8
;; The palette's cover modes (coverNow in PaletteComponent{}): the overlay over a cover, the jukebox page, and the palette page, whose
;; pen 0 is its area look's backdrop, not the cover's black (its rows sit over the sky, its scene on the front).
#PALETTE_COVER_OVERLAY = 1
#PALETTE_COVER_JUKEBOX = 2
#PALETTE_COVER_PAGE    = 3

;; The NES palette chosen (paletteChoice): 0 is "as drawn", the art's own colour tables, and 1 on are the palettes in
;; sparkydave.palettes.data.ab3. That file also holds #PALETTE_DEFAULT (the choice for a new settings file and for DEFAULTS) and which
;; choices a release offers (nesInRelease()). Then the palette page's area looks (ground, underground, water, castle: AreaLookIndex{}'s
;; sets 0, 1, 4 and 5), Mario's colour modes (normal, Fire, the Starman), and where the page's characters stand in its scene (map
;; coordinates: the scene is drawn at its own map y).
#PALETTE_MARIO_MODES = 3
#PALETTE_LOOKS       = 4
#PAL_PAGE_BIG_Y      = 176
#PAL_PAGE_KOOPA_Y    = 184
#PAL_PAGE_SMALL_Y    = 192
;; Floating score numbers (sparkydave.floaters.blitz.ab3).
;; From the cartridge: a number lives #FLOATER_TICKS ticks ($30), rises a pixel a
;; tick until its y reaches #FLOATER_TOP_Y ($18), and adds its points when it has
;; been alive five ticks, the tick its timer reads #FLOATER_SCORE_AT ($2b;
;; FloateyNumbersRoutine, smbdis 1283). There are #FLOATER_SLOTS (six, one per
;; enemy slot). The points index is the stomp chain: 1 to 10 are 100 to 8000 and
;; #FLOATER_ONEUP_INDEX (11) is a 1-UP; #FLOATER_POWER_UP_INDEX (6) is the 1000 of a
;; power-up. The digits are six 4x8 shapes from the items-4x8 sheet in
;; #DIGITS_BM; the "1UP" is cell #FLOATER_UP_CELL of the 16x16 items sheet.
;; #STOMP_BOUNCE_SPEED_Y is Mario's speed after stomping a Goomba ($fc, SBnce,
;; smbdis 11510).
#STOMP_BOUNCE_SPEED_Y   = -4
#FLOATER_DIGIT_W        = 4
#FLOATER_SLOTS          = 6
#FLOATER_POWER_UP_INDEX = 6
#FLOATER_DIGIT_H        = 8
#DIGITS_BM              = 9
#FLOATER_ONEUP_INDEX    = 11
#MULTI_COIN_INTERVALS   = 11 ; a brick with coins pays out for 11 intervals of #INTERVAL_PERIOD ticks
#PEN_CYCLE              = 12
#PEN_MARIO_SKIN         = 13
#PEN_MARIO_BROWN        = 14
#PEN_MARIO_RED          = 15

;; Mario as a hardware sprite (#MARIO_SPRITE, the look files). His sprite is 3 colours on channel 0, in sprite bank 2 (BPLCON4 xor
;; #SPRITE_BANK_XOR), so his colours are entries 33 to 35, the low two bits of his pens 13, 14 and 15 (skin, brown, red). The HUD list
;; and list 2 then load #SPRITE_PALETTE_COLOURS colours. #SPRITE_FLAG is the lores sprite flag of the lists' type words. The scratch
;; shape and bitmap are used only while the sprites are cut; #SPRITE_HIDDEN_Y is below any list.
#SPRITE_CHANNELS        = 8
#SPRITE_TMP_BM          = 13
#COIN_W                 = 16
#COIN_H                 = 16
#FLOATER_UP_CELL        = 21
#FLOATER_TOP_Y          = 24
#DIGITS_SHEET_W         = 24
#COIN_POP_FRAMES        = 32 ; half speed: 32 frames total (16 up, 16 down)
#PEN_SPRITE_SKIN        = 33
#PEN_SPRITE_BROWN       = 34
#PEN_SPRITE_RED         = 35
#COIN_SPRITE_BASE       = 42
#FLOATER_SCORE_AT       = 43
#COIN_POP_HEIGHT        = 44 ; 2 blocks + poke into block above (44 pixels peak height)
#COIN_SPRITE_TURN_BASE  = 45
#SPRITE_PALETTE_COLOURS = 48
#FLOATER_TICKS          = 48
#PALETTE_SAFE_LINE      = 50
#SPRITE_BANK_XOR        = $33
#FLOATER_DIGIT_SHAPE    = 138
#FLOATER_ONEUP_SHAPE    = 144
#FLOATER_NUMBER_SHAPE   = 192 ; whole numbers, one shape each: slots 193 to 202 for indices 1 to 10
#SPRITE_HIDDEN_Y        = 300

;; The value XORed into the world lists' BPLCON2 (DisplayControls; the default is $224) to put Mario between the playfields: behind
;; the front one (the pipe's tiles, the cloud floor) and in front of the back one. PF1P 0 and PF2P 2 put the back playfield behind
;; sprite pairs 0-1 and 2-3, so the second pair of the big swim poses (#SPRITE_SWIM) is in front of it too. With PF2P 1 the back
;; playfield would cover pair 2-3 and only his back half would show over the hills.
#MARIO_BEHIND_XOR = $34
; The first of the two clip sprite slots, 66 and 67 (CutMarioClipSprite{}: one on show while the other is cut).
#SPRITE_CLIP = 66
; Where the lives cover puts the small Mario (the cartridge's place for him, in the cover bitmap's pixels).
#COVER_MARIO_X = 96
; The back strip's top rows left empty for the HUD's copy (StampBackPlayfield{}).
#BACK_HUD_ROWS        = 2
#COVER_MARIO_Y        = 104
#SPRITE_SCRATCH_SHAPE = 322
#SPRITE_FLAG          = $400

;; All-Stars Mario's own sheets (#MARIO_SPRITE_COLOURS 15, the look files): 4 plane bitmaps of their own, loaded from mario-small-all-stars.iff
;; and mario-big-all-stars.iff and cut into attached sprites by CutMarioSprites{}. The bob sheets (#MARIO_BM, #MARIO_BIG_BM) stay the NES art's:
;; the covers, the palette page and the jukebox still blit him, in the playfield's pens.
#SPRITE_SMALL_BM      = 14
#SPRITE_BIG_BM        = 15
#SPRITE_SMALL_SHEET_W = 240
#SPRITE_BIG_SHEET_W   = 256

;; Big Mario's three swim poses, 32 wide, from mario-big-swim-all-stars.iff (tools/make_sprite_mario.py). The All-Stars art for them
;; is 18 to 20 pixels wide, so a 16 wide sprite would cut off his nose, front hand and feet. Each pose is two attached pairs side by
;; side: the left half on channel 0 at his x less #SWIM_WINDOW_X, the right half on channel #SWIM_CHANNEL, #SWIM_HALF_W further right.
;; The frame's columns 8 to 23 match the big sheet's 16 wide frame, so his body does not shift between poses. Pose p's four sprites
;; start at #SPRITE_SWIM + p*4: the right-facing left and right halves, then the left-facing ones (the halves flipped and swapped).
#SWIM_CHANNEL        = 2
#SWIM_POSES          = 3
#SWIM_WINDOW_X       = 8
#SPRITE_SWIM_BM      = 16
#SWIM_HALF_W         = 16
#SPRITE_SWIM         = 68
#SPRITE_SWIM_SHEET_W = 96

;; ---------------------------------------------------------------
;; Object Pool
;; ---------------------------------------------------------------
#OBJ_NONE     = 0
#OBJ_MUSHROOM = 1
#OBJ_COIN     = 2
#MAX_OBJECTS  = 12

#PLAY_BM_A = 0
#BOB_BUF_A = 0
#PLAY_BM_B = 1
#BOB_BUF_B = 1

;; #BOB_BYTES is the BBlit/UnBuffer buffer, not the playfield: it holds the background behind each shape between UnBuffers, so it
;; scales with shape size and count. BitMapLib.guide suggests 16384 for most situations; 4096 is too small for two 16x16 shapes in
;; one frame.
#BOB_BYTES = 16384

;; Dirty-cell list for RedrawMetatileCells{}. One cell is queued per block spent,
;; so this is generous; over-full drops the cell rather than wrapping.
#MAX_REDRAW_CELLS = 32

;; Frame indices into the 224x16, 14 frame Mario sheet, which DrawPlayer{} reads at x = frame * #TILE. The order is the sheet's own:
;; 0-2 walk, 3 turn, 4 jump, 5 death, 6 idle, 7-8 climb, 9-13 swim. The names come from game-data/derived/mario-small-contact.json.
;; Do not reorder them: DrawPlayer{} indexes the sheet by these numbers, and the test ScenarioFlagpole{} checks that the flagpole
;; frames are 7 and 8.
;;
;; The sheet has no crouch frame: small Mario cannot crouch in SMB1. Inventory in ../assets/the main project's SPEC note.
#MARIO_FACE_LEFT  = -1
#MARIO_F_WALK1    = 0
#MARIO_SHAPE      = 1
#MARIO_FACE_RIGHT = 1
#MARIO_F_WALK2    = 1
#MARIO_F_WALK3    = 2
#MARIO_F_TURN     = 3
#MARIO_F_JUMP     = 4
#MARIO_BM         = 4
#MARIO_F_DEATH    = 5
#MARIO_F_IDLE     = 6
#MARIO_SCREEN_X   = 80
#MARIO_SHEET_W    = 224

;; Flagpole. The pole's box is generated from the Tiled "Flagpole" object into sparkydave.level.meta.ab3 as #FLAGPOLE_X/_Y/_W/_H,
;; and nothing here repeats those numbers. What is here is the rule the cartridge applies to that box.
;;
;; #PLAYER_ST_RESIZE is the grow/shrink lockout. The pole slide has a state of its own for the same reason: both run outside the
;; normal movement code.
#PLAYER_ST_FREE    = 0
#PLAYER_ST_POLE    = 1
#PLAYER_ST_RESIZE  = 2
#PLAYER_ST_DYING   = 3
#PLAYER_ST_ENDWALK = 4

;; Damage, death, lives (sparkydave.life.blitz.ab3). From the cartridge unless
;; marked. Ticks are sim ticks, one per console frame.
;;   - #CONTACT_EVERY_OTHER_TICK: PlayerEnemyCollision only runs on frames where
;;     FrameCounter bit 0 is clear (smbdis 11293), so enemy contact is checked at
;;     half rate. 1 is authentic; 0 checks every tick.
;;   - #INJURY_INTERVALS: InjuryTimer is set to 8 (11410) and is an interval
;;     timer, so it counts down once per #INTERVAL_PERIOD ticks: 147 to 168 ticks
;;     of invulnerability, the sprite drawn on alternate ticks only.
;;   - A killed Mario is held #DEATH_FREEZE_TICKS ticks (PlayerDeath waits for
;;     TimerControl to fall from $ff to $f0, 5766), then jumps at
;;     #DEATH_SPEED_Y px a tick (KillPlayer sets $fc, 11427) and falls under
;;     #DEATH_FALL_FORCE (the cartridge's falling force for the slow speed bands is $70; on the cartridge the force actually in play
;;     is whatever his last jump left, which has not been checked), with no tile collision at all (PlayerBGCollision returns for
;;     routine $0b, 11893).
;;   - He is gone once he has fallen to #DEATH_FALL_Y (Player_Y_HighPos 4) or, for a pit, #PIT_FALL_Y (HighPos 6, 5617-5640). A pit
;;     death starts when his top passes #PIT_DEATH_Y (HighPos 2) and has no hop and no freeze.
;;   - #LIVES_START is 2, shown as 3 on the cartridge (2722): the third death is game over. #HALFWAY_X is page 5 of 1-1
;;     (HalfwayPageNybbles, 2906). Game over's time is the cover's (CoverTicksFor{}, 18 intervals).
#DEATH_SPEED_Y            = -4
#DEATH_HOP                = 0
#LIFE_NONE                = 0
#CONTACT_EVERY_OTHER_TICK = 1
#DEATH_PIT                = 1
#LIFE_RESPAWN             = 1
#LIVES_START              = 2
#LIFE_GAMEOVER            = 2
#LIFE_NEWGAME             = 3
#LIFE_COMPLETE            = 4
#LIFE_REPLAY              = 5
#INJURY_INTERVALS         = 8
#DEATH_FREEZE_TICKS       = 16
#DEATH_FALL_FORCE         = 112
#PIT_DEATH_Y              = 256
#DEATH_FALL_Y             = 768
#PIT_FALL_Y               = 1280
#HALFWAY_X                = 1280

; Frames 7 and 8 are the two halves of the climbing pose, used on the flagpole.
#MARIO_F_CLIMB1 = 7
#MARIO_F_CLIMB2 = 8
#MARIO_F_SWIM1  = 9
#MARIO_F_SWIM2  = 10
#MARIO_F_SWIM3  = 11
#MARIO_F_SWIM4  = 12
#MARIO_F_SWIM5  = 13

;; Big Mario only: a sixth swim frame, which the cartridge gives big and not
;; small. See the Big Mario block above for why the sheets otherwise agree.
#MARIO_F_SWIM6 = 14

;; The size changes and what the world does meanwhile (the main project's LIFE_CYCLE note, "The freeze").
;; The cartridge sets its master timer TimerControl to $ff when a power-up or an injury starts
;; one, and it counts down a tick at a time; while it is not zero the enemies and every timer
;; (the game clock, the invulnerability, a shell's revive) stand still. The two routines look at
;; it at set moments (smbdis 5732 PlayerChangeSize, 5744 PlayerInjuryBlink, 5764 PlayerFireFlower).
;; The numbers are the ticks from $ff to each moment:
;;   grow   (a mushroom to a small Mario)  held for 59 ticks ($c4); the size flips and the picture
;;          starts alternating 7 ticks in ($f8)
;;   injury (a hit big Mario)  held 15 ticks ($f0), when the size flips and the shrink picture
;;          starts; he is then free for the rest of the freeze, 55 ticks in all ($c8), while the
;;          enemies and timers stand still
;;   fire   (a flower to a big Mario)  held for 63 ticks ($c0), see #FIRE_FLASH_TICKS
;; The alternating picture is #SIZE_ANIM_STEPS steps of #SIZE_ANIM_STEP_TICKS ticks (40 in all).
#SIZE_ANIM_STEP_TICKS = 4
#GROW_ANIM_START      = 7
#SIZE_ANIM_STEPS      = 10
#INJURY_HOLD_TICKS    = 15
#SIZE_ANIM_TICKS      = 40
#INJURY_FREEZE_TICKS  = 55
#GROW_FREEZE_TICKS    = 59

;; The flag's own three states, separate from the player's. The flag descends because the pole was touched, and keeps going after
;; Mario has let go; only Mario's grab height varies, and on the cartridge that decides the score, not how far the flag falls.
#FLAG_ST_IDLE = 0
#FLAG_ST_DOWN = 1
#FLAG_ST_DONE = 2

;; The ROM's grab window is the low nybble of X in $06..$09 -- an 8-px effective
;; width, with the cartridge's own comment that this makes the physical part of
;; the pole thinner than 16 pixels (12153-12159, in the main project's PLAYER_HITBOX note
;; section 4.5). The shaft tile, GID 104, draws at pixel columns 7-8 of its
;; tile, so the window brackets the line.
#FLAGPOLE_GRAB_LO = $06
#FLAGPOLE_SHAFT_X = 7
#FLAGPOLE_GRAB_HI = $09

;; The flag. #OBJ_FLAG is its tile on the Game Objects sheet, #FLAG_SHAPE the
;; shape slot it is blitted from (Mario has slot 1), and #OBJ_BM the sheet's
;; bitmap -- slot 2, since 0 and 1 are the playfield and its cookie buffer, 3 is
;; the atlas and 4 is Mario. #FLAG_TOP_DY clears the ball tile, which takes the
;; top of the pole box, so the flag hangs just below it.
;;
;; The flag is a Game Object rather than a playfield tile: it is drawn
;; separately, it moves independently of the level, and its colours are reserved
;; on the shared screen palette at pens 13 and 14 (manifest.SWATCHES) because
;; that palette comes from the atlas, not from this sheet. #OBJ_SHEET_W/_H
;; allocate the sheet's bitmap and are checked against the PNG by
;; tools/build_assets.py, so growing the sheet without bumping them fails the
;; build rather than cropping. Append new objects to the sheet; do not insert.
#OBJ_FLAG    = 0
#OBJ_BM      = 2
#FLAG_SHAPE  = 2
#FLAG_TOP_DY = 8
#OBJ_SHEET_W = 16
#OBJ_SHEET_H = 16
#FLAG_W      = 16
#FLAG_H      = 16

;; Enemy sprites. #ENEMIES_BM is bitmap slot 7 (0 and 1 the playfield, 2 game objects, 3 the atlas, 4 small Mario, 5 big Mario,
;; 6 items, 7 enemies). #ENEMIES_SHAPE is shape slot 7 (0 tile, 1 small Mario, 2 flag, 3 big Mario, 4 items, 5 bump, 6 occlude,
;; 7 enemies). The enemies sheet is 720x32 (45 cells of 16x32), matched to the atlas's palette.
#ENEMIES_BM      = 7
#ENEMIES_SHAPE   = 7
#ENEMIES_SHEET_H = 32
#ENEMIES_SHEET_W = 720

;; Goomba constants. Frames 0,1 = walking (16x16 at bottom of 16x32 cell);
;; frame 2 = squashed. Animation at fixed interval.
#GOOMBA_F_WALK1    = 0
#GOOMBA_F_WALK2    = 1
#GOOMBA_F_SQUASH   = 2
#GOOMBA_ANIM_SPEED = 8
#GOOMBA_W          = 16
#GOOMBA_H          = 16

;; Goomba fall: gravity, capped. It walks at #ENEMY_WALK_SPEED and reverses at
;; solid walls.
;; The cartridge's numbers (MoveD_EnemyVertically, smbdis 7599: $3d a tick, capped at 3 px a tick).
;; A Koopa and a shell fall the same way.
#GOOMBA_GRAVITY  = 61
#GOOMBA_FALL_MAX = 768

;; A group of Goombas or Koopas (HandleGroupEnemies, smbdis 8756): its members are placed from the screen's right edge as the entry
;; is met, each #ENEMY_GROUP_SPACING px after the last (`adc #$18`), so the first stands #ENEMY_GROUP_LEAD px left of the entry's
;; own x (the importer's group_lead, CheckRightBounds' `adc #$30`). Single enemies stand on the 16 px grid, so two spawns of a kind
;; on the same row this far apart are a group: GoombaEntryX{} and KoopaEntryX{} give back the entry the cartridge decides on.
#ENEMY_GROUP_SPACING = 24
#ENEMY_GROUP_LEAD    = 48


; Object pool type for Goomba
#OBJ_GOOMBA = 3

;; Walkers: a Goomba or a Koopa walks at the cartridge's $f8, half a pixel a tick (InitNormalEnemy, smbdis 8166; MoveObjectHorizontally,
;; 7541, takes the speed in sixteenths of a pixel), kept here in sixteenths with the remainder carried between ticks. A kicked shell
;; moves at $30, three pixels a tick.

;; An enemy knocked off by a shell: up at 3 pixels a tick ($fd), sideways at 1.5
;; ($18) away from Mario, then down under the cartridge's enemy gravity ($3d a tick
;; in 1/256 pixels), upside down, until it is out of the level. The sideways speed
;; is in sixteenths of a pixel, the vertical numbers in 256ths.
#KNOCK_SPEED_Y  = -768
#KNOCK_SPEED_X  = 24
#KNOCK_GRAVITY  = 61
#KNOCK_FALL_MAX = 1024

;; An object on a bumped or broken block (smbdis 12470 to 12490, SetStun): lifted 2 px,
;; vertical speed $fd (three pixels a tick up) and sideways $10 (a pixel a tick) away from
;; Mario. Units: 1/256 px a tick up (negative), 1/16 px a tick.
#BUMP_JUMP_SPEED_Y  = -768
#BUMP_THROW_SPEED_X = 16

;; The Koopa is a 16x24 sprite whose object y is its top. Its box is the cartridge's
;; control $03 (BoundBoxCtrlData, smbdis 11271): 2 to 14 across, 9 to 21 down, the
;; head not counting. Stomped it becomes a shell, a 16x16 picture at the bottom of
;; the same 24, which the revive timer (RevivalRateData, 11497: $10 intervals)
;; turns back into a Koopa. Kicking it starts it sliding; the shell kills what it
;; touches. #KOOPA_ST_KNOCKED is shared with the Goomba's state 3.
#KOOPA_ST_WALK      = 0
#KOOPA_ST_SHELL     = 1
#GOOMBA_ST_SQUASHED = 1
#KOOPA_BOX_LEFT     = 2
#KOOPA_ST_KICKED    = 2
#KOOPA_ST_KNOCKED   = 3
#GOOMBA_ST_KNOCKED  = 3
#OBJ_KOOPA          = 4
#KOOPA_SHELL_DROP   = 8
#KOOPA_BOX_TOP      = 9
#KOOPA_BOX_RIGHT    = 13
#KOOPA_W            = 16
#KOOPA_WALL_PROBE_Y = 16
#KOOPA_BOX_BOTTOM   = 21
#KOOPA_H            = 24

;; The Starman (smbdis 7160-7195 PowerUpObjHandler, 9376 MoveJumpingEnemy, EnemyJump,
;; 11237 HandlePowerUpCollision, 5340 the palette cycle). Released from a brick
;; that holds one; rises like the mushroom, then goes along at 1 px a tick and hops
;; for good: gravity $1c a tick (1/256 px), capped at 3 px a tick, a bounce of 3 up
;; ($fd) every time it lands, and it turns at a wall. Four colour frames, items
;; cells 32 to 35, one every #STAR_FRAME_TICKS. Picked up it gives 1000 and
;; #STAR_INTERVALS (35, $23) intervals of invincibility: Mario's colours step
;; through the four star sets, every 2 ticks while 8 or more intervals remain and
;; every 8 after, and whatever he touches is knocked off (100 for a Goomba, 200 for
;; the rest, as a shell kills). Must match STAR_SPRITE in tools/manifest.py.
#STAR_BOUNCE_VY      = -768
#STAR_FAST_TICKS     = 2
#STAR_FRAME_TICKS    = 2
#STAR_FRAMES         = 4
#OBJ_STAR            = 6
#STAR_FAST_INTERVALS = 8
#STAR_SLOW_TICKS     = 8
#STAR_SPEED          = 16
#STAR_GRAVITY        = 28
#STAR_SPRITE_BASE    = 32
#STAR_INTERVALS      = 35
#PRE_STAR            = 164
#STAR_FALL_MAX       = 768

;; Fireballs (smbdis 6273-6380, 12726, 14229; see sparkydave.fireballs.blitz.ab3).
;; Their speeds are in sparkydave.physics.ab3. A bounce is 3 up ($fd). The ball is 8x8 (box control $07), cut from
;; the four quadrants of items cell 28 (`fire_tile`), and its burst from cells 17,
;; 16 and 15 (`fireworks_1` to `_3`, small to large: the cartridge draws the burst
;; and the end-of-level fireworks from the same tiles). #MARIO_F_THROW is
;; `throwing_1`, frame 16 of the big Mario sheet.
#FIREBALL_BOUNCE_VY     = -768
#FIREBALL_SPAWN_DY      = -16
#FIREBALL_FLYING        = 1
#FIREBALL_SLOTS         = 2
#FIREBALL_EXPLODING     = 2
#FIREBALL_SPAWN_DX      = 4
#FIREBALL_SPIN_TICKS    = 4
#FIREBALL_EXPLODE_TICKS = 6
#FIREBALL_SIZE          = 8
#MARIO_F_THROW          = 16
#BLAST_SHEET_CELL       = 17
#FIREBALL_TOP_LIMIT     = 24
#FIREBALL_SHEET_CELL    = 28
#PRE_FIREBALL           = 156
#PRE_BLAST              = 160

;; The Fire Flower (smbdis 7140, 11237, 13475-13537). A `?` block that releases a
;; mushroom releases a flower instead when Mario is big. The flower rises like the
;; mushroom and then stays where it is; its four colour sets, items cells 22 to 25,
;; are drawn in turn, one every #FLOWER_FRAME_TICKS (the cartridge steps its
;; palette bits with the frame counter shifted right once). Picked up it gives
;; 1000 and turns a big Mario into Fire Mario, after a freeze of #FIRE_FLASH_TICKS
;; (TimerControl $ff to $c0) in which his colours step through the star sets every
;; #FLASH_SET_TICKS (PlayerFireFlower, 5764).
#FLOWER_FRAME_TICKS = 2
#FLOWER_FRAMES      = 4
#FLASH_SET_TICKS    = 4
#OBJ_FLOWER         = 5
#FLOWER_SPRITE_BASE = 22
#FIRE_FLASH_TICKS   = 63
#PRE_FLOWER         = 152

;; Shape slots, filled by CutEnemyShapes{}: the Koopa's two walk frames facing
;; left then right, the shell, the shell upside down, the Goomba upside down.
#KOOPA_SHEET_CELL = 3
#SHELL_SHEET_CELL = 7
#PRE_KOOPA        = 145
#PRE_SHELL        = 149
#PRE_SHELL_FLIP   = 150
#PRE_GOOMBA_FLIP  = 151

;; The Piranha Plant (the main project's OBJECT_SYSTEM note, "The Piranha Plant"; smbdis InitPiranhaPlant 8814, MovePiranhaPlant
;; 10577). #PLANT_RISE is how far it comes out of its pipe, #PLANT_NEAR the horizontal distance inside which it stays
;; down (`cmp #$21`, so under 33), #PLANT_FRAME_TICKS the mouth's step. The box is the cartridge's control $09 (#SMALL_BOX_*). Its two frames are enemies sheet cells
;; 9 and 10, the bottom 24 of the 32 px cell, in shapes from #PRE_PIRANHA. #PLANT_WAIT_TICKS (the pause at each end,
;; 64 frames) is a variant constant. The pipe tiles drawn over a plant are cut once each, into #PLANT_CELL_CACHE shape
;; slots from #PLANT_CELL_SHAPE (213 to 220), keyed by the tile (a pipe is four tiles, whatever the pipe).
#OBJ_PIRANHA        = 7
#PLANT_FRAME_TICKS  = 8
