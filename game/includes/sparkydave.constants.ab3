#PIRANHA_SHEET_CELL = 9
#PLANT_W            = 16
#PLANT_H            = 24
#PLANT_RISE         = 24
#PLANT_NEAR         = 33
#PRE_PIRANHA        = 184

;; The cartridge's bounding box control $09 (SmallBBox: the Piranha Plant, the Bloober and the swimming Cheep-Cheep), 3 to 12 across
;; (its 13, less one as the Koopa's) and 14 to 20 down of the 24 px sprite: SmallBoxHitBox{}.
#SMALL_BOX_LEFT   = 3
#SMALL_BOX_RIGHT  = 12
#SMALL_BOX_TOP    = 14
#SMALL_BOX_BOTTOM = 20
;; The large lift (the main project's OBJECT_SYSTEM note, "The large lift"; smbdis 8944, 10974, 11709, 11846): a platform 48 px wide and 8
;; thick whose box is the cartridge's control $06 (48 across, 13 down from its top). It is one shape, #PRE_LIFT, cut from the
;; three copies of the platform segment appended to the items sheet at #LIFT_SHEET_X (the sheet's width before them).
;; #LIFT_SPEED (a variant constant) is how far it goes a tick in 256ths of a pixel, up or down, wrapping at 256 as the
;; cartridge's one-byte y does.
#OBJ_LIFT        = 8
#LIFT_H          = 8
#LIFT_BOX_BOTTOM = 13
#LIFT_W          = 48
#PRE_LIFT        = 222
#LIFT_WRAP       = 256
#LIFT_SHEET_X    = 832
;; The warp zone (the main project's AREAS note, "The warp zone"): its text at #WARP_TEXT_Y, left edge on the left warp pipe (the
;; cartridge's text starts in the pipe's column), and each pipe's number #WARP_NUMBER_DY above its top, 8 across.
#WARP_PIPES_MAX   = 3
#WARP_NUMBER_DY   = 24
#WARP_TEXT_Y      = 96
#PLANT_CELL_SHAPE = 213
;; The HUD goes away while Mario is above the top of the world (the main project's AMIGA_RENDERER note, "The HUD goes away"): a third Copper
;; list (list 2), one world list #AWAY_H lines tall from the HUD's first line, showing the world from bitmap row #AWAY_TOP, so every row
;; stays on the screen line it had. #AWAY_LEAD is how far below #VIEW_TOP his top may be before the switch is asked for (the display
;; changes a frame or two later, so with 0 a few rows of his head are hidden for a frame or two). #BAND_LINE_AWAY (below, beside
;; #BAND_LINE) is the hills' band's line in list 2. #PRE_PLAYER_CLIP is the first of the shape slots for Mario cut short at the top of
;; the bitmap (DrawPlayer{}).
#AWAY_LEAD       = 0
#PRE_PLAYER_CLIP = 223
;; The HUD over the world while list 2 is shown (the main project's AMIGA_RENDERER note, "The HUD goes away"): 1 shows the HUD in the first lines
;; of list 2's back playfield, with Mario in front of it as on the NES and the clock still on screen; 0 hides the HUD while he is up
;; there. The HUD is a copy of the band's bitmap in the back bitmap's rows 0 to 15 (empty in every strip). The whole copy is made as the
;; list comes up or when it is stale (UpdateHudMirror{}), about 31 raster lines for #HUD_STAMP_W pixels, and after that each changed
;; glyph is drawn into it as well (a line or two). The list's header gives the back playfield x 0, y 0, and two Copper strings at lines
;; #HUD_END_LINE - 2 and - 1 move it on to the clouds, as the hills' band does; the back's colour offset is 0 for those lines, so the HUD
;; has its real colours even where the back playfield is hidden (1-2). Nothing is copied on a frame where the HUD has not changed.
#HUD_OVER_WORLD = 1
#HUD_END_LINE   = 18
#AWAY_TOP       = #VIEW_TOP - #HUD_H - #LIST_GAP
#AWAY_H         = #HUD_H + #LIST_GAP + #VIEW_H
;; Mario cut short at the top of the bitmap is cached (DrawPlayer{}). A cut is a GetaShape, which frees and allocates memory, makes a
;; cookie and waits for the blitter, 42 to 125 raster lines each, so each cut is kept. Only the rows list 2 shows are cut, so the rows
;; that can show above row 0 are the cell's height less #AWAY_TOP and one (big Mario 18, small Mario 2): one shape for each, facing each
;; way (PlayerClipIndex{}), from #PRE_PLAYER_CLIP, cut again only when the slot holds a different frame (nothing clears them: his sheets
;; are cut once, at start). #PLAYER_SMALL_H is #TILE, which the level meta defines after this file. `Max Shape` in the header of
;; SparkyDave.ab3 must reach #PRE_PLAYER_CLIP + #PLAYER_CLIP_SLOTS.
#PLAYER_SMALL_H         = 16
#PLAYER_CLIP_BIG_ROWS   = #MARIO_BIG_H - #AWAY_TOP - 1
#PLAYER_CLIP_SMALL_ROWS = #PLAYER_SMALL_H - #AWAY_TOP - 1
#PLAYER_CLIP_SLOTS      = 2*(#PLAYER_CLIP_BIG_ROWS + #PLAYER_CLIP_SMALL_ROWS)
;; The HUD's text ends at the clock (3 digits at #HUD_CLOCK_X); #HUD_STAMP_W is how much of the band is copied: the text and a blank
;; margin of #SAFE_MARGIN each side (more than a camera moves in a frame), so a moving camera overwrites the last copy's edges. A glyph
;; past it is not shown while the HUD is away (DrawGlyphInto{} leaves it out of both the whole copy and the per-glyph update).
#HUD_CLOCK_X = #SAFE_MARGIN + 192
#HUD_STAMP_W = #HUD_CLOCK_X + 3*8 + 2*#SAFE_MARGIN
;; The Red Koopa (sheet cells 30 and 31 for the walk, 32 for the shell, built from the Koopa's: manifest "copies"): shapes
;; 187 to 190 the walk facing left then right, 191 the shell, 221 the shell upside down.
#RED_KOOPA_SHEET_CELL = 30
#RED_SHELL_SHEET_CELL = 32
#PRE_RED_KOOPA        = 187
#PRE_RED_SHELL        = 191
#PRE_RED_SHELL_FLIP   = 221

;; The Green Paratroopa that hops (GreenParatroopaJump: InitJumpGPTroopa, smbdis 8868; MoveJumpingEnemy, 9371; EnemyJump, 12661): a
;; winged Koopa that walks left at the Koopa's pace and bounces on whatever it lands on, as the Starman does (gravity $1c a tick, capped
;; at three pixels a tick, up at three pixels a tick, $fd, each time it lands, and only landing when it is falling by a pixel a tick
;; or more). Its sheet cells are 5 and 6 (the winged art); shapes #PRE_PARATROOPA to +3, the walk facing left then right, after the
;; clip cache's slots (`Max Shape` in SparkyDave.ab3 must reach #PRE_PARATROOPA + 4). Stomped it loses its wings and is a walking
;; Koopa again (ChkForDemoteKoopa, 11481), 400 and no stomp chain. A spawn's kind (koopaSpawnKind) is one of #KOOPA_KIND_*.
#PARATROOPA_BOUNCE_VY      = -768
#KOOPA_KIND_GREEN          = 0
#KOOPA_KIND_RED            = 1
#KOOPA_KIND_WINGED         = 2
#PARATROOPA_DEMOTE_FLOATER = 3
#PARATROOPA_SHEET_CELL     = 5
#PARATROOPA_GRAVITY        = 28
#PARATROOPA_LAND_SPEED     = 256
#PARATROOPA_FALL_MAX       = 768
#PRE_PARATROOPA            = #PRE_PLAYER_CLIP + #PLAYER_CLIP_SLOTS

;; The Red Paratroopa that flies up and down (RedParatroopa: InitRedPTroopa, smbdis 8214; ProcMoveRedPTroopa, 9377): a winged Koopa
;; (objWinged #WINGS_FLY, the green hopper's being #WINGS_HOP) that swings about a centre by StepSwing{} (objStartY
;; its top, its start; objRiseTarget its centre, 48 px below, or 32 above from y 128) and never moves sideways or meets the ground (the
;; cartridge leaves ids from $07 out of EnemyToBGCollisionDet). It faces left. Stomped it is demoted as the green one is (400, no chain,
;; facing Mario) to the cartridge's id $01: a red Koopa that walks off ledges (objRed #RED_WALKS_OFF; a Red Koopa's #RED_TURNS turns at
;; them, ChkForRedKoopa looks for $03 only). Its art is the green one's cells in the red palette (sheet cells #RED_PARATROOPA_SHEET_CELL
;; and on, manifest "copies"), shapes #PRE_RED_PARATROOPA to +3 (after the retainer's), the flap facing left then right.
#WINGS_HOP                 = 1
#RED_TURNS                 = 1
#WINGS_FLY                 = 2
#RED_WALKS_OFF             = 2
#KOOPA_KIND_RED_FLYING     = 3
#RED_PARATROOPA_SHEET_CELL = 42

;; The jumpspring (JumpspringHandler, smbdis 6628; ChkForLandJumpSpring, 12248; the metatiles $67 and $68, a column of two tile rows). An
;; object 16 across and 32 tall (#OBJ_SPRING), solid like a lift: Mario falling onto its top (his feet within #MT_FEET_MIN_SUBTILE of
;; it) starts the squash, in which he is held still (no jump, no walk, no gravity: jumpspringAnimCtrl is the cartridge's
;; JumpspringAnimCtrl) while the spring steps through its five frames, #SPRING_STEP_TICKS ticks each (the first
;; #SPRING_LAND_TIMER + 1): he is moved #SPRING_MOVE pixels a tick, down in the first two steps and up in the last two, and at the
;; last frame he leaves at #SPRING_FORCE, or #SPRING_FORCE_A (variant constants) if A went down afresh from the second step on, with
;; #SPRING_RISE_FORCE for gravity on the first tick and his last jump's fall force from then on (springLaunch). The
;; art is the items sheet's cells 0 to 4 ("jumping board": the top up and middle, the bottom up, middle and down; the down frame has
;; no top), the pictures already carrying the lowering, shapes #PRE_SPRING to +4 after the Paratroopa's. `Max Shape` must reach
;; #PRE_SPRING + 5.
#SPRING_MOVE       = 2
#SPRING_LAND_TIMER = 3
#SPRING_STEP_TICKS = 4
#SPRING_FRAMES     = 5
#OBJ_SPRING        = 9
#PRE_SPRING        = #PRE_PARATROOPA + 4

;; THE VINE and the climb (smbdis 6677 Setup_Vine, 6705 VineObjectHandler, 13103 DrawVine; 12153 HandleClimbing, 12185 PutPlayerOnVine,
;; 5966 ClimbingSub, 6043 PlayerPhysicsSub, 5666 Vine_AutoClimb). A vine grows from the top of the block that
;; made it: one pixel on the ticks whose counter has bit 1 set (two of every four), to #VINE_HEIGHT_FIRST (the first piece, $30) or to
;; #VINE_HEIGHT_FULL ($60, the two pieces 2-1's vine has). From #VINE_CLIMB_MIN ($20) high it is climbable: the cells from the one a tile
;; under its top (its top + 16, floored to a cell) down to the block, but not above #CLIMB_TOP_Y ($20, the status bar). Mario touching it
;; with a side probe, within #CLIMB_GRAB_MIN to #CLIMB_GRAB_MAX of the 16 across, is put on its side (#CLIMB_X_RIGHT or #CLIMB_X_LEFT from
;; its column, by which way he faces) and climbs (playerClimbing): up and down move him 1 px a tick with a movement force of
;; #CLIMB_UP_FORCE or #CLIMB_DOWN_FORCE carried in 256ths (about 7/8 px a tick up and 2 down), left and right swap sides by
;; the four steps of climbAdder() at most every #CLIMB_SIDE_TICKS ticks. Above #CLIMB_TOP_Y he is taken over (the controller is
;; Up) and climbs on until his y is #CLIMB_AREA_Y, when the area is to change (climbAreaChange). The picture is the items sheet's cells
;; (sheet cells 36 and 37, the curled top at x #VINE_SHEET_TOP_X and the body at #VINE_SHEET_BODY_X, row #VINE_SHEET_Y), shapes #PRE_VINE and +1. `Max Shape` must reach #PRE_VINE + 13 (see the cloud platform and the title panel below).
;; (The cloud platform is +2, the title panel's tiles +3 to +11 and its whole shape +12.)
#CLIMB_AREA_Y      = -29
#CLIMB_X_RIGHT     = -7
#VINE_SHEET_Y      = 0
#CLIMB_ANIM_DOWN   = 4
#CLIMB_GRAB_MIN    = 6
#CLIMB_X_LEFT      = 7
#CLIMB_ANIM_UP     = 8
#CLIMB_GRAB_MAX    = 9
#CLIMB_EDGE_X      = 16
#CLIMB_SIDE_TICKS  = 24
#VINE_CLIMB_MIN    = 32
#CLIMB_TOP_Y       = 32
#CLIMB_UP_FORCE    = $20
#VINE_SPRITE       = 36
#VINE_HEIGHT_FIRST = 48
#VINE_HEIGHT_FULL  = 96
#CLIMB_DOWN_FORCE  = $ff
#VINE_SHEET_TOP_X  = 576
#VINE_SHEET_BODY_X = 592
#PRE_VINE          = #PRE_SPRING + #SPRING_FRAMES
; A lift in a cloud area (the sky bonus, 5-2) is the cloud platform, six of the 8x8 items' ball: #PRE_CLOUD_LIFT, from #CLOUD_LIFT_SHEET_X.
#CLOUD_LIFT_SHEET_X = 880
;; The title's panel (DrawTitlePanel{}): nine 8x8 tiles, title-panel.iff (72 across: top-left, top-right, bottom-left, bottom-right, left, right, top,
;; bottom, centre = #PT_*), cut into the shapes #PRE_PANEL to #PRE_PANEL + 8 from a bitmap in the logo's slot before the logo is loaded there
;; (LoadPanel{}, CutPanelShapes{}). The panel is the text's size plus #PANEL_PAD_X a side and #PANEL_PAD_Y above and below, in whole tiles.
;; #OVERLAY_ROWS_MAX: the rows an overlay page records a key for (pageRowKey$(), #OVERLAY_ROWS_MAX for each page). It must be at least
;; the longest page's row count, the NES look's options page with 10 (#OPTIONS_ROWS): a smaller number lets a page write past the end
;; of the array and corrupt memory. python tools/check_source_split.py checks it (LOOKS).
#PT_TL            = 0
#PT_TR            = 1
#PT_BL            = 2
#PT_BR            = 3
#PT_L             = 4
#PANEL_PAD_Y      = 4
#PT_R             = 5
#PT_T             = 6
#PT_B             = 7
#PANEL_TILE       = 8
#PT_C             = 8
#PANEL_PAD_X      = 8
#PANEL_TILES      = 9
#OVERLAY_ROWS_MAX = 10
#PANEL_SHEET_W    = 72
#PANEL_MAX_H      = 112
#TITLE_MENU_W     = 120
#PRE_PANEL        = #PRE_VINE + 3
#PRE_PANEL_WHOLE  = #PRE_VINE + 12
#PRE_CLOUD_LIFT   = #PRE_VINE + 2

;; THE BLOOBER (the main project's OBJECT_SYSTEM note, "The Bloober"; smbdis 8206 InitBloober, 9468 MoveBloober,
;; 9520 ProcSwimmingB, 11330 the touch in water, 11172 ShellOrBlockDefeat, 13816 the frame). objY is the cartridge's Enemy_Y, the
;; top of its 24 px sprite. Its box is control $09, as the Piranha's (#SMALL_BOX_*). It may not rise above
;; #BLOOBER_TOP_Y (the status bar's edge, $20); its swim speeds up and slows by 1 every #BLOOBER_SWIM_TICKS ticks to
;; #BLOOBER_SWIM_TOP; then it floats down for #BLOOBER_FLOAT_INTERVALS intervals and while it is more than #BLOOBER_NEAR_Y above
;; Mario (the steps, the speeds, the float and the distance are variant constants). Beaten (a fireball, the Starman) it is lifted
;; 2 px and falls slowly from speed -1 (SetStun, MoveEnemySlowVert: #BLOOBER_FALL_FORCE to #BLOOBER_FALL_MAX), 200 points. Drawn
;; stretched #BLOOBER_DRAW_DROP px lower, squeezed when its interval timer is 1, and beaten squeezed upside down. The pictures are
;; enemies sheet cells 26 (squeezed: its top 24 rows) and 27 (stretched: its bottom 24), shapes #PRE_BLOOBER to +2, after the panel's
;; (`Max Shape` in SparkyDave.ab3 must reach #PRE_BLOOBER + 3). Erased #BLOOBER_ERASE_MARGIN px out of the view (OffscreenBoundsCheck).
#BLOOBER_SWIM_TOP        = 2
#BLOOBER_FLOAT_INTERVALS = 2
#BLOOBER_DRAW_DROP       = 3
#OBJ_BLOOBER             = 10
#BLOOBER_W               = 16
#BLOOBER_H               = 24
#BLOOBER_SQUEEZED_CELL   = 26
#BLOOBER_STRETCHED_CELL  = 27
#BLOOBER_TOP_Y           = 32
#BLOOBER_ERASE_MARGIN    = 72
#PRE_BLOOBER             = #PRE_PANEL_WHOLE + 1

;; THE SWIMMING CHEEP-CHEEP AND ITS FRENZY (the main project's OBJECT_SYSTEM note, "The Cheep-Cheep frenzy";
;; smbdis 3607 AreaFrenzy, 7871 ChkEnemyFrenzy, 8004 CheckFrenzyBuffer, 8243 InitCheepCheep, 8685 BulletBillCheepCheep, 9595
;; MoveSwimmingCheepCheep). While a swimming frenzy is on in a water area, once its timer is out and fewer than #FRENZY_SWIMMERS
;; swimmers (Bloobers and Cheep-Cheeps: the cartridge's first three enemy slots) are alive, a Cheep-Cheep comes in
;; #CHEEP_SPAWN_GAP px past the view's right edge, at the next of frenzyHeights() its filter allows, red when its random byte is
;; #CHEEP_RED_LIMIT or more (in world 2; grey otherwise there, the other way round in the other worlds). It swims left; one that came
;; when two swimmers were already alive (the cartridge's slot 2 and on) also bobs, turning #CHEEP_BOB_RANGE px from where it came in.
;; objY is its Enemy_Y, the top of the 24 px figure whose bottom 16 rows are the fish; its box is control $09, the Bloober's. Beaten
;; it falls as a beaten Bloober does, 200. Shapes #PRE_CHEEP to +5: grey's two frames, red's two, grey and red upside down (`Max
;; Shape` in SparkyDave.ab3 must reach #PRE_CHEEP + 6), from enemies sheet cells 28 and 29 (grey) and 33 and 34 (the red copy).
#FRENZY_KIND_STOP     = 0
#FRENZY_KIND_SWIMMING = 1
#FRENZY_KIND_FLYING   = 2
#FRENZY_SWIMMERS      = 3
#FRENZY_KIND_FLAME    = 4
#OBJ_CHEEP            = 11
#CHEEP_BOB_RANGE      = 15
#CHEEP_GREY_CELL      = 28
#CHEEP_SPAWN_GAP      = 31
#CHEEP_RED_CELL       = 33
#CHEEP_RED_LIMIT      = $aa
#PRE_CHEEP            = #PRE_BLOOBER + 3

;; THE AIR BUBBLES (smbdis 6311 ProcAirBubbles, 6384 BubbleCheck, 6394 SetupBubble, 14372 DrawBubble). In a
;; water area #BUBBLE_SLOTS bubbles, the last first: an empty one, once the shared timer is out, comes from Mario's mouth (#BUBBLE_MOUTH_X
;; right of his x when he faces right, at his x when left; #BUBBLE_MOUTH_Y below his y: the cartridge's y + 8, 16 lower in this game's y), setting
;; the timer long or short by its random bit (the register's byte after its slot); every tick it rises by its random bit's speed and pops
;; under #BUBBLE_TOP_Y (the status bar). The picture is the items sheet's at #BUBBLE_SHEET_X (the 8x8's top-left ring), shape #PRE_BUBBLE.
#BUBBLE_MOUTH_Y = -8
#BUBBLE_SLOTS   = 3
#BUBBLE_SIZE    = 8
#BUBBLE_MOUTH_X = 9
#BUBBLE_TOP_Y   = 32
#BUBBLE_SHEET_X = 928
#PRE_BUBBLE     = #PRE_CHEEP + 6

;; THE FLYING CHEEP-CHEEP (model: tools/record/fly_cheep_model.py; smbdis 8419 InitFlyingCheepCheep,
;; 9922 MoveFlyingCheepCheep, 7704 ImposeGravity, 7541 MoveObjectHorizontally, 11293 PlayerEnemyCollision, 11439 EnemyStomped, 12466 SetStun). A flying
;; frenzy (#FRENZY_KIND_FLYING, 2-3) sends one when its timer is out into the lowest of the cartridge's enemy slots 0 to 2 a flyer does not
;; hold (objAux; at most #FLY_CHEEP_SLOTS; with none free the timer starts again all the same), from #FLY_CHEEP_SPAWN_Y below the screen,
;; around Mario by his speed and the register (the variant files' numbers). It does not move on the tick it comes. objY is its Enemy_Y,
;; the top of the 24 px figure whose bottom 16 rows are the fish (as the swimmers'); erased once objY reaches #FLY_CHEEP_ERASE_Y, never
;; sideways. It touches Mario only once wholly above the screen's bottom (objY at most #FLY_CHEEP_SHOWN_Y). A stomp (Mario moving down,
;; or his cartridge y + #FLY_CHEEP_STOMP_REACH above its y) is 200 and bounces him at #FLY_CHEEP_STOMP_BOUNCE; a side touch hurts. Shapes:
;; the red Cheep-Cheep's frames facing right, and upside down facing right (#PRE_FLY_CHEEP to +2; facing left it is #PRE_CHEEP's red).
#FLY_CHEEP_STOMP_BOUNCE = -3
#FLY_CHEEP_SLOTS        = 3
#FLY_CHEEP_STOMP_REACH  = 12
#OBJ_FLY_CHEEP          = 12
#FLY_CHEEP_SHOWN_Y      = 216
#FLY_CHEEP_SPAWN_Y      = $f8
#FLY_CHEEP_ERASE_Y      = 256
#PRE_FLY_CHEEP          = #PRE_BUBBLE + 1

;; THE FIREBARS (model: tools/record/firebar_model.py; smbdis 8378 InitShortFirebar, 9701
;; ProcFirebar, 10639 FirebarSpin, GetFirebarPosition, 9678 FirebarPosLookupTbl, 9797 FirebarCollision, 14236 DrawFirebar). A firebar
;; (#OBJ_FIREBAR) turns about its block: objX and objY the centre ball's top left (the block's + 4), objAux its kind (the cartridge's id
;; less $1b: 0 slow and 1 fast clockwise, 2 slow and 3 fast counter-clockwise, #FIREBAR_LONG long), objVelX and objVelY its spin state's
;; low and high bytes (the high byte's five bits the angle: 32 steps a turn from straight up, clockwise as it grows; the long bar steps
;; over the level states 8 and 24). Its balls: the centre's and #FIREBAR_SHORT_PARTS parts (#FIREBAR_LONG_PARTS long) 8 px apart, each
;; offset by firebarTable() and firebarMirror(). Built as its block comes within #FIREBAR_WAKE_MARGIN of the view's right (the cartridge's
;; extended right boundary), erased #FIREBAR_ERASE_MARGIN out of the view either side (OffscreenBoundsCheck): both less than a long bar's
;; reach (88), so its far arm appears and goes at the view's edge, as the cartridge's does. A ball touches Mario within
;; 8 px both ways of his x + 4 and one point of him (24 below his cartridge y small or crouching; 0, 12 and 24 big); not while the Starman
;; lasts. Drawn as the player's fireball (#PRE_FIREBALL, its four turns), each ball an 8x8 bob.
#FIREBAR_LONG         = 4
#FIREBAR_SHORT_PARTS  = 5
#FIREBAR_HARD_BIT     = 8
#FIREBAR_LONG_PARTS   = 11
#OBJ_FIREBAR          = 13
#FIREBAR_WAKE_MARGIN  = 48
#FIREBAR_ERASE_MARGIN = 72
#FIREBAR_REACH        = 96

;; THE PODOBOO (smbdis 8144 InitPodoboo, 9187 MovePodoboo, 11293 PlayerEnemyCollision, 13669
;; CheckForPodoboo). It waits below the screen (#PODOBOO_WAIT_Y: the cartridge's high byte 2, y 2) on its interval timer (objPopTimer,
;; counted by UpdateIntervalTimers{}); when that runs out it leaps from there (#PODOBOO_LAUNCH and the random byte's 256ths, the register's
;; byte after its slot's own) and waits (the byte's low four bits ORed with #PODOBOO_MIN_INTERVALS, the cartridge's ORA #$06: so 6, 7, 14 or
;; 15 intervals) before the next. It falls by the
;; cartridge's gravity exactly (FlyCheepGravity{}). Any touch hurts Mario (no stomp), once it is wholly above the screen's bottom; with the
;; Starman it is knocked back down for this leap (200, the smack; flagged #KOOPA_ST_KNOCKED until its next leap). Fireballs burst on it and
;; do nothing. Never erased below the screen; #FIREBAR_ERASE_MARGIN out of the view either side. Drawn flipped while falling or knocked:
;; enemies sheet cell #PODOBOO_CELL, shapes #PRE_PODOBOO and + 1 (flipped).
#PODOBOO_MIN_INTERVALS = 6
#OBJ_PODOBOO           = 14
#PODOBOO_CELL          = 25
#PODOBOO_WAIT_Y        = 258
#PRE_PODOBOO           = #PRE_FLY_CHEEP + 3

;; THE SMALL LIFTS AND THE SWAYING PLATFORM (smbdis 8956 PlatLiftUp and PlatLiftDown, 9131 RunSmallPlatform,
;; 10978 MoveSmallPlatform, 11743 SmallPlatformCollision, 14309 DrawSmallPlatform, 10927 XMovingPlatform, 8930 CommonPlatCode, the
;; large platform's draw). Both are #OBJ_LIFT, told apart by objAux (#LIFT_KIND_*). A small lift moves as the large one does (up or down
;; at #LIFT_SPEED, its one-byte y wrapping) but is #SMALL_LIFT_W across, #LIFT_SHIFT right of its data's x (PosPlatform), its box
;; #SMALL_LIFT_BOX_BOTTOM deep, and a pair: a second one #LIFT_TWIN_GAP below it, wrapping too, each with its box (none in the status
;; bar, above y 32). The swaying platform goes left and right by two counters (objAnimFrame the primary, objAnimTimer the secondary, to
;; #XPLAT_SECONDARY_MAX) and carries Mario. In a castle a large platform is #CASTLE_LIFT_W across (DrawLargePlatform hides its last
;; two tiles there). Pictures: the items sheet's at #SMALL_LIFT_SHEET_X and #CASTLE_LIFT_SHEET_X (#PRE_SMALL_LIFT, #PRE_CASTLE_LIFT).
;; The platform that moves up and down (1-3's; smbdis 8914 InitVertPlatform, 10896 YMovingPlatform) is
;; #LIFT_KIND_VERT: a large platform swinging about a centre (StepSwing{}), objStartY its top and objRiseTarget its centre; still and above
;; its top it creeps down a pixel on the ticks whose low bits under #SWING_CREEP_MASK (a variant constant) are clear. The large lifts (up
;; and down, 1-2's) are #LIFT_SHIFT right of their data's x too (LargeLiftUp and LargeLiftDown run PlatLiftUp and PlatLiftDown).
#LIFT_KIND_LARGE       = 0
#LIFT_KIND_SMALL       = 1
#LIFT_KIND_SWAY        = 2
#LIFT_KIND_VERT        = 3
#SMALL_LIFT_BOX_BOTTOM = 6
#LIFT_SHIFT            = 12
#XPLAT_SECONDARY_MAX   = 14
#SMALL_LIFT_W          = 24
#CASTLE_LIFT_W         = 32
#LIFT_TWIN_GAP         = 128
#SMALL_LIFT_SHEET_X    = 936
#CASTLE_LIFT_SHEET_X   = 960

;; BOWSER (smbdis 8504 InitBowser, 10134 RunBowser, 10151 BowserControl, 10264 BowserGfxHandler, 11123
;; HandleEnemyFBallCol, 11120 BowserIdentities). One pool object (the cartridge's two, front and rear): objX and objY his front's top left,
;; objDir his way (he starts facing right, the cartridge's $df), objAux his pacing speed (2 at first, then 1 or -1), objPopTimer his frame
;; timer (EnemyFrameTimer: the jump's wait, or the chase), objVelY, objFractionY and objRiseStep his fall (FlyCheepGravity{}), objState
;; #KOOPA_ST_KNOCKED once the Starman has knocked him. bowserOrigX where he started and bowserMaxRange how far he paces from it this
;; time (#BOWSER_RANGE_*: the cartridge's PRandomRange as distances), bowserFeetCounter, bowserBodyControls (bit 7 the mouth open, bit 0
;; the feet), bowserFireBreathTimer, bowserFlameTimerCtrl, bowserHitPoints (#BOWSER_HIT_POINTS fireballs). He stands at
;; #BOWSER_GROUND_Y; his rear is #BOWSER_HALF_W behind his front and #BOWSER_REAR_DROP lower; each half's box is #BOWSER_BOX_* (control
;; $0a). Beaten by fireballs he is world 2's Koopa (BowserIdentities), knocked off, 5000. Pictures: enemies sheet cells #BOWSER_CELL on
;; (front with the mouth open, rear with the feet one way, the other, front with the mouth shut, the flame), shapes #PRE_BOWSER + 0 to 3
;; facing left, + 4 to 7 facing right, + 8 to 11 upside down (front shut, rear: left, then right), + 12 and 13 the flame.
#BOWSER_KOOPA_SPEED = -512
#BOWSER_BOX_LEFT    = 0
#BOWSER_BOX_TOP     = 2
#BOWSER_HIT_POINTS  = 5
#BOWSER_REAR_DROP   = 8
#OBJ_BOWSER         = 15
#BOWSER_HALF_W      = 16
#BOWSER_BOX_RIGHT   = 16
#BOWSER_RANGE_2     = 17
#BOWSER_BOX_BOTTOM  = 21
#BOWSER_RANGE_0     = 33
#BOWSER_CELL        = 35
#BOWSER_RANGE_3     = 49
#BOWSER_RANGE_1     = 65
#BOWSER_GROUND_Y    = 128
#BOWSER_PACE_LIMIT  = $c8
#BOWSER_FALLEN_Y    = 224
#PRE_BOWSER         = #PRE_PODOBOO + 4
#PRE_SMALL_LIFT     = #PRE_PODOBOO + 2
#PRE_CASTLE_LIFT    = #PRE_PODOBOO + 3

;; BOWSER'S FLAME (smbdis 8548 FlameYPosData, 8554 InitBowserFlame, 8590 SpawnFromMouth, 9115
;; RunBowserFlame, 10315 SetFlameTimer, 10324 ProcBowserFlame, 11164 ChkOtherEnemies). The frenzy's kind #FRENZY_KIND_FLAME is the
;; cartridge's EnemyFrenzyBuffer holding $15: set by the 2-4 marker (the fire frenzy) and by Bowser each time his mouth shuts. While it is
;; set and the frenzy's timer is out, a flame comes into a free pool slot: from Bowser's mouth if he is in the pool (#FLAME_MOUTH_X left
;; of his x, #FLAME_MOUTH_Y below his y; the kind then clears), else #FLAME_SPAWN_GAP px past the view's right edge at its height, the
;; timer the next flame wait plus #FLAME_FRENZY_EXTRA (the kind stays). One pool object: objX and objY its left and top (#FLAME_W by
;; #FLAME_H), objFractionX its sideways force (Enemy_X_MoveForce), objAux the height it goes to (flameHeights(), by its random byte),
;; objVelY its step there (-1, 1, or 0 from the right edge, already there), objState #KOOPA_ST_KNOCKED once the Starman has hit it (it
;; goes on, unseen and harmless, as the cartridge's). Its box is control $08 (#FLAME_BOX_*); a fireball bursts on it and it is not
;; touched. Erased #FLAME_ERASE_MARGIN px out of the view either side. Shapes #PRE_FLAME and + 1, its two pictures in turn.
#FLAME_BOX_TOP      = 4
#FLAME_BOX_LEFT     = 6
#FLAME_H            = 8
#FLAME_BOX_BOTTOM   = 8
#FLAME_MOUTH_Y      = 8
#FLAME_BOX_RIGHT    = 10
#FLAME_MOUTH_X      = 14
#OBJ_FLAME          = 16
#FLAME_W            = 24
#FLAME_SPAWN_GAP    = 32
#FLAME_ERASE_MARGIN = 72
#PRE_FLAME          = #PRE_BOWSER + 12
#PRE_RETAINER       = #PRE_BOWSER + 14
#PRE_RED_PARATROOPA = #PRE_RETAINER + 1
#PRE_RETAINER_ZOOL  = #PRE_RED_PARATROOPA + 4

;; THE SKY BONUS (smbdis 5524 VineEntr, 2856 Entrance_GameTimerSetup, 5644 PlayerHole, 2742 GetAreaMusic).
;; Climbing out of the top (climbAreaChange) is #AREA_EVENT_VINE: the area's vine link (tableAreaVineLink) names the sky, entered by mode
;; #ARRIVE_VINE: Mario at x #VINE_ENTRY_X, y #VINE_ENTRY_Y (below the screen), a vine grows from there up to #VINE_HEIGHT_FULL, then he
;; climbs it by himself (collision off) until his y is below #VINE_ENTRY_STOP_Y, steps off to the right (walking by himself, vineWalkOut) and has
;; the controls from x #VINE_ENTRY_READY_X. The vine's column is the one #VINE_ENTRY_X + 8 falls in. A cloud-type area (tableAreaCloud) is left
;; by falling to #CLOUD_EXIT_Y (a fall of three screens, the cartridge's Player_Y_HighPos 4): #AREA_EVENT_FALL, the area's fall link
;; (tableAreaFallLink), entered by mode #ARRIVE_DROP: dropped in from the top at #FALL_ENTRY_X on the page of the link. It has the cloud music
;; and no pit death.
#AREA_EVENT_VINE      = 3
#ARRIVE_DROP          = 3
#AREA_EVENT_FALL      = 4
#ARRIVE_VINE          = 4
#PLAYER_ST_VINE_ENTRY = 9

;; THE CASTLE'S END (smbdis 12127 HandleAxeMetatile, 1112 VictoryMode, 10067 BridgeCollapseData, 10073
;; BridgeCollapse, 10095 RemoveBridge, 10142 KillAllEnemies). Mario's box on the area's Axe cell (areaAxeX, areaAxeY), not rising: the
;; state #PLAYER_ST_AXE (the cartridge's victory mode: nothing else moves, the clock stops), the axe gone at once, his speed the walk's.
;; castleEndTask #CASTLE_END_COLLAPSE: while Bowser is in the pool and standing, his feet's counter runs and each time it is out (then
;; #BRIDGE_STEP_TICKS) a piece goes, with the blast and the shatter: the axe, the chain (a cell left and down), then the bridge from
;; the axe end (a row lower, #BRIDGE_PIECES to the left), #BRIDGE_SEQUENCE in all; after the last he drops (#BOWSER_ST_DROPPED, his fall's
;; sound) and falls until #BOWSER_FALLEN_Y. Then, or at once with no Bowser standing: the music stops, every object goes, the frenzy is
;; over, and the task is #CASTLE_END_WALK. Its first tick (SetupVictoryMode): the end-of-castle music, the scroll lock lifted, the state
;; #PLAYER_ST_ENDWALK, and the destination the page after the one the view's right edge is on (castleWalkDestX). Then (PlayerVictoryWalk)
;; Mario walks right on his own physics until #CASTLE_WALK_STOP_DX into that page, while the view scrolls on its own (CastleScroll{},
;; 1 px and #CASTLE_SCROLL_FRACTION 256ths a tick) until its left edge reaches the page (or the area's end); with both done,
;; #CASTLE_END_MESSAGES (PrintVictoryMessages): "THANK YOU MARIO!" at once, the second message #CASTLE_MSG_SECOND ticks later, both in
;; the HUD glyphs into the world (DrawCastleText{}: x from the destination, the cartridge's nametable rows); at #CASTLE_MSG_END,
;; #CASTLE_END_DELAY for 6 intervals (WorldEndTimer); then the next level (#LIFE_REPLAY, PlayerEndWorld: no COURSE CLEAR).
;; The retainer (the area's Retainer object, areaRetainerX and areaRetainerY, the cartridge's fixed $b8) is drawn whenever in view,
;; #RETAINER_DRAW_DY above his y (every picture ends on its 16x32 cell's bottom row): in world 1 Robocod, enemies sheet cell
;; #RETAINER_CELL, shape #PRE_RETAINER; in world 2 Zool, cell #RETAINER_ZOOL_CELL, shape #PRE_RETAINER_ZOOL (game-data/derived/npcs.png).
#RETAINER_DRAW_DY    = -8
#CASTLE_END_COLLAPSE = 1
#CASTLE_END_WALK     = 2
#CASTLE_END_MESSAGES = 3
#CASTLE_END_DELAY    = 4
#CASTLE_END_DONE     = 5
#PLAYER_ST_AXE       = 10
#BRIDGE_PIECES       = 13
#BRIDGE_SEQUENCE     = 15
#CASTLE_TEXT_LOWER_X = 40
#FALL_ENTRY_X        = 40
#RETAINER_CELL       = 41
#RETAINER_ZOOL_CELL  = 44
#VINE_ENTRY_X        = 56
#CASTLE_TEXT_UPPER_X = 64
#BOWSER_ST_DROPPED   = 64
#VINE_ENTRY_COLUMN_X = 64
#VINE_ENTRY_READY_X  = 72
#CASTLE_TEXT_UPPER_Y = 80
#CASTLE_WALK_STOP_DX = 96
#CASTLE_TEXT_LOWER_Y = 112
#VINE_ENTRY_STOP_Y   = 153
#VINE_ENTRY_Y        = 240
#CLOUD_EXIT_Y        = 768

;; The slide, from the cartridge: Mario's climb down is a speed of 1 plus a carry every tick (Climb_Y_SpeedData and MForceData,
;; smbdis 6036-6040, ClimbingSub 5966) and the flag's descent is 1 plus a carry too (FlagpoleRoutine, 6579): both 2 px a tick.
;; #FLAGPOLE_FRAME_TIME is the climb animation's step; it has not been checked against the cartridge.
#FLAGPOLE_SLIDE      = 2
#FLAGPOLE_FLAG_STEP  = 2
#FLAGPOLE_FRAME_TIME = 4

;; The end of the level (see sparkydave.levelend.blitz.ab3). The player y values (the pole's bands, where he hangs and where the slide
;; ends) are the cartridge's plus 16: the cartridge's player y is the top of a 32 px envelope, this game's the top of a 16 px sprite.
;; The flag's and the number's y values are sprite positions and are the cartridge's own ($aa, $b0). The pole's bands (the cartridge's
;; $22, $50, $68, $90), where a sliding Mario hangs ($9e), where the slide ends (flag $aa, or Mario $a2), where the number starts ($b0)
;; and its offset from the flag, and the climb's 14 px side-step. #CASTLE_STOP_DX is added to his x before it is compared with the door
;; object's left edge: 0 hides him as his left edge enters the doorway the object covers.
#CASTLE_STOP_DX         = 0
#POLE_NUMBER_STEP       = 2
#FIREWORK_SLOTS         = 6
#FIREWORK_PICTURE_TICKS = 8
#POLE_STEP_OFF_DX       = 14
