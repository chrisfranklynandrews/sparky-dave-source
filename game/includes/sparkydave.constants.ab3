#LOGO_SHAPE        = 183

;; Cover screens (see sparkydave.cover.blitz.ab3 and the main project's SCREENS note). The cover is bitmap slot 11. #COVER_BLANK_TICKS is how long
;; the blank cover stays up after the reload it hides (two frames' worth of sim ticks, so a black frame is always seen). #SHOW_TITLE is
;; 1 to show the title (an overlay over the attract mode, ShowTitle{}) at the start and after a game over, 0 to go straight to the lives
;; screen. #COVER_END is the end screen after the last level, shown until Return (or fire). #COVER_CONTINUE is not a cover: it is only
;; used as a chain's next step (coverNext), the continue screen after TIME UP, which HandleLifeEvent{} opens.
#COVER_NONE        = 0
#COVER_BLANK       = 1
#SHOW_TITLE        = 1
#COVER_LIVES       = 2
