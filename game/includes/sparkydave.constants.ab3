#CONTINUE_ROWS_Y    = 168
#CONTINUE_LEFT_Y    = 208

;; The menus' rows: the title's three (the game, the level it starts at, the options), the options page's (#OPT_*; its last three rows and #OPTIONS_ROWS are the look files':
;; the All-Stars look has no palette row), the pause menu's
;; three (#PAUSE_*) and the palette page's four (#PAL_PAGE_*: the palette, the area look and Mario's colours to see it with, BACK), each the
;; row's number; and the two axes of menuAxisHeld() (#MENU_AXIS_*).
#OPT_KEYBOARD         = 0
#PAUSE_RESUME         = 0
#PAL_PAGE_CHOICE      = 0
