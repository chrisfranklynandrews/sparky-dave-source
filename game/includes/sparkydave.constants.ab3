#COVER_END         = 7
#LIFE_TITLE        = 7
#LIFE_START_GAME   = 8
#COVER_CONTINUE    = 8
#COVER_BM          = 11

;; The back playfield's bitmap: the 768 px strip (#BACK_STRIP_W columns, from the area table) followed by its first #VIEW_W + #FETCH_GUARD
;; pixels again, so x can wrap at 768 with no seam. It is stamped for the start area's scenery at start (EnsureBackStrip{}), for another
;; scenery as its area is entered, and again when the title or pause overlay, which uses it as a canvas, goes (RestoreBackStrip{}).
#BACK_BM = 12

;; The title overlay: while the title is up the back bitmap is its canvas, two pages of #OVERLAY_PAGE_W (the view and the fetch guard)
;; at x 0 and x #OVERLAY_PAGE_W. A change is drawn on the page not shown, which is then shown, so the title never flickers.
#OVERLAY_PAGE_W = #VIEW_W + #FETCH_GUARD

;; The attract mode behind the title (AdvanceAttract{}): the camera's phase. Its speed and timings
;; are in the variant files (#ATTRACT_STEP, #ATTRACT_HOLD_TICKS, #ATTRACT_BLANK_TICKS), since they
;; count sim ticks.
#ATTRACT_OFF    = 0
#ATTRACT_SCROLL = 1
#ATTRACT_HOLD   = 2
#ATTRACT_BLANK  = 3

;; The overlay's screens (overlayScreenWanted, overlayScreenShown): none, the title, the options page, the pause menu, the jukebox, the
;; palette page and the game over's continue.
#SCREEN_NONE     = 0
#SCREEN_TITLE    = 1
#SCREEN_OPTIONS  = 2
#SCREEN_PAUSE    = 3
#SCREEN_JUKEBOX  = 4
#SCREEN_PALETTE  = 5
#SCREEN_CONTINUE = 6

