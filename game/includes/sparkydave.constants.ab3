#POLE_Y_100             = 160
#PRE_STAR_FLAG          = 169
#POLE_FLAG_END_Y        = 170
#POLE_STOP_Y            = 174
#POLE_NUMBER_START_Y    = 176
#POLE_END_Y             = 178
#FIREWORK_POINTS        = 500

;; Areas and pipes (see sparkydave.pipes.blitz.ab3 and sparkydave.areas.blitz.ab3).
;; The pipe moves are 48 ticks (ChangeAreaTimer $30); he comes back up from below the
;; bottom of the screen (the cartridge's $f0 plus 16) at x 56 into the screen
;; ($38) and is free when his top is above #PIPE_UP_READY_Y (its $91 plus 16); in the
;; bonus room he drops in with no control until his top is below #BONUS_DROP_READY_Y
