#SCENERY_CLOUDS = 1
#SCENERY_HILLS  = 2
#SCENERY_TREES  = 3
#SCENERY_WATER  = 4

;; Where the flag waits in an area with no flagpole: in the bitmap, right of anything the camera shows (no area without a flagpole is
