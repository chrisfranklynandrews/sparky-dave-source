#PAL_PAGE_BACK        = 3
#OPT_COYOTE           = 4
#PAL_PAGE_ROWS        = 4
#OPT_CONTINUES        = 5
#OPT_SOUND            = 6

;; The options and pause pages' layout on a page: the cursor's, the labels' and the values'
;; columns, the heading's row, the first row (#TITLE_LINE apart) and the hint's row.
#MENU_HEADING_Y = 40
#MENU_ROWS_Y    = 56
#MENU_HINT_Y    = 232

;; The jukebox page (sparkydave.jukebox.blitz.ab3): its rows (#JKB_*), its layout on a page (the heading, the stage from #JKB_STAGE_TOP
;; to the ground at #JKB_GROUND_Y, the rows from #JKB_ROWS_Y a #JKB_ROW_PITCH apart, the readout line; the columns are #MENU_*), the
;; highest hop of a character, and the NES look's sky pen in the backdrop's scenes (#JKB_SKY_PEN, an atlas pen the scenery does not
;; use). The backdrop is a pre-cut scene from the stage's top down (sparkydave.jukebox-scenes.data.ab3, ShowJukeboxScene{}).
;; The four characters are spread evenly across the view: the first at #JKB_CHAR_X, each next one #JKB_CHAR_PITCH further on (16 wide,
;; so 38 between them and 39 at each end: the 192 px they leave, in five equal gaps to the whole pixel).
#JKB_SONG        = 0
#JKB_EFFECT      = 1
#JKB_PAN         = 2
#JKB_FILTER      = 3
#JKB_PULSE       = 4
#JKB_TRIANGLE    = 5
#JKB_NOISE       = 6
#JKB_DEFAULTS    = 7
#JKB_BACK        = 8
#JKB_ROWS        = 9
#JKB_SKY_PEN     = 9
#JKB_ROW_PITCH   = 12
#JKB_HEADING_Y   = 36
#JKB_CHAR_X      = 39
#JKB_STAGE_MAX_H = 40
#JKB_STAGE_TOP   = 48
#JKB_CHAR_PITCH  = 54
#JKB_GROUND_Y    = 112
#JKB_ROWS_Y      = 122
#JKB_READOUT_Y   = 232

;; The back's two bands (sparkydave.parallax.blitz.ab3): the hills' band starts at world list line
;; #BAND_LINE (bitmap row #VIEW_TOP + 80 = 112, among the back's empty rows between the clouds at 32
;; to 79 and the hills at 160 to 207). Two CustomStrings: 2 instructions each (a no-op and the wait)
;; plus 4 and 5 moves, so 13 custom instructions for the band, the second string from slot 6 (counted from the band's own first slot: list 1's
;; custom area starts with #WORLD_START_SLOTS slots for the sky restore string, so #BAND_POKE_FIRST_1 and #BAND_POKE_SECOND_1 add that shift). The
;; CopList object's custom area pointer is its eighth long (displaylib.ab3, NEWTYPE .mycop), and
;; the value words of the moves are at these byte offsets in it. #BAND_BLOCK_MASK is an x in
;; quarter pixels less its 32 px fine part (#FINE_MASK, in quarter pixels). The copper registers: the even (back) planes' pointers,
;; high word, and BPLCON1.
#FETCH_OFF_SLOTS       = 4
#BAND_STRING_B_SLOT    = 6
#SKY_STRING_SLOTS      = 7
#BAND_POKE_FIRST       = 10
#BAND_CUSTOMS          = 13
#MYCOP_CUSTOMS         = 28
#BAND_POKE_SECOND      = 34
#BAND_LINE             = 80
#FINE_MASK             = 127
#BPL2PTH               = $E4
#BPL4PTH               = $EC
#BPL6PTH               = $F4
#BPL8PTH               = $FC
#BPLCON0               = $100
#BPLCON1               = $102
#BPLCON3               = $106
#COLOR00               = $180
#COPPER_NOP            = $1fe
#PLAYFIELD2_OFFSET_HUD = $0c00
#BAND_BLOCK_MASK       = $FF80
#BAND_LINE_AWAY        = #BAND_LINE + #HUD_H + #LIST_GAP
;; The back's colour offset 16 as list 1 has it (BPLCON3 $0c00 by default, XOR #PLAYFIELD2_OFFSET_16): the second HUD string sets it. The default's
;; bits are all in #PLAYFIELD2_OFFSET_16, so the XOR is a subtraction: $1000.
#BPLCON3_BACK = #PLAYFIELD2_OFFSET_16 - #PLAYFIELD2_OFFSET_HUD
;; BPLCON3's BRDRBLNK (enabled by ECSENA, BPLCON0's bit 0, which the library sets, so a BPLCON0 written by a string keeps it). With it
;; on, the border is black, and so is any line inside the window that fetches no planes. It is on in all three lists' headers and in every
;; string that writes BPLCON3, so the frame is black all round, the 3 line gap under the HUD is black and nothing switches part way along a
;; line (a header's BPLCON3 lands part way along a line: a half black line). The HUD is black too: each list that has the HUD on its first
;; lines (list 0, list 2) has a start string (#START_SLOTS, ShowHudStart{}) that writes COLOR00 black after the palette load. The string that puts
;; the sky (pen 0's colour) back is the first string of a world list: slot 0 of list 1 (#WORLD_START_SLOTS, which shifts all of list 1's other
;; strings on) at its line 0, and #AWAY_RESTORE_SLOT of list 2 at its line #HUD_H + #LIST_GAP, the same line, so the black is the HUD, the gap
;; and the world's first line, 20 lines in both (#RESTORE_SLOTS, InitHudRestore{} and PokeHudRestore{}). List 0 holds only its start string, so
;; #COPPER_CUSTOMS is #START_SLOTS; a restore string at the end of list 0 broke Amiga Forever (the main project's AMIGA_RENDERER note).
#START_SLOTS       = 7
#RESTORE_SLOTS     = 7
#BORDER_BLANK      = $20
#COPPER_CUSTOMS    = #START_SLOTS
#WORLD_START_SLOTS = #RESTORE_SLOTS

;; List 2's custom area: its start string, then with #HUD_OVER_WORLD its two HUD strings (BuildBandStrings{}): the first is a no-op, a wait and four
;; pointer moves (#BAND_STRING_B_SLOT slots), the second a no-op, a wait and six moves, the four and BPLCON1 and BPLCON3 (#HUD_STRING_B_SLOTS);
;; the hills' strings follow at slot #AWAY_BAND_SLOT (the world's strings from #AWAY_WORLD_SLOT, in list 1's order), so their pokes are 4 bytes a
;; slot on; without it the hills' strings follow the start string. InitBand{} checks the registers are where these say, and rebuilds the strings
;; every frame if not.
#HUD_STRING_B_SLOTS    = 2 + 6
#HUD_STRING_SLOTS      = #BAND_STRING_B_SLOT + #HUD_STRING_B_SLOTS
#BAND_SLOT_1           = #SKY_EARLY_BANDS*#SKY_STRING_SLOTS
#BAND_POKE_FIRST_1     = #BAND_POKE_FIRST + 4*(#WORLD_START_SLOTS + #BAND_SLOT_1)
#BAND_POKE_SECOND_1    = #BAND_POKE_SECOND + 4*(#WORLD_START_SLOTS + #BAND_SLOT_1)
#HUD_POKE_FIRST        = #BAND_POKE_FIRST + 4*#START_SLOTS
#HUD_POKE_SECOND       = #BAND_POKE_SECOND + 4*#START_SLOTS
#AWAY_RESTORE_SLOT     = #START_SLOTS + #HUD_STRING_SLOTS*#HUD_OVER_WORLD
#AWAY_WORLD_SLOT       = #AWAY_RESTORE_SLOT + #RESTORE_SLOTS
#AWAY_BAND_SLOT        = #AWAY_WORLD_SLOT + #BAND_SLOT_1
#AWAY_CUSTOMS          = #BAND_CUSTOMS + #AWAY_WORLD_SLOT
#BAND_POKE_FIRST_AWAY  = #BAND_POKE_FIRST + 4*#AWAY_BAND_SLOT
#BAND_POKE_SECOND_AWAY = #BAND_POKE_SECOND + 4*#AWAY_BAND_SLOT

;; The speeds: the clouds' and the hills' share of the camera's movement, one of #PARALLAX_PRESETS
;; pairs (globals.ab3, parallaxCloudRate() and parallaxHillRate()), #PARALLAX_DEFAULT at start.
;; In debug mode Help steps through them and the HUD shows "P" and the number (Help is refused by
;; the redefine screen, KeyAllowed{}).
#PARALLAX_DEFAULT = 2
#PARALLAX_PRESETS = 6

; NES button bits. Right is 1 and left is 2, so they also work as facing values.
#MARIO_BTN_RIGHT = $01
#MARIO_BTN_LEFT  = $02
#MARIO_BTN_DOWN  = $04

; Up climbs a vine (nothing else reads it): the UP key (the cursor Up unless redefined, #KEY_UP) and the joystick's stick up.
#MARIO_BTN_UP  = $08
#MARIO_BTN_RUN = $40

;; The fire button, a bit of its own so the run button and the fire button can be two keys.
;; The cartridge's B is both; #MARIO_BTN_FIRE sits where its Select bit is, which this
;; engine never sets (the heldBits test in PrepareGroundMotion{} leaves it out).
#MARIO_BTN_FIRE = $20
#MARIO_BTN_JUMP = $80




; Numbers the same in both builds: the jump halt, the run timer, the side-collision timer.
#MARIO_JUMP_HALT = 1
#MARIO_RUN_TIME  = 10
; Big Mario's vertical speed after breaking a brick (BrickShatter sets $fe).
#BRICK_BREAK_SPEED_Y = -2
#MARIO_SIDECOLLIDE   = 16
#MARIO_SCROLL_CATCH  = 112
#MARIO_FALL_FRAC     = $80

;; The water's surface, the same in both builds: above it a stroke does not lift him and the surface force pushes him under (ProcSwim
;; and InitJS's cmp #$14, in the cartridge's y; this game's y is the top of the 16 px sprite, 16 lower).
#SWIM_SURFACE_Y = 36
;; Big Mario's head while swimming (ChkCollSize's second probe set, BlockBufferAdderData 7: the head at y $02, not $04),
;; 2 px above #PROBE_TOP_Y_BIG; his feet and sides are as on land.
#PROBE_TOP_Y_BIG_SWIM = -14

;; The display refresh is 50 or 60 Hz (#SIM_HZ_PAL plus #SIM_HZ_STEP when the machine is NTSC); the sim's rate
;; (#SIM_HZ) is in the physics variant, and the sound engine's is always #SOUND_HZ. Cap is ticks per frame.
#SIM_MAX_TICKS = 2
#SIM_HZ_STEP   = 10
#SIM_HZ_PAL    = 50

;; ---------------------------------------------------------------
;; Tile-collision geometry
;; ---------------------------------------------------------------
;; The NES tile-collision box is 12x14, inset 2 px on the left, right and
;; top and flush at the bottom, sampled at five points that serve all four
;; directions: the top edge at its centre, the bottom edge at both ends,
;; and each side edge at its own extreme. The cartridge reaches these numbers through a 32 px OAM envelope with small Mario's art at
;; the bottom; this game blits one 16 px shape, so the offsets are rebased by -16 on Y. The geometry is identical; only the arithmetic
;; differs. See the main project's PLAYER_HITBOX note section 4.2.
;;
;; The player's bounding box is a second, separate box used for enemy
;; collision: small Mario is 10x12 at (+3, +4). Big Mario is 12x24 at
;; (+2, +8) and crouching is 12x12 at (+2, +20), both in a 32-px sprite, so
;; those need no rebasing either. Moving items, Goombas and Koopas read this box.

;; Tile-collision probes, relative to the sprite top left.
;;
;; The head probe moves with Mario's size and NOTHING ELSE about the box does.
;; From the ROM's two probe sets (the main project's PLAYER_HITBOX note section 4.3: adder indices
;; 0-6 standing big, 14-20 small) both put the FEET at Y+32 and span the same
;; 12 px horizontally, X+2 to X+13. Only the head differs -- Y+4 standing big,
;; Y+18 small -- so big is 28 px tall against small's 14 and the delta is 14 px.
;; #PROBE_TOP_Y_BIG is that delta applied to #PROBE_TOP_Y. The horizontal box is
;; already right for both sizes, so growing changes one number and not a box.
#PROBE_TOP_Y_BIG    = -12
#PROBE_SIDE_Y_UPPER = -8
#PROBE_TOP_Y        = 2
#PROBE_SIDE_X1      = 2
#PROBE_FOOT_X1      = 3
#PROBE_TOP_X        = 8
#PROBE_SIDE_Y       = 8
#PROBE_FOOT_X2      = 12
#PROBE_SIDE_X2      = 13
#PROBE_FOOT_Y       = 16

;; Sub-tile gates. The ROM tests the low nybble of the player's own Y, not
;; the probe's, so these transfer across the rebasing unchanged. The head
;; gate lets Mario rise through the first 4 px of a ceiling; the foot gate
;; refuses to land once he is #MT_FEET_MIN_SUBTILE px or more into a tile row (5 on NTSC, 6 on PAL,
;; in sparkydave.physics.ab3) and impedes horizontal motion instead. Both are safe while the worst
;; fall step, #MARIO_FALL_MAX + 1, is no more than #MT_FEET_MIN_SUBTILE: then the residues playerY
;; mod 16 takes while falling always include one below it. The VARIANTS check in
;; tools/check_source_split.py enforces that for both variants. See the main project's PLAYER_HITBOX note
;; section 4.4.
#MT_HEAD_MIN_SUBTILE = 4
#MT_HEAD_MIN_Y       = 16

; The box shape itself, derived from the probes above rather than used.
#HITBOX_INSET  = 2
#HITBOX_WIDTH  = 12
#HITBOX_HEIGHT = 14

;; Enemy-collision bounding box. See the note above for the -16 Y rebasing: the cartridge states these against the 32 px sprite
;; envelope and this game blits one 16 px shape, so every Y here is 16 less than the cartridge's.
;;
;; Small: $03,$14,$0d,$20 -> x+3..x+13, y+4..y+16 (10 wide, 12 tall).
;; Big: $02,$08,$0e,$20 -> x+2..x+14, y-8..y+16 (12 wide, 24 tall). The top is
;; negative because a 24-tall box whose feet are at y+16 starts 8 px above the
;; sprite origin, which is exactly where DrawPlayer{} lifts big Mario's blit to.
#BOUND_TOP_BIG    = -8
#BOUND_LEFT_BIG   = 2
#BOUND_LEFT       = 3
#BOUND_TOP        = 4
#BOUND_RIGHT      = 13
#BOUND_RIGHT_BIG  = 14
#BOUND_BOTTOM     = 16
#BOUND_BOTTOM_BIG = 16

;; END OF CONSTANTS
