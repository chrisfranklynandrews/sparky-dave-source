jukeboxEffectBit(17) = #SFX_BOWSER_FLAME

; The engine's own length table (the cartridge's APU length counter values).
Dim apuLengthTable.w(31)
apuLengthTable(0) = 10
apuLengthTable(1) = 254
apuLengthTable(2) = 20
apuLengthTable(3) = 2
apuLengthTable(4) = 40
apuLengthTable(5) = 4
apuLengthTable(6) = 80
apuLengthTable(7) = 6
apuLengthTable(8) = 160
apuLengthTable(9) = 8
apuLengthTable(10) = 60
apuLengthTable(11) = 10
apuLengthTable(12) = 14
apuLengthTable(13) = 12
apuLengthTable(14) = 26
apuLengthTable(15) = 14
apuLengthTable(16) = 12
apuLengthTable(17) = 16
