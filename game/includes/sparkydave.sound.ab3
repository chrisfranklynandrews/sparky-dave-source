Dim jukeboxEffectName$(#JUKEBOX_EFFECTS - 1)
Dim jukeboxEffectGroup.w(#JUKEBOX_EFFECTS - 1)
Dim jukeboxEffectBit.w(#JUKEBOX_EFFECTS - 1)
jukeboxSongName$(0) = "GROUND"
jukeboxSongBit(0) = #MUSIC_GROUND
jukeboxSongName$(1) = "UNDERGROUND"
jukeboxSongBit(1) = #MUSIC_UNDERGROUND
jukeboxSongName$(2) = "WATER"
jukeboxSongBit(2) = #MUSIC_WATER
