jukeboxSongBit(13) = #MUSIC_TIME_RUNNING_OUT
jukeboxEffectName$(0) = "SMALL JUMP"
jukeboxEffectBit(0) = #SFX_SMALL_JUMP
jukeboxEffectName$(1) = "BIG JUMP"
jukeboxEffectBit(1) = #SFX_BIG_JUMP
jukeboxEffectName$(2) = "BUMP"
jukeboxEffectBit(2) = #SFX_BUMP
jukeboxEffectName$(3) = "STOMP"
jukeboxEffectBit(3) = #SFX_ENEMY_STOMP
jukeboxEffectName$(4) = "SMACK"
jukeboxEffectBit(4) = #SFX_ENEMY_SMACK
jukeboxEffectName$(5) = "PIPE INJURY"
jukeboxEffectBit(5) = #SFX_PIPE_DOWN_INJURY
jukeboxEffectName$(6) = "FIREBALL"
jukeboxEffectBit(6) = #SFX_FIREBALL
jukeboxEffectName$(7) = "FLAGPOLE"
jukeboxEffectBit(7) = #SFX_FLAGPOLE
jukeboxEffectName$(8) = "COIN"
jukeboxEffectGroup(8) = 1
jukeboxEffectBit(8) = #SFX_COIN_GRAB
jukeboxEffectName$(9) = "GROW POWER UP"
jukeboxEffectGroup(9) = 1
jukeboxEffectBit(9) = #SFX_GROW_POWER_UP
jukeboxEffectName$(10) = "GROW VINE"
jukeboxEffectGroup(10) = 1
jukeboxEffectBit(10) = #SFX_GROW_VINE
jukeboxEffectName$(11) = "FIREWORK BLAST"
jukeboxEffectGroup(11) = 1
jukeboxEffectBit(11) = #SFX_BLAST
jukeboxEffectName$(12) = "TIMER TICK"
