;; =======================================================
;; SOUND (AMIGA MODE)
;; =======================================================
;; The cartridge's sound engine, ported (sparkydave.sound.blitz.ab3), drives a virtual
;; APU, and a mapping layer plays the virtual APU on Paula. This file holds what the
;; Blitz half needs declared first: the constants, the engine's variables, the APU's
;; state, and the waveforms in Chip RAM. See the main project's SOUND note.

;; --- The sound queues and music, as the game asks for them (smbdis's names and values).
;; Square 1 effects.
#SFX_BIG_JUMP         = 1
#SFX_BUMP             = 2
#SFX_ENEMY_STOMP      = 4
#SFX_ENEMY_SMACK      = 8
#SFX_PIPE_DOWN_INJURY = 16
#SFX_FIREBALL         = 32
#SFX_FLAGPOLE         = 64
#SFX_SMALL_JUMP       = 128

; Square 2 effects.
#SFX_COIN_GRAB     = 1
#SFX_GROW_POWER_UP = 2
#SFX_GROW_VINE     = 4
#SFX_BLAST         = 8
#SFX_TIMER_TICK    = 16
#SFX_POWER_UP_GRAB = 32
#SFX_EXTRA_LIFE    = 64
#SFX_BOWSER_FALL   = 128

; Noise effects.
#SFX_BRICK_SHATTER = 1
#SFX_BOWSER_FLAME  = 2

; Area music (the area queue).
#MUSIC_GROUND      = 1
#MUSIC_WATER       = 2
#MUSIC_UNDERGROUND = 4
#MUSIC_CASTLE      = 8
#MUSIC_CLOUD       = 16
#MUSIC_PIPE_INTRO  = 32
#MUSIC_STAR_POWER  = 64
#MUSIC_SILENCE     = 128

; Event music (the event queue).
#MUSIC_DEATH            = 1
#MUSIC_GAME_OVER        = 2
#MUSIC_VICTORY          = 4
#MUSIC_END_OF_CASTLE    = 8
#MUSIC_ALT_GAME_OVER    = 16
#MUSIC_END_OF_LEVEL     = 32
#MUSIC_TIME_RUNNING_OUT = 64

;; --- The engine's variables, in one array (soundState), by index. The names are the
;; cartridge's, spelled out.
#SS_SQUARE1_QUEUE                = 0
#SS_SQUARE2_QUEUE                = 1
#SS_NOISE_QUEUE                  = 2
#SS_AREA_MUSIC_QUEUE             = 3
#SS_EVENT_MUSIC_QUEUE            = 4
#SS_SQUARE1_BUFFER               = 5
#SS_SQUARE2_BUFFER               = 6
#SS_NOISE_BUFFER                 = 7
#SS_AREA_MUSIC_BUFFER            = 8
#SS_EVENT_MUSIC_BUFFER           = 9
#SS_MUSIC_DATA                   = 10
#SS_MUSIC_OFFSET_SQUARE2         = 11
#SS_MUSIC_OFFSET_SQUARE1         = 12
#SS_MUSIC_OFFSET_TRIANGLE        = 13
#SS_MUSIC_OFFSET_NOISE           = 14
#SS_NOTE_LENGTH_OFFSET           = 15
#SS_NOISE_LOOPBACK_OFFSET        = 16
#SS_LENGTH_TABLE_ADDER           = 17
#SS_AREA_MUSIC_BUFFER_ALT        = 18
#SS_GROUND_HEADER_OFFSET         = 19
#SS_ALT_REG_CONTENT_FLAG         = 20
#SS_SQUARE2_NOTE_LENGTH_BUFFER   = 21
#SS_SQUARE2_NOTE_LENGTH_COUNTER  = 22
#SS_SQUARE2_ENVELOPE_CONTROL     = 23
#SS_SQUARE1_NOTE_LENGTH_COUNTER  = 24
#SS_SQUARE1_ENVELOPE_CONTROL     = 25
#SS_TRIANGLE_NOTE_LENGTH_BUFFER  = 26
#SS_TRIANGLE_NOTE_LENGTH_COUNTER = 27
#SS_NOISE_BEAT_LENGTH_COUNTER    = 28
#SS_SQUARE1_SFX_LENGTH           = 29
#SS_SQUARE2_SFX_LENGTH           = 30
#SS_SFX_SECONDARY_COUNTER        = 31
#SS_NOISE_SFX_LENGTH             = 32
#SS_LOAD_VALUE                   = 33
#SS_ENABLED                      = 34
#SS_PAUSE_QUEUE                  = 35
#SS_PAUSE_BUFFER                 = 36
#SS_PAUSE_MODE                   = 37
#SS_COUNT                        = 38

;; --- The virtual APU: four channels (0 pulse 1, 1 pulse 2, 2 triangle, 3 noise), 16
;; fields each.
#AP_CONTROL        = 0
#AP_SWEEP          = 1
#AP_TIMER          = 2
#AP_LENGTH         = 3
#AP_ENABLED        = 4
#AP_ENVELOPE_START = 5
#AP_ENVELOPE_DIV   = 6
#AP_ENVELOPE_LEVEL = 7
#AP_SWEEP_RELOAD   = 8
#AP_SWEEP_DIV      = 9
#AP_LINEAR         = 10
#AP_LINEAR_RELOAD  = 11
#AP_NOISE_PERIOD   = 12
#AP_NOISE_MODE     = 13
#AP_LEVEL          = 14

;; --- Paula
#PAULA_PERIOD_MIN = 124
#PAULA_DMA_AUDIO  = $820f
#PAULA_PERIOD_MAX = 65535
#PAULA_DMACON     = $dff096
#PAULA_ADKCON     = $dff09e
#PAULA_BASE       = $dff0a0

;; The loudness of each NES channel on Paula, per step of the 4-bit volume (Paula's
;; range is 0 to 64): by ear.
#SOUND_NOISE_VOLUME    = 3
#SOUND_PULSE_VOLUME    = 4
#SOUND_TRIANGLE_VOLUME = 4

;; The pan layouts the tuning keys step through (soundPanLayout(): four Paula channels for each,
;; in the order pulse 1, pulse 2, triangle, noise). Paula's channels 0 and 3 are the left speaker
;; and 1 and 2 the right. Layout 0 is the first one made.
#SOUND_PAN_LAYOUTS = 5

;; The settings the game starts with, chosen by ear (the main project's SOUND note, "The sound settings"): layout 3 (melody and
;; noise left, harmony and bass right), the low-pass filter off (1 is on), and the volume steps above. A player's
;; own choice replaces them through the settings file (the same variables the tuning keys change).
#SOUND_FILTER_DEFAULT = 0
#SOUND_PAN_DEFAULT    = 3

;; The wave block in Chip RAM: the 4 pulse duties in 3 cycle lengths (56 bytes each
;; duty), the triangle in 3 lengths (56), the long noise (32768, one 32767-step pass
;; and the first byte again) and the short noise (two 93-step passes, 186).
#SOUND_WAVE_LEVEL        = 90
#SOUND_NOISE_SHORT_BYTES = 186
#SOUND_NOISE_LONG_BYTES  = 32768
#SOUND_WAVE_BLOCK_BYTES  = 33280

Dim soundState.l(#SS_COUNT)
Dim apuState.l(63)

;; The jukebox page. While the page is up soundJukeboxOn is True: the engine runs
;; whatever the cover (the title is silent otherwise) with its own clean state, and the game's state is
;; kept in the soundSaved arrays by SoundJukeboxBegin{} and put back by SoundJukeboxEnd{}
;; (sparkydave.sound.blitz.ab3), so the game's music goes on where it was.
soundJukeboxOn.w = False
Dim soundSavedState.l(#SS_COUNT)
Dim soundSavedApu.l(63)

;; What the page lists, in order: the songs (area music loops, event tunes play once; jukeboxSongEvent
;; says which queue the bit goes to) and the effects (group 0 square 1, 1 square 2, 2 noise).
#JUKEBOX_SONGS   = 14
#JUKEBOX_EFFECTS = 18
