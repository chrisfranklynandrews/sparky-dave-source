apuLengthTable(26) = 72
apuLengthTable(27) = 26
apuLengthTable(28) = 16
apuLengthTable(29) = 28
apuLengthTable(30) = 32
apuLengthTable(31) = 30

Dim apuPowerOfTwo.w(7)
apuPowerOfTwo(0) = 1
apuPowerOfTwo(1) = 2
apuPowerOfTwo(2) = 4
apuPowerOfTwo(3) = 8
apuPowerOfTwo(4) = 16
apuPowerOfTwo(5) = 32
apuPowerOfTwo(6) = 64
apuPowerOfTwo(7) = 128

; The noise channel's 16 periods, in CPU cycles per shift of its register.
Dim apuNoisePeriod.w(15)
apuNoisePeriod(0) = 4
apuNoisePeriod(1) = 8
apuNoisePeriod(2) = 16
apuNoisePeriod(3) = 32
apuNoisePeriod(4) = 64
apuNoisePeriod(5) = 96
apuNoisePeriod(6) = 128
apuNoisePeriod(7) = 160
apuNoisePeriod(8) = 202
apuNoisePeriod(9) = 254
apuNoisePeriod(10) = 380
apuNoisePeriod(11) = 508
apuNoisePeriod(12) = 762
apuNoisePeriod(13) = 1016
apuNoisePeriod(14) = 2034
apuNoisePeriod(15) = 4068

; Cycle lengths of the pulse and triangle waves: index 0 is 32 bytes, 1 is 16, 2 is 8.
Dim soundCycleLength.w(2)
soundCycleLength(0) = 32
soundCycleLength(1) = 16
soundCycleLength(2) = 8

; Byte offsets of the waves inside the wave block.
Dim soundPulseWaveOffset.l(11)
Dim soundTriangleWaveOffset.l(2)

;; Which Paula channel each APU channel plays on, from the pan layout in use (soundPanLayout(),
;; below; set from #SOUND_PAN_DEFAULT once the layouts are filled in). Paula's channels 0 and 3
;; are the left speaker and 1 and 2 the right.
Dim soundPaulaChannel.w(3)

;; What each Paula channel was last given, so an unchanged channel is not rewritten.
;; The tuning (the main project's SOUND note, "The sound settings"): the layouts, the layout in use, the volume per
;; step of the 4-bit level for the pulses, the triangle and the noise (Paula's range is 0 to 64),
;; which of the three the keypad changes, whether the readout needs drawing, and the keys' edges.
Dim soundPanLayout.w(#SOUND_PAN_LAYOUTS*4 - 1)
soundPanLayout(0) = 0
soundPanLayout(1) = 3
soundPanLayout(2) = 1
soundPanLayout(3) = 2
soundPanLayout(4) = 0
soundPanLayout(5) = 1
soundPanLayout(6) = 3
soundPanLayout(7) = 2
soundPanLayout(8) = 1
soundPanLayout(9) = 2
soundPanLayout(10) = 0
soundPanLayout(11) = 3
soundPanLayout(12) = 0
soundPanLayout(13) = 1
soundPanLayout(14) = 2
soundPanLayout(15) = 3
soundPanLayout(16) = 1
soundPanLayout(17) = 0
soundPanLayout(18) = 3
soundPanLayout(19) = 2
soundPanNow.w = 0
Dim soundVolumeScale.w(2)
;; The low-pass filter as chosen (True on), put on the hardware by SoundApplySettings{} and the
;; options page; the settings file can replace it, as it can the layout and the volume steps.
soundFilterChosen.w = False

;; The sound's settings as the game comes: at the start, and for the options page's DEFAULTS. The
;; variables only; the hardware gets them in SoundApplySettings{}.
Statement SetSoundDefaults{}
  SHARED soundPanNow, soundPaulaChannel(), soundPanLayout(), soundFilterChosen, soundVolumeScale()
  soundPanNow = #SOUND_PAN_DEFAULT
  For panIndex.w = 0 To 3
    soundPaulaChannel(panIndex) = soundPanLayout(soundPanNow*4 + panIndex)
  Next
  soundVolumeScale(0) = #SOUND_PULSE_VOLUME
  soundVolumeScale(1) = #SOUND_TRIANGLE_VOLUME
  soundVolumeScale(2) = #SOUND_NOISE_VOLUME
  soundFilterChosen = False
  If #SOUND_FILTER_DEFAULT = 1 Then soundFilterChosen = True
End Statement
SetSoundDefaults{}

Dim soundPaulaKey.l(3)
Dim soundPaulaWave.l(3)
Dim soundPaulaWords.l(3)
Dim soundPaulaPeriod.l(3)
Dim soundPaulaVolume.l(3)

soundWaveBlock.l = 0
soundNoiseLongOffset.l = 0
soundNoiseShortOffset.l = 0
soundPlanSize.l = 0
soundPlanPeriod.l = 0

;; True once the hardware is running (the tests leave it off: the registers are not
;; written and nothing is heard).
soundHardwareOn.w = False

;; The frame time report's split of the sound (the main project's TIMING note, "The sound
;; split"): soundPartLines() adds up the raster lines of each part of the frame's sound ticks
;; (#SOUND_PART_*), soundTicksLast is how many ticks the frame ran. Kept here, not in globals.ab3,
;; because the standalone sound program (proofs/sound-engine.ab3) includes the sound files and nothing else. Only when soundTimingOn
;; (the game's debug mode, sparkydave.init.ab3); soundFrameLines is the frame's raster lines,
;; for a beam that wraps.
#SOUND_PART_CLOCKS = 0
#SOUND_PART_SFX    = 1
#SOUND_PART_MUSIC  = 2
#SOUND_PART_PAULA  = 3
soundTimingOn.w = False
soundFrameLines.l = 312
soundMarkLine.l = 0
soundTicksLast.w = 0
Dim soundPartLines.l(3)

;; The waves, built once at start-up into Chip RAM (signed bytes). Returns False if
;; the allocation failed.
Function.w BuildSoundWaves{}
  SHARED soundWaveBlock, soundPulseWaveOffset(), soundTriangleWaveOffset(), soundCycleLength()
  SHARED soundNoiseLongOffset, soundNoiseShortOffset
  soundWaveBlock = AllocMem(#SOUND_WAVE_BLOCK_BYTES, 2 + 65536)
  If soundWaveBlock = 0 Then Function Return False

  waveOffset.l = 0
  For dutyIndex.w = 0 To 3
    If dutyIndex = 0 Then eighthsHigh.w = 1
    If dutyIndex = 1 Then eighthsHigh.w = 2
    If dutyIndex = 2 Then eighthsHigh.w = 4
    If dutyIndex = 3 Then eighthsHigh.w = 6
    For sizeIndex.w = 0 To 2
      cycleBytes.w = soundCycleLength(sizeIndex)
      highCount.w = (cycleBytes*eighthsHigh)/8
      soundPulseWaveOffset(dutyIndex*3 + sizeIndex) = waveOffset
      For sampleIndex.w = 0 To cycleBytes - 1
        If sampleIndex < highCount
          Poke.b soundWaveBlock + waveOffset + sampleIndex, #SOUND_WAVE_LEVEL
        Else
          Poke.b soundWaveBlock + waveOffset + sampleIndex, -#SOUND_WAVE_LEVEL
        EndIf
      Next
      waveOffset = waveOffset + cycleBytes
    Next
  Next

  For sizeIndex.w = 0 To 2
    cycleBytes.w = soundCycleLength(sizeIndex)
    halfBytes.w = cycleBytes/2
    soundTriangleWaveOffset(sizeIndex) = waveOffset
    For sampleIndex.w = 0 To cycleBytes - 1
      If sampleIndex < halfBytes
        stepLevel.w = halfBytes - 1 - sampleIndex
      Else
        stepLevel.w = sampleIndex - halfBytes
      EndIf
      Poke.b soundWaveBlock + waveOffset + sampleIndex, (stepLevel*240)/(halfBytes - 1) - 120
    Next
    waveOffset = waveOffset + cycleBytes
  Next

  ;; The cartridge's noise: a 15-bit shift register from 1, feedback bit 0 xor bit 1
  ;; (long mode) or bit 0 xor bit 6 (short mode), the output high while bit 0 is clear.
  ;; The long mode repeats after 32767 steps; the 32768th byte repeats the first, a
  ;; one-sample hiccup every 32768 samples.
  soundNoiseLongOffset = waveOffset
  shiftRegister.l = 1
  noiseIndex.l = 0
  While noiseIndex < #SOUND_NOISE_LONG_BYTES - 1
    lowBit.l = shiftRegister AND 1
    tapBit.l = (shiftRegister/2) AND 1
    feedback.l = Xor(lowBit, tapBit)
    shiftRegister = (shiftRegister/2) OR (feedback*16384)
    If lowBit = 0
      Poke.b soundWaveBlock + waveOffset + noiseIndex, #SOUND_WAVE_LEVEL
    Else
      Poke.b soundWaveBlock + waveOffset + noiseIndex, -#SOUND_WAVE_LEVEL
    EndIf
    noiseIndex = noiseIndex + 1
  Wend
  Poke.b soundWaveBlock + waveOffset + noiseIndex, Peek.b(soundWaveBlock + waveOffset)
  waveOffset = waveOffset + #SOUND_NOISE_LONG_BYTES

  soundNoiseShortOffset = waveOffset
  shiftRegister = 1
  noiseIndex = 0
  While noiseIndex < #SOUND_NOISE_SHORT_BYTES
    lowBit.l = shiftRegister AND 1
    tapBit.l = (shiftRegister/64) AND 1
    feedback.l = Xor(lowBit, tapBit)
    shiftRegister = (shiftRegister/2) OR (feedback*16384)
    If lowBit = 0
      Poke.b soundWaveBlock + waveOffset + noiseIndex, #SOUND_WAVE_LEVEL
    Else
      Poke.b soundWaveBlock + waveOffset + noiseIndex, -#SOUND_WAVE_LEVEL
    EndIf
    noiseIndex = noiseIndex + 1
  Wend
  Function Return True
End Function

;; END OF SOUND (AMIGA MODE)
