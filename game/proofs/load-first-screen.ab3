; /XTRA
;; Proof: LoadBitMap the baked World 1-1 first screen. ESC quits.
;; Folded into sparkydave.init.ab3 / sparkydave.draw.ab3.

WBStartup

#RAW_KEY_ESC = $45
#PLAYFIELD_PLANES = 4
#COPPER_COLORS = 16
#COPPER_YPOS = 44
#COPPER_FLAGS = $10004
#VIEW_W = 320

quitFlag.w = False
scrh.w = 256

scrh = DispHeight
BitMap 0, #VIEW_W, scrh, #PLAYFIELD_PLANES
BitMap 1, #VIEW_W, scrh, #PLAYFIELD_PLANES
InitPalette 0, #COPPER_COLORS
screenIff$ = "sparky-dave:game/assets/world1-1-320x256.iff"
If Exists(screenIff$) > 0
  LoadBitMap 0, screenIff$, 0
  LoadBitMap 1, screenIff$, 0
Else
  AGAPalRGB 0, 0, 92, 148, 252
EndIf
InitCopList 0, #COPPER_YPOS, scrh, #COPPER_FLAGS, 8, #COPPER_COLORS, 0

BLITZ
CreateDisplay 0
DisplayPalette 0, 0
BlitzKeys On

drawBm.w = 0
While quitFlag = False
  If RawStatus(#RAW_KEY_ESC) Then quitFlag = True
  VWait
  DisplayBitMap 0, drawBm
  drawBm = 1 - drawBm
Wend

AMIGA
End
