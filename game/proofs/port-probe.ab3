;; port-probe.ab3 -- both joystick ports, read every way the game could read them, live on screen. Compile in UAE (run-proof), or boot
;; it on the A500 Mini from its own disk (python tools/make_port_probe_adf.py). Not part of the game.
;;
;; The questions, for the controls rework (every control live all the time, both ports, a CD32 pad found by itself):
;;   1. Which port does a pad land in? The A500 Mini puts its pad in "port 1", its first non-mouse port, and the game reads only the
;;      Amiga's port 2 (the joystick port, Blitz port 1).
;;   2. Can the mouse port be read as a joystick, and a mouse told from one? Both move the counters in JOYxDAT (X the low byte, Y the
;;      high): the first UAE run showed a joystick stepping each by one a direction change, and a mouse by several a frame; Amiga
;;      Forever stepped a stick by two once (down to right in one frame). MOUSE lights SEEN, for either port, once a counter has stepped
;;      by more than two between two frames (#MOUSE_STEP), and stays lit.
;;   3. Can a CD32 pad be told from a stick? The pad is read here as Gameb reads it (the mode line low, then read and clock), but for
;;      ten bits, not seven: the first seven are the buttons (blue, red, yellow, green, forward, reverse, play), and lowlevel.library
;;      tells a pad by the bits after them. A stick gives nothing on the data line with its second button up, and all ones with it held.
;; Blitz's Gameb is not used: on port 0 its loop runs on into port 1's code and ends by writing port 1's POTGO value
;; (AmiBlitz3/Sourcecodes/Amiblitz3/BlitzLibs/Blitzlibs/gameiolib.ab3, .do_gameb).
;;
;; THE SCREEN, one column a port (PORT 1 is the mouse port, PORT 2 the joystick port, as the Amiga's case labels them):
;;   STICK    L R U D as Joyx and Joyy see it, - for not held
;;   BUTTONS  1 2 as Joyb sees them
;;   JOYDAT   the raw JOY0DAT or JOY1DAT word, in hex
;;   PAD      the ten bits clocked out, the first on the left, 1 for the data line low (pressed)
;;   MOUSE    SEEN once a counter has stepped by more than #MOUSE_STEP in a frame
;;   PAD WAIT the way the pad is read, W to step through them: 0 as Gameb (no wait), 1 a scanline's wait after the mode line goes
;;            low, 2 a scanline's wait before every bit as well
;;   SEEN     for each way, how many frames port 2 read with a pad's signature (the 8th bit high, the 9th low), of how many read
;; Esc quits and writes the results: every change, with the frame and both ports' readings, and the SEEN counts.
;; Amiga Forever (2026-11-10) read a pad still on the desk as a pad in only some frames, and as nothing at all (all ten bits high,
;; a stick) in the others; FS-UAE read it the same every frame. The waits test whether it is the pad read too soon after the mode
;; line, before the emulator has seen it change.
;; In UAE, plug the pad in before starting the emulator: it does not see one plugged in while it runs, until it is restarted from
;; its launcher (the main project's INPUT note).
;;
;; WHAT TO DO, once for each device in each port (a stick, a CD32 pad, the A500 Mini's pad, a mouse in port 1):
;;   1. Leave it alone for two seconds.
;;   2. Each direction in turn, then each button in turn (on a pad: blue, red, yellow, green, the two shoulders, play).
;;   3. Esc. Say which device was in which port (and, on the A500 Mini, what its Game settings for the disk said).

WBStartup

#RAW_KEY_ESC        = $45
#PAD_BITS           = 10
#MAX_LOG            = 600
#MOUSE_STEP         = 2
#RAW_KEY_W          = $11
#PAD_WAIT_MODES     = 3
#VHPOSR             = $dff006
#CIAA_PRA           = $bfe001
#CIAA_DDRA          = $bfe201
#JOY0DAT            = $dff00a
#JOY1DAT            = $dff00c
#POTGOR             = $dff016
#POTGO              = $dff034

;; The results file: the proofs' place in UAE, or the path given as the first argument (the boot disk gives
;; DF0:port-probe-results.txt, as there is no sparky-dave: assign there).
resultsPath$ = "sparky-dave:game/proofs/results/port-probe-results.txt"
If NumPars > 0 Then resultsPath$ = Par$(1)

Dim portStickX.w(1)
Dim portStickY.w(1)
Dim portButtons.w(1)
Dim portJoyData.l(1)
Dim portPadRead.l(1)
Dim lastStickX.w(1)
Dim lastStickY.w(1)
Dim lastButtons.w(1)
Dim lastJoyData.l(1)
Dim lastPadRead.l(1)

Dim logFrame.l(#MAX_LOG - 1)
Dim logStickX0.w(#MAX_LOG - 1)
Dim logStickY0.w(#MAX_LOG - 1)
Dim logButtons0.w(#MAX_LOG - 1)
Dim logJoyData0.l(#MAX_LOG - 1)
Dim logPad0.l(#MAX_LOG - 1)
Dim logStickX1.w(#MAX_LOG - 1)
Dim logStickY1.w(#MAX_LOG - 1)
Dim logButtons1.w(#MAX_LOG - 1)
Dim logJoyData1.l(#MAX_LOG - 1)
Dim logPad1.l(#MAX_LOG - 1)
Dim portMouseSeen.w(1)
Dim padReadCount.l(#PAD_WAIT_MODES - 1)
Dim padSeenCount.l(#PAD_WAIT_MODES - 1)
Dim logWaitMode.w(#MAX_LOG - 1)
Dim logMouseSeen0.w(#MAX_LOG - 1)
Dim logMouseSeen1.w(#MAX_LOG - 1)

;; The bits as text, the first on the left: 1 set, 0 clear.
Function.s BitsText{bits.l, bitCount.w}
  bitsShown$ = ""
  bitMask.l = 1
  For bitIndex.w = 0 To bitCount - 1
    If (bits AND bitMask) <> 0
      bitsShown$ = bitsShown$ + "1"
    Else
      bitsShown$ = bitsShown$ + "0"
    EndIf
    bitMask = bitMask*2
  Next
  Function Return bitsShown$
End Function

;; How far a JOYxDAT counter moved between two reads, the larger of X (the low byte) and Y (the high byte), each taken the short way
;; round, as the counters wrap at 256.
Function.w CounterStep{joyNow.l, joyBefore.l}
  stepX.w = (joyNow AND 255) - (joyBefore AND 255)
  If stepX > 127 Then stepX = stepX - 256
  If stepX < -128 Then stepX = stepX + 256
  stepY.w = ((joyNow AND $ff00)/256) - ((joyBefore AND $ff00)/256)
  If stepY > 127 Then stepY = stepY - 256
  If stepY < -128 Then stepY = stepY + 256
  If stepX < 0 Then stepX = -stepX
  If stepY < 0 Then stepY = -stepY
  If stepY > stepX Then stepX = stepY
  Function Return stepX
End Function

; A word as four hex digits.
Function.s WordText{value.l}
  Function Return Right$(Hex$(value), 4)
End Function

BitMap 0, 320, 200, 4
InitPalette 0, 16
AGAPalRGB 0, 0, 0, 0, 0
AGAPalRGB 0, 1, 255, 255, 255
AGAPalRGB 0, 2, 255, 60, 60
AGAPalRGB 0, 3, 60, 60, 60

BLITZ

InitCopList 0, 44, 200, $10014, 8, 16, 0
CreateDisplay 0
DisplayPalette 0, 0
BlitzKeys On
DisplayBitMap 0, 0, 0, 0

;; Waits for the beam to start a new scanline (VHPOSR's line byte to change), then another, so at least one whole line passes.
Statement WaitLine{}
  lineNow.w = Peek.b(#VHPOSR)
  While Peek.b(#VHPOSR) = lineNow
  Wend
  lineNow = Peek.b(#VHPOSR)
  While Peek.b(#VHPOSR) = lineNow
  Wend
End Statement

;; Whether ten bits read from a port carry a CD32 pad's signature, lowlevel.library's test: the 8th bit high (0 here) and the 9th
;; low (1 here). A stick reads all high, and a stick or mouse with its second button held all low; neither matches.
Function.w PadSignature{padBits.l}
  If (padBits AND $80) <> 0 Then Function Return False
  If (padBits AND $100) = 0 Then Function Return False
  Function Return True
End Function

;; One port read the CD32 way, for #PAD_BITS bits: the fire line (CIA-A PRA bit 7 for port 1, the joystick port; bit 6 for port 0)
;; made an output, low, and the pot line on pin 5 driven low (the pad's shift mode), then each bit read from the pin 9 pot line
;; (POTGOR bit 14 or 10; low is a 1 here) and the fire line pulsed high and low to clock the next out. At the end pin 5 is driven
;; high and the fire line is an input again, as Gameb leaves them.
Function.l ReadPadBits{port.w, waitMode.w}
  clockBit.w = $80
  potDrive.l = $2000
  potEnd.l = $3000
  dataMask.l = $4000
  If port = 0
    clockBit = $40
    potDrive = $0200
    potEnd = $0300
    dataMask = $0400
  EndIf
  Poke.b #CIAA_DDRA, (Peek.b(#CIAA_DDRA) AND 255) OR clockBit
  Poke.b #CIAA_PRA, (Peek.b(#CIAA_PRA) AND 255) AND (255 - clockBit)
  Poke.w #POTGO, potDrive
  If waitMode >= 1 Then WaitLine{}
  padBits.l = 0
  bitMask.l = 1
  For bitIndex.w = 0 To #PAD_BITS - 1
    ; The settle Gameb gives each bit: eight reads of the CIA, each a slow bus cycle.
    For settleIndex.w = 0 To 7
      settleRead.w = Peek.b(#CIAA_PRA)
    Next
    If waitMode >= 2 Then WaitLine{}
    If (Peek.w(#POTGOR) AND dataMask) = 0 Then padBits = padBits OR bitMask
    Poke.b #CIAA_PRA, (Peek.b(#CIAA_PRA) AND 255) OR clockBit
    Poke.b #CIAA_PRA, (Peek.b(#CIAA_PRA) AND 255) AND (255 - clockBit)
    bitMask = bitMask*2
  Next
  Poke.w #POTGO, potEnd
  Poke.b #CIAA_DDRA, (Peek.b(#CIAA_DDRA) AND 255) AND (255 - clockBit)
  Function Return padBits
End Function

; A stick's four directions as text: L R U D, or - for one not held.
Function.s StickText{directionX.w, directionY.w}
  leftShown$ = "-"
  rightShown$ = "-"
  upShown$ = "-"
  downShown$ = "-"
  If directionX < 0 Then leftShown$ = "L"
  If directionX > 0 Then rightShown$ = "R"
  If directionY < 0 Then upShown$ = "U"
  If directionY > 0 Then downShown$ = "D"
  Function Return leftShown$ + " " + rightShown$ + " " + upShown$ + " " + downShown$
End Function

; Joyb's two buttons as text: 1 and 2, or - for one not held.
Function.s ButtonsText{buttonBits.w}
  firstShown$ = "-"
  secondShown$ = "-"
  If (buttonBits AND 1) <> 0 Then firstShown$ = "1"
  If (buttonBits AND 2) <> 0 Then secondShown$ = "2"
  Function Return firstShown$ + " " + secondShown$
End Function

Use BitMap 0
Cls 0
BitMapOutput 0
Locate 1, 1
Print "PORT PROBE              ESC QUITS"
Locate 1, 3
Print "          PORT 1 MOUSE    PORT 2 JOY"
Locate 1, 5
Print "STICK"
Locate 1, 6
Print "BUTTONS"
Locate 1, 7
Print "JOYDAT"
Locate 1, 8
Print "PAD"
Locate 1, 9
Print "MOUSE"
Locate 1, 10
Print "PAD WAIT"
Locate 1, 11
Print "SEEN 0"
Locate 1, 12
Print "SEEN 1"
Locate 1, 13
Print "SEEN 2"
Locate 1, 15
Print "PAD: BLUE RED YELLOW GREEN FWD REV PLAY,"
Locate 1, 16
Print "THEN THREE MORE. 1 = LINE LOW."
Locate 1, 17
Print "W: THE NEXT PAD WAIT. SEEN: PORT 2 READ"
Locate 1, 18
Print "AS A PAD, OF FRAMES READ, EACH WAIT."

logCount.w = 0
quitNow.w = False
frameNumber.l = 0
padWaitMode.w = 0
waitKeyHeld.w = False
For waitMode.w = 0 To #PAD_WAIT_MODES - 1
  padReadCount(waitMode) = 0
  padSeenCount(waitMode) = 0
Next
previousJoyData0.l = Peek.w(#JOY0DAT) AND $ffff
previousJoyData1.l = Peek.w(#JOY1DAT) AND $ffff
For port.w = 0 To 1
  portMouseSeen(port) = False
  lastStickX(port) = 99
  lastStickY(port) = 99
  lastButtons(port) = 99
  lastJoyData(port) = -1
  lastPadRead(port) = -1
Next

Repeat
  VWait
  frameNumber = frameNumber + 1
  If RawStatus(#RAW_KEY_ESC) Then quitNow = True
  If RawStatus(#RAW_KEY_W)
    If waitKeyHeld = False
      padWaitMode = padWaitMode + 1
      If padWaitMode >= #PAD_WAIT_MODES Then padWaitMode = 0
    EndIf
    waitKeyHeld = True
  Else
    waitKeyHeld = False
  EndIf

  ;; The library's reads first (Joyb on port 1 writes POTGO itself), then the raw words, then the pad reads, which drive the lines
  ;; and put them back.
  For port = 0 To 1
    portStickX(port) = Joyx(port)
    portStickY(port) = Joyy(port)
    portButtons(port) = Joyb(port)
  Next
  portJoyData(0) = Peek.w(#JOY0DAT) AND $ffff
  portJoyData(1) = Peek.w(#JOY1DAT) AND $ffff
  portPadRead(0) = ReadPadBits{0, padWaitMode}
  portPadRead(1) = ReadPadBits{1, padWaitMode}
  padReadCount(padWaitMode) = padReadCount(padWaitMode) + 1
  If PadSignature{portPadRead(1)} <> False Then padSeenCount(padWaitMode) = padSeenCount(padWaitMode) + 1
  If CounterStep{portJoyData(0), previousJoyData0} > #MOUSE_STEP Then portMouseSeen(0) = True
  If CounterStep{portJoyData(1), previousJoyData1} > #MOUSE_STEP Then portMouseSeen(1) = True
  previousJoyData0 = portJoyData(0)
  previousJoyData1 = portJoyData(1)

  Locate 11, 5
  Print StickText{portStickX(0), portStickY(0)}, "         ", StickText{portStickX(1), portStickY(1)}
  Locate 11, 6
  Print ButtonsText{portButtons(0)}, "             ", ButtonsText{portButtons(1)}
  Locate 11, 7
  Print WordText{portJoyData(0)}, "            ", WordText{portJoyData(1)}
  Locate 11, 8
  Print BitsText{portPadRead(0), #PAD_BITS}, "      ", BitsText{portPadRead(1), #PAD_BITS}
  Locate 11, 9
  For port = 0 To 1
    If portMouseSeen(port) <> False
      Print "SEEN            "
    Else
      Print "-               "
    EndIf
  Next
  Locate 11, 10
  Print padWaitMode
  For waitMode = 0 To #PAD_WAIT_MODES - 1
    Locate 11, 11 + waitMode
    Print padSeenCount(waitMode), " / ", padReadCount(waitMode), "    "
  Next

  changed.w = False
  If logCount > 0
    If logWaitMode(logCount - 1) <> padWaitMode Then changed = True
  EndIf
  For port = 0 To 1
    If portStickX(port) <> lastStickX(port) OR portStickY(port) <> lastStickY(port) Then changed = True
    If portButtons(port) <> lastButtons(port) OR portJoyData(port) <> lastJoyData(port) OR portPadRead(port) <> lastPadRead(port) Then changed = True
    lastStickX(port) = portStickX(port)
    lastStickY(port) = portStickY(port)
    lastButtons(port) = portButtons(port)
    lastJoyData(port) = portJoyData(port)
    lastPadRead(port) = portPadRead(port)
  Next
  If changed <> False AND logCount < #MAX_LOG
    logFrame(logCount) = frameNumber
    logWaitMode(logCount) = padWaitMode
    logStickX0(logCount) = portStickX(0)
    logStickY0(logCount) = portStickY(0)
    logButtons0(logCount) = portButtons(0)
    logJoyData0(logCount) = portJoyData(0)
    logPad0(logCount) = portPadRead(0)
    logStickX1(logCount) = portStickX(1)
    logStickY1(logCount) = portStickY(1)
    logButtons1(logCount) = portButtons(1)
    logJoyData1(logCount) = portJoyData(1)
    logPad1(logCount) = portPadRead(1)
    logMouseSeen0(logCount) = portMouseSeen(0)
    logMouseSeen1(logCount) = portMouseSeen(1)
    logCount = logCount + 1
  EndIf
Until quitNow <> False

AMIGA

If WriteFile(0, resultsPath$)
  FileOutput 0
  NPrint "port-probe"
  For waitMode = 0 To #PAD_WAIT_MODES - 1
    NPrint "pad wait ", waitMode, ": port 2 read as a pad in ", padSeenCount(waitMode), " of ", padReadCount(waitMode), " frames"
  Next
  NPrint "frame, pad wait | port 1 (mouse port): stick, buttons, JOY0DAT, pad bits, mouse seen | port 2 (joystick port): the same"
  For logIndex.w = 0 To logCount - 1
    mouseShown0$ = "-"
    If logMouseSeen0(logIndex) <> False Then mouseShown0$ = "MOUSE"
    mouseShown1$ = "-"
    If logMouseSeen1(logIndex) <> False Then mouseShown1$ = "MOUSE"
    port1$ = StickText{logStickX0(logIndex), logStickY0(logIndex)} + "  " + ButtonsText{logButtons0(logIndex)} + "  $" + WordText{logJoyData0(logIndex)} + "  " + BitsText{logPad0(logIndex), #PAD_BITS} + "  " + mouseShown0$
    port2$ = StickText{logStickX1(logIndex), logStickY1(logIndex)} + "  " + ButtonsText{logButtons1(logIndex)} + "  $" + WordText{logJoyData1(logIndex)} + "  " + BitsText{logPad1(logIndex), #PAD_BITS} + "  " + mouseShown1$
    NPrint logFrame(logIndex), " w", logWaitMode(logIndex), " | ", port1$, " | ", port2$
  Next
  If logCount >= #MAX_LOG Then NPrint "(the log filled at ", #MAX_LOG, " changes)"
  CloseFile 0
EndIf

End
