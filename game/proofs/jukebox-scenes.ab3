Data.w 181, 50, 32
;; front set 3 (look set 5)
Data.w 0, 0, 0
Data.w 174, 174, 174
Data.w 254, 254, 254
Data.w 0, 0, 0
Data.w 230, 156, 33
Data.w 82, 33, 0
Data.w 140, 214, 0
