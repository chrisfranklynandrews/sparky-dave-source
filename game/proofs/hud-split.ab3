; XTRA
; Embedded .xtra Header
;
; General Info
; -------------------------------------------------------
; ExePath         = "RAM:"
; ExeFile         = "Prog.exe"
; CreateIcon      = 0
; Residents       = ""
;
; Compiler
; -------------------------------------------------------
; StringBuffer    = 10240
; MakeSmallest    = 0
; FuncOptimize    = 0
; Version         = 0.0.0
; NumberOfBuilds  = 0
;
; Debugger
; -------------------------------------------------------
; CliArgs         = ""
; StackSize       = 32768
; RuntimeDebug    = 0
; DebugInfo       = 0
; CreateDbgFile   = 0
; OverflowCheck   = 1
; AssemblerCheck  = 0
; InterruptCheck  = 1
; AutoRun         = 1
;
; Editor
; -------------------------------------------------------
; CursorLine      = 1
; CursorColumn    = 1
; LabelSearch     = ""
; LabelRemark     = 0
; LabelAll        = 0
; LabelCase       = 0
; LabelPosition   = 0
;
; Blitz Objects
; -------------------------------------------------------
; Max File        = 5
; Max GadgetList  = 5
; Max Shape       = 192
; Max MenuList    = 5
; Max IntuiFont   = 5
; Max BlitzFont   = 4
; Max Bank        = 5
; Max GTList      = 20
; Max IconInfo    = 1
; Max MUIObject   = 50
; Max AsyncReq    = 4
; Max GTMenuList  = 5
; Max Console     = 5
; Max TCPSock     = 5
; Max Tape        = 5
; Max TagList     = 5
; Max Database    = 16
; Max Window      = 20
; Max BitMap      = 10
; Max Screen      = 5
; Max Palette     = 32
; Max Sound       = 10
; Max MedModule   = 8
; Max Buffer      = 10
; Max Queue       = 10
; Max Sprite      = 20
; Max Module      = 5
; Max Slice       = 10
; Max CopList     = 10
; Max PTModule    = 5
; Max Anim        = 10
; Max NChunky     = 50
; Max Chunky      = 20
; Max Stencil     = 5
; Max XBSound     = 10
; Max Page        = 4
; /XTRA
;; hud-split.ab3 -- fixed HUD band over a hardware-scrolled world. Compile in UAE.
;; Not part of the game. Proof for the renderer-engine-architecture-reset plan (git history).
;;
;; Question: can CreateDisplay stack two CopLists, a fixed 16-line HUD list on
;; top and a smooth-scrolling world list below it, with the world panning while
;; the HUD stays put? No raw Copper. DISPLAYLIB says CreateDisplay takes several
;; CopLists in vertical order that must not overlap.
;;
;; CopList 0 = HUD,   y 44..59,   own 320x16 bitmap (bitmap 1), never scrolled.
;; CopList 1 = world, y 60..299,  wide 4-plane bitmap (bitmap 0), 240 lines.
;; CreateDisplay is given the HUD list first (higher on screen).
;;
;; Keys
;;   Left / Right   camera -/+ 2 px
;;   Up / Down      camera +/- 16 px
;;   B              pen 0 magenta (diagnostic) / sky blue (game look)
;;   F              toggle fractional mode: Left/Right then move 0.25 px
;;   Q / W          world list ypos -1 / +1 (rebuilds the display)
;;   Esc            quit
;;
;; What to look at (assertions)
;; 1. HUD band: green left block, white right block, and a white tick every
;;    16 px. Colour 0 (magenta) is never drawn into either bitmap, so magenta
;;    anywhere is border or a gap between the two lists. HUD must not move.
;; 2. Gap: look for a magenta or black strip between HUD and world. Use Q / W to
;;    find the smallest world ypos with no gap and no overlap, and record it.
;; 3. World: white pillars on every 10th tile column, digit bricks between, as
;;    in hw-scroll.ab3. At camX 0 the window shows columns 0..19: two pillars
;;    and no third. HUD ticks must stay on the same pixels as the camera moves.
;; 4. Edges: camMax 3072 ends on the last yellow pixel (x = 3391). Red after
;;    the yellow means the window is wider than 320.
;; 5. Fractional mode (F): scroll should be smooth at 0.25 px per frame, not
;;    stepping once per whole pixel. Note whether the picture visibly changes
;;    between whole pixels; lores may only show whole-pixel steps.
;; 6. Hold Right for several seconds: no tearing at the HUD/world boundary and
;;    no one-frame lag between the two.
;; On exit the proof writes hud-split-results.txt next to this file: free Chip
;; RAM at launch, after the bitmaps, and at exit, plus the final world ypos.

WBStartup

;; =======================================================
;; CONSTANTS
;; =======================================================

#RAW_KEY_B     = $35
#RAW_KEY_F     = $23
#RAW_KEY_Q     = $10
#RAW_KEY_W     = $11
#RAW_KEY_UP    = $4c
#RAW_KEY_DOWN  = $4d
#RAW_KEY_ESC   = $45
#RAW_KEY_RIGHT = $4e
#RAW_KEY_LEFT  = $4f

;; $4 + $10 + $10000 = 4 planes, smooth scroll, AGA palette.
#COPPER_COLORS = 16
#COPPER_FLAGS  = $10014
#HUD_YPOS   = 44
#HUD_H      = 16
#WORLD_H    = 240

#TILE     = 16
#COLS     = 213
#VIEW_W   = 320
#BM_W     = 3408
#STEP     = 2
#STEP_FAST = 16
;; 213*16 = 3408. 3072+320 = 3392 (first poison pixel). 3072+336 = 3408 (end).
#CAM_MAX  = 3072

;; =======================================================
;; GLOBALS
;; =======================================================

quitFlag.w = False
fracMode.w = False
fLock.w = False
qLock.w = False
wLock.w = False
bLock.w = False
palNum.w = 0
worldYpos.w = #HUD_YPOS + #HUD_H + 3
camX.q = 0
camMax.q = #CAM_MAX
col.w = 0
tileX.w = 0
pen.w = 0
memStart.l = 0
memAlloc.l = 0
memEnd.l = 0
memStartBig.l = 0
memAllocBig.l = 0
memEndBig.l = 0

;; =======================================================
;; ALLOC (AMIGA MODE)
;; =======================================================

;; exec AvailMem: 2 = MEMF_CHIP, $20002 = MEMF_CHIP + MEMF_LARGEST.
memStart = AvailMem_(2)
memStartBig = AvailMem_($20002)
BitMap 0, #BM_W, #WORLD_H, 4
BitMap 1, #VIEW_W, #HUD_H, 4
memAlloc = AvailMem_(2)
memAllocBig = AvailMem_($20002)
InitPalette 0, #COPPER_COLORS
;; 0 border (never drawn). 1 sky. 2 white pillar. 3 yellow end. 4 red poison.
;; 5 green. 6..14 digit bricks. 15 red-pink ground.
AGAPalRGB 0, 0, 255, 0, 255
AGAPalRGB 0, 1, 92, 148, 252
AGAPalRGB 0, 2, 255, 255, 255
AGAPalRGB 0, 3, 255, 220, 0
AGAPalRGB 0, 4, 220, 0, 0
AGAPalRGB 0, 5, 0, 200, 0
AGAPalRGB 0, 6, 0, 70, 170
AGAPalRGB 0, 7, 0, 150, 40
AGAPalRGB 0, 8, 170, 70, 0
AGAPalRGB 0, 9, 160, 0, 160
AGAPalRGB 0, 10, 0, 160, 160
AGAPalRGB 0, 11, 170, 170, 0
AGAPalRGB 0, 12, 70, 70, 220
AGAPalRGB 0, 13, 230, 120, 0
AGAPalRGB 0, 14, 190, 190, 190
AGAPalRGB 0, 15, 255, 60, 60
InitPalette 1, #COPPER_COLORS
;; Palette 1: identical, but pen 0 (border and gap) is the game sky blue.
AGAPalRGB 1, 0, 92, 148, 252
AGAPalRGB 1, 1, 92, 148, 252
AGAPalRGB 1, 2, 255, 255, 255
AGAPalRGB 1, 3, 255, 220, 0
AGAPalRGB 1, 4, 220, 0, 0
AGAPalRGB 1, 5, 0, 200, 0
AGAPalRGB 1, 6, 0, 70, 170
AGAPalRGB 1, 7, 0, 150, 40
AGAPalRGB 1, 8, 170, 70, 0
AGAPalRGB 1, 9, 160, 0, 160
AGAPalRGB 1, 10, 0, 160, 160
AGAPalRGB 1, 11, 170, 170, 0
AGAPalRGB 1, 12, 70, 70, 220
AGAPalRGB 1, 13, 230, 120, 0
AGAPalRGB 1, 14, 190, 190, 190
AGAPalRGB 1, 15, 255, 60, 60

;; =======================================================
;; DISPLAY (BLITZ MODE)
;; =======================================================

BLITZ

Statement ApplyDisplay{}
  SHARED camX, worldYpos, palNum
  InitCopList 0, #HUD_YPOS, #HUD_H, #COPPER_FLAGS, 8, #COPPER_COLORS, 0
  InitCopList 1, worldYpos, #WORLD_H, #COPPER_FLAGS, 8, 0, 0
  CreateDisplay 0, 1
  DisplayPalette 0, palNum
  BlitzKeys On
  DisplayBitMap 0, 1, 0, 0
  DisplayBitMap 1, 0, camX, 0
End Statement

;; HUD bitmap. Sky background, green left block, white right block, and a white
;; tick every 16 px so any horizontal movement of the band is obvious.
Use BitMap 1
Cls 1
Boxf 0, 0, 31, #HUD_H - 1, 5
Boxf #VIEW_W - 32, 0, #VIEW_W - 1, #HUD_H - 1, 2
For col = 2 To 17
  Boxf col*16, 12, col*16, #HUD_H - 1, 2
Next
Boxf 0, 0, #VIEW_W - 1, 0, 2
Boxf 0, #HUD_H - 1, #VIEW_W - 1, #HUD_H - 1, 2

;; World bitmap, same pattern as hw-scroll.ab3.
Use BitMap 0
Cls 1
For col = 0 To #COLS - 1
  tileX = col*#TILE
  If (col MOD 10) = 0
    Boxf tileX, 0, tileX + 15, 120, 2
  Else
    pen = 5 + (col MOD 10)
    Boxf tileX + 1, 64, tileX + 14, 96, pen
  EndIf
  pen = 6
  If (col MOD 2) = 1 Then pen = 15
  Boxf tileX, 204, tileX + 15, #WORLD_H - 1, pen
Next
Boxf 3360, 0, 3391, #WORLD_H - 1, 3
Boxf 3392, 0, #BM_W - 1, #WORLD_H - 1, 4
Boxf 0, 0, 3, #WORLD_H - 1, 5

ApplyDisplay{}

While quitFlag = False
  If RawStatus(#RAW_KEY_ESC) Then quitFlag = True

  ;; Edge-triggered toggles and ypos nudges.
  If RawStatus(#RAW_KEY_B)
    If bLock = False
      bLock = True
      If palNum = 0
        palNum = 1
      Else
        palNum = 0
      EndIf
      DisplayPalette 0, palNum
        EndIf
  Else
    bLock = False
  EndIf
  If RawStatus(#RAW_KEY_F)
    If fLock = False
      fLock = True
      If fracMode = True
        fracMode = False
      Else
        fracMode = True
      EndIf
    EndIf
  Else
    fLock = False
  EndIf
  If RawStatus(#RAW_KEY_Q)
    If qLock = False
      qLock = True
      worldYpos = worldYpos - 1
      ApplyDisplay{}
    EndIf
  Else
    qLock = False
  EndIf
  If RawStatus(#RAW_KEY_W)
    If wLock = False
      wLock = True
      worldYpos = worldYpos + 1
      ApplyDisplay{}
    EndIf
  Else
    wLock = False
  EndIf

  If fracMode = True
    If RawStatus(#RAW_KEY_RIGHT) Then camX = camX + 0.25
    If RawStatus(#RAW_KEY_LEFT) Then camX = camX - 0.25
  Else
    If RawStatus(#RAW_KEY_RIGHT) Then camX = camX + #STEP
    If RawStatus(#RAW_KEY_LEFT) Then camX = camX - #STEP
  EndIf
  If RawStatus(#RAW_KEY_UP) Then camX = camX + #STEP_FAST
  If RawStatus(#RAW_KEY_DOWN) Then camX = camX - #STEP_FAST
  If camX < 0 Then camX = 0
  If camX > camMax Then camX = camMax
  VWait
  DisplayBitMap 1, 0, camX, 0
Wend

AMIGA
;; Display torn down, bitmaps and coplists still allocated: this is the peak.
memEnd = AvailMem_(2)
memEndBig = AvailMem_($20002)
If WriteFile(0, "sparky-dave:game/proofs/results/hud-split-results.txt")
  FileOutput 0
  NPrint "hud-split chip RAM (bytes)"
  NPrint ""
  NPrint "                  free chip   largest block"
  NPrint "launch         ", memStart, "  ", memStartBig
  NPrint "after bitmaps  ", memAlloc, "  ", memAllocBig
  NPrint "at exit        ", memEnd, "  ", memEndBig
  NPrint ""
  NPrint "bitmaps cost    ", memStart - memAlloc
  NPrint "display+palette ", memAlloc - memEnd
  NPrint "total used      ", memStart - memEnd
  NPrint ""
  NPrint "world ypos at exit: ", worldYpos
  NPrint "palette at exit: ", palNum
  If fracMode = True
    NPrint "fractional mode on at exit"
  Else
    NPrint "fractional mode off at exit"
  EndIf
  CloseFile 0
EndIf
End
