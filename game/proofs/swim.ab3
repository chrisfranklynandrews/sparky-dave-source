Statement EnsureTileSet{}
End Statement
XINCLUDE "/includes/sparkydave.cover.blitz.ab3"

;; ---------------------------------------------------------------
;; The two sets
;; ---------------------------------------------------------------

;; Set 1 is set 0 scaled to 50 ticks a second: a force is per tick squared (x1.44), a speed per tick (x1.2),
;; a timer in ticks (x5/6). A speed is the cartridge's whole pixels and a fraction of 256 carried in the move
;; force, so -1.5 (-2 and $80) becomes -1.8 (-2 and $33) and -1 (-1 and $00) becomes -1.2 (-2 and $cd). The
;; whirlpool's top speed (1) and its sideways pixel every other tick stay.
Statement SelectSwimSet{setIndex.w}
  SHARED swimSet, swimRiseForce, swimFallForce, swimSpeed, swimInitForce, whirlRiseForce, whirlFallForce
  SHARED whirlSpeed, whirlInitForce, swimSurfaceForce, swimTimerTicks, whirlPullForce
  swimSet = setIndex
  If setIndex = #SWIM_SET_LISTING
    swimRiseForce = $0d
    swimFallForce = $0a
    swimSpeed = -2
    swimInitForce = $80
    whirlRiseForce = $04
    whirlFallForce = $09
    whirlSpeed = -1
    whirlInitForce = $00
    swimSurfaceForce = $18
    swimTimerTicks = $20
    whirlPullForce = $10
  Else
    swimRiseForce = $13
    swimFallForce = $0e
    swimSpeed = -2
    swimInitForce = $33
    whirlRiseForce = $06
    whirlFallForce = $0d
    whirlSpeed = -2
    whirlInitForce = $cd
    swimSurfaceForce = $23
    swimTimerTicks = 27
    whirlPullForce = $17
  EndIf
End Statement

;; ---------------------------------------------------------------
;; The swim (to fold into sparkydave.player.blitz.ab3)
;; ---------------------------------------------------------------

;; A stroke (ProcJumping and InitJS, smbdis 6066 to 6131, with SwimmingFlag set): a fresh press strokes from the sea
;; floor, and in the water too unless he is still rising from the last one after the stroke timer has run out. In a
;; whirlpool (last tick's Whirlpool_Flag) the weaker stroke. Above the surface he does not rise from it.
Statement ProofTryStartSwim{}
  SHARED playerOnGround, playerButtons, playerButtonsLast, playerY, playerJumpOriginY, playerFractionY
  SHARED playerMoveForceY, playerSpeedY, playerVerticalForce, playerFallForce, jumpSwimTimer, whirlpoolFlag
  SHARED swimRiseForce, swimFallForce, swimSpeed, swimInitForce, whirlRiseForce, whirlFallForce
  SHARED whirlSpeed, whirlInitForce, swimTimerTicks
  jumpNow.w = playerButtons AND #MARIO_BTN_JUMP
  previousJump.w = playerButtonsLast AND #MARIO_BTN_JUMP
  If jumpNow = 0 Then Statement Return
  If previousJump <> 0 Then Statement Return
  If playerOnGround = False
    If jumpSwimTimer = 0 AND playerSpeedY < 0 Then Statement Return
  EndIf
  jumpSwimTimer = swimTimerTicks
  playerFractionY = 0
  playerJumpOriginY = playerY
  playerOnGround = False
  If whirlpoolFlag <> False
    playerVerticalForce = whirlRiseForce
    playerFallForce = whirlFallForce
    playerMoveForceY = whirlInitForce
    playerSpeedY = whirlSpeed
  Else
    playerVerticalForce = swimRiseForce
    playerFallForce = swimFallForce
    playerMoveForceY = swimInitForce
    playerSpeedY = swimSpeed
  EndIf
  SoundSquare1{#SFX_ENEMY_STOMP}
  If playerY < #SWIM_SURFACE_Y Then playerSpeedY = 0
End Statement

;; The horizontal limits in water (X_Physics, 6132): in the water the land's air rows; on the sea floor the third
;; row (ProcPRun branches past the run for a water area), which only water uses, and no running timer.
Statement ProofSetupSwimLimits{}
  SHARED playerOnGround, playerSpeedAbsolute, playerRunningSpeed, playerMaximumLeft, playerMaximumRight
  SHARED playerFrictionLow, playerFrictionHigh, playerFacingDirection, playerMovingDirection, seaFloorMax
  If playerOnGround = False
    SetupHorizontalLimits{}
    Statement Return
  EndIf
  frictionBand.w = 1
  If playerRunningSpeed <> 0 Then frictionBand = 2
  If playerSpeedAbsolute >= #MARIO_SPD_FASTFRIC Then frictionBand = 2
  playerMaximumRight = seaFloorMax
  playerMaximumLeft = 0 - seaFloorMax
  playerFrictionLow = #MARIO_FRIC_WALK
  If frictionBand = 2 Then playerFrictionLow = #MARIO_FRIC_TURN
  playerFrictionHigh = #MARIO_FRIC_HIGH
  If playerFacingDirection <> playerMovingDirection
    playerFrictionLow = playerFrictionLow*2
    playerFrictionHigh = playerFrictionHigh*2
    If playerFrictionLow >= 256
      playerFrictionLow = playerFrictionLow - 256
      playerFrictionHigh = playerFrictionHigh + 1
    EndIf
  EndIf
End Statement

;; GetPlayerAnimSpeed runs in the water too (ProcSwim, 5938): the frame timing, the running-speed latch and the
;; turn on the spot under #MARIO_SPD_SKIDSTOP. PrepareGroundMotion{} is it, gated on the ground; this is the same
;; with no gate.
Statement ProofSwimAnimSpeed{}
  SHARED playerOnGround, playerSpeedAbsolute, playerRunningSpeed, playerAnimPeriod
  SHARED playerButtons, playerMovingDirection, playerFacingDirection, playerSpeedX, playerMoveForceX
  If playerOnGround = True
    PrepareGroundMotion{}
    Statement Return
  EndIf
  If playerSpeedAbsolute >= #MARIO_SPD_RUNFLAG
    playerRunningSpeed = playerSpeedAbsolute
    playerAnimPeriod = #MARIO_ANIM_FAST
    Statement Return
  EndIf
  playerAnimPeriod = #MARIO_ANIM_SLOW
  If playerSpeedAbsolute >= #MARIO_SPD_ANIM Then playerAnimPeriod = #MARIO_ANIM_MID
  heldBits.w = playerButtons AND ($7f - #MARIO_BTN_FIRE)
  If heldBits = 0 Then Statement Return
  directionBits.w = playerButtons AND (#MARIO_BTN_LEFT + #MARIO_BTN_RIGHT)
  If directionBits = playerMovingDirection
    playerRunningSpeed = 0
    Statement Return
  EndIf
  If playerSpeedAbsolute < #MARIO_SPD_SKIDSTOP
    playerMovingDirection = playerFacingDirection
    playerSpeedX = 0
    playerMoveForceX = 0
    playerSpeedAbsolute = 0
  EndIf
End Statement

;; In the water he turns to face the way pressed (ProcSwim's LRWater, 5945); on land only on the ground.
Statement ProofApplySwimFacing{}
  SHARED playerButtons, playerFacingDirection, playerFacing
  directionBits.w = playerButtons AND (#MARIO_BTN_LEFT + #MARIO_BTN_RIGHT)
  If directionBits = 0 Then Statement Return
  playerFacingDirection = directionBits
  If playerFacingDirection = #MARIO_BTN_LEFT Then playerFacing = #MARIO_FACE_LEFT
  If playerFacingDirection = #MARIO_BTN_RIGHT Then playerFacing = #MARIO_FACE_RIGHT
End Statement

;; JumpSwimSub (5922): the stroke's rise force while the button is held or he has not yet risen a pixel, else the
;; fall force; and above the surface the surface force, whatever he is doing (ProcSwim, 5939).
Statement ProofSelectSwimForce{}
  SHARED playerOnGround, playerY, playerVerticalForce, swimSurfaceForce
  If playerOnGround = True Then Statement Return
  SelectVerticalForce{}
  If playerY < #SWIM_SURFACE_Y Then playerVerticalForce = swimSurfaceForce
End Statement

;; The head in water (PlayerBGCollision, 11950 to 11973): no block is bumped or broken; a solid metatile plays the
;; bump; either way the rise stops. The cartridge's NTSC listing sets the speed to 1, down; the PAL listing's fix
;; (NYSpd, its 11959) sets 0 in water, which both our builds take (the user, 2026-10-21).
Statement CheckSwimHead{}
  SHARED playerX, playerY, playerSpeedY
  If playerSpeedY >= 0 Then Statement Return
  If playerY < #MT_HEAD_MIN_Y Then Statement Return
  If (playerY AND $0f) < #MT_HEAD_MIN_SUBTILE Then Statement Return
  blockClass.w = MetatileAt{playerX + #PROBE_TOP_X, playerY + #PROBE_TOP_Y}
  If blockClass = #MT_EMPTY Then Statement Return
  If blockClass <> #MT_BRICK AND blockClass <> #MT_QUESTION Then SoundSquare1{#SFX_BUMP}
  playerSpeedY = 0
End Statement

;; ImposeGravity (7704) for the player with a force and a top speed of its own: MovePlayerVertical{}'s step, which
;; is the same with the vertical force and #MARIO_FALL_MAX. (Folded in, MovePlayerVertical{} becomes a call to it.)
Statement ProofImposePlayerGravity{gravityForce.w, maxSpeed.w}
  SHARED playerY, playerSpeedY, playerMoveForceY, playerFractionY
  playerFractionY = playerFractionY + playerMoveForceY
  yCarry.w = 0
  If playerFractionY >= 256
    playerFractionY = playerFractionY - 256
    yCarry = 1
  EndIf
  playerY = playerY + playerSpeedY + yCarry
  playerMoveForceY = playerMoveForceY + gravityForce
  If playerMoveForceY >= 256
    playerMoveForceY = playerMoveForceY - 256
    playerSpeedY = playerSpeedY + 1
  EndIf
  If playerSpeedY >= maxSpeed
    If playerMoveForceY >= #MARIO_FALL_FRAC
      playerSpeedY = maxSpeed
      playerMoveForceY = 0
    EndIf
  EndIf
End Statement

;; ProcessWhirlpools and WhirlpoolActivate (6494 to 6567), after the player's own move: inside the span (its left
;; edge to its right edge, both in) every other tick a pixel toward the middle (toward the right only if nothing
;; blocks him there), and every tick a second vertical step with the pull's force and a top speed of 1. The flag
;; it sets is the next stroke's.
Statement ProcessWhirlpool{}
  SHARED playerX, playerCollisionBits, whirlpoolFlag, swimFrame, whirlPullForce
  whirlpoolFlag = False
  swimFrame = swimFrame + 1
  If playerX < #WHIRLPOOL_LEFT Then Statement Return
  If playerX > #WHIRLPOOL_LEFT + #WHIRLPOOL_WIDTH Then Statement Return
  centreX.w = #WHIRLPOOL_LEFT + #WHIRLPOOL_WIDTH/2
  If (swimFrame AND 1) <> 0
    If playerX > centreX
      playerX = playerX - 1
    Else
      If (playerCollisionBits AND 1) <> 0 Then playerX = playerX + 1
    EndIf
  EndIf
  ProofImposePlayerGravity{whirlPullForce, 1}
  whirlpoolFlag = True
End Statement

;; One tick in water: the harness's Tick{} (the live UpdatePlayer{}'s order) with the water's routines in the places
;; the cartridge's are. No jump forgiveness in water (a stroke is a stroke), no crouch, no camera (one screen).
Statement SwimTick{buttons.w}
  SHARED playerButtons, playerButtonsLast, playerRunningTimer, sideCollisionTimer, playerOnGround
  SHARED playerCollisionBits, jumpSwimTimer
  If jumpSwimTimer > 0 Then jumpSwimTimer = jumpSwimTimer - 1
  If playerRunningTimer > 0 Then playerRunningTimer = playerRunningTimer - 1
  If sideCollisionTimer > 0 Then sideCollisionTimer = sideCollisionTimer - 1
  playerButtons = buttons
  ApplyCollisionButtonMask{}
  playerCollisionBits = $ff
  SetPlayerAbsoluteSpeed{}
  ProofTryStartSwim{}
  ProofSetupSwimLimits{}
  ProofSwimAnimSpeed{}
  SetPlayerAbsoluteSpeed{}
  ProofApplySwimFacing{}
  ApplyHorizontalFriction{}
  MovePlayerHorizontal{}
  SetPlayerMovingDirection{}
  CheckPlayerSides{}
  SetPlayerAbsoluteSpeed{}
  ProofSelectSwimForce{}
  If playerOnGround = False Then MovePlayerVertical{}
  CheckPlayerFeet{}
  CheckSwimHead{}
  ProcessWhirlpool{}
  playerButtonsLast = playerButtons
End Statement

;; ---------------------------------------------------------------
;; The proof's screen, runs and drawing
;; ---------------------------------------------------------------

Statement SetSwimCell{cellRow.w, cellColumn.w}
  SHARED metatileBuffer()
  metatileBuffer(cellRow*#MAP_W + cellColumn) = #MT_GROUND
End Statement

Statement BuildSwimMap{}
  SHARED metatileBuffer()
  For mapCell = 0 To #MAP_CELLS - 1
    metatileBuffer(mapCell) = #MT_EMPTY
  Next
  For mapColumn = 0 To #WALL_COLUMN
    If mapColumn < #PIT_FIRST OR mapColumn > #PIT_LAST
      SetSwimCell{#FLOOR_ROW, mapColumn}
      SetSwimCell{#FLOOR_ROW + 1, mapColumn}
    EndIf
  Next
  For mapRow = #WATER_TOP_ROW To #FLOOR_ROW - 1
    SetSwimCell{mapRow, #WALL_COLUMN}
  Next
  For mapRow = #PILLAR_TOP To #FLOOR_ROW - 1
    SetSwimCell{mapRow, #PILLAR_COLUMN}
  Next
  For mapColumn = #LEDGE_FIRST To #LEDGE_LAST
    SetSwimCell{#LEDGE_ROW, mapColumn}
  Next
End Statement

;; A standing start: still, in the water, sinking with `fallForce` until the first stroke.
Statement ResetSwimmer{startX.w, startY.w, fallForce.w}
  SHARED playerX, playerY, playerSpeedX, playerMoveForceX, playerFractionX, playerSpeedY, playerMoveForceY
  SHARED playerFractionY, playerOnGround, playerFallForce, playerVerticalForce, playerJumpOriginY, jumpSwimTimer
  SHARED playerButtons, playerButtonsLast, playerRunningSpeed, playerRunningTimer, whirlpoolFlag, swimFrame
  SHARED playerState, playerFacingDirection, playerMovingDirection, playerCollisionBits, sideCollisionTimer
  playerX = startX
  playerY = startY
  playerSpeedX = 0
  playerMoveForceX = 0
  playerFractionX = 0
  playerSpeedY = 0
  playerMoveForceY = 0
  playerFractionY = 0
  playerOnGround = False
  playerFallForce = fallForce
  playerVerticalForce = fallForce
  playerJumpOriginY = startY
  jumpSwimTimer = 0
  playerButtons = 0
  playerButtonsLast = 0
  playerRunningSpeed = 0
  playerRunningTimer = 0
  whirlpoolFlag = False
  swimFrame = 0
  playerState = #PLAYER_ST_FREE
  playerFacingDirection = #MARIO_BTN_RIGHT
  playerMovingDirection = #MARIO_BTN_RIGHT
  playerCollisionBits = $ff
  sideCollisionTimer = 0
End Statement

;; One scripted run of #TRACE_TICKS ticks for the set in use, its x and y each tick into the traces.
Statement RunTrace{traceRun.w}
  SHARED traceX(), traceY(), swimSet, swimFallForce, playerX, playerY
  If traceRun = 0 Then ResetSwimmer{#START_X, 64, #MARIO_GRAV_FALL_INIT}
  If traceRun = 1 OR traceRun = 2 Then ResetSwimmer{#START_X, 128, swimFallForce}
  If traceRun = 3 Then ResetSwimmer{#START_X, 160, swimFallForce}
  If traceRun = 4 Then ResetSwimmer{136, 96, swimFallForce}
  If traceRun = 5 Then ResetSwimmer{#START_X, 48, swimFallForce}
  If traceRun = 6 Then ResetSwimmer{232, 144, swimFallForce}
  traceBase.w = (swimSet*#TRACE_RUNS + traceRun)*#TRACE_TICKS
  For traceTick = 0 To #TRACE_TICKS - 1
    traceButtons.w = 0
    If traceRun = 1 AND traceTick = 0 Then traceButtons = #MARIO_BTN_JUMP
    If traceRun = 2 Then traceButtons = #MARIO_BTN_JUMP
    If traceRun = 3 OR traceRun = 6
      If (traceTick AND 7) = 0 Then traceButtons = #MARIO_BTN_JUMP
    EndIf
    If traceRun = 5
      If (traceTick AND 3) = 0 Then traceButtons = #MARIO_BTN_JUMP
    EndIf
    SwimTick{traceButtons}
    traceX(traceBase + traceTick) = playerX
    traceY(traceBase + traceTick) = playerY
  Next
End Statement

;; The scene that does not move, once, into its own bitmap: the water, the whirlpool's band, the surface and the rock.
Statement DrawSwimScene{}
  SHARED metatileBuffer()
  Use BitMap #SCENE_BM
  Cls 0
  Boxf #WHIRLPOOL_LEFT, #WATER_TOP_ROW*#TILE, #WHIRLPOOL_LEFT + #WHIRLPOOL_WIDTH - 1, #MAP_H*#TILE - 1, 4
  Boxf 0, #WATER_TOP_ROW*#TILE + 5, #VIEW_W - 1, #WATER_TOP_ROW*#TILE + 6, 3
  For sceneRow = 0 To #MAP_H - 1
    For sceneColumn = 0 To #VIEW_TILES_W - 1
      If metatileBuffer(sceneRow*#MAP_W + sceneColumn) <> #MT_EMPTY
        Boxf sceneColumn*#TILE, sceneRow*#TILE, sceneColumn*#TILE + #TILE - 1, sceneRow*#TILE + #TILE - 1, 1
      EndIf
    Next
  Next
End Statement

;; A frame: the scene copied in, Mario's box, the set's colour and the stroke timer's bar.
Statement DrawSwimFrame{}
  SHARED swimDrawBitmap, playerX, playerY, swimSet, jumpSwimTimer
  Use BitMap swimDrawBitmap
  Scroll 0, 0, #VIEW_W, #MAP_H*#TILE, 0, 0, #SCENE_BM
  If playerY > -16 AND playerY < #MAP_H*#TILE
    boxTop.w = playerY + 1
    If boxTop < 0 Then boxTop = 0
    boxBottom.w = playerY + #TILE - 1
    If boxBottom > #MAP_H*#TILE - 1 Then boxBottom = #MAP_H*#TILE - 1
    Boxf playerX + 2, boxTop, playerX + 13, boxBottom, 2
  EndIf
  Boxf 4, 4, 15, 15, 5 + swimSet
  If jumpSwimTimer > 0 Then Boxf 20, 8, 20 + jumpSwimTimer*2, 11, 3
End Statement

;; ---------------------------------------------------------------
;; Run
;; ---------------------------------------------------------------

BuildSwimMap{}
For setRun = #SWIM_SET_LISTING To #SWIM_SET_SCALED
  SelectSwimSet{setRun}
  For traceRun = 0 To #TRACE_RUNS - 1
    RunTrace{traceRun}
  Next
Next

DrawSwimScene{}
SelectSwimSet{#SWIM_SET_LISTING}
ResetSwimmer{#START_X, #START_Y, #MARIO_GRAV_FALL_INIT}
While quitFlag = False
  buttons.w = 0
  If RawStatus(#RAW_KEY_LEFT) Then buttons = #MARIO_BTN_LEFT
  If RawStatus(#RAW_KEY_RIGHT) Then buttons = buttons OR #MARIO_BTN_RIGHT
  If RawStatus(#RAW_KEY_JUMP) Then buttons = buttons OR #MARIO_BTN_JUMP
  restartNow.w = False
  keyNow.w = RawStatus(#RAW_KEY_F1)
  If keyNow <> False AND lastF1 = False
    SelectSwimSet{1 - swimSet}
    restartNow = True
  EndIf
  lastF1 = keyNow
  keyNow = RawStatus(#RAW_KEY_F2)
  If keyNow <> False AND lastF2 = False Then restartNow = True
  lastF2 = keyNow
  If restartNow = True Then ResetSwimmer{#START_X, #START_Y, #MARIO_GRAV_FALL_INIT}
  SwimTick{buttons}
  If playerY > #RESTART_Y Then ResetSwimmer{#START_X, #START_Y, #MARIO_GRAV_FALL_INIT}
  DrawSwimFrame{}
  VWait
  DisplayBitMap 0, swimDrawBitmap
  swimDrawBitmap = 1 - swimDrawBitmap
  If RawStatus(#RAW_KEY_ESC) Then quitFlag = True
Wend

AMIGA
If WriteFile(0, "sparky-dave:game/proofs/results/swim-results.txt")
  FileOutput 0
  NPrint "Swim proof results"
  NPrint "Physics variant: ", #SIM_HZ, " ticks a second; sea floor top speed ", seaFloorMax, "; start fall force ", #MARIO_GRAV_FALL_INIT
  For setReport = #SWIM_SET_LISTING To #SWIM_SET_SCALED
    SelectSwimSet{setReport}
    NPrint ""
    If setReport = #SWIM_SET_LISTING
      NPrint "Set 0, the PAL listing's (the NTSC numbers):"
    Else
      NPrint "Set 1, scaled to 50 ticks a second:"
    EndIf
    NPrint "  stroke rise ", swimRiseForce, " fall ", swimFallForce, " speed ", swimSpeed, " start force ", swimInitForce
    NPrint "  whirlpool stroke rise ", whirlRiseForce, " fall ", whirlFallForce, " speed ", whirlSpeed, " start force ", whirlInitForce
    NPrint "  surface force ", swimSurfaceForce, " stroke timer ", swimTimerTicks, " whirlpool pull ", whirlPullForce
    For runReport = 0 To #TRACE_RUNS - 1
      reportBase.w = (setReport*#TRACE_RUNS + runReport)*#TRACE_TICKS
      Print "  run ", runReport, " y:"
      For tickReport = 0 To #TRACE_TICKS - 1
        Print " ", traceY(reportBase + tickReport)
      Next
      NPrint ""
      If runReport = 4
        Print "  run 4 x:"
        For tickReport = 0 To #TRACE_TICKS - 1
          Print " ", traceX(reportBase + tickReport)
        Next
        NPrint ""
      EndIf
    Next
  Next
  CloseFile 0
EndIf
End
