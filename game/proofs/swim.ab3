Dim traceX.w(2*#TRACE_RUNS*#TRACE_TICKS - 1)
Dim traceY.w(2*#TRACE_RUNS*#TRACE_TICKS - 1)

mapWidth.w = #MAP_W
quitFlag.w = False
screenHeight = DispHeight

;; The swim's own state: the cartridge's JumpSwimTimer and Whirlpool_Flag, and its FrameCounter for the
;; whirlpool's every-other-frame pull.
;; (jumpSwimTimer and whirlpoolFlag are the engine's, globals.ab3, since the fold.)
swimFrame.w = 0
;; The set in use: a stroke (JumpMForceData, FallMForceData, PlayerYSpdData and InitMForceData, entry 5),
;; a stroke in a whirlpool (entry 6), the force above the surface, the stroke timer and the whirlpool's pull.
swimSet.w = #SWIM_SET_LISTING
swimRiseForce.w = 0
swimFallForce.w = 0
swimSpeed.w = 0
swimInitForce.w = 0
whirlRiseForce.w = 0
whirlFallForce.w = 0
whirlSpeed.w = 0
whirlInitForce.w = 0
swimSurfaceForce.w = 0
swimTimerTicks.w = 0
whirlPullForce.w = 0
;; The sea floor's top speed (MaxLeftXSpdData and MaxRightXSpdData, entry 2, only a water area's): the PAL
;; listing's 19, the NTSC one's 16.
seaFloorMax.w = 16
If #SIM_HZ = 50 Then seaFloorMax = 19
swimDrawBitmap.w = 0
lastF1.w = False
lastF2.w = False

InitPalette 0, #COPPER_COLORS
AGAPalRGB 0, 0, 66, 64, 254
AGAPalRGB 0, 1, 0, 168, 0
AGAPalRGB 0, 2, 220, 0, 0
AGAPalRGB 0, 3, 252, 252, 252
AGAPalRGB 0, 4, 30, 30, 160
AGAPalRGB 0, 5, 252, 152, 56
AGAPalRGB 0, 6, 200, 0, 200
AGAPalRGB 0, 7, 0, 0, 0
BitMap 0, #VIEW_W, screenHeight, #PLAYFIELD_PLANES
BitMap 1, #VIEW_W, screenHeight, #PLAYFIELD_PLANES
BitMap #SCENE_BM, #VIEW_W, screenHeight, #PLAYFIELD_PLANES

BLITZ
InitCopList 0, #COPPER_FLAGS
CreateDisplay 0
DisplayPalette 0, 0
BlitzKeys On

XINCLUDE "/includes/sparkydave.beam.blitz.ab3"
