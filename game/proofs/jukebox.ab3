;; =======================================================
;; ALLOCATION (AMIGA MODE)
;; =======================================================

;; The back bitmap holds two pages of #PAGE_W side by side; the front is a blank cover.
BitMap #BACK_BM, #PAGE_W*2 + #FETCH_GUARD, #WORLD_H, #PLAYFIELD_PLANES
BitMap #COVER_BM, #VIEW_W + #FETCH_GUARD, #WORLD_H, #PLAYFIELD_PLANES
BitMap #HUD_BAND_BM, #VIEW_W + #FETCH_GUARD, #HUD_H, #PLAYFIELD_PLANES
BitMap #MARIO_BM, #MARIO_SHEET_W, #TILE, #PLAYFIELD_PLANES
BitMap #ITEMS_BM, #ITEMS_SHEET_W, #ITEMS_SHEET_H, #PLAYFIELD_PLANES
BitMap #ENEMIES_BM, #ENEMIES_SHEET_W, #ENEMIES_SHEET_H, #PLAYFIELD_PLANES
BitMap #HUD_BM, #HUD_SHEET_W, 8, #PLAYFIELD_PLANES
BitMap #SCENE_BM, #VIEW_W, 256, #PLAYFIELD_PLANES

LoadBitMap #MARIO_BM, "sparky-dave:game/assets/mario-small.iff"
LoadBitMap #ITEMS_BM, "sparky-dave:game/assets/items-16x16.iff"
LoadBitMap #ENEMIES_BM, "sparky-dave:game/assets/enemies.iff"
LoadBitMap #HUD_BM, "sparky-dave:game/assets/hud-objects.iff"
LoadBitMap #SCENE_BM, "sparky-dave:game/assets/world1-1-320x256.iff"
InitShape #SCENE_SHAPE, #VIEW_W, #SCENE_H, #PLAYFIELD_PLANES

For hudGlyph.w = 0 To #HUD_GLYPHS - 1
  InitShape #HUD_SHAPE_BASE + hudGlyph, 8, 8, #PLAYFIELD_PLANES
Next
InitShape #PRE_SMALL_R + #MARIO_F_JUMP, #TILE, #TILE, #PLAYFIELD_PLANES
InitShape #PRE_SMALL_R + #MARIO_F_IDLE, #TILE, #TILE, #PLAYFIELD_PLANES
InitShape #PRE_GOOMBA, #TILE, #TILE, #PLAYFIELD_PLANES
InitShape #PRE_GOOMBA + 1, #TILE, #TILE, #PLAYFIELD_PLANES
InitShape #PRE_KOOPA + 2, #KOOPA_W, #KOOPA_H, #PLAYFIELD_PLANES
InitShape #PRE_KOOPA + 3, #KOOPA_W, #KOOPA_H, #PLAYFIELD_PLANES
InitShape #PRE_MUSHROOM, #TILE, #TILE, #PLAYFIELD_PLANES

;; The palette is the game's: entries 0 to 15 the front (the cover is black), 16 to 31 the
;; back's pens, each the atlas colour of the pen (the main project's PALETTE note).
InitPalette 0, #COPPER_COLORS
For penIndex.w = 1 To 15
  AGAPalRGB 0, penIndex, atlasPalette(penIndex*3), atlasPalette(penIndex*3 + 1), atlasPalette(penIndex*3 + 2)
  AGAPalRGB 0, penIndex + 16, atlasPalette(penIndex*3), atlasPalette(penIndex*3 + 1), atlasPalette(penIndex*3 + 2)
Next
;; The front, which shows only the backdrop: the picture's own colours for its pens 1 to 8 (black,
;; white, light blue, brown, orange, green, light green, skin), the sky in the spare pen, and black
;; at entry 0 for the rest of the page. The back's entries 17 to 31 are the atlas's, above.
AGAPalRGB 0, 0, 0, 0, 0
AGAPalRGB 0, 1, 0, 0, 0
AGAPalRGB 0, 2, 255, 255, 255
AGAPalRGB 0, 3, 99, 173, 255
AGAPalRGB 0, 4, 156, 74, 0
AGAPalRGB 0, 5, 230, 156, 33
AGAPalRGB 0, 6, 16, 148, 0
AGAPalRGB 0, 7, 140, 214, 0
AGAPalRGB 0, 8, 255, 206, 198
AGAPalRGB 0, #SKY_PEN, 193, 224, 254
AGAPalRGB 0, 16, 0, 0, 0

;; =======================================================
;; DISPLAY (BLITZ MODE)
;; =======================================================

BLITZ

XINCLUDE "/includes/sparkydave.beam.blitz.ab3"
XINCLUDE "/includes/sparkydave.sound.blitz.ab3"

;; CIA-A's time-of-day counter, which counts the 50 or 60 Hz vertical sync (proofs/sound-engine.ab3).
;; The high byte is read first, as that latches the other two.
Function.l ReadTimeOfDay{}
  highByte.l = Peek.b($bfea01) AND 255
  middleByte.l = Peek.b($bfe901) AND 255
  lowByte.l = Peek.b($bfe801) AND 255
  Function Return highByte*65536 + middleByte*256 + lowByte
End Function

;; True once when a key goes down.
Function.w KeyPressed{rawCode.w}
  SHARED keyHeld()
  If RawStatus(rawCode)
    If keyHeld(rawCode) = False
      keyHeld(rawCode) = True
      Function Return True
    EndIf
  Else
    keyHeld(rawCode) = False
  EndIf
  Function Return False
End Function

;; The HUD font, as hud.blitz.ab3 draws it: a clear of the 8x8 cell and a blit.
Function.w HudGlyphFor{code.w}
  If code >= 48
    If code <= 57 Then Function Return code - 48
  EndIf
  If code >= 65
    If code <= 90 Then Function Return code - 55
  EndIf
  If code = 45 Then Function Return #HUD_G_DASH
  Function Return -1
End Function

Statement DrawGlyphInto{targetBitmap.w, glyphIndex.w, glyphX.w, glyphY.w}
  Use BitMap targetBitmap
  Boxf glyphX, glyphY, glyphX + 7, glyphY + 7, 0
  Blit #HUD_SHAPE_BASE + glyphIndex, glyphX, glyphY
End Statement

Statement DrawTextInto{targetBitmap.w, glyphText$, textX.w, textY.w}
  For charIndex.w = 1 To Len(glyphText$)
    glyphIndex.w = HudGlyphFor{Asc(Mid$(glyphText$, charIndex, 1))}
    If glyphIndex >= 0 Then DrawGlyphInto{targetBitmap, glyphIndex, textX + (charIndex - 1)*8, textY}
  Next
End Statement

;; Text blitted with no clear of each cell: over an area already cleared (a row's value), or over
;; the same text (a label). Half the blitter work of DrawTextInto{}.
Statement BlitTextInto{targetBitmap.w, glyphText$, textX.w, textY.w}
  Use BitMap targetBitmap
  For charIndex.w = 1 To Len(glyphText$)
    glyphIndex.w = HudGlyphFor{Asc(Mid$(glyphText$, charIndex, 1))}
    If glyphIndex >= 0 Then Blit #HUD_SHAPE_BASE + glyphIndex, textX + (charIndex - 1)*8, textY
  Next
End Statement

Statement DrawTextCentredAt{targetBitmap.w, glyphText$, originX.w, textY.w}
  DrawTextInto{targetBitmap, glyphText$, originX + (#VIEW_W - Len(glyphText$)*8)/2, textY}
End Statement

Statement CutShapes{}
  Use BitMap #HUD_BM
  For hudGlyph.w = 0 To #HUD_GLYPHS - 1
    GetaShape #HUD_SHAPE_BASE + hudGlyph, hudGlyph*8, 0, 8, 8
  Next
  Use BitMap #MARIO_BM
  GetaShape #PRE_SMALL_R + #MARIO_F_JUMP, #MARIO_F_JUMP*#TILE, 0, #TILE, #TILE
  GetaShape #PRE_SMALL_R + #MARIO_F_IDLE, #MARIO_F_IDLE*#TILE, 0, #TILE, #TILE
  Use BitMap #ENEMIES_BM
  For goombaFrame.w = 0 To 1
    GetaShape #PRE_GOOMBA + goombaFrame, goombaFrame*#GOOMBA_W, 16, #GOOMBA_W, #GOOMBA_H
  Next
  ;; The Koopa's art faces left; the shapes are turned to face right, as the game's are.
  For koopaFrame.w = 0 To 1
    GetaShape #PRE_KOOPA + 2 + koopaFrame, (#KOOPA_SHEET_CELL + koopaFrame)*#KOOPA_W, 8, #KOOPA_W, #KOOPA_H
    XFlip #PRE_KOOPA + 2 + koopaFrame
  Next
  Use BitMap #ITEMS_BM
  GetaShape #PRE_MUSHROOM, #PRE_MUSHROOM_CELL*#TILE, 0, #ITEM_W, #ITEM_H
End Statement

;; The backdrop on the front (the cover bitmap), once: sky from the stage's top to the ground, then
;; the picture's strip over it, its sky transparent (pen 0, as every shape's is).
Statement DrawScene{}
  Use BitMap #SCENE_BM
  GetaShape #SCENE_SHAPE, 0, #SCENE_FIRST_ROW*#TILE, #VIEW_W, #SCENE_H
  Use BitMap #COVER_BM
  Boxf 0, #STAGE_TOP, #VIEW_W - 1, #SCENE_TOP + #SCENE_H - 1, #SKY_PEN
  Blit #SCENE_SHAPE, 0, #SCENE_TOP
End Statement

;; The page's x on the back bitmap.
Function.w PageX{pageIndex.w}
  Function Return pageIndex*#PAGE_W
End Function

;; True if the sound's settings differ from the baseline.
Function.w SettingsChanged{}
  SHARED soundPanNow, soundFilterChosen, soundVolumeScale(), baselinePan, baselineFilter, baselineVolume()
  changedNow.w = False
  If soundPanNow <> baselinePan Then changedNow = True
  filterNow.w = 0
  If soundFilterChosen <> False Then filterNow = 1
  If filterNow <> baselineFilter Then changedNow = True
  For volumeGroup.w = 0 To 2
    If soundVolumeScale(volumeGroup) <> baselineVolume(volumeGroup) Then changedNow = True
  Next
  Function Return changedNow
End Function

;; What is set now becomes the baseline (the page opening, or BACK saving).
Statement TakeBaseline{}
  SHARED soundPanNow, soundFilterChosen, soundVolumeScale(), baselinePan, baselineFilter, baselineVolume()
  baselinePan = soundPanNow
  baselineFilter = 0
  If soundFilterChosen <> False Then baselineFilter = 1
  For volumeGroup.w = 0 To 2
    baselineVolume(volumeGroup) = soundVolumeScale(volumeGroup)
  Next
End Statement

;; The baseline put back, on the hardware too. The layout restarts the audio only if it differs.
Statement DiscardChanges{}
  SHARED soundPanNow, soundFilterChosen, soundVolumeScale(), baselinePan, baselineFilter, baselineVolume()
  If soundPanNow <> baselinePan Then SoundSetPan{baselinePan}
  soundFilterChosen = False
  If baselineFilter = 1 Then soundFilterChosen = True
  SoundSetFilter{soundFilterChosen}
  For volumeGroup.w = 0 To 2
    soundVolumeScale(volumeGroup) = baselineVolume(volumeGroup)
  Next
End Statement

;; A row's label, and its value.
Function.s RowLabel{rowIndex.w}
  If rowIndex = #ROW_SONG Then Function Return "SONG"
  If rowIndex = #ROW_EFFECT Then Function Return "EFFECT"
  If rowIndex = #ROW_PAN Then Function Return "SOUND LAYOUT"
  If rowIndex = #ROW_FILTER Then Function Return "FILTER"
  If rowIndex = #ROW_PULSE Then Function Return "PULSE VOLUME"
  If rowIndex = #ROW_TRIANGLE Then Function Return "TRIANGLE VOLUME"
  If rowIndex = #ROW_NOISE Then Function Return "NOISE VOLUME"
  If rowIndex = #ROW_DEFAULTS Then Function Return "DEFAULTS"
  If SettingsChanged{} <> False Then Function Return "SAVE AND BACK"
  Function Return "BACK"
End Function

Function.s RowValue{rowIndex.w}
  SHARED songName$(), effectName$(), songIndex, effectIndex, soundPanNow, soundFilterChosen, soundVolumeScale()
  If rowIndex = #ROW_SONG Then Function Return songName$(songIndex)
  If rowIndex = #ROW_EFFECT Then Function Return effectName$(effectIndex)
  If rowIndex = #ROW_PAN Then Function Return Chr$(49 + soundPanNow)
  If rowIndex = #ROW_FILTER
    If soundFilterChosen <> False Then Function Return "ON"
    Function Return "OFF"
  EndIf
  If rowIndex = #ROW_PULSE Then Function Return Chr$(48 + soundVolumeScale(0))
  If rowIndex = #ROW_TRIANGLE Then Function Return Chr$(48 + soundVolumeScale(1))
  If rowIndex = #ROW_NOISE Then Function Return Chr$(48 + soundVolumeScale(2))
  If rowIndex = #ROW_BACK
    If SettingsChanged{} <> False Then Function Return "ESC DISCARDS"
  EndIf
  Function Return ""
End Function

;; One row on one page: its cursor cell and value area cleared (the label never changes and is
;; drawn once, by DrawStatic{}), then the cursor if it is the chosen row and the value, blitted
;; without a clear of each cell. The last row number is the readout.
Statement DrawRow{pageIndex.w, rowIndex.w}
  SHARED cursorRow, playingText$
  pageX.w = PageX{pageIndex}
  Use BitMap #BACK_BM
  If rowIndex = #ROW_COUNT
    Boxf pageX, #READOUT_Y, pageX + #VIEW_W - 1, #READOUT_Y + 7, 0
    BlitTextInto{#BACK_BM, playingText$, pageX + (#VIEW_W - Len(playingText$)*8)/2, #READOUT_Y}
    Statement Return
  EndIf
  rowY.w = #ROWS_Y + rowIndex*#ROW_PITCH
  Boxf pageX + #CURSOR_X, rowY, pageX + #CURSOR_X + 7, rowY + 7, 0
  Boxf pageX + #VALUE_X, rowY, pageX + #VIEW_W - 1, rowY + 7, 0
  If rowIndex = #ROW_BACK
    Boxf pageX + #LABEL_X, rowY, pageX + #VALUE_X - 1, rowY + 7, 0
    BlitTextInto{#BACK_BM, RowLabel{rowIndex}, pageX + #LABEL_X, rowY}
  EndIf
  If rowIndex = cursorRow Then Blit #HUD_SHAPE_BASE + #HUD_G_MENU_CURSOR, pageX + #CURSOR_X, rowY
  BlitTextInto{#BACK_BM, RowValue{rowIndex}, pageX + #VALUE_X, rowY}
End Statement

;; A row (or the readout) to be redrawn on both pages.
Statement MarkRow{rowIndex.w}
  SHARED rowDirty()
  rowDirty(rowIndex) = True
  rowDirty(#ROW_COUNT + 1 + rowIndex) = True
End Statement

Statement MarkAllRows{}
  For rowIndex.w = 0 To #ROW_COUNT
    MarkRow{rowIndex}
  Next
End Statement

;; The rows marked for a page, drawn and cleared. True if there were any.
Function.w DrawDirtyRows{pageIndex.w}
  SHARED rowDirty()
  drewAny.w = False
  For rowIndex.w = 0 To #ROW_COUNT
    If rowDirty(pageIndex*(#ROW_COUNT + 1) + rowIndex) <> False
      DrawRow{pageIndex, rowIndex}
      rowDirty(pageIndex*(#ROW_COUNT + 1) + rowIndex) = False
      drewAny = True
    EndIf
  Next
  Function Return drewAny
End Function

;; Everything that does not move: cleared, the heading, the speakers' letters and the labels, then
;; every row. The page then shows no character.
Statement DrawStatic{pageIndex.w}
  SHARED drawnShape(), rowDirty()
  pageX.w = PageX{pageIndex}
  Use BitMap #BACK_BM
  Boxf pageX, 0, pageX + #PAGE_W - 1, #WORLD_H - 1, 0
  DrawTextCentredAt{#BACK_BM, "JUKEBOX", pageX, #HEADING_Y}
  DrawTextInto{#BACK_BM, "L", pageX + 16, #HEADING_Y}
  DrawTextInto{#BACK_BM, "R", pageX + #VIEW_W - 24, #HEADING_Y}
  For rowIndex.w = 0 To #ROW_COUNT - 1
    DrawTextInto{#BACK_BM, RowLabel{rowIndex}, pageX + #LABEL_X, #ROWS_Y + rowIndex*#ROW_PITCH}
  Next
  For channelIndex.w = 0 To 3
    drawnShape(pageIndex*4 + channelIndex) = -1
  Next
  For rowIndex.w = 0 To #ROW_COUNT
    rowDirty(pageIndex*(#ROW_COUNT + 1) + rowIndex) = True
  Next
  drewAny.w = DrawDirtyRows{pageIndex}
End Statement

;; The shape a channel's character is showing now.
Function.w CharacterShape{channelIndex.w}
  SHARED hopHeight(), frameCount
  If channelIndex = 0
    If hopHeight(0) > 0 Then Function Return #PRE_SMALL_R + #MARIO_F_JUMP
    Function Return #PRE_SMALL_R + #MARIO_F_IDLE
  EndIf
  If channelIndex = 1 Then Function Return #PRE_GOOMBA + ((frameCount/8) AND 1)
  If channelIndex = 2 Then Function Return #PRE_KOOPA + 2 + ((frameCount/8) AND 1)
  Function Return #PRE_MUSHROOM
End Function

;; The character in a channel's place on a page, only if it is not already as it should be there:
;; erased where this page last drew it, then drawn at its height above the ground.
Statement DrawCharacter{pageIndex.w, channelIndex.w, characterX.w}
  SHARED hopHeight(), characterHeight(), drawnShape(), drawnX(), drawnY()
  pageX.w = PageX{pageIndex}
  slotIndex.w = pageIndex*4 + channelIndex
  shapeSlot.w = CharacterShape{channelIndex}
  drawY.w = #GROUND_Y - characterHeight(channelIndex) - hopHeight(channelIndex)
  If drawnShape(slotIndex) = shapeSlot AND drawnX(slotIndex) = characterX AND drawnY(slotIndex) = drawY Then Statement Return
  Use BitMap #BACK_BM
  If drawnShape(slotIndex) >= 0
    Boxf pageX + drawnX(slotIndex), drawnY(slotIndex), pageX + drawnX(slotIndex) + 15, drawnY(slotIndex) + characterHeight(channelIndex) - 1, 0
  EndIf
  Blit shapeSlot, pageX + characterX, drawY
  drawnShape(slotIndex) = shapeSlot
  drawnX(slotIndex) = characterX
  drawnY(slotIndex) = drawY
End Statement

;; One frame's hop for a channel: it rises at once to the height its loudness asks for and falls back
;; under gravity (the speed grows a pixel a frame).
Statement UpdateHop{channelIndex.w}
  SHARED hopHeight(), hopSpeed(), hopPeak, apuState(), soundVolumeScale()
  groupIndex.w = 0
  If channelIndex = 2 Then groupIndex = 1
  If channelIndex = 3 Then groupIndex = 2
  levelNow.w = apuState(channelIndex*16 + #AP_LEVEL)
  targetHeight.w = (levelNow*soundVolumeScale(groupIndex)*8)/15
  If targetHeight > #STAGE_MAX_H Then targetHeight = #STAGE_MAX_H
  If targetHeight > hopHeight(channelIndex)
    hopHeight(channelIndex) = targetHeight
    hopSpeed(channelIndex) = 0
  Else
    hopSpeed(channelIndex) = hopSpeed(channelIndex) + 1
    hopHeight(channelIndex) = hopHeight(channelIndex) - hopSpeed(channelIndex)
    If hopHeight(channelIndex) < 0
      hopHeight(channelIndex) = 0
      hopSpeed(channelIndex) = 0
    EndIf
  EndIf
  If hopHeight(channelIndex) > hopPeak Then hopPeak = hopHeight(channelIndex)
End Statement

;; The stage on one page: the four characters, each on the side of the speaker its channel's Paula
;; channel is on (channels 0 and 3 are the left, 1 and 2 the right), in channel order. A character
;; whose side changed (the layout row) is erased where it was by DrawCharacter{}.
Statement DrawStage{pageIndex.w}
  SHARED soundPaulaChannel()
  leftCount.w = 0
  rightCount.w = 0
  For channelIndex.w = 0 To 3
    paulaNow.w = soundPaulaChannel(channelIndex)
    If paulaNow = 0 OR paulaNow = 3
      DrawCharacter{pageIndex, channelIndex, 56 + leftCount*56}
      leftCount = leftCount + 1
    Else
      DrawCharacter{pageIndex, channelIndex, 208 + rightCount*56}
      rightCount = rightCount + 1
    EndIf
  Next
End Statement

;; A song asked for now (area music loops; an event tune plays once).
Statement StartSong{startIndex.w}
  SHARED songIsEvent(), songBit(), songName$(), playingText$, playingSongIndex
  If songIsEvent(startIndex) <> False
    SoundEventMusic{songBit(startIndex)}
  Else
    SoundAreaMusic{songBit(startIndex)}
  EndIf
  playingSongIndex = startIndex
  playingText$ = "PLAYING " + songName$(startIndex)
  MarkRow{#ROW_COUNT}
End Statement

;; Return on the SONG row: the song shown, if another is playing or none is; the same one again
;; stops it. A change of song silences the engine's music first and starts the new one the next
;; frame (pendingSongIndex), since one request is kept a tick, and an event tune would hold off an
;; area one.
Statement PressSong{}
  SHARED songIndex, playingSongIndex, pendingSongIndex, playingText$
  If playingSongIndex = songIndex
    SoundAreaMusic{#MUSIC_SILENCE}
    SoundEventMusic{#MUSIC_SILENCE}
    playingSongIndex = -1
    playingText$ = "SILENT"
    MarkRow{#ROW_COUNT}
    Statement Return
  EndIf
  If playingSongIndex >= 0
    SoundAreaMusic{#MUSIC_SILENCE}
    SoundEventMusic{#MUSIC_SILENCE}
    pendingSongIndex = songIndex
    playingSongIndex = -1
    Statement Return
  EndIf
  StartSong{songIndex}
End Statement

;; Once a frame, before the ticks: the song waiting for the silence, and an event tune that has
;; ended on its own (the engine's event buffer is empty) leaves the readout.
Statement UpdateSongState{}
  SHARED pendingSongIndex, playingSongIndex, songIsEvent(), soundState(), playingText$
  If pendingSongIndex >= 0
    StartSong{pendingSongIndex}
    pendingSongIndex = -1
    Statement Return
  EndIf
  If playingSongIndex >= 0
    If songIsEvent(playingSongIndex) <> False AND soundState(#SS_EVENT_MUSIC_BUFFER) = 0 AND soundState(#SS_EVENT_MUSIC_QUEUE) = 0
      playingSongIndex = -1
      playingText$ = "SILENT"
      MarkRow{#ROW_COUNT}
    EndIf
  EndIf
End Statement

Statement PlayEffect{}
  SHARED effectIndex, effectGroup(), effectBit(), effectName$(), playingText$
  If effectGroup(effectIndex) = 0 Then SoundSquare1{effectBit(effectIndex)}
  If effectGroup(effectIndex) = 1 Then SoundSquare2{effectBit(effectIndex)}
  If effectGroup(effectIndex) = 2 Then SoundNoise{effectBit(effectIndex)}
  playingText$ = "EFFECT " + effectName$(effectIndex)
End Statement

;; Left (-1) or right (1) on the chosen row.
Statement ChangeRow{changeNow.w}
  SHARED cursorRow, songIndex, effectIndex, soundPanNow, soundFilterChosen, soundVolumeScale()
  If cursorRow = #ROW_SONG
    songIndex = (songIndex + changeNow + #SONG_COUNT) MOD #SONG_COUNT
  EndIf
  If cursorRow = #ROW_EFFECT
    effectIndex = (effectIndex + changeNow + #EFFECT_COUNT) MOD #EFFECT_COUNT
  EndIf
  If cursorRow = #ROW_PAN
    SoundSetPan{(soundPanNow + changeNow + #SOUND_PAN_LAYOUTS) MOD #SOUND_PAN_LAYOUTS}
  EndIf
  If cursorRow = #ROW_FILTER
    soundFilterChosen = NOT soundFilterChosen
    SoundSetFilter{soundFilterChosen}
  EndIf
  If cursorRow >= #ROW_PULSE AND cursorRow <= #ROW_NOISE
    groupIndex.w = cursorRow - #ROW_PULSE
    volumeNew.w = soundVolumeScale(groupIndex) + changeNow
    If volumeNew >= 0 AND volumeNew <= 9 Then soundVolumeScale(groupIndex) = volumeNew
  EndIf
  MarkRow{cursorRow}
  MarkRow{#ROW_BACK}
End Statement

;; Return on BACK, and Esc.
Statement PressBack{}
  SHARED playingText$
  If SettingsChanged{} <> False
    TakeBaseline{}
    playingText$ = "SAVED"
  Else
    playingText$ = "NOTHING CHANGED"
  EndIf
  MarkRow{#ROW_BACK}
  MarkRow{#ROW_COUNT}
End Statement

Statement PressCancel{}
  SHARED playingText$
  If SettingsChanged{} <> False
    DiscardChanges{}
    playingText$ = "DISCARDED"
    MarkAllRows{}
  Else
    playingText$ = "NOTHING CHANGED"
    MarkRow{#ROW_COUNT}
  EndIf
End Statement

;; The keys, once a frame.
Statement PollKeys{}
  SHARED cursorRow, quitFlag, soundState(), apuState(), savedSoundState(), savedApuState(), stateSaved
  SHARED playingText$
  If RawStatus(#RAW_KEY_F10) Then quitFlag = True
  If KeyPressed{#RAW_KEY_ESC} Then PressCancel{}
  If KeyPressed{#RAW_KEY_UP}
    MarkRow{cursorRow}
    cursorRow = (cursorRow + #ROW_COUNT - 1) MOD #ROW_COUNT
    MarkRow{cursorRow}
  EndIf
  If KeyPressed{#RAW_KEY_DOWN}
    MarkRow{cursorRow}
    cursorRow = (cursorRow + 1) MOD #ROW_COUNT
    MarkRow{cursorRow}
  EndIf
  If KeyPressed{#RAW_KEY_LEFT} Then ChangeRow{-1}
  If KeyPressed{#RAW_KEY_RIGHT} Then ChangeRow{1}
  If KeyPressed{#RAW_KEY_START}
    If cursorRow = #ROW_SONG Then PressSong{}
    If cursorRow = #ROW_EFFECT Then PlayEffect{}
    If cursorRow = #ROW_BACK Then PressBack{}
    If cursorRow = #ROW_DEFAULTS
      SetSoundDefaults{}
      SoundApplySettings{}
      MarkAllRows{}
    EndIf
    MarkRow{#ROW_COUNT}
  EndIf
  If KeyPressed{#RAW_KEY_F1}
    For stateIndex.w = 0 To #SS_COUNT
      savedSoundState(stateIndex) = soundState(stateIndex)
    Next
    For stateIndex.w = 0 To 63
      savedApuState(stateIndex) = apuState(stateIndex)
    Next
    stateSaved = True
    playingText$ = "STATE SAVED"
    MarkRow{#ROW_COUNT}
  EndIf
  If KeyPressed{#RAW_KEY_F2}
    If stateSaved <> False
      For stateIndex.w = 0 To #SS_COUNT
        soundState(stateIndex) = savedSoundState(stateIndex)
      Next
      For stateIndex.w = 0 To 63
        apuState(stateIndex) = savedApuState(stateIndex)
      Next
      playingText$ = "STATE PUT BACK"
      MarkRow{#ROW_COUNT}
    EndIf
  EndIf
End Statement

;; The display: the HUD band (blank) over the world list, whose front is the blank cover and whose
;; back is the page, brought in front by PF2PRI. The game's lists, flags and window edges.
BBlitMode CookieMode
BlitMode CookieMode
CutShapes{}
Use BitMap #COVER_BM
Cls 0
DrawScene{}
Use BitMap #HUD_BAND_BM
Cls 0
Use BitMap #BACK_BM
Cls 0

InitCopList 0, hudLine, #HUD_H, #COPPER_FLAGS, #COPPER_SPRITES, #COPPER_COLORS, #COPPER_CUSTOMS
InitCopList 1, hudLine + #HUD_H + #LIST_GAP, #VIEW_H, #WORLD_FLAGS, 0, 0, #COPPER_CUSTOMS
DisplayAdjust 0, 0, 0, 0, #DISPLAY_ADJUST_START, #DISPLAY_ADJUST_STOP
DisplayAdjust 1, 0, 0, 0, #DISPLAY_ADJUST_START, #DISPLAY_ADJUST_STOP
DisplayControls 1, 0, #PLAYFIELD2_OFFSET_16, 0
CreateDisplay 0, 1
DisplayPalette 0, 0
DisplayBitMap 0, #HUD_BAND_BM, 0, 0
DisplayBitMap 1, #COVER_BM, 0, #VIEW_TOP, #BACK_BM, 0, #VIEW_TOP
BlitzKeys On

;; Both pages drawn before the back comes to the front (the cost of opening the page is measured).
openStart.l = RasterLine{}
SoundReset{}
SetSoundDefaults{}
TakeBaseline{}
DrawStatic{0}
DrawStatic{1}
openLines = SegmentLines{openStart, RasterLine{}, frameLines}
VWait
DisplayControls 1, #PLAYFIELD2_PRIORITY, 0, 0

If wavesOk = True
  soundState(#SS_ENABLED) = True
  SoundStart{}
  SoundApplySettings{}
EndIf

tickDebt.w = 0
todStart = ReadTimeOfDay{}
lastTod = todStart
While quitFlag = False
  VWait
  DisplayBitMap 1, #COVER_BM, 0, #VIEW_TOP, #BACK_BM, PageX{shownPage}, #VIEW_TOP
  drawPage.w = 1 - shownPage
  frameStart.l = RasterLine{}

  UpdateSongState{}
  PollKeys{}

  ;; The sound ticks: 60 a second, so 6 in 5 frames on PAL and one a frame on NTSC. Counted from
  ;; the display frames that really passed since the last pass (CIA-A's time of day counts the
  ;; vertical sync), not from the passes: a pass that ran long (the keys held down through the
  ;; menu) then catches the music up and it keeps its tempo.
  tickStart.l = RasterLine{}
  todNow.l = ReadTimeOfDay{}
  framesPassed.l = (todNow - lastTod) AND $ffffff
  lastTod = todNow
  If framesPassed < 1 Then framesPassed = 1
  If framesPassed > 4 Then framesPassed = 4
  If videoIsNtsc = True
    tickDebt = tickDebt + 5*framesPassed
  Else
    tickDebt = tickDebt + 6*framesPassed
  EndIf
  While tickDebt >= 5
    SoundTick{}
    tickCount = tickCount + 1
    tickDebt = tickDebt - 5
  Wend
  tickLines.l = SegmentLines{tickStart, RasterLine{}, frameLines}
  tickLineSum = tickLineSum + tickLines
  If tickLines > tickLineWorst Then tickLineWorst = tickLines

  ;; The stage on the hidden page, every frame.
  stageStart.l = RasterLine{}
  For channelIndex.w = 0 To 3
    UpdateHop{channelIndex}
  Next
  DrawStage{drawPage}
  stageLines.l = SegmentLines{stageStart, RasterLine{}, frameLines}
  stageLineSum = stageLineSum + stageLines
  If stageLines > stageLineWorst Then stageLineWorst = stageLines

  ;; The rows marked for this page, on the hidden page.
  rowsStart.l = RasterLine{}
  If DrawDirtyRows{drawPage} <> False
    rowsLines.l = SegmentLines{rowsStart, RasterLine{}, frameLines}
    rowsDrawCount = rowsDrawCount + 1
    rowsLineSum = rowsLineSum + rowsLines
    If rowsLines > rowsLineWorst Then rowsLineWorst = rowsLines
  EndIf

  workEnd.l = RasterLine{}
  workLines.l = SegmentLines{frameStart, workEnd, frameLines}
  workLineSum = workLineSum + workLines
  If workLines > workLineWorst Then workLineWorst = workLines
  ;; Past the next vertical blank: the beam is back above where the frame's work began.
  If workEnd < frameStart Then overBudgetCount = overBudgetCount + 1

  shownPage = drawPage
  frameCount = frameCount + 1
Wend

todEnd = ReadTimeOfDay{}
SoundStop{}

AMIGA
If WriteFile(0, "sparky-dave:game/proofs/results/jukebox-results.txt")
  FileOutput 0
  NPrint "jukebox: ", frameCount, " frames, ", tickCount, " sound ticks, video ", frameLines, " lines a frame"
  If wavesOk = False Then NPrint "BuildSoundWaves FAILED (no Chip RAM): no sound"
  NPrint "opening the page, both pages drawn whole: ", openLines, " lines"
  If frameCount > 0
    NPrint "per frame, average / worst lines: sound ticks ", tickLineSum/frameCount, " / ", tickLineWorst, ", stage ", stageLineSum/frameCount, " / ", stageLineWorst, ", whole frame's work ", workLineSum/frameCount, " / ", workLineWorst
  EndIf
  If rowsDrawCount > 0 Then NPrint "rows redraws on one page: ", rowsDrawCount, ", average ", rowsLineSum/rowsDrawCount, " lines, worst ", rowsLineWorst
  NPrint "frames whose work ran past the next vertical blank (this check misses a long overrun): ", overBudgetCount
  NPrint "loop passes ", frameCount, ", display frames that really passed (CIA-A time of day) ", todEnd - todStart, " (equal if every pass fitted in a frame)"
  NPrint "highest hop reached: ", hopPeak, " px"
  If stateSaved = True Then NPrint "the engine's state was saved (F1)"
  NPrint ""
  NPrint "The picture and the sound are the main result: report the five points at the top of the proof."
  CloseFile 0
EndIf
End
