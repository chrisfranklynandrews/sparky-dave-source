;; Test harness. A batch run: every scenario runs once, the results are written to
;; test-harness-results-<variant>-<look>.txt (ntsc or pal, nes or allstars: the physics variant and
;; the look it was compiled with), and the program ends. execute sparky-dave:S/run-tests compiles
;; and runs it for both variants in both looks; S/run-tests-one runs one of the four.
;;
;; This is a TEST PROGRAM, not a proof, which is why it lives in tests/
;; rather than proofs/. A proof is an untried technique, compiled once to prove
;; it works and then folded into includes/; nothing here will ever be folded in.
;; It is the standing behavioural gate: the living docs cite it with its scenario
;; and assertion counts, and it carries no recorded known-failure. Every scenario is
;; expected green; a red assertion is a regression, not a recorded gap.
;;
;; It drives the live physics, collision, object, level, input and sound includes
;; through scripted input and checks the behaviour this engine claims to match. The
;; rules under test are in the main project's PLAYER_PHYSICS note, the main project's PLAYER_HITBOX note,
;; the main project's LIFE_CYCLE note, the main project's OBJECT_SYSTEM note, the main project's LEVEL_END note, the main project's AREAS note, the main project's SCREENS note, the main project's INPUT note
;; and the main project's SOUND note.
;;
;;   1 RUNLATCH  PrepareGroundMotion leaves playerRunningSpeed alone when no
;;               button but A is held, so the latch survives standing still
;;               and only drops on a held direction that equals
;;               playerMovingDirection after his speed falls below the run
;;               threshold.
;;   2 CEILING   A hard-block head hit sets speedY to 1 and leaves the
;;               subpixel alone, and does not move the player. The head
;;               probe sits at +2, inside the sprite, so Mario rises into
;;               the ceiling by 2 px before the bump can fire, and the
;;               sub-tile gate stops him no shallower than
;;               #MT_HEAD_MIN_SUBTILE.
;;   3 SIDECOL   A wall hit sets sideCollisionTimer to #MARIO_SIDECOLLIDE
;;               and the camera stands still for that many ticks. The gate
;;               is checked white-box by forcing the timer, because a
;;               wall-pinned Mario can never restart a rightward scroll.
;;   4 BOXSIDE   The tile-collision box is 12 px wide, so a pinned player's
;;               right probe stops 1-2 px short of the wall face and never
;;               penetrates it.
;;   5 LEAVE     Ground support is re-derived from the foot probes every
;;               frame as an OR, so there is no walk-off hover: the tick a
;;               player leaves a ledge, the tick his trailing foot probe
;;               clears it, playerOnGround is already False.
;;   6 QUESTION  A question block is not a solid metatile, so it takes the
;;               block path rather than the hard bump: speedY is cleared and
;;               blockBounceTimer locks the block out on the bump tick, the
;;               cell clears to sky for the whole 16-frame bob, and only at
;;               the end of the bob does the class become the used block and
;;               mapBuffer take the spent GID. Big Mario gets the same bump,
;;               and starts no chunks: only bricks break.
;;   7 BRICK     Small Mario cannot break bricks. The bump clears the speed,
;;               the class is unchanged, the same lockout applies, and the
;;               settle restores the brick's own GID after the bob.
;;   8 WALLMASK  Delta 8, the blocked-input mask: a right-wall stop leaves the
;;               mask byte exactly $fe -- RIGHT cleared, nothing else -- and a
;;               jump still works while pinned. See the block on
;;               ScenarioWallMask{} below for why the acceleration subpixel
;;               cannot be the probe for it.
;;   9 POLE      The flagpole: the grab window, the slide on frames 7-8, Mario
;;               hanging at the cartridge's stop height while the flag goes down 2 a
;;               tick, the end of the slide at the flag's end height with the band's
;;               points, and the step off the pole into the end walk.
;;  10 RESIZE    Grow and shrink: the lockout, the size settling, and the one
;;               size-dependent probe -- big Mario's head is 14 px higher.
;;  11 SIDEAWAY  A wall hit while moving away from the blocked side bails
;;               without dragging Mario backward; both blocked probes use the
;;               movement direction as their documented fallback.
;;  12 BLOCKITEM A `?` block carrying a block-item marker releases the item
;;               when the bump's bob settles, 16 frames after the head hit
;;               rather than on the bump tick. The cell is read from the
;;               generated table (never hardcoded), so an unmarked level
;;               fails the assertion. The scenario then steps the mushroom
;;               through the settled vertical motion: the 1-second rise out of
;;               the block, the rest on the block top, the fall from rest with
;;               the cap landing on tick 16, and the landing on the floor.
;;  13 COINMUSH  A coin arc still playing when a `?` block settles must not
;;               stop that block's mushroom: the coin is released first through
;;               SpawnBlockItem{}, then the mushroom block is bumped and the
;;               mushroom must still come out on the settle tick.
;;  14 TWOCOINS  Two coin blocks released back to back both put a coin in the
;;               pool. Coins are not limited to one live item.
;;  15 MUSHCOIN  A mushroom still out does not stop a coin block: the coin is
;;               released and a second mushroom replaces the first (one
;;               power-up out at a time; the new one wins, as on the cartridge).
;;  16 MUSHLEAVE An uncollected mushroom that falls below the level or goes
;;               behind the camera is freed, so the next mushroom block can
;;               release a mushroom again.
;;  17 BRICKBREAK Big Mario breaks a brick: no bob, the cell empties at once
;;               for both collision and art, his speed becomes -2 so he rises
;;               through the gap, 50 points, four chunks start. Two more
;;               breaks while chunks fly both go through and are not cut off:
;;               two sets fly, and a third takes over the first.
;;  18 COINABOVE A floating coin tile directly above a block is collected when
;;               the block is bumped (small Mario, brick; small, `?`) or broken
;;               (big, brick): the cell clears to sky and the coin pops out as a
;;               coin object. A bump with no coin above spawns nothing.
;;  19 COINTOUCH A floating coin tile under one of the player's tile probes is
;;               collected at once: cell cleared, one coin, 200 points, and a
;;               coin that is not touched stays.
;;  20 MULTICOIN The brick with coins: every hit pays a coin on the hit, for
;;               both sizes, and the brick stays a brick (big Mario cannot break
;;               it). The timer runs out after 211 to 231 ticks depending on the
;;               phase it was started in; the next hit still pays but settles as
;;               the used block, and the one after pays nothing.
;;  21 COINONHIT A `?` block's coin is paid on the hit, not at the settle or at
;;               the end of the coin's arc, and only once.
;;  22 CONTACT   Goomba contact: a side hit kills small Mario, shrinks big Mario
;;               and starts the invulnerability, which blocks a second hit; a
;;               stomp squashes the Goomba and leaves Mario unhurt; a squashed
;;               Goomba is harmless; the Goomba turns to face him; the
;;               every-other-tick rule holds.
;;  23 DEATH     The death sequence: held, hop, fall through the floor with no
;;               collision, life lost; a pit is the same fall with no hop and no
;;               freeze; each costs a life.
;;  24 LIVES     Lives, game over and the halfway point: the third death is game
;;               over and it stays until the game-over cover ends it, and the
;;               restart camera is the halfway point only if he had passed it.
;;  25 TIMEUP    The HUD timer reaching zero kills Mario one unit later, and the
;;               clock does not run while he is dying.
;;  26 GOOMBAWAKE Goombas appear only when the screen's right edge reaches them,
;;               are not woken twice or after dying, a death restart passes every
;;               entry in or behind the view, and a new game passes none.
;;  27 STOMPCHAIN Consecutive stomps score 100, 200, 400, 500, 800, 1000, 2000,
;;               4000, 5000, 8000 and then a 1-UP (capped there), the points
;;               arrive when the floating number is five ticks old, the number
;;               rises and expires on the cartridge's timing, a full set still
;;               scores, the bounce is -4, and landing clears the chain.
;;  28 COINLIFE  The hundredth coin gives an extra life, and the counter wraps.
;;  29 MUSHSCORE Picking up a mushroom spawns a 1000 number, adds the points five
;;               ticks later, and starts Mario growing.
;;  30 HIDDENONEUP A hidden block is nothing until the screen reaches it, builds
;;               once per game, and a head hit makes it the used block and releases
;;               a 1-UP that gives a life, no points and no growth.
;;  31 KOOPA     A walking Koopa goes half a pixel a tick; stomped it is a shell
;;               with the chain number and a revive timer; any touch kicks a shell
;;               (400, or 500 with the timer low) and Mario is not hurt by it while
;;               he still overlaps; a sliding shell knocks off what it hits with
;;               500, 800, ...; a stomp stops it; the timer revives it; a walker
;;               hurts Mario.
;;  32 FIREFLOWER A power-up block gives big Mario a flower and small Mario a
;;               mushroom; the flower gives 1000, a freeze with Mario's colours
;;               stepping through the star sets, and then Fire Mario; a hit Fire
;;               Mario is small at once.
;;  33 FIREBALL  Only Fire Mario throws, on a fresh B press, two slots used in turn
;;               (a third throw with the first still out does nothing); a ball moves
;;               4 a tick and bounces on the floor; a wall makes it bounce and then
;;               explode, and the burst ends; it knocks off a Goomba for 100 and a
;;               Koopa for 200 and explodes.
;;  34 STARMAN   A brick holding a Starman bumps for big Mario instead of breaking
;;               and becomes the used block; the star hops, goes along and turns at
;;               a wall; picked up it gives 1000 and 35 intervals, counted down by
;;               the interval timer; a Starman Mario knocks off a Goomba (100), a
;;               walking Koopa and a standing shell (200) without being hurt; his
;;               colours step quickly, then slowly for the last 8 intervals.
;;  35 LEVELEND  The pole's five bands from five heights; the fireworks count from
;;               the timer's last digit (1, 3 or 6); the castle door hides Mario and
;;               starts the tasks; the tasks give 50 a timer unit and 500 a firework,
;;               leave the timer at 0 and end in the course-clear event.
;;  36 BONUSROOM The way into the bonus pipe needs Down, his feet centred on the
;;               pipe's top and the ground; the sink takes 48 ticks and asks for the
;;               area event; the bonus map has 19 coins, a solid floor and nothing
;;               of the main level; the way out needs right at the mouth on the
;;               floor; the exit takes 48 ticks and asks for the way back; the rise
;;               out of the pipe ends standing on it; the palettes differ.
;;  37 COVER     The cover screens' times (the cartridge's ScreenTimer: 7 intervals
;;               for the lives and time up screens, 18 for game over, a blank one
;;               for two ticks, the title until Return); a cover ends when its
;;               time is up, game over ends in a new game with its cover left up,
;;               the title waits; and the palette model's pens: the cover blacks
;;               pen 0, the bonus room's palette, the cycle, Mario's fire set.
;;  38 STARFLOWERFIRE  The star and the flower in every order, and whether the fire
;;               button works after them: a big Mario takes the star then the
;;               flower and throws under the star; a small Mario takes both and
;;               only grows; a flower lying on a Mario mid-growth waits for the
;;               freeze to end; Fire Mario's star keeps the fire.
;;  39 PAUSE     The pause: PauseRoutine and the sound engine's pause mode.
;;  40 BUMPOBJECTS A bumped block against what stands on it: a Goomba on the
;;               cell is thrown off, and the block bump sets it.
;;  41 ENEMYTURN Enemies that meet turn round: on every other tick, a pair
;;               walking into each other both turn.
;;  42 CONTROLS  The keyboard's two schemes and the choice between them, with the
;;               keys as parameters (the keyboard cannot be scripted).
;;  43 JOYSTICK  The joystick choices, with the stick and buttons as parameters.
;;  44 KEYS      Redefinable keys: which keys no action may use, and the tables the
;;               redefine screen uses.
;;  45 CROUCH    The crouch: only a big Mario on the ground crouches, Down clears the
;;               walking, a crouch jump stays crouched until he lands.
;;  46 FALLINIT  Falling before any jump: the cartridge sets VerticalForceDown when
;;               an area starts, so a Mario who has not jumped still falls.
;;  47 JUMPFORGIVE Jump forgiveness (buffering and coyote time), the one scenario
;;               that runs with the windows on. Not the cartridge's: see
;;               the main project's PLAYER_PHYSICS note, "Jump forgiveness".
;;  48 JUKEBOX   The jukebox page's use of the sound engine: opening it keeps the
;;               game's engine state and closing it restores that state exactly.
;;  49 VARJUMP   Variable jump height: a tap rises less than a hold, a released A
;;               cuts the jump to the falling force while Mario is still rising,
;;               and a held A never does.
;;  50 SPEEDCAP  The land speed caps: walking tops out at #MARIO_MAX_WALK and holding
;;               B at #MARIO_MAX_RUN, read against the variant's constants.
;;  51 CAMFWD    The camera only scrolls forward: while running right, and after
;;               Mario stops, cameraX never falls.
;;  52 PAUSEESC The pause's lockout: a press in the frame after Start does not resume or
;;               re-pause the game, and the lockout then runs out as before.
;;  53 AREABOXES The pipe and room boxes on the game's own area files (read by the loader at
;;               start-up): 1-1 has no exit pipe, a room's exit and its link, the box gone
;;               again when the level area is back, the links of 1-1's own pipe, the return
;;               pipes by page, and a Goomba group where the cartridge builds it.
;;  54 PIRANHA   A Piranha Plant rises when Mario is not within 33 px across of it, waits at
;;               each end, stays down while he is near, hurts him on touch, is knocked off by
;;               the Starman or a fireball for 200 (and sinks into its pipe), is built as its
;;               pipe comes into view (and again after a restart that leaves it in view), and
;;               is erased 16 px left of the screen.
;;  55 REDKOOPA  A Red Koopa turns round at a ledge once it has landed instead of walking off
;;               (a green one walks off), falls first when it is built in the air, is built
;;               from a spawn entry marked red, and is a shell like a green one when stomped.
;;  56 LIFT      A large lift carries a Mario who lands on it (his feet on its top, on the
;;               ground, no speed) down it goes and he with it; it wraps at 256 both ways; a
;;               jump into its underside is cut short only near its bottom edge; it pushes
;;               him out from either side; it is erased 72 px left of the screen; and the
;;               area's lift entries are built as the screen arrives, up or down as marked.
;;  57 HUDAWAY   The HUD is asked to go away while any of Mario is above the world list's top
;;               (small: his top is playerY; big: 16 less), not at the top row itself, and
;;               never while a cover is up or he is hidden.
;;  58 NOLEVELEND An area with no flagpole is never grabbed from and one with no castle door
;;               never hides him as he walks off the pole (their boxes are #AREA_BOX_NONE).
;;  59 BACKSTRIPS The back playfield's strip is stamped only for a scenery that shows and is not already there,
;;               each kind has its strip in the area table (none has none; clouds one speed, hills and trees the
;;               band, with tile rows 5 to 9 empty), and an area with no scenery has no back showing.
;;  60 HUDSTAMP  The HUD's copy in the back bitmap is made when it is stale and the tall list is wanted or on show, and
;;               not otherwise.
;;  61 PLAYERCLIP Mario cut short at the top of the bitmap has a slot of his own for each of the rows that can show and each way
;;               he faces, in range and none shared (big Mario's 36 and small Mario's 4).
;;  62 PARATROOPA The Green Paratroopa (smbdis 8868 InitJumpGPTroopa, 12661 EnemyJump): it hops for ever, three pixels up and the
;;               Starman's gravity (a rise of about 41 px) while it walks left; a stomp takes the wings (a walking Koopa, Mario
;;               bounces, no chain), a bump from below does too (a shell), and a spawn of the winged kind builds one.
;;  63 JUMPSPRING The jumpspring (smbdis 6628 JumpspringHandler, 12248 ChkForLandJumpSpring): Mario landing on its top is held and
;;               squashed for 13 ticks (down 2 px a tick for eight, up for five, a net 6 px lower), then let go at -7 (NTSC) or -8,
;;               or -12 or -14 if the jump key went down afresh after the first step, with gravity the last jump's fall force after the
;;               first tick; it is a wall at its sides; a spawn builds one.
;;  64 VINE      The vine and the climb (smbdis 6705 VineObjectHandler, 12153 HandleClimbing, 5966 ClimbingSub): it grows a pixel on two
;;               ticks in four to 96 px and is climbable from 32 px, from the cell a tile under its top (not above y 32) down to its block;
;;               a side probe in the middle 4 px of the column grabs it (put on its side by his facing, speed gone); up is 1 px a tick
;;               with a carried force (7 ticks in 8), down 1 and the carry (2 a tick), the side swap 14 px with a 24 tick wait, letting go
;;               when he is off it, the take-over above y 32 and the area change at y -29.
;;  65 SKYBONUS  The sky bonus's pieces (smbdis 5524 VineEntr, 5644 PlayerHole, 2806 GetAreaMusic): 2-1's vine link names the sky (mode 4) and
;;               the sky's fall link 2-1 at page 10 (mode 3), the sky is a cloud area (the cloud music, no pit death), and the way in:
;;               below the screen he waits while the vine grows to 96 px, climbs it by himself to under y 153, and is then free,
;;               walking right by himself.
;;
;; One square per assertion along the bottom of the on-screen panel is no longer
;; drawn: the batch loop runs every scenario headless. The results file lists each
;; scenario and its assertions, PASS, FAIL or NO RESULT, and a scenario that never
;; ran is NOT RUN. The on-screen probe (DrawProbe{}) is kept for interactive debugging.
;;
;; Pen 1 solid tile, pen 3 the 16-px sprite, pen 6 the 12x14 tile-collision
;; box, pen 5 the 10x12 enemy-collision bounding box.

;; Tick{} mirrors the call order in UpdatePlayer{} but sets playerButtons directly
;; instead of reading the keyboard, and it reinitialises playerCollisionBits at the
;; top of the tick where UpdatePlayer{} does. It calls the live
;; ApplyCollisionButtonMask{} rather than repeating the masking, so the mask is
;; engine code under test here. It calls UpdateBlockBump{} immediately after the
;; blockBounceTimer decrement, matching UpdatePlayer{}'s wiring of the bump's
;; deferred settle. Tick{} does not call UpdateObjects{} for the item path:
;; scenario 12 steps the object dispatcher manually for the whole rise and
;; fall, at its own pacing, and no other
;; scenario ever has a live mushroom, so adding the call would only add a
;; no-op. If UpdatePlayer{} gains or reorders any other call, this proof has to
;; be updated to match.
;;
;; Every Statement that touches a global names it in SHARED, including globals
;; it only READS. An undeclared name inside a Blitz Statement is a local set to
;; 0, silently: reading a physics global without SHARED gives 0 every time, and
;; touching a Dim'd array without `SHARED array()` fails at runtime with
;; "Array not yet dim'd". Both bit the first version of this file, and
;; blockClass bit a Statement-local one during the metatile port.
;;
;; "Array not yet dim'd" has a second, separate cause: using an array at file
;; scope before its column-1 Dim. That is a compile error, and because the
;; compiler caps at 100 errors it buries the real line under a hundred identical
;; syntax errors on the lines after it. This proof is its own compilation root,
;; so it needs its own Dim for anything it includes -- see metatileBuffer above.
;;
;; Subpixel preservation after a ceiling bump is not asserted, because the
;; gravity accumulator wraps and can legitimately be 0 on the bump tick. Read
;; playerMoveForceY and playerFractionY in RAM across the bump to check it.

;; The 68020 optimizer (Amiblitz3.guide, "Directives"). The A1200's 68020 divides and multiplies in
;; hardware; without this AmiBlitz compiles for the 68000, and a long division is a library routine of
;; about 2 raster lines. proofs/op-cost-020.ab3 against proofs/op-cost.ab3 (2026-10-14): a division
;; 1.9 lines to 0.08, a multiply 0.24 to 0.06, plain code about a third faster. MOD is not helped (still
;; about 2.3 lines): see the main project's OPTIMISATION note, entry 8.
OPTIMIZE 1

WBStartup

#PLAYFIELD_PLANES = 4
#COPPER_FLAGS = $10004
#COPPER_COLORS = 16

;; The map dimensions come from includes/sparkydave.level.meta.ab3, the physics
;; and collision constants from includes/sparkydave.constants.ab3, and the #MT_*
;; codes from includes/sparkydave.metatile.classes.ab3. All three are the shipped,
;; generated files rather than hand copies, so the values under test cannot
;; drift from what the game compiles with.
;;
;; metatileBuffer and mapBuffer both have to be Dim'd HERE, before the metatile
;; include, because that include assigns metatileBuffer at file scope -- exactly
;; the arrangement the live tree gets from sparkydave.map.ab3. They also have to
;; be the real #MAP_CELLS cells, because the generated table carries all of 1-1's
;; assignments, not the probe's synthetic map. mapBuffer is here because
;; StartBlockBump{} and FinishBlockBump{}, which this proof includes, clear the
;; bumped cell to sky and then write its settled GID into it. Every scenario
;; clears the buffer before it builds its own terrain, so 1-1's contents are
;; overwritten rather than added to.
#FLOOR_ROW = 12
#CEILING_ROW = 8
#WALL_COLUMN = 12

#PROBE_TICKS = 150
#IDLE_TICKS = 6
#MAX_ASSERTS = 32
#SCENARIO_COUNT = 82

XINCLUDE "/includes/sparkydave.level.meta.ab3"
XINCLUDE "/includes/sparkydave.areas.table.ab3"
XINCLUDE "/includes/sparkydave.palettes.data.ab3"
XINCLUDE "/includes/sparkydave.mario-allstars.data.ab3"
XINCLUDE "/includes/sparkydave.allstars-palette.data.ab3"
XINCLUDE "/includes/sparkydave.jukebox-scenes.data.ab3"
XINCLUDE "/includes/sparkydave.look.ab3"
XINCLUDE "/includes/sparkydave.constants.ab3"
XINCLUDE "/includes/sparkydave.physics.ab3"
XINCLUDE "/includes/sparkydave.globals.ab3"
Dim metatileBuffer.w(#MAP_CELLS - 1)
Dim mapBuffer.w(#MAP_CELLS - 1)
Dim mapBufferBackup.w(#MAP_CELLS - 1)
Dim stampHead.w(#STAMP_GID_MAX)
Dim stampNext.w(#MAP_CELLS - 1)
; The back strip's cells grouped by tile for its stamp (StampBackPlayfield{}), as stampHead() and stampNext() group the map's.
Dim backStampHead.w(#STAMP_GID_MAX)
Dim backStampNext.w(#BACK_CELLS - 1)
Dim metatileBufferBackup.w(#MAP_CELLS - 1)
XINCLUDE "/includes/sparkydave.metatile.classes.ab3"
XINCLUDE "/includes/sparkydave.areaload.ab3"
XINCLUDE "/includes/sparkydave.sound.data.ab3"
XINCLUDE "/includes/sparkydave.sound.ab3"
XINCLUDE "/includes/sparkydave.settings.ab3"

Dim assertResult.w(#MAX_ASSERTS - 1)
Dim scenarioResult.w(#SCENARIO_COUNT*#MAX_ASSERTS - 1)
Dim scenarioAssertCount.w(#SCENARIO_COUNT - 1)
Dim scenarioCompleted.w(#SCENARIO_COUNT - 1)
Dim savedGoombaX.w(#GOOMBA_COUNT - 1)
Dim expectedChain.w(9)
expectedChain(0) = 100
expectedChain(1) = 200
expectedChain(2) = 400
expectedChain(3) = 500
expectedChain(4) = 800
expectedChain(5) = 1000
expectedChain(6) = 2000
expectedChain(7) = 4000
expectedChain(8) = 5000
expectedChain(9) = 8000
Dim savedGoombaY.w(#GOOMBA_COUNT - 1)
; Scenario 66's runs: Mario's x and y each tick.
Dim swimTraceX.w(63)
Dim swimTraceY.w(63)

mapWidth.w = #MAP_W
quitFlag.w = False
screenHeight = DispHeight

scenario.w = 1
scenarioTick.w = 0
assertIndex.w = 0
previousY.w = 0
bumpHeadRow.w = 0
bumpHeadColumn.w = 0
stoppedY.w = 0
riseEndSpeedY.w = 0
armSpeedY.w = 0
armTimer.w = 0
armClass.w = 0
armGid.w = 0
midClass.w = 0
midGid.w = 0
finishClass.w = 0
finishGid.w = 0
finishTimer.w = 0
bumpFinished.w = False
postBumpY.w = 0
bumpArmTick.w = -1
bumpFinishTick.w = -1
mushroomSpawnTick.w = -1
hoverTicks.w = 0
pinnedRightProbe.w = 0
cameraHeldTicks.w = 0
hitTimerValue.w = 0
hitTick.w = 0
gateCameraX.w = 0
gateHeld.w = False
gateFreed.w = False
wallPinnedProbe.w = 0
wallMaskedTicks.w = 0
wallWrongMaskedTicks.w = 0
