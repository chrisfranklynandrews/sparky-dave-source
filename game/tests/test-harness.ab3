blockItemCol.w = 0


;; The real areas, from their files by the loader the game uses, so the scenarios on pipes and boxes run on what the game
;; has: the first level's slots read, and its start area's objects applied (the harness keeps its own maps).
;; harnessAreaStatus is a loader code, or the number of values that differed from the compiled-in level: 0 is good.
dataDir$ = "sparky-dave:game/assets/"
harnessAreaStatus.w = LoadLevelAreas{0}
If harnessAreaStatus = 0 Then harnessAreaStatus = ApplyAreaObjects{0}

InitPalette 0, #COPPER_COLORS
AGAPalRGB 0, 0, 0, 0, 0
AGAPalRGB 0, 1, 168, 168, 168
AGAPalRGB 0, 2, 220, 0, 0
AGAPalRGB 0, 3, 0, 200, 0
AGAPalRGB 0, 4, 60, 60, 60
AGAPalRGB 0, 5, 252, 252, 252
AGAPalRGB 0, 6, 252, 152, 56
BitMap 1, #VIEW_W, screenHeight, #PLAYFIELD_PLANES

BLITZ
;; Canonical DisplayLib startup, per both examples in BlitzProgrammers.guide:
;; InitCopList, CreateDisplay, DisplayPalette, BlitzKeys On.
;;
;; $10004 is agacolors + fourbitplanes. Do NOT use $10014: the extra $10 is
;; #smoothscrolling, which the guide says to set only "if you will be scrolling
;; the bitmap". A non-scrolling proof that copies $10014 from a scrolling one
;; gets a black screen. The early tile-map proof (since deleted) used $10004 for the same reason.
;;
;; Use the short InitCopList form: flags only. The long form takes a ypos, and
;; the ypos I invented (#COPPER_YPOS = 44) would have put the assertion row at
;; screen y 282, off the bottom of a 256-line display.
InitCopList 0, #COPPER_FLAGS
CreateDisplay 0
DisplayPalette 0, 0
BlitzKeys On

;; The batch run draws no panel and prints no names; the results file lists each
;; scenario, and the names are in the header. FONTLIB text output was tried and removed.

;; map.blitz.ab3 supplies QueueMetatileRedraw{}, which StartBlockBump{} and
;; FinishBlockBump{} call. The probe never drains the list -- its DrawProbe{}
;; paints the test map itself -- so queued cells just accumulate to
;; #MAX_REDRAW_CELLS and are then dropped, which is harmless.
XINCLUDE "/includes/sparkydave.beam.blitz.ab3"
XINCLUDE "/includes/sparkydave.sound.blitz.ab3"
XINCLUDE "/includes/sparkydave.timing-marks.blitz.ab3"
XINCLUDE "/includes/sparkydave.map.blitz.ab3"
XINCLUDE "/includes/sparkydave.object-system.blitz.ab3"
XINCLUDE "/includes/sparkydave.debris.blitz.ab3"
XINCLUDE "/includes/sparkydave.floaters.blitz.ab3"
XINCLUDE "/includes/sparkydave.collision.blitz.ab3"
XINCLUDE "/includes/sparkydave.player-state.blitz.ab3"
XINCLUDE "/includes/sparkydave.life.blitz.ab3"
XINCLUDE "/includes/sparkydave.enemies.blitz.ab3"
XINCLUDE "/includes/sparkydave.fireballs.blitz.ab3"
XINCLUDE "/includes/sparkydave.levelend.blitz.ab3"
XINCLUDE "/includes/sparkydave.pipes.blitz.ab3"
XINCLUDE "/includes/sparkydave.object-system-runtime.blitz.ab3"
XINCLUDE "/includes/sparkydave.player.blitz.ab3"
XINCLUDE "/includes/sparkydave.hud.blitz.ab3"
XINCLUDE "/includes/sparkydave.frametime.blitz.ab3"
XINCLUDE "/includes/sparkydave.palette.blitz.ab3"
XINCLUDE "/includes/sparkydave.parallax.blitz.ab3"
XINCLUDE "/includes/sparkydave.jukebox.blitz.ab3"
;; The tile sets (sparkydave.tileset.blitz.ab3) are not loaded here: there is no atlas, so there is nothing to change.
Statement EnsureTileSet{}
End Statement
XINCLUDE "/includes/sparkydave.cover.blitz.ab3"

;; ---------------------------------------------------------------
;; Harness
;; ---------------------------------------------------------------

Statement Assert{condition.w}
  SHARED assertIndex, assertResult()
  If assertIndex < #MAX_ASSERTS
    If condition = 0
      assertResult(assertIndex) = 2
    Else
      assertResult(assertIndex) = 3
    EndIf
  EndIf
  assertIndex = assertIndex + 1
End Statement

;; Mirrors the call order in UpdatePlayer{} with scripted buttons. The live
;; vertical integrator is used, not a fixed 2 px stand-in, so the sub-tile
;; gates are exercised through real residues.
Statement Tick{buttons.w}
  SHARED playerButtons, playerButtonsLast, playerRunningTimer
  SHARED sideCollisionTimer, blockBounceTimer, playerOnGround, playerState
  SHARED playerIsBig, playerCollisionBits, worldFreezeTicks, playerSizeAnimTicks
  SHARED playerClimbing, climbAutoUp, climbSideTimer, climbAreaChange, playerY, currentAreaType, jumpSwimTimer
  ;; The master timer and the size picture count down every tick, as in the live UpdatePlayer{}.
  If worldFreezeTicks > 0 Then worldFreezeTicks = worldFreezeTicks - 1
  If playerSizeAnimTicks > 0 Then playerSizeAnimTicks = playerSizeAnimTicks - 1
  ;; Not reset here: ApplyCollisionButtonMask{} below needs the previous
  ;; frame's mask to survive until it is applied, so the reset is after
  ;; that call. Pole/resize branches reset explicitly before returning.
  UpdateFlag{}
  ; The bump clock stays above the pole/resize branches, matching the live
  ; UpdatePlayer{}: the bob ends 16 real ticks after it started even when the
  ; state machine locks out.
  If blockBounceTimer > 0 Then blockBounceTimer = blockBounceTimer - 1
  ;; The decrement above brings the timer to 0 exactly once; that is the tick
  ;; the block's deferred spend/restore lands.
  UpdateBlockBump{}
  If playerState = #PLAYER_ST_DYING
    UpdateDeath{}
    playerButtonsLast = playerButtons
    playerCollisionBits = $ff
    Statement Return
  EndIf
  If playerState = #PLAYER_ST_POLE
    UpdatePoleSlide{}
    playerButtonsLast = playerButtons
    playerCollisionBits = $ff
    Statement Return
  EndIf
  If playerState = #PLAYER_ST_RESIZE
    UpdateResize{}
    playerButtonsLast = playerButtons
    playerCollisionBits = $ff
    Statement Return
  EndIf
  If playerRunningTimer > 0 Then playerRunningTimer = playerRunningTimer - 1
  If sideCollisionTimer > 0 Then sideCollisionTimer = sideCollisionTimer - 1
  If jumpSwimTimer > 0 Then jumpSwimTimer = jumpSwimTimer - 1
  playerButtons = buttons
  ;; Taken over above the status bar, as the live UpdatePlayer{}.
  If climbAutoUp <> False
    playerButtons = #MARIO_BTN_UP
    If playerY <= #CLIMB_AREA_Y Then climbAreaChange = True
  EndIf
  If climbSideTimer > 0 Then climbSideTimer = climbSideTimer - 1
  If playerClimbing = False Then climbSideTimer = #CLIMB_SIDE_TICKS
  ;; The live masking step, not a copy of it: ReadPlayerButtons{} cannot be used
  ;; here because it reads the keyboard, but the mask itself is engine code and
  ;; calling the same routine is the point. See the note above ScenarioWallMask{}.
  ApplyCollisionButtonMask{}
  UpdateCrouch{}
  playerCollisionBits = $ff
  SetPlayerAbsoluteSpeed{}
  ;; The water branch, as the live UpdatePlayer{}'s.
  swimNow.w = False
  If currentAreaType = #AREA_TYPE_WATER Then swimNow = True
  If playerClimbing = False AND swimNow = True
    TryStartSwim{}
    SetupSwimLimits{}
    SwimAnimSpeed{}
    SetPlayerAbsoluteSpeed{}
    ApplySwimFacing{}
    ApplyHorizontalFriction{}
    MovePlayerHorizontal{}
    SetPlayerMovingDirection{}
  EndIf
  If playerClimbing = False AND swimNow = False
    TryStartJump{}
    SetupHorizontalLimits{}
    PrepareGroundMotion{}
    SetPlayerAbsoluteSpeed{}
    ApplyPlayerFacing{}
    ApplyHorizontalFriction{}
    MovePlayerHorizontal{}
    SetPlayerMovingDirection{}
  EndIf
  If playerClimbing <> False
    UpdateClimbMove{}
  EndIf
  CheckPlayerSides{}
  CheckVineGrab{}
  SetPlayerAbsoluteSpeed{}
  If playerClimbing = False
    If swimNow = True
      SelectSwimForce{}
    Else
      SelectVerticalForce{}
    EndIf
    If playerOnGround = False Then MovePlayerVertical{}
  EndIf
  CheckPlayerFeet{}
  CheckPlayerHead{}
  If swimNow = True AND worldFreezeTicks = 0 Then ProcessWhirlpools{}
  CheckPlayerCoins{}
  CheckPitDeath{}
  UpdatePlayerCamera{}
  UpdatePlayerBoundBox{}
  SetPlayerAbsoluteSpeed{}
  UpdatePlayerAnimation{}
  CheckFlagpole{}
  playerButtonsLast = playerButtons
End Statement

Statement ClearTestMap{}
  SHARED metatileBuffer()
  For testCell = 0 To #MAP_CELLS - 1
    metatileBuffer(testCell) = 0
  Next
End Statement

Statement SetTestCell{testRow.w, testColumn.w, testClass.w}
  SHARED metatileBuffer()
  metatileBuffer(testRow*#MAP_W + testColumn) = testClass
End Statement

Statement SetTestRun{testRow.w, firstColumn.w, lastColumn.w, testClass.w}
  For runColumn = firstColumn To lastColumn
    SetTestCell{testRow, runColumn, testClass}
  Next
End Statement

Statement PlacePlayer{startX.w, startY.w}
  SHARED playerX, playerY, playerFacing, playerFrame, playerAnimTimer
  SHARED playerAnimPeriod, playerOnGround, playerButtons, playerButtonsLast
  SHARED playerSpeedX, playerMoveForceX, playerFractionX, cameraFractionX
  SHARED playerSpeedY, playerMoveForceY, playerFractionY, playerVerticalForce, playerFallForce
  SHARED playerSpeedAbsolute, playerRunningTimer, playerRunningSpeed
  SHARED playerMovingDirection, playerFacingDirection
  SHARED playerScreenX, playerJumpOriginY, sideCollisionTimer, blockBounceTimer, jumpBufferTimer, coyoteTimer
  SHARED boundBoxLeft, boundBoxTop, boundBoxRight, boundBoxBottom, cameraX
  SHARED playerState, playerPoleTimer, flagState, flagX, flagY
  ;; TRAP, learned the hard way by ScenarioFlagpole{}. This mirrors
  ;; InitPlayer{}, which is right for #MARIO_START_X and wrong for anywhere
  ;; else: cameraX is left at 0, and UpdatePlayerCamera{} clamps playerX to
  ;; cameraX + #VIEW_W - 16. A scenario that places the player far from the
  ;; start must advance cameraX to where running there would have left it, and
  ;; set playerScreenX to match, or the player is dragged back to the left edge
  ;; on the first tick.
  playerX = startX
  playerY = startY
  playerFacing = #MARIO_FACE_RIGHT
  playerFrame = #MARIO_F_IDLE
  playerAnimTimer = 0
  playerAnimPeriod = #MARIO_ANIM_SLOW
  playerOnGround = True
  playerButtons = 0
  playerButtonsLast = 0
  playerSpeedX = 0
  playerMoveForceX = 0
  playerFractionX = 0
  cameraFractionX = 0
  playerSpeedY = 0
  playerMoveForceY = 0
  playerFractionY = 0
  playerVerticalForce = 0
  playerFallForce = #MARIO_GRAV_FALL_INIT
  playerSpeedAbsolute = 0
  playerRunningTimer = 0
  playerRunningSpeed = 0
  playerMovingDirection = #MARIO_BTN_RIGHT
  playerFacingDirection = #MARIO_BTN_RIGHT
  playerScreenX = startX
  playerJumpOriginY = startY
  sideCollisionTimer = 0
  blockBounceTimer = 0
  jumpBufferTimer = 0
  coyoteTimer = 0
  boundBoxLeft = playerX + #BOUND_LEFT
  boundBoxTop = playerY + #BOUND_TOP
  boundBoxRight = playerX + #BOUND_RIGHT
  boundBoxBottom = playerY + #BOUND_BOTTOM
  cameraX = 0
  ; Mirrors InitPlayer{}: the flagpole state has to start clean, or a scenario
  ; that leaves him on the pole would leak into the next one.
  playerState = #PLAYER_ST_FREE
  playerPoleTimer = 0
  flagState = #FLAG_ST_IDLE
  flagX = (#FLAGPOLE_X/#TILE)*#TILE + #FLAGPOLE_SHAFT_X - #FLAG_W + 1
  flagY = #FLAGPOLE_Y + #FLAG_TOP_DY
End Statement

Statement BuildFlatMap{}
  ClearTestMap{}
  SetTestRun{#FLOOR_ROW, 0, #MAP_W - 1, #MT_GROUND}
End Statement

Statement BuildLedgeMap{lastColumn.w}
  ClearTestMap{}
  SetTestRun{#FLOOR_ROW, 0, lastColumn, #MT_GROUND}
End Statement

;; ---------------------------------------------------------------
;; Scenarios
;; ---------------------------------------------------------------

;; Hold Right+B until the run latch sets, idle with no buttons, coast to a stop,
;; then press the direction OPPOSITE to playerMovingDirection (which must leave
;; the latch set -- the skid path), and finally the direction that MATCHES it
;; (which must clear it).
;;
;; Do not hardcode the direction. playerMovingDirection is only rewritten when
;; the speed is non-zero, and the friction path does not clamp at zero, so a
;; coasting player crosses through +/-1 subpixel and settles with the flag
;; holding whichever sign the last non-zero speed had. Pressing a fixed
;; direction would be testing the deceleration arithmetic, not the rule.
Statement ScenarioRunLatch{}
  SHARED playerRunningSpeed, playerMovingDirection
  BuildFlatMap{}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For warmupTick = 0 To 89
    Tick{#MARIO_BTN_RIGHT + #MARIO_BTN_RUN}
  Next
  Assert{playerRunningSpeed <> 0}
  For idleTick = 0 To #IDLE_TICKS - 1
    Tick{0}
  Next
  Assert{playerRunningSpeed <> 0}
  For coastTick = 0 To 59
    Tick{0}
  Next
  Assert{playerRunningSpeed <> 0}
  ; Opposite direction: takes the ProcSkid path, must not clear the latch.
  oppositeBits.w = Xor(playerMovingDirection, #MARIO_BTN_LEFT + #MARIO_BTN_RIGHT)
  Tick{oppositeBits}
  Assert{playerRunningSpeed <> 0}
  ; Re-read the flag: that tick may have flipped it, since the friction path
  ; can leave the speed at +/-1.
  matchBits.w = playerMovingDirection
  If matchBits = 0 Then matchBits = #MARIO_BTN_RIGHT
  Tick{matchBits}
  Assert{playerRunningSpeed = 0}
End Statement

;; Jump into hard terrain two tiles up. There is no snap: the head hit only
;; changes the vertical speed. The head probe is at +2, inside the sprite, so
;; Mario rises into the ceiling before the bump can fire.
;;
;; The bump is found as the first tick that failed to rise, which is the only
;; place CheckPlayerHead can have acted.
;;
;; The gate assertion is on the STOP position, not on every residue seen while
;; climbing. The gate skips the head check at residues 0-3; it does not stop him
;; there, so a 4 px/tick rise cycles 4, 8, 12, 0, 12, 8, 4, 0, 12 and passes
;; through 0 perfectly legally. Asserting a minimum over the whole rise measures
;; the climb step, not the gate.
Statement ScenarioCeiling{}
  SHARED stoppedY, riseEndSpeedY, postBumpY, previousY
  SHARED playerY, playerSpeedY
  BuildFlatMap{}
  SetTestRun{#CEILING_ROW, 2, 4, #MT_GROUND}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  previousY.w = playerY
  For riseTick = 0 To 79
    Tick{#MARIO_BTN_JUMP}
    If stoppedY = 0 AND playerY < previousY Then riseEndSpeedY = playerSpeedY
    If stoppedY = 0
      If playerY >= previousY
        stoppedY = previousY
      EndIf
    EndIf
    If postBumpY = 0
      If playerY > stoppedY Then postBumpY = playerY
    EndIf
    previousY = playerY
  Next
  Assert{stoppedY <> 0}
  ; The gate, not the sprite, is what stopped him: the bump cannot fire at
  ; residues 0-3, so stopping on one would mean the check ran anyway.
  Assert{(stoppedY AND $0f) >= #MT_HEAD_MIN_SUBTILE}
  ; The head probe finished inside the ceiling tile, so he clipped in.
  Assert{stoppedY + #PROBE_TOP_Y >= #CEILING_ROW*#TILE}
  Assert{stoppedY + #PROBE_TOP_Y < (#CEILING_ROW + 1)*#TILE}
  ; Hard terrain takes the solid path: downward speed 1, no position change.
  ; The hit sets 1 (a bump would set 0). Read on the tick he last rose: the tick after, the
  ; fraction may carry it to 2, which depends on the variant's forces.
  Assert{riseEndSpeedY = 1}
  Assert{playerY > stoppedY}
End Statement

;; Run right into a wall, then stop pushing. The timer must be set to
;; #MARIO_SIDECOLLIDE on the hit tick and expire exactly that many ticks later.
;; The camera gate is then checked white-box by forcing the timer on and off
;; while Mario is free to move, which a wall-pinned Mario never is.
Statement ScenarioSideCollide{}
  SHARED cameraHeldTicks, hitTimerValue, hitTick
  SHARED sideCollisionTimer, cameraX
  SHARED gateCameraX, gateHeld, gateFreed
  BuildFlatMap{}
  SetTestRun{#FLOOR_ROW - 1, #WALL_COLUMN, #MAP_W - 1, #MT_GROUND}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For wallTick = 0 To 119
    If hitTick = 0
      Tick{#MARIO_BTN_RIGHT + #MARIO_BTN_RUN}
    Else
      Tick{0}
    EndIf
    If sideCollisionTimer = #MARIO_SIDECOLLIDE
      hitTimerValue = sideCollisionTimer
      If hitTick = 0
        hitTick = wallTick
      EndIf
      ;; Counted again from the latest hit: a faster Mario can be pushed out of the wall over
      ;; two or three ticks, and each push sets the timer again.
      cameraHeldTicks = 0
    EndIf
    If hitTick > 0
      If sideCollisionTimer > 0
        cameraHeldTicks = cameraHeldTicks + 1
      EndIf
    EndIf
  Next
  Assert{hitTimerValue = #MARIO_SIDECOLLIDE}
  Assert{cameraHeldTicks = #MARIO_SIDECOLLIDE}
  Assert{sideCollisionTimer = 0}
  ; Gate check: forced timer holds the camera, clearing it releases the camera.
  BuildFlatMap{}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For gateTick = 0 To 39
    Tick{#MARIO_BTN_RIGHT + #MARIO_BTN_RUN}
  Next
  gateCameraX.w = cameraX
  sideCollisionTimer = 8
  Tick{#MARIO_BTN_RIGHT + #MARIO_BTN_RUN}
  gateHeld = True
  If cameraX <> gateCameraX Then gateHeld = False
  sideCollisionTimer = 0
  Tick{#MARIO_BTN_RIGHT + #MARIO_BTN_RUN}
  gateFreed = True
  If cameraX = gateCameraX Then gateFreed = False
  Assert{gateHeld = True}
  Assert{gateFreed = True}
End Statement

;; The tile-collision box is 12 px wide, so the right probe is at
;; playerX + #PROBE_SIDE_X2 and a pinned player must rest with that probe
;; short of the wall face. ImpedePlayerMove pushes 1 px rather than snapping,
;; so the probe sits 1 or 2 px back, never inside the wall.
Statement ScenarioBoxSide{}
  SHARED pinnedRightProbe, playerX
  BuildFlatMap{}
  SetTestRun{#FLOOR_ROW - 1, #WALL_COLUMN, #MAP_W - 1, #MT_GROUND}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For pinTick = 0 To 199
    Tick{#MARIO_BTN_RIGHT + #MARIO_BTN_RUN}
  Next
  pinnedRightProbe = playerX + #PROBE_SIDE_X2
  Assert{pinnedRightProbe <= #WALL_COLUMN*#TILE - 1}
  Assert{pinnedRightProbe >= #WALL_COLUMN*#TILE - 2}
  ; The sprite is 16 px wide and the box 12, so the sprite overhangs the box
  ; by 2 px on the side that is not against the wall.
  Assert{playerX + #TILE - 1 > #WALL_COLUMN*#TILE - 1}
End Statement

;; Check the ExIPM separation path directly from both sides. The player is
;; deliberately one probe deep into the blocked cell: moving away must bail
;; before changing position, speed, or the side-collision timer, while moving
;; into the same cell must apply the one-pixel correction. The final case pins
;; both probes in solid cells with zero speed to document the fallback in
;; CheckPlayerSides{}.
Statement ScenarioSideAway{}
  SHARED playerX, playerY, playerSpeedX, sideCollisionTimer, playerCollisionBits
  BuildFlatMap{}
  SetTestCell{#FLOOR_ROW - 1, #WALL_COLUMN, #MT_GROUND}
  PlacePlayer{#WALL_COLUMN*#TILE - 8, (#FLOOR_ROW - 1)*#TILE}
  playerSpeedX = -16
  playerCollisionBits = $ff
  sideCollisionTimer = 0
  beforeX.w = playerX
  CheckPlayerSides{}
  Assert{playerX = beforeX}
  Assert{playerSpeedX = -16}
  Assert{sideCollisionTimer = 0}
  Assert{playerCollisionBits = Xor($ff, #MARIO_BTN_RIGHT)}

  playerX = #WALL_COLUMN*#TILE - 8
  playerSpeedX = 16
  playerCollisionBits = $ff
  sideCollisionTimer = 0
  beforeX = playerX
  CheckPlayerSides{}
  Assert{playerX = beforeX - 1}
  Assert{playerSpeedX = 0}
  Assert{sideCollisionTimer = #MARIO_SIDECOLLIDE}

  BuildFlatMap{}
  SetTestCell{#FLOOR_ROW - 1, #WALL_COLUMN, #MT_GROUND}
  PlacePlayer{#WALL_COLUMN*#TILE + 4, (#FLOOR_ROW - 1)*#TILE}
  playerSpeedX = 16
  playerCollisionBits = $ff
  sideCollisionTimer = 0
  beforeX = playerX
  CheckPlayerSides{}
  Assert{playerX = beforeX}
  Assert{playerSpeedX = 16}
  Assert{playerCollisionBits = Xor($ff, #MARIO_BTN_LEFT)}

  playerX = #WALL_COLUMN*#TILE + 4
  playerSpeedX = -16
  playerCollisionBits = $ff
  sideCollisionTimer = 0
  beforeX = playerX
  CheckPlayerSides{}
  Assert{playerX = beforeX + 1}
  Assert{playerSpeedX = 0}
  Assert{sideCollisionTimer = #MARIO_SIDECOLLIDE}

  BuildFlatMap{}
  SetTestCell{#FLOOR_ROW - 1, #WALL_COLUMN, #MT_GROUND}
  SetTestCell{#FLOOR_ROW - 1, #WALL_COLUMN + 1, #MT_GROUND}
  PlacePlayer{#WALL_COLUMN*#TILE, (#FLOOR_ROW - 1)*#TILE}
  playerSpeedX = 0
  playerCollisionBits = $ff
  sideCollisionTimer = 0
  beforeX = playerX
  CheckPlayerSides{}
  ; Both probes are blocked; zero speed takes the documented rightward fallback.
  Assert{playerX = beforeX + 1}
  Assert{playerSpeedX = 0}
  Assert{sideCollisionTimer = #MARIO_SIDECOLLIDE}
End Statement

;; Ground support is re-derived every frame from the foot probes as an OR, so
;; there is no separate pass and no walk-off hover. Count the ticks where the
;; player is still flagged grounded but his trailing foot probe is already over
;; nothing: the old both-feet rule produced ticks of exactly that.
Statement ScenarioLeave{}
  SHARED hoverTicks, playerOnGround, playerX, playerY
  BuildLedgeMap{9}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For leaveTick = 0 To 179
    Tick{#MARIO_BTN_RIGHT + #MARIO_BTN_RUN}
    If playerOnGround = True
      If MetatileAt{playerX + #PROBE_FOOT_X1, playerY + #PROBE_FOOT_Y} = #MT_EMPTY
        hoverTicks = hoverTicks + 1
      EndIf
    EndIf
  Next
  Assert{playerX > 10*#TILE}
  Assert{playerOnGround = False}
  Assert{hoverTicks = 0}
End Statement

;; Capture the bump's three beats, shared by the two block scenarios. The bump
;; is now clear -> bob -> restore, so the block's state moves across 16 ticks
;; instead of settling on the bump tick:
;;   - the ARM tick, keyed on the lockout being armed: blockBounceTimer is set
;;     to #MARIO_BLOCKBOUNCE by CheckPlayerHead{} during that tick and
;;     decremented at the top of the next one, so it reads exactly
;;     #MARIO_BLOCKBOUNCE here and only there. playerSpeedY is only exactly 0
;;     on that tick, and the cell has just cleared to sky.
;;   - the MID tick, keyed on the timer's midpoint: one tick of the run has the
;;     timer at half its lockout, and the cell must still be sky under the bob.
;;   - the FINISH tick, keyed on blockBumpActive clearing: the timer reached 0
;;     and FinishBlockBump{} ran, so the class and GID have settled.
;;
;; Everything has to be read ON its tick, not after the loop: by the end of the
;; run Mario is back on the floor, so computing the cell from the final playerY
;; would read the floor instead of the block.
Statement CaptureBlockBump{}
  SHARED stoppedY, armSpeedY, armTimer, armClass, armGid
  SHARED midClass, midGid, finishClass, finishGid, finishTimer
  SHARED bumpHeadRow, bumpHeadColumn, bumpFinished
  SHARED playerY, playerSpeedY, blockBounceTimer, blockBumpActive, headProbeY, playerX, mapWidth
  SHARED metatileBuffer(), mapBuffer()
  If stoppedY = 0
    If blockBounceTimer = #MARIO_BLOCKBOUNCE
      stoppedY = playerY
      armSpeedY = playerSpeedY
      armTimer = blockBounceTimer
      bumpHeadRow.w = (playerY + headProbeY)/#TILE
      bumpHeadColumn.w = (playerX + #PROBE_TOP_X)/#TILE
      armClass.w = metatileBuffer(bumpHeadRow.w*mapWidth + bumpHeadColumn.w)
      armGid.w = mapBuffer(bumpHeadRow.w*mapWidth + bumpHeadColumn.w)
    EndIf
    Statement Return
  EndIf
  bumpCell.w = bumpHeadRow.w*mapWidth + bumpHeadColumn.w
  If blockBounceTimer = #MARIO_BLOCKBOUNCE/2
    midGid.w = mapBuffer(bumpCell)
    midClass.w = metatileBuffer(bumpCell)
  EndIf
  If blockBumpActive = False
    If bumpFinished = False
      bumpFinished = True
      finishClass.w = metatileBuffer(bumpCell)
      finishGid.w = mapBuffer(bumpCell)
      finishTimer = blockBounceTimer
    EndIf
  EndIf
End Statement

;; A question block is not a solid metatile, so it takes the block path rather
;; than the hard bump: the speed is cleared and the lockout arms on the bump
;; tick, the cell clears to sky for the whole 16-frame bob, and only when the
;; timer runs out does the class become the used block and mapBuffer take the
;; spent GID (the look's: #SPENT_BLOCK_GID, 4 in the NES look, 139 in the All-Stars look). Big Mario gets the same bump and starts no chunks: only bricks break.
Statement ScenarioQuestionBlock{}
  SHARED stoppedY, armSpeedY, armTimer, armClass, armGid
  SHARED midClass, midGid, finishClass, finishGid, finishTimer
  SHARED mapBuffer(), playerIsBig, bumpFinished, debrisActive()
  BuildFlatMap{}
  SetTestRun{#CEILING_ROW, 2, 4, #MT_QUESTION}
  ; Give the `?` cells their GID so the clear to sky is observable: the test
  ; map's mapBuffer is 0 everywhere, so armGid/midGid would pass whether or
  ; not StartBlockBump{} cleared the cell. GID 24 is the `?`'s Tiled GID
  ; (the main project's LEVEL_FORMAT note's class table).
  For questionColumn = 2 To 4
    mapBuffer(#CEILING_ROW*#MAP_W + questionColumn) = 24
  Next
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  stoppedY = 0
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
    CaptureBlockBump{}
  Next
  Assert{stoppedY <> 0}
  ; The block path clears the speed outright, unlike the hard bump's 1. The
  ; latch assertion above guards the rest: every value below is only written
  ; on the tick that armed the bump.
  Assert{armSpeedY = 0}
  ; Armed on the bump tick and not yet decremented, because we read it there.
  Assert{armTimer = #MARIO_BLOCKBOUNCE}
  ; The bump cell stays a question block until the settle...
  Assert{armClass = #MT_QUESTION}
  ; ...and its art is cleared to sky under the bob from the bump tick on.
  Assert{armGid = 0}
  ; ...and still is, at the middle of the bob.
  Assert{midClass = #MT_QUESTION}
  Assert{midGid = 0}
  ; The settle lands when the timer reaches 0.
  Assert{finishClass = #MT_BLOCK}
  Assert{finishGid = #SPENT_BLOCK_GID}
  Assert{finishTimer = 0}

  ; Big Mario, on fresh question blocks: the same bump, and no chunks.
  playerIsBig = True
  debrisActive(0) = False
  debrisActive(1) = False
  SetTestRun{#CEILING_ROW, 2, 4, #MT_QUESTION}
  For questionColumn = 2 To 4
    mapBuffer(#CEILING_ROW*#MAP_W + questionColumn) = 24
  Next
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  bumpFinished = False
  stoppedY = 0
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
    CaptureBlockBump{}
  Next
  Assert{stoppedY <> 0}
  Assert{armSpeedY = 0}
  Assert{armClass = #MT_QUESTION}
  Assert{armGid = 0}
  Assert{finishClass = #MT_BLOCK}
  Assert{finishGid = #SPENT_BLOCK_GID}
  bigSets.w = BrickDebrisSetsActive{}
  Assert{bigSets = 0}
  playerIsBig = False
End Statement

;; Small Mario cannot break bricks. PlayerHeadCollision sets the block state
;; unbreakable for a small player and only breakable for a big one, so the
;; brick stays a brick and the speed is cleared rather than kicked. The bump
;; still runs the full bob: the cell clears to sky for 16 frames, and the
;; settle restores the brick's own GID rather than leaving it empty.
Statement ScenarioBrick{}
  SHARED stoppedY, armSpeedY, armTimer, armClass, armGid
  SHARED midClass, midGid, finishClass, finishGid, finishTimer
  SHARED mapBuffer()
  BuildFlatMap{}
  SetTestRun{#CEILING_ROW, 2, 4, #MT_BRICK}
  ; Give the brick cells their GID so the restore is observable: StartBlockBump
  ; saves the cell's GID when it clears the cell, and FinishBlockBump writes it
  ; back. GID 2 is the brick's Tiled GID (the main project's LEVEL_FORMAT note's class table).
  For brickColumn = 2 To 4
    mapBuffer(#CEILING_ROW*#MAP_W + brickColumn) = 2
  Next
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  stoppedY = 0
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
    CaptureBlockBump{}
  Next
  Assert{stoppedY <> 0}
  Assert{armSpeedY = 0}
  Assert{armTimer = #MARIO_BLOCKBOUNCE}
  ; The class never changes...
  Assert{armClass = #MT_BRICK}
  ; ...but the art is cleared to sky under the bob from the bump tick on.
  Assert{armGid = 0}
  Assert{midClass = #MT_BRICK}
  Assert{midGid = 0}
  ; ...and the settle puts the brick's own GID back.
  Assert{finishClass = #MT_BRICK}
  Assert{finishGid = 2}
  Assert{finishTimer = 0}
  ; Small Mario breaks nothing: no chunks.
  setsActive.w = BrickDebrisSetsActive{}
  Assert{setsActive = 0}
End Statement

;; Jump big Mario from startX at the brick row and report his vertical speed on
;; the tick the head hit broke a brick (known by the score moving), or 999 if no
;; break happened in 40 ticks. Goes through the real CheckPlayerHead{}.
Function.w JumpAndBreak{startX.w}
  SHARED playerIsBig, playerSpeedY, hudScore
  PlacePlayer{startX, (#FLOOR_ROW - 1)*#TILE}
  playerIsBig = True
  scoreBefore.l = hudScore
  speedAtBreak.w = 999
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
    If speedAtBreak = 999
      If hudScore <> scoreBefore Then speedAtBreak = playerSpeedY
    EndIf
  Next
  Function Return speedAtBreak
End Function

;; Big Mario breaks a brick instead of bumping it (BrickShatter, smbdis 7379).
;; Three bricks, jump from under the middle one. On the break tick: chunks are
;; flying, there is no bump in progress (no bob), the lockout is armed, and his
;; speed is -2 where a bump would leave 0. The cell is empty for both collision
;; and art at once, and the neighbours are untouched. Three ticks later he is
;; higher than at the break, which is only true if the cell really let him
;; through.
;;
;; Then the two chunk sets, through real head hits. Tick{} does not step the
;; chunks, so the first set is still flying when he jumps under a second brick:
;; both break, two sets fly, nothing is refused and his jump is not cut off. A
;; third break inside the first's lifetime takes over the first set, as the
;; cartridge's alternating block objects do, so two sets stay active and set 0
;; restarts at the third brick.
Statement ScenarioBrickBreak{}
  SHARED playerIsBig, playerY, playerSpeedY, blockBounceTimer, blockBumpActive
  SHARED hudScore, metatileBuffer(), mapBuffer(), debrisX(), debrisActive()
  SHARED debrisNextSet
  BuildFlatMap{}
  SetTestRun{#CEILING_ROW, 2, 4, #MT_BRICK}
  SetTestRun{#CEILING_ROW, 8, 10, #MT_BRICK}
  SetTestRun{#CEILING_ROW, 14, 16, #MT_BRICK}
  For brickColumn = 2 To 16
    mapBuffer(#CEILING_ROW*#MAP_W + brickColumn) = 2
  Next
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  playerIsBig = True
  debrisActive(0) = False
  debrisActive(1) = False
  debrisNextSet = 0
  scoreBefore.l = hudScore
  breakTick.w = -1
  breakY.w = 0
  breakSpeed.w = 0
  breakTimer.w = 0
  breakBumpActive.w = True
  afterY.w = 0
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
    If breakTick < 0
      If hudScore <> scoreBefore
        breakTick = riseTick
        breakY = playerY
        breakSpeed = playerSpeedY
        breakTimer = blockBounceTimer
        breakBumpActive = blockBumpActive
      EndIf
    Else
      If riseTick = breakTick + 3 Then afterY = playerY
    EndIf
  Next
  emptyCount.w = 0
  brickCount.w = 0
  brokenGid.w = -1
  For brickColumn = 2 To 4
    checkCell.w = #CEILING_ROW*#MAP_W + brickColumn
    If metatileBuffer(checkCell) = #MT_EMPTY
      emptyCount = emptyCount + 1
      brokenGid = mapBuffer(checkCell)
    Else
      brickCount = brickCount + 1
    EndIf
  Next
  Assert{breakTick >= 0}
  Assert{breakSpeed = #BRICK_BREAK_SPEED_Y}
  Assert{breakTimer = #MARIO_BLOCKBOUNCE}
  Assert{breakBumpActive = False}
  Assert{emptyCount = 1}
  Assert{brickCount = 2}
  Assert{brokenGid = 0}
  Assert{hudScore = scoreBefore + #SCORE_BRICK}
  Assert{afterY < breakY}
  setsActive.w = BrickDebrisSetsActive{}
  Assert{setsActive = 1}

  ; A second brick while the first set still flies: both sets active, a real
  ; break with the full -2 kick, and 100 points in all.
  secondSpeed.w = JumpAndBreak{144}
  setsActive = BrickDebrisSetsActive{}
  Assert{setsActive = 2}
  Assert{secondSpeed = #BRICK_BREAK_SPEED_Y}
  Assert{hudScore = scoreBefore + 2*#SCORE_BRICK}
  ; A third takes over set 0: still two sets, set 0 restarts at the third
  ; brick's column (14 or 15, by the head probe's X), 150 points, full kick.
  thirdSpeed.w = JumpAndBreak{224}
  setsActive = BrickDebrisSetsActive{}
  Assert{setsActive = 2}
  Assert{debrisX(0)/256 >= 14*#TILE}
  Assert{thirdSpeed = #BRICK_BREAK_SPEED_Y}
  Assert{hudScore = scoreBefore + 3*#SCORE_BRICK}
  ; Leave the world as the other scenarios expect it.
  guardTicks.w = 0
  setsActive = BrickDebrisSetsActive{}
  While setsActive > 0 AND guardTicks < 400
    UpdateBrickDebris{}
    guardTicks = guardTicks + 1
    setsActive = BrickDebrisSetsActive{}
  Wend
  playerIsBig = False
End Statement

;; Floating coin tiles collected from below. Coins sit one row above three
;; blocks (a brick bumped by small Mario, a `?` bumped by small Mario, a brick
;; broken by big Mario) and not above a fourth, a control brick. Each jump goes
;; through the real CheckPlayerHead{}. Tick{} does not step the object pool, so
;; the popped coins are still objects at the end.
Statement ScenarioCoinAbove{}
  SHARED mapBuffer(), metatileBuffer(), playerIsBig, objActive(), objType()
  SHARED objX(), objY()
  BuildFlatMap{}
  SetTestRun{#CEILING_ROW, 2, 4, #MT_BRICK}
  SetTestRun{#CEILING_ROW, 6, 8, #MT_QUESTION}
  SetTestRun{#CEILING_ROW, 10, 12, #MT_BRICK}
  SetTestRun{#CEILING_ROW, 14, 16, #MT_BRICK}
  coinRow.w = #CEILING_ROW - 1
  mapBuffer(coinRow*#MAP_W + 3) = #COIN_TILE_GID
  mapBuffer(coinRow*#MAP_W + 7) = #COIN_TILE_GID
  mapBuffer(coinRow*#MAP_W + 11) = #COIN_TILE_GID
  playerIsBig = False
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
  Next
  PlacePlayer{112, (#FLOOR_ROW - 1)*#TILE}
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
  Next
  breakSpeed.w = JumpAndBreak{176}
  playerIsBig = False
  coinsBeforeControl.w = 0
  For poolIndex = 0 To #MAX_OBJECTS - 1
    If objActive(poolIndex) = True AND objType(poolIndex) = #OBJ_COIN Then coinsBeforeControl = coinsBeforeControl + 1
  Next
  PlacePlayer{224, (#FLOOR_ROW - 1)*#TILE}
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
  Next
  coinObjects.w = 0
  foundFirst.w = False
  For poolIndex = 0 To #MAX_OBJECTS - 1
    If objActive(poolIndex) = True AND objType(poolIndex) = #OBJ_COIN
      coinObjects = coinObjects + 1
      If objX(poolIndex) = 3*#TILE
        If objY(poolIndex) = coinRow*#TILE Then foundFirst = True
      EndIf
    EndIf
  Next
  Assert{mapBuffer(coinRow*#MAP_W + 3) = 0}
  Assert{mapBuffer(coinRow*#MAP_W + 7) = 0}
  Assert{mapBuffer(coinRow*#MAP_W + 11) = 0}
  Assert{coinsBeforeControl = 3}
  Assert{coinObjects = 3}
  Assert{foundFirst = True}
  ; The blocks still behave as before.
  Assert{metatileBuffer(#CEILING_ROW*#MAP_W + 7) = #MT_BLOCK}
  Assert{metatileBuffer(#CEILING_ROW*#MAP_W + 11) = #MT_EMPTY}
  Assert{breakSpeed = #BRICK_BREAK_SPEED_Y}
  ; Leave no coin tiles behind for the scenarios after this one.
  mapBuffer(coinRow*#MAP_W + 3) = 0
  mapBuffer(coinRow*#MAP_W + 7) = 0
  mapBuffer(coinRow*#MAP_W + 11) = 0
  setsLeft.w = BrickDebrisSetsActive{}
  guardTicks.w = 0
  While setsLeft > 0 AND guardTicks < 400
    UpdateBrickDebris{}
    guardTicks = guardTicks + 1
    setsLeft = BrickDebrisSetsActive{}
  Wend
End Statement

;; Touching a floating coin collects it at once, with no object and no arc.
;; Mario stands at the start with a coin tile in the cell his side probes sit in
;; and a second coin two cells to the right. The first goes on the first tick:
;; one coin and 200 points, the cell cleared. The second stays until he walks
;; into it, and the count never moves for a coin already taken.
Statement ScenarioCoinTouch{}
  SHARED mapBuffer(), hudCoins, hudScore, objActive(), objType()
  BuildFlatMap{}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  bodyRow.w = #FLOOR_ROW - 1
  mapBuffer(bodyRow*#MAP_W + 3) = #COIN_TILE_GID
  mapBuffer(bodyRow*#MAP_W + 5) = #COIN_TILE_GID
  coinsBefore.w = hudCoins
  scoreBefore.l = hudScore
  For idleTick = 0 To 2
    Tick{0}
  Next
  Assert{mapBuffer(bodyRow*#MAP_W + 3) = 0}
  Assert{hudCoins = coinsBefore + 1}
  Assert{hudScore = scoreBefore + #SCORE_COIN}
  ; Not touched yet.
  Assert{mapBuffer(bodyRow*#MAP_W + 5) = #COIN_TILE_GID}
  For walkTick = 0 To 59
    Tick{#MARIO_BTN_RIGHT}
  Next
  Assert{mapBuffer(bodyRow*#MAP_W + 5) = 0}
  Assert{hudCoins = coinsBefore + 2}
  Assert{hudScore = scoreBefore + 2*#SCORE_COIN}
  ; No coin object: a touched coin does not arc.
  touchPoolCoins.w = 0
  For poolIndex = 0 To #MAX_OBJECTS - 1
    If objActive(poolIndex) = True AND objType(poolIndex) = #OBJ_COIN Then touchPoolCoins = touchPoolCoins + 1
  Next
  Assert{touchPoolCoins = 0}
End Statement

;; The brick with coins. The generated multiCoinCell(0) points at the real 1-1
;; brick, so the scenario aims it at a test brick and restores it after. A small
;; Mario hit, then a big Mario hit on the same brick: each pays one coin and 200
;; points on the hit tick (blockBounceTimer is still full, armed that tick), the
;; brick stays class MT_BRICK with its GID, and the big hit starts no chunks.
;; Then the timer, driven directly through UpdateIntervalTimers{}: from the longest
;; phase it takes 231 ticks and from the shortest 211, the cartridge's 211 to
;; 231 window. The hit after that still pays and settles as the used block; one
;; more pays nothing.
Statement ScenarioMultiCoin{}
  SHARED mapBuffer(), metatileBuffer(), multiCoinCell(), multiCoinStarted()
  SHARED multiCoinIntervals(), intervalPhase, hudCoins, hudScore, playerIsBig
  SHARED blockBounceTimer
  BuildFlatMap{}
  multiCell.w = #CEILING_ROW*#MAP_W + 3
  savedCell.w = multiCoinCell(0)
  multiCoinCell(0) = multiCell
  SetTestRun{#CEILING_ROW, 2, 4, #MT_BRICK}
  mapBuffer(multiCell) = 2
  multiCoinStarted(0) = False
  multiCoinIntervals(0) = 0
  intervalPhase = #INTERVAL_PERIOD - 1
  playerIsBig = False
  coinsBefore.w = hudCoins
  scoreBefore.l = hudScore
  payTimer.w = -1
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
    If payTimer < 0
      If hudCoins <> coinsBefore Then payTimer = blockBounceTimer
    EndIf
  Next
  Assert{payTimer = #MARIO_BLOCKBOUNCE}
  Assert{hudCoins = coinsBefore + 1}
  Assert{hudScore = scoreBefore + #SCORE_COIN}
  Assert{multiCoinStarted(0) = True}
  Assert{multiCoinIntervals(0) = #MULTI_COIN_INTERVALS}
  Assert{metatileBuffer(multiCell) = #MT_BRICK}
  Assert{mapBuffer(multiCell) = 2}

  ; Big Mario bumps it too and does not break it.
  playerIsBig = True
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
  Next
  bigSets.w = BrickDebrisSetsActive{}
  Assert{hudCoins = coinsBefore + 2}
  Assert{metatileBuffer(multiCell) = #MT_BRICK}
  Assert{bigSets = 0}
  playerIsBig = False

  ; The timer window.
  intervalPhase = #INTERVAL_PERIOD - 1
  multiCoinIntervals(0) = #MULTI_COIN_INTERVALS
  longTicks.w = 0
  While multiCoinIntervals(0) > 0 AND longTicks < 400
    UpdateIntervalTimers{}
    longTicks = longTicks + 1
  Wend
  intervalPhase = 0
  multiCoinIntervals(0) = #MULTI_COIN_INTERVALS
  shortTicks.w = 0
  While multiCoinIntervals(0) > 0 AND shortTicks < 400
    UpdateIntervalTimers{}
    shortTicks = shortTicks + 1
  Wend
  ;; 11 intervals from a full phase, and from an empty one the first interval comes a tick in (NTSC
  ;; 231 and 211; PAL 198 and 181).
  Assert{longTicks = #MULTI_COIN_INTERVALS*#INTERVAL_PERIOD AND shortTicks = 1 + (#MULTI_COIN_INTERVALS - 1)*#INTERVAL_PERIOD}

  ; Expired: this hit still pays, and settles as the used block.
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
  Next
  Assert{hudCoins = coinsBefore + 3}
  Assert{metatileBuffer(multiCell) = #MT_BLOCK}
  Assert{mapBuffer(multiCell) = #SPENT_BLOCK_GID}
  ; A used block pays nothing.
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
  Next
  Assert{hudCoins = coinsBefore + 3}
  multiCoinCell(0) = savedCell
  multiCoinStarted(0) = False
  multiCoinIntervals(0) = 0
End Statement

;; A `?` block's coin is paid on the hit. Table entry 1 is a coin `?` in the real
;; level; the scenario aims it at a test block and restores it. The coin and its
;; 200 points land on the hit tick, and nothing more is paid at the settle (16
;; ticks later) or when the coin's arc ends (32 ticks after that), which the
;; object step below runs through.
Statement ScenarioCoinOnHit{}
  SHARED mapBuffer(), metatileBuffer(), blockItemCell(), hudCoins, hudScore
  SHARED blockBounceTimer
  BuildFlatMap{}
  SetTestRun{#CEILING_ROW, 2, 4, #MT_QUESTION}
  For questionColumn = 2 To 4
    mapBuffer(#CEILING_ROW*#MAP_W + questionColumn) = 24
  Next
  questionCell.w = #CEILING_ROW*#MAP_W + 3
  savedItemCell.w = blockItemCell(1)
  blockItemCell(1) = questionCell
  coinsBefore.w = hudCoins
  scoreBefore.l = hudScore
  payTimer.w = -1
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For riseTick = 0 To 79
    Tick{#MARIO_BTN_JUMP}
    UpdateObjects{}
    If payTimer < 0
      If hudCoins <> coinsBefore Then payTimer = blockBounceTimer
    EndIf
  Next
  coinSlot.w = PoolTypeActive{#OBJ_COIN}
  Assert{payTimer = #MARIO_BLOCKBOUNCE}
  Assert{hudCoins = coinsBefore + 1}
  Assert{hudScore = scoreBefore + #SCORE_COIN}
  Assert{metatileBuffer(questionCell) = #MT_BLOCK}
  ; The arc has finished and freed its slot, and paid nothing more.
  Assert{coinSlot = -1}
  blockItemCell(1) = savedItemCell
End Statement

;; Step the floating numbers a number of updates, as the sim does once per tick.
Statement StepFloaters{updateCount.w}
  For stepNumber = 1 To updateCount
    UpdateFloaters{}
  Next
End Statement

;; A Goomba standing where it overlaps a small Mario on the floor, on screen,
;; for the contact scenarios. Returns the pool slot.
Function.w PlaceContactGoomba{goombaX.w}
  SHARED simTickCounter, playerInjuryIntervals, playerIsBig
  PoolInit{}
  playerIsBig = False
  playerInjuryIntervals = 0
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  contactSlot.w = PoolAlloc{}
  PoolInitGoomba{contactSlot, goombaX, (#FLOOR_ROW - 1)*#TILE}
  Function Return contactSlot
End Function

;; Goomba contact (PlayerEnemyCollision, smbdis 11293). Driven through the real
;; UpdateObjects{} with simTickCounter set by hand: the cartridge only tests
;; contact on every other frame (#CONTACT_EVERY_OTHER_TICK).
Statement ScenarioEnemyContact{}
  SHARED playerState, playerIsBig, playerInjuryIntervals, simTickCounter
  SHARED playerSpeedY, objDir(), objState(), deathKind, stompChain
  SHARED objActive(), objAux()
  BuildFlatMap{}

  ; A small Mario, a Goomba overlapping him from his right. The odd tick is
  ; skipped when the rule is on; then the even tick kills him.
  slotA.w = PlaceContactGoomba{108}
  simTickCounter = 1
  UpdateObjects{}
  oddHurt.w = False
  If playerState = #PLAYER_ST_DYING Then oddHurt = True
  Assert{oddHurt = (#CONTACT_EVERY_OTHER_TICK = 0)}
  simTickCounter = 2
  UpdateObjects{}
  Assert{playerState = #PLAYER_ST_DYING}
  Assert{playerSpeedY = #DEATH_SPEED_Y}
  Assert{deathKind = #DEATH_HOP}
  ; The Goomba, to his right and walking left, is already facing him.
  Assert{objDir(slotA) = #MARIO_BTN_LEFT}

  ; A big Mario shrinks instead, and is invulnerable.
  slotB.w = PlaceContactGoomba{108}
  playerIsBig = True
  UpdatePlayerBoundBox{}
  simTickCounter = 2
  UpdateObjects{}
  Assert{playerState = #PLAYER_ST_RESIZE}
  Assert{playerInjuryIntervals = #INJURY_INTERVALS}
  For shrinkTick = 0 To #INJURY_FREEZE_TICKS + 2
    Tick{0}
  Next
  Assert{playerState = #PLAYER_ST_FREE AND playerIsBig = False}
  ; Still overlapping, and invulnerable: nothing happens.
  simTickCounter = 4
  UpdateObjects{}
  Assert{playerState = #PLAYER_ST_FREE}
  ; Invulnerability over: now he dies.
  playerInjuryIntervals = 0
  simTickCounter = 6
  UpdateObjects{}
  Assert{playerState = #PLAYER_ST_DYING}

  ; A Goomba to his left walking away from him, and one to his right walking
  ; away: after the hit each is turned to face him.
  slotC.w = PlaceContactGoomba{90}
  objDir(slotC) = #MARIO_BTN_LEFT
  simTickCounter = 2
  UpdateObjects{}
  Assert{objDir(slotC) = #MARIO_BTN_RIGHT}
  slotD.w = PlaceContactGoomba{108}
  objDir(slotD) = #MARIO_BTN_RIGHT
  simTickCounter = 2
  UpdateObjects{}
  Assert{objDir(slotD) = #MARIO_BTN_LEFT}

  ; A stomp: falling onto it squashes the Goomba and leaves Mario unhurt.
  slotE.w = PlaceContactGoomba{100}
  PlacePlayer{100, 165}
  playerSpeedY = 3
  UpdatePlayerBoundBox{}
  stompChain = 0
  simTickCounter = 2
  UpdateObjects{}
  StepFloaters{6}
  Assert{playerState = #PLAYER_ST_FREE}
  Assert{objState(slotE) = #GOOMBA_ST_SQUASHED}
  ; It stays for #GOOMBA_SQUASH_INTERVALS intervals (ChkKillGoomba), not for a few ticks.
  Assert{objAux(slotE) = #GOOMBA_SQUASH_INTERVALS AND objActive(slotE) = True}
  ; The squashed Goomba is harmless.
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  simTickCounter = 4
  UpdateObjects{}
  For intervalCall = 1 To 3*#INTERVAL_PERIOD
    UpdateIntervalTimers{}
  Next
  simTickCounter = 6
  UpdateObjects{}
  Assert{objActive(slotE) = False}
  Assert{playerState = #PLAYER_ST_FREE}
  ClearFloaters{}
  stompChain = 0
End Statement

;; The death sequence (PlayerDeath, smbdis 5766; PlayerHole, 5617). The floor is
;; there to be fallen through. Tick{} does not run the objects, so nothing else
;; moves.
Statement ScenarioDeath{}
  SHARED playerState, playerY, playerSpeedY, deathKind, deathTimer, lifeEvent
  SHARED playerLives, playerIsBig, cameraX
  BuildFlatMap{}
  playerLives = #LIVES_START
  lifeEvent = #LIFE_NONE
  cameraX = 0
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  startY.w = playerY
  StartPlayerDeath{#DEATH_HOP}
  For heldTick = 1 To #DEATH_FREEZE_TICKS
    Tick{0}
  Next
  Assert{playerY = startY}
  Tick{0}
  Assert{playerY < startY}
  highestY.w = playerY
  deathGuard.w = 0
  While lifeEvent = #LIFE_NONE AND deathGuard < 600
    Tick{0}
    If playerY < highestY Then highestY = playerY
    deathGuard = deathGuard + 1
  Wend
  ; Rose, then fell through the floor to the limit, and the life is gone.
  Assert{highestY < startY - 8}
  Assert{playerY >= #DEATH_FALL_Y}
  Assert{lifeEvent = #LIFE_RESPAWN}
  Assert{playerLives = #LIVES_START - 1}

  ; A pit: nothing under him, so his top passes the bottom of the world while
  ; still alive; the same fall with no hop and no freeze.
  ClearTestMap{}
  lifeEvent = #LIFE_NONE
  PlacePlayer{100, 240}
  playerSpeedY = 3
  pitGuard.w = 0
  While playerState <> #PLAYER_ST_DYING AND pitGuard < 100
    Tick{0}
    pitGuard = pitGuard + 1
  Wend
  Assert{deathKind = #DEATH_PIT}
  Assert{playerY >= #PIT_DEATH_Y}
  pitY.w = playerY
  Tick{0}
  Assert{playerY > pitY}
  pitGuard = 0
  While lifeEvent = #LIFE_NONE AND pitGuard < 800
    Tick{0}
    pitGuard = pitGuard + 1
  Wend
  Assert{playerY >= #PIT_FALL_Y}
  Assert{lifeEvent = #LIFE_RESPAWN AND playerLives = #LIVES_START - 2}
  Assert{playerIsBig = False}
  lifeEvent = #LIFE_NONE
End Statement

;; Lives, game over and the halfway point (PlayerLoseLife, smbdis 2906).
Statement ScenarioLives{}
  SHARED playerState, playerLives, lifeEvent, lifeStartCameraX, cameraX
  BuildFlatMap{}
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  playerLives = 1
  cameraX = 100
  lifeEvent = #LIFE_NONE
  ResolveLifeLost{}
  Assert{playerLives = 0 AND lifeEvent = #LIFE_RESPAWN}
  Assert{lifeStartCameraX = 0}
  ; Past the halfway point: the restart is from it.
  cameraX = #HALFWAY_X + 40
  lifeEvent = #LIFE_NONE
  ResolveLifeLost{}
  Assert{playerLives = -1 AND lifeEvent = #LIFE_GAMEOVER}
  Assert{lifeStartCameraX = #HALFWAY_X}
  ; Game over is the game-over cover's to end (UpdateCover{}, scenario 37): the dying
  ; state no longer counts a timer down, so the event stays until the cover ends it.
  StartPlayerDeath{#DEATH_PIT}
  For overTick = 1 To 300
    Tick{0}
  Next
  Assert{lifeEvent = #LIFE_GAMEOVER}
  ; Leave the world as the other scenarios expect it.
  playerLives = #LIVES_START
  lifeEvent = #LIFE_NONE
  lifeStartCameraX = 0
  cameraX = 0
End Statement

;; Time up (smbdis 6452-6471): the timer at zero waits one more unit, then kills
;; him, and it does not run while he is dying.
Statement ScenarioTimeUp{}
  SHARED hudTime, hudTimeTicks, playerState, deathKind
  BuildFlatMap{}
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  hudTime = 1
  hudTimeTicks = 0
  For clockTick = 1 To #HUD_TIME_TICKS
    TickHudTimer{}
  Next
  Assert{hudTime = 0 AND playerState = #PLAYER_ST_FREE}
  For clockTick = 1 To #HUD_TIME_TICKS - 1
    TickHudTimer{}
  Next
  Assert{playerState = #PLAYER_ST_FREE}
  TickHudTimer{}
  Assert{playerState = #PLAYER_ST_DYING AND deathKind = #DEATH_HOP}
  ; Dying: the clock stops.
  hudTime = 5
  hudTimeTicks = 0
  For clockTick = 1 To #HUD_TIME_TICKS*2
    TickHudTimer{}
  Next
  Assert{hudTime = 5}
  hudTime = #HUD_TIME_START
End Statement

;; Goombas wake when the screen arrives. The table is pointed at known columns for
;; the scenario and put back after.
Function.w CountGoombas{}
  SHARED objActive(), objType()
  goombaCount.w = 0
  For poolIndex = 0 To #MAX_OBJECTS - 1
    If objActive(poolIndex) = True
      If objType(poolIndex) = #OBJ_GOOMBA Then goombaCount = goombaCount + 1
    EndIf
  Next
  Function Return goombaCount
End Function

Statement ScenarioGoombaWake{}
  SHARED goombaSpawnX(), goombaSpawnY(), cameraX, objActive(), objType(), objX()
  SHARED savedGoombaX(), savedGoombaY()
  For tableIndex = 0 To #GOOMBA_COUNT - 1
    savedGoombaX(tableIndex) = goombaSpawnX(tableIndex)
    savedGoombaY(tableIndex) = goombaSpawnY(tableIndex)
  Next
  goombaSpawnX(0) = 400
  goombaSpawnX(1) = 448
  goombaSpawnX(2) = 800
  goombaSpawnX(3) = 1296
  For tableIndex = 0 To #GOOMBA_COUNT - 1
    goombaSpawnY(tableIndex) = 192
  Next
  ; The level has more than four now: park the rest far off to the right so only
  ; the four under test can wake.
  For tableIndex = 4 To #GOOMBA_COUNT - 1
    goombaSpawnX(tableIndex) = 5000 + tableIndex*32
  Next
  PoolInit{}
  cameraX = 0
  ArmGoombas{0}
  ActivateGoombas{}
  nothingYet.w = CountGoombas{}
  Assert{nothingYet = 0}
  ; The view's right edge, 420, has reached the first at 400 and not the second (the view's width is the look's, so the camera is set from it).
  cameraX = 420 - #VIEW_W
  ActivateGoombas{}
  firstOnly.w = CountGoombas{}
  Assert{firstOnly = 1}
  ActivateGoombas{}
  stillOne.w = CountGoombas{}
  Assert{stillOne = 1}
  cameraX = 460 - #VIEW_W
  ActivateGoombas{}
  bothNow.w = CountGoombas{}
  Assert{bothNow = 2}
  ; Killed or gone is not woken again.
  For poolIndex = 0 To #MAX_OBJECTS - 1
    If objActive(poolIndex) = True Then PoolFree{poolIndex}
  Next
  ActivateGoombas{}
  noRespawn.w = CountGoombas{}
  Assert{noRespawn = 0}
  ;; A death restart at the halfway point: the cartridge skips every entry left of its screen's right edge (PositionEnemyObj), so the
  ;; three behind (400, 448, 800) and the one 16 px into the screen (1296) are all passed; one at the edge (1536) is woken, in either look's view.
  goombaSpawnX(4) = 1536
  cameraX = #HALFWAY_X
  ArmGoombas{cameraX + #NES_VIEW_W}
  ActivateGoombas{}
  afterDeath.w = CountGoombas{}
  Assert{afterDeath = 1}
  ; A new game passes none: all five are woken from there (the one the restart woke is cleared first).
  PoolInit{}
  ArmGoombas{0}
  ActivateGoombas{}
  afterNewGame.w = CountGoombas{}
  Assert{afterNewGame = 5}
  ;; A group is judged by its entry, its first member's x plus 48. 1-2's halfway restart (the screen at 1536): its trio at 1584, 1608
  ;; and 1632 (entry 1632) are passed, so none is built on Mario; the single at 1792, at the edge, is woken.
  goombaSpawnX(0) = 1584
  goombaSpawnX(1) = 1608
  goombaSpawnX(2) = 1632
  goombaSpawnX(3) = 1792
  goombaSpawnX(4) = 5000
  PoolInit{}
  cameraX = 1536
  ArmGoombas{cameraX + #NES_VIEW_W}
  ActivateGoombas{}
  trioPassed.w = CountGoombas{}
  Assert{GoombaEntryX{1} = 1632 AND GoombaEntryX{3} = 1792 AND trioPassed = 1}
  ; 1-1 out of the bonus pipe (the screen at 2560): its pair at 2784 and 2808 (entry 2832) is past the edge, so both are built.
  goombaSpawnX(0) = 2784
  goombaSpawnX(1) = 2808
  goombaSpawnX(2) = 5000
  goombaSpawnX(3) = 5032
  PoolInit{}
  cameraX = 2560
  ArmGoombas{cameraX + #NES_VIEW_W}
  ActivateGoombas{}
  pairBuilt.w = CountGoombas{}
  Assert{GoombaEntryX{0} = 2832 AND pairBuilt = 2}
  For tableIndex = 0 To #GOOMBA_COUNT - 1
    goombaSpawnX(tableIndex) = savedGoombaX(tableIndex)
    goombaSpawnY(tableIndex) = savedGoombaY(tableIndex)
  Next
  PoolInit{}
  cameraX = 0
  ArmGoombas{0}
End Statement

;; The stomp chain and the floating numbers (HandleStompedShellE, smbdis 11499;
;; FloateyNumbersRoutine, 1283). Twelve stomps without landing, each on a fresh
;; Goomba through the real UpdateObjects{}, with the floating numbers stepped by
;; hand. The first ten are 100 to 8000, the eleventh a 1-UP (a life, no points)
;; and the twelfth another, since the index is capped. The points arrive on the
;; sixth update of the number, not at the stomp. Then the number's own timing
;; (it rises a pixel an update until y 24, lives 48 updates), a full set still
;; scoring, and landing clearing the chain.
Statement ScenarioStompChain{}
  SHARED stompChain, hudScore, playerLives, playerSpeedY, simTickCounter
  SHARED floaterActive(), floaterY(), expectedChain()
  BuildFlatMap{}
  ClearFloaters{}
  stompChain = 0
  livesBefore.w = playerLives
  chainOk.w = True
  delayOk.w = False
  bounceSpeed.w = 0
  elevenDelta.l = -1
  livesAfterEleven.w = -1
  For stompNumber = 1 To 12
    contactSlot.w = PlaceContactGoomba{100}
    PlacePlayer{100, 165}
    playerSpeedY = 3
    UpdatePlayerBoundBox{}
    simTickCounter = 2
    scoreBefore.l = hudScore
    UpdateObjects{}
    If stompNumber = 1
      bounceSpeed = playerSpeedY
      StepFloaters{5}
      If hudScore = scoreBefore Then delayOk = True
      UpdateFloaters{}
    Else
      StepFloaters{6}
    EndIf
    deltaScore.l = hudScore - scoreBefore
    If stompNumber <= 10
      If deltaScore <> expectedChain(stompNumber - 1) Then chainOk = False
    EndIf
    If stompNumber = 11
      elevenDelta = deltaScore
      livesAfterEleven = playerLives
    EndIf
    ClearFloaters{}
  Next
  Assert{delayOk = True}
  Assert{chainOk = True}
  Assert{elevenDelta = 0}
  Assert{livesAfterEleven = livesBefore + 1}
  Assert{playerLives = livesBefore + 2}
  Assert{bounceSpeed = #STOMP_BOUNCE_SPEED_Y}
  Assert{stompChain = 12}
  ; Landing clears the chain.
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  Tick{0}
  Assert{stompChain = 0}
  ; One number's life: it rises a pixel an update, and is gone on the 49th.
  SpawnFloater{100, 100, 1}
  StepFloaters{10}
  Assert{floaterY(0) = 90}
  StepFloaters{38}
  Assert{floaterActive(0) = True}
  UpdateFloaters{}
  Assert{floaterActive(0) = False}
  ; It stops rising once y is under 24: 26 goes 25, 24, 23 and no further.
  SpawnFloater{100, 26, 1}
  StepFloaters{10}
  Assert{floaterY(0) = 23}
  ; A full set loses the number but not the points.
  ClearFloaters{}
  For fillSlot = 1 To #FLOATER_SLOTS
    SpawnFloater{100, 100, 1}
  Next
  scoreBefore = hudScore
  SpawnFloater{100, 100, 1}
  Assert{hudScore = scoreBefore + 100}
  ClearFloaters{}
  stompChain = 0
End Statement

;; The hundredth coin: the counter wraps to 0 and a life is added; an ordinary coin
;; adds none (GiveOneCoin, smbdis 7090-7098).
Statement ScenarioCoinLife{}
  SHARED hudCoins, playerLives
  hudCoins = 99
  livesBefore.w = playerLives
  AddCoin{}
  Assert{hudCoins = 0}
  Assert{playerLives = livesBefore + 1}
  AddCoin{}
  Assert{hudCoins = 1 AND playerLives = livesBefore + 1}
End Statement

;; Collecting a mushroom: a floating 1000 (index 6) at the mushroom, the points
;; five updates later and not before, and Mario starts to grow. Through the real
;; UpdateObjects{}; the mushroom is placed on Mario, already risen.
Statement ScenarioMushroomScore{}
  SHARED hudScore, playerIsBig, playerState, simStepNumerator
  SHARED objRiseRemaining(), floaterActive(), floaterIndex()
  BuildFlatMap{}
  PoolInit{}
  ClearFloaters{}
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  playerIsBig = False
  mushroomSlot.w = PoolAlloc{}
  PoolInitBlockItem{mushroomSlot, 100, (#FLOOR_ROW - 1)*#TILE, #PRE_MUSHROOM_CELL, 0, simStepNumerator}
  objRiseRemaining(mushroomSlot) = 0
  scoreBefore.l = hudScore
  UpdateObjects{}
  Assert{floaterActive(0) = True}
  Assert{floaterIndex(0) = #FLOATER_POWER_UP_INDEX}
  Assert{hudScore = scoreBefore}
  StepFloaters{6}
  Assert{hudScore = scoreBefore + #SCORE_POWER_UP}
  Assert{playerState = #PLAYER_ST_RESIZE}
  ClearFloaters{}
  PoolInit{}
  playerState = #PLAYER_ST_FREE
End Statement

;; The hidden 1-UP block (Hidden1UpBlock, smbdis 4172): an empty cell that is not
;; built until the screen reaches it, is built only while the game's flag is set and
;; clears it, and on a head hit becomes the used block and releases the green
;; mushroom. Collected, that gives a life through a floating 1UP, no points, and
;; Mario does not grow. The generated table's first entry is moved to a test cell.
Statement ScenarioHiddenOneUp{}
  SHARED metatileBuffer(), hiddenBlockCell(), hiddenBlockLive(), hiddenOneUpFlag, hudCoins, blockBounceTimer
  SHARED blockItemCell(), blockItemSprite(), cameraX, playerLives, hudScore
  SHARED playerIsBig, playerState, playerX, playerY, objX(), objY(), objRiseRemaining(), objSprite()
  BuildFlatMap{}
  PoolInit{}
  ClearFloaters{}
  oneupItem.w = -1
  For itemIndex = 0 To #BLOCK_ITEM_COUNT - 1
    If blockItemSprite(itemIndex) = #ONEUP_SPRITE Then oneupItem = itemIndex
  Next
  savedHiddenCell.w = hiddenBlockCell(0)
  savedItemCell.w = blockItemCell(oneupItem)
  hiddenCell.w = #CEILING_ROW*#MAP_W + 3
  hiddenBlockCell(0) = hiddenCell
  blockItemCell(oneupItem) = hiddenCell
  ; The screen has not reached it, or the flag is clear: nothing is built.
  hiddenOneUpFlag = True
  hiddenBlockLive(0) = False
  cameraX = 0
  hiddenBlockCell(0) = #CEILING_ROW*#MAP_W + 62
  ActivateHiddenBlocks{}
  Assert{hiddenBlockLive(0) = False}
  Assert{hiddenOneUpFlag = True}
  cameraX = 1020 - #VIEW_W
  ActivateHiddenBlocks{}
  Assert{hiddenBlockLive(0) = True}
  Assert{hiddenOneUpFlag = False}
  ; A block already behind the screen is not built and leaves the flag alone.
  hiddenBlockLive(0) = False
  hiddenOneUpFlag = True
  cameraX = 1300
  ActivateHiddenBlocks{}
  Assert{hiddenBlockLive(0) = False}
  Assert{hiddenOneUpFlag = True}
  ; With the flag already spent it stays unbuilt.
  cameraX = 1020 - #VIEW_W
  hiddenOneUpFlag = False
  ActivateHiddenBlocks{}
  Assert{hiddenBlockLive(0) = False}
  cameraX = 0
  hiddenBlockCell(0) = hiddenCell
  ; Not built: a jump through the cell finds nothing.
  hiddenOneUpFlag = True
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
  Next
  Assert{metatileBuffer(hiddenCell) = #MT_EMPTY}
  Assert{PoolTypeActive{#OBJ_MUSHROOM} = -1}
  ; Built: the head hit makes it the used block and releases the 1-UP.
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  ActivateHiddenBlocks{}
  Assert{hiddenBlockLive(0) = True}
  oneupSlot.w = -1
  For riseTick = 0 To 159
    If oneupSlot < 0
      Tick{#MARIO_BTN_JUMP}
      UpdateObjects{}
      oneupSlot = PoolTypeActive{#OBJ_MUSHROOM}
    EndIf
  Next
  Assert{metatileBuffer(hiddenCell) = #MT_BLOCK}
  Assert{oneupSlot >= 0}
  Assert{objSprite(oneupSlot) = #ONEUP_SPRITE}
  ; Collected: a life, no points, no growth.
  playerIsBig = False
  livesBefore.w = playerLives
  scoreBefore.l = hudScore
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  objRiseRemaining(oneupSlot) = 0
  objX(oneupSlot) = playerX
  objY(oneupSlot) = playerY
  UpdatePlayerBoundBox{}
  UpdateObjects{}
  StepFloaters{6}
  Assert{playerLives = livesBefore + 1}
  Assert{hudScore = scoreBefore}
  Assert{playerState <> #PLAYER_ST_RESIZE}
  Assert{playerIsBig = False}
  ClearFloaters{}
  PoolInit{}
  ; A hidden COIN block (2-1's): built without the 1-UP flag, spent flag or not, and leaving the flag alone; a head hit pays a coin at once.
  metatileBuffer(hiddenCell) = #MT_EMPTY
  blockItemSprite(oneupItem) = #COIN_SPRITE_BASE
  hiddenBlockLive(0) = False
  hiddenOneUpFlag = False
  cameraX = 0
  blockBounceTimer = 0
  ActivateHiddenBlocks{}
  Assert{hiddenBlockLive(0) = True}
  Assert{hiddenOneUpFlag = False}
  coinsBefore.w = hudCoins
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For riseTick = 0 To 39
    Tick{#MARIO_BTN_JUMP}
  Next
  Assert{metatileBuffer(hiddenCell) = #MT_BLOCK}
  Assert{hudCoins = coinsBefore + 1}
  Assert{PoolTypeActive{#OBJ_MUSHROOM} = -1}
  PoolInit{}
  ClearFloaters{}
  blockItemSprite(oneupItem) = #ONEUP_SPRITE
  metatileBuffer(hiddenCell) = #MT_EMPTY
  hiddenBlockLive(0) = False
  hiddenBlockCell(0) = savedHiddenCell
  blockItemCell(oneupItem) = savedItemCell
  hiddenOneUpFlag = True
  cameraX = 0
End Statement

;; A Koopa standing on the floor at koopaX, in the given state, with a small Mario on
;; the floor at marioX. Returns its pool slot.
Function.w PlaceTestKoopa{koopaX.w, koopaState.w, marioX.w}
  SHARED simTickCounter, playerInjuryIntervals, playerIsBig, objState(), objAux()
  PoolInit{}
  playerIsBig = False
  playerInjuryIntervals = 0
  PlacePlayer{marioX, (#FLOOR_ROW - 1)*#TILE}
  UpdatePlayerBoundBox{}
  testKoopa.w = PoolAlloc{}
  PoolInitKoopa{testKoopa, koopaX, #FLOOR_ROW*#TILE - #KOOPA_H}
  objState(testKoopa) = koopaState
  objAux(testKoopa) = #KOOPA_REVIVE_INTERVALS
  Function Return testKoopa
End Function

;; The Koopa Troopa (smbdis 11376-11520, 9293-9360, 11552-11700), through the real
;; UpdateObjects{} with the tick counter set by hand where contact matters.
Statement ScenarioKoopa{}
  SHARED objX(), objY(), objState(), objAux(), objDir(), objActive(), objPopTimer()
  SHARED playerState, playerSpeedY, playerInjuryIntervals, hudScore, stompChain
  SHARED simTickCounter, intervalPhase, cameraX
  BuildFlatMap{}
  ClearFloaters{}
  stompChain = 0
  cameraX = 0
  ; #ENEMY_WALK_SPEED sixteenths of a pixel a tick: sixteen ticks is that many pixels (NTSC 8, PAL 10).
  walker.w = PlaceTestKoopa{200, #KOOPA_ST_WALK, 40}
  For walkTick = 1 To 16
    UpdateObjects{}
  Next
  Assert{objX(walker) = 200 - #ENEMY_WALK_SPEED}
  ; Stomped: a shell, the chain, the timer, the bounce, and the number's points.
  stomped.w = PlaceTestKoopa{100, #KOOPA_ST_WALK, 100}
  PlacePlayer{100, objY(stomped) - 4}
  playerSpeedY = 3
  UpdatePlayerBoundBox{}
  scoreBefore.l = hudScore
  simTickCounter = 2
  UpdateObjects{}
  StepFloaters{6}
  Assert{objState(stomped) = #KOOPA_ST_SHELL}
  Assert{objAux(stomped) = #KOOPA_REVIVE_INTERVALS}
  Assert{stompChain = 1}
  Assert{playerSpeedY = #STOMP_BOUNCE_SPEED_Y}
  Assert{hudScore = scoreBefore + #SCORE_STOMP}
  ; A shell touched kicks, away from Mario, for 3 plus the chain (400 here).
  stompChain = 0
  ClearFloaters{}
  kicked.w = PlaceTestKoopa{108, #KOOPA_ST_SHELL, 100}
  scoreBefore = hudScore
  simTickCounter = 2
  UpdateObjects{}
  StepFloaters{6}
  Assert{objState(kicked) = #KOOPA_ST_KICKED}
  Assert{objDir(kicked) = #MARIO_BTN_RIGHT}
  Assert{hudScore = scoreBefore + 400}
  ; Still touching it two ticks later does not hurt him: a touch counts once.
  simTickCounter = 4
  UpdateObjects{}
  simTickCounter = 6
  UpdateObjects{}
  Assert{playerState = #PLAYER_ST_FREE}
  ; With the timer nearly out the kick is worth 500.
  ClearFloaters{}
  nearly.w = PlaceTestKoopa{108, #KOOPA_ST_SHELL, 100}
  objAux(nearly) = 2
  scoreBefore = hudScore
  simTickCounter = 2
  UpdateObjects{}
  StepFloaters{6}
  Assert{hudScore = scoreBefore + 500}
  ; A sliding shell knocks off the Goombas it hits: 500 then 800, and they fall away.
  ClearFloaters{}
  slider.w = PlaceTestKoopa{100, #KOOPA_ST_KICKED, 40}
  objDir(slider) = #MARIO_BTN_RIGHT
  victimA.w = PoolAlloc{}
  PoolInitGoomba{victimA, 112, (#FLOOR_ROW - 1)*#TILE}
  victimB.w = PoolAlloc{}
  PoolInitGoomba{victimB, 116, (#FLOOR_ROW - 1)*#TILE}
  scoreBefore = hudScore
  simTickCounter = 1
  UpdateObjects{}
  StepFloaters{6}
  Assert{objState(victimA) = #GOOMBA_ST_KNOCKED}
  Assert{hudScore = scoreBefore + 500 + 800}
  For fallTick = 1 To 160
    UpdateObjects{}
  Next
  Assert{objActive(victimA) = False}
  ; Stomping a sliding shell stops it.
  ClearFloaters{}
  stopper.w = PlaceTestKoopa{100, #KOOPA_ST_KICKED, 100}
  PlacePlayer{100, objY(stopper) - 4}
  playerSpeedY = 3
  UpdatePlayerBoundBox{}
  simTickCounter = 2
  UpdateObjects{}
  Assert{objState(stopper) = #KOOPA_ST_SHELL}
  ; The revive timer counts down by the interval and, at 0, it walks again.
  ClearFloaters{}
  reviver.w = PlaceTestKoopa{200, #KOOPA_ST_SHELL, 40}
  objAux(reviver) = 3
  intervalPhase = 0
  UpdateIntervalTimers{}
  Assert{objAux(reviver) = 2}
  objAux(reviver) = 0
  UpdateObjects{}
  Assert{objState(reviver) = #KOOPA_ST_WALK}
  ; A walking Koopa touched from the side hurts a small Mario.
  hurter.w = PlaceTestKoopa{108, #KOOPA_ST_WALK, 100}
  simTickCounter = 2
  UpdateObjects{}
  Assert{playerState = #PLAYER_ST_DYING}
  ClearFloaters{}
  PoolInit{}
  stompChain = 0
  playerState = #PLAYER_ST_FREE
End Statement

;; The Fire Flower (SetupPowerUp, smbdis 7143; HandlePowerUpCollision, 11237;
;; PlayerFireFlower, 5764). The colour sets are checked through
;; MarioColourSetWanted{}: the palette itself needs a screen.
Statement ScenarioFireFlower{}
  SHARED playerIsBig, playerFire, playerState, playerResizeTimer, playerInjuryIntervals
  SHARED playerResizeFire
  SHARED hudScore, simStepNumerator, objType(), objRiseRemaining(), blockItemCell()
  BuildFlatMap{}
  ClearFloaters{}
  powerCell.w = blockItemCell(0)
  ; A big Mario's power-up block gives a flower and no mushroom.
  PoolInit{}
  playerIsBig = True
  playerFire = False
  SpawnBlockItem{powerCell}
  Assert{PoolTypeActive{#OBJ_FLOWER} >= 0}
  Assert{PoolTypeActive{#OBJ_MUSHROOM} = -1}
  ; A small Mario's gives the mushroom.
  PoolInit{}
  playerIsBig = False
  SpawnBlockItem{powerCell}
  Assert{PoolTypeActive{#OBJ_MUSHROOM} >= 0}
  Assert{PoolTypeActive{#OBJ_FLOWER} = -1}
  ; A big Mario takes a flower: 1000, a freeze in the star colours, then fire.
  PoolInit{}
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  playerIsBig = True
  playerFire = False
  UpdatePlayerBoundBox{}
  flowerSlot.w = PoolAlloc{}
  PoolInitBlockItem{flowerSlot, 100, (#FLOOR_ROW - 1)*#TILE, #MUSHROOM_SPRITE, 0, simStepNumerator}
  objType(flowerSlot) = #OBJ_FLOWER
  objRiseRemaining(flowerSlot) = 0
  scoreBefore.l = hudScore
  UpdateObjects{}
  StepFloaters{6}
  Assert{playerState = #PLAYER_ST_RESIZE}
  Assert{hudScore = scoreBefore + #SCORE_POWER_UP}
  Assert{MarioColourSetWanted{} = 2}
  For flashTick = 1 To #FLASH_SET_TICKS
    UpdateResize{}
  Next
  Assert{MarioColourSetWanted{} = 3}
  For flashTick = #FLASH_SET_TICKS + 1 To #FIRE_FLASH_TICKS
    UpdateResize{}
  Next
  Assert{playerFire = True}
  Assert{playerState = #PLAYER_ST_FREE}
  Assert{playerIsBig = True}
  Assert{MarioColourSetWanted{} = 1}
  ; The resize flash's colour over every timer value from 0 to the end of the fire freeze,
  ; against the same formula written out here with MOD (see the Starman sweep in scenario 34).
  playerState = #PLAYER_ST_RESIZE
  playerResizeFire = True
  flashMismatchCount.l = 0
  For flashSweepTimer.w = 0 To #FIRE_FLASH_TICKS
    playerResizeTimer = flashSweepTimer
    flashExpectedColour.w = 2 + ((flashSweepTimer/#FLASH_SET_TICKS) MOD 4)
    If MarioColourSetWanted{} <> flashExpectedColour Then flashMismatchCount = flashMismatchCount + 1
  Next
  playerState = #PLAYER_ST_FREE
  playerResizeFire = False
  playerResizeTimer = 0
  Assert{flashMismatchCount = 0}
  ; A hit Fire Mario is small at once, in his own colours.
  ClearFloaters{}
  PoolInit{}
  playerIsBig = True
  playerFire = True
  playerInjuryIntervals = 0
  playerState = #PLAYER_ST_FREE
  InjurePlayer{}
  Assert{playerFire = False}
  Assert{MarioColourSetWanted{} = 0}
  For shrinkTick = 1 To #INJURY_HOLD_TICKS
    UpdateResize{}
  Next
  playerState = #PLAYER_ST_FREE
  playerIsBig = False
  playerFire = False
  playerInjuryIntervals = 0
  ClearFloaters{}
  PoolInit{}
End Statement

;; Fireballs (ProcFireball_Bubble, smbdis 6273; FireballObjCore, 6327;
;; FireballBGCollision, 12726; FireballEnemyCollision, 11060). TryThrowFireball{} and
;; UpdateFireballs{} are driven by hand.
Statement ScenarioFireball{}
  SHARED playerFire, playerButtons, playerButtonsLast, playerThrowTimer, playerFacing
  SHARED fireballCounter, fireballActive(), fireballX(), fireballY(), fireballVelY()
  SHARED fireballDirection(), fireballBounced(), fireballFractionY()
  SHARED simTickCounter, cameraX, objState(), hudScore
  BuildFlatMap{}
  PoolInit{}
  ClearFloaters{}
  cameraX = 0
  For clearBall = 0 To #FIREBALL_SLOTS - 1
    fireballActive(clearBall) = 0
  Next
  fireballCounter = 0
  playerThrowTimer = 0
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  playerFacing = #MARIO_FACE_RIGHT
  ; Only Fire Mario throws.
  playerFire = False
  playerButtons = #MARIO_BTN_FIRE
  playerButtonsLast = 0
  TryThrowFireball{}
  Assert{fireballActive(0) = 0}
  playerFire = True
  TryThrowFireball{}
  Assert{fireballActive(0) = #FIREBALL_FLYING}
  Assert{fireballX(0) = 100 + #FIREBALL_SPAWN_DX}
  Assert{fireballY(0) = (#FLOOR_ROW - 1)*#TILE - 16}
  Assert{playerThrowTimer > 0}
  ; Held, no second; a fresh press uses the other slot; a third with the first still
  ; out does nothing.
  playerButtonsLast = #MARIO_BTN_FIRE
  TryThrowFireball{}
  Assert{fireballActive(1) = 0}
  playerButtonsLast = 0
  TryThrowFireball{}
  Assert{fireballActive(1) = #FIREBALL_FLYING}
  TryThrowFireball{}
  Assert{fireballCounter = 2}
  fireballActive(1) = 0
  ; Flight: 4 a tick across, and a bounce on the floor.
  simTickCounter = 1
  startX.w = fireballX(0)
  bounceSeen.w = False
  For flightTick = 1 To 12
    UpdateFireballs{}
    If fireballVelY(0) < 0 Then bounceSeen = True
  Next
  Assert{fireballX(0) = startX + 12*#FIREBALL_SPEED_X/16}
  Assert{bounceSeen = True}
  Assert{fireballActive(0) = #FIREBALL_FLYING}
  ; A wall: it bounces off as if it were a floor, explodes the second time, and the
  ; burst ends.
  fireballActive(0) = 0
  fireballCounter = 0
  SetTestRun{#FLOOR_ROW - 3, 10, 10, #MT_GROUND}
  SetTestRun{#FLOOR_ROW - 2, 10, 10, #MT_GROUND}
  SetTestRun{#FLOOR_ROW - 1, 10, 10, #MT_GROUND}
  playerButtonsLast = 0
  TryThrowFireball{}
  exploded.w = False
  For wallTick = 1 To 40
    UpdateFireballs{}
    If fireballActive(0) = #FIREBALL_EXPLODING Then exploded = True
  Next
  Assert{exploded = True}
  Assert{fireballActive(0) = 0}
  BuildFlatMap{}
  ; A fireball through a Goomba: knocked off, 100, and the ball explodes.
  PoolInit{}
  goomba.w = PoolAlloc{}
  PoolInitGoomba{goomba, 110, (#FLOOR_ROW - 1)*#TILE}
  fireballActive(0) = #FIREBALL_FLYING
  fireballX(0) = 104
  fireballY(0) = (#FLOOR_ROW - 1)*#TILE - 2
  fireballVelY(0) = 0
  fireballFractionY(0) = 0
  fireballDirection(0) = 1
  fireballBounced(0) = False
  scoreBefore.l = hudScore
  simTickCounter = 2
  UpdateFireballs{}
  StepFloaters{6}
  Assert{objState(goomba) = #GOOMBA_ST_KNOCKED}
  Assert{fireballActive(0) = #FIREBALL_EXPLODING}
  Assert{hudScore = scoreBefore + 100}
  ; And a Koopa: 200.
  ClearFloaters{}
  koopa.w = PlaceTestKoopa{110, #KOOPA_ST_WALK, 40}
  fireballActive(0) = #FIREBALL_FLYING
  fireballX(0) = 104
  fireballY(0) = (#FLOOR_ROW - 1)*#TILE - 2
  fireballVelY(0) = 0
  fireballFractionY(0) = 0
  fireballBounced(0) = False
  scoreBefore = hudScore
  simTickCounter = 2
  UpdateFireballs{}
  StepFloaters{6}
  Assert{objState(koopa) = #KOOPA_ST_KNOCKED}
  Assert{hudScore = scoreBefore + 200}
  fireballActive(0) = 0
  playerFire = False
  playerButtons = 0
  playerThrowTimer = 0
  ClearFloaters{}
  PoolInit{}
End Statement

;; The Starman (smbdis 7160, 9376, 11237, 5340). Through the real UpdateObjects{}
;; where contact matters; the colour sets through MarioColourSetWanted{}.
Statement ScenarioStarman{}
  SHARED metatileBuffer(), mapBuffer(), blockItemCell(), blockItemSprite()
  SHARED playerIsBig, playerFire, playerState, playerStarIntervals, playerX, playerY
  SHARED simTickCounter, intervalPhase, cameraX, hudScore, simStepNumerator
  SHARED objType(), objX(), objY(), objVelY(), objDir(), objRiseRemaining(), objState()
  BuildFlatMap{}
  PoolInit{}
  ClearFloaters{}
  cameraX = 0
  playerStarIntervals = 0
  playerFire = False
  ; A brick holding a star: big Mario bumps it, it does not break, it is the used
  ; block, and a star comes out.
  starItem.w = -1
  For itemIndex = 0 To #BLOCK_ITEM_COUNT - 1
    If blockItemSprite(itemIndex) = #STAR_SPRITE_BASE Then starItem = itemIndex
  Next
  savedCell.w = blockItemCell(starItem)
  SetTestRun{#CEILING_ROW, 2, 4, #MT_BRICK}
  For brickColumn = 2 To 4
    mapBuffer(#CEILING_ROW*#MAP_W + brickColumn) = 2
  Next
  starCell.w = #CEILING_ROW*#MAP_W + 3
  blockItemCell(starItem) = starCell
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  playerIsBig = True
  starSlot.w = -1
  For riseTick = 0 To 159
    If starSlot < 0
      Tick{#MARIO_BTN_JUMP}
      UpdateObjects{}
      starSlot = PoolTypeActive{#OBJ_STAR}
    EndIf
  Next
  Assert{starSlot >= 0}
  Assert{metatileBuffer(starCell) = #MT_BLOCK}
  blockItemCell(starItem) = savedCell
  ; Along at a pixel a tick, hopping: it rises to about 40 px above the floor and
  ; comes back, and keeps going.
  PoolInit{}
  playerIsBig = False
  PlacePlayer{20, (#FLOOR_ROW - 1)*#TILE}
  UpdatePlayerBoundBox{}
  hopper.w = PoolAlloc{}
  PoolInitBlockItem{hopper, 100, (#FLOOR_ROW - 1)*#TILE, #STAR_SPRITE_BASE, 0, simStepNumerator}
  objType(hopper) = #OBJ_STAR
  objRiseRemaining(hopper) = 0
  objDir(hopper) = #MARIO_BTN_RIGHT
  highest.w = objY(hopper)
  For hopTick = 1 To 60
    UpdateObjects{}
    If objY(hopper) < highest Then highest = objY(hopper)
  Next
  Assert{objX(hopper) = 160}
  Assert{highest < (#FLOOR_ROW - 1)*#TILE - 30}
  ; A wall turns it round.
  SetTestRun{#FLOOR_ROW - 1, 12, 12, #MT_GROUND}
  SetTestRun{#FLOOR_ROW - 2, 12, 12, #MT_GROUND}
  SetTestRun{#FLOOR_ROW - 3, 12, 12, #MT_GROUND}
  SetTestRun{#FLOOR_ROW - 4, 12, 12, #MT_GROUND}
  For wallTick = 1 To 90
    UpdateObjects{}
  Next
  Assert{objDir(hopper) = #MARIO_BTN_LEFT}
  BuildFlatMap{}
  ; Picked up: 1000 and the timer.
  PoolInit{}
  ClearFloaters{}
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  UpdatePlayerBoundBox{}
  grabbed.w = PoolAlloc{}
  PoolInitBlockItem{grabbed, 100, (#FLOOR_ROW - 1)*#TILE, #STAR_SPRITE_BASE, 0, simStepNumerator}
  objType(grabbed) = #OBJ_STAR
  objRiseRemaining(grabbed) = 0
  scoreBefore.l = hudScore
  UpdateObjects{}
  StepFloaters{6}
  Assert{playerStarIntervals = #STAR_INTERVALS}
  Assert{hudScore = scoreBefore + #SCORE_POWER_UP}
  ; A new power-up replaces the one that is out (the cartridge's single slot).
  PoolInit{}
  playerIsBig = False
  outStar.w = PoolAlloc{}
  PoolInitBlockItem{outStar, 100, (#FLOOR_ROW - 1)*#TILE, #STAR_SPRITE_BASE, 0, simStepNumerator}
  objType(outStar) = #OBJ_STAR
  SpawnBlockItem{blockItemCell(0)}
  Assert{PoolTypeActive{#OBJ_STAR} = -1}
  Assert{PoolTypeActive{#OBJ_MUSHROOM} >= 0}
  PoolInit{}
  ; The interval timer counts it down.
  playerState = #PLAYER_ST_FREE
  intervalPhase = 0
  UpdateIntervalTimers{}
  Assert{playerStarIntervals = #STAR_INTERVALS - 1}
  ; Touching knocks off a Goomba (100), a walking Koopa and a standing shell (200).
  ClearFloaters{}
  PoolInit{}
  goomba.w = PoolAlloc{}
  PoolInitGoomba{goomba, 108, (#FLOOR_ROW - 1)*#TILE}
  scoreBefore = hudScore
  simTickCounter = 2
  UpdateObjects{}
  StepFloaters{6}
  Assert{objState(goomba) = #GOOMBA_ST_KNOCKED}
  Assert{playerState = #PLAYER_ST_FREE}
  Assert{hudScore = scoreBefore + 100}
  ClearFloaters{}
  shell.w = PlaceTestKoopa{108, #KOOPA_ST_SHELL, 100}
  scoreBefore = hudScore
  simTickCounter = 2
  UpdateObjects{}
  StepFloaters{6}
  Assert{objState(shell) = #KOOPA_ST_KNOCKED}
  Assert{hudScore = scoreBefore + 200}
  ; His colours: sets 2 to 5, a new one every 2 ticks until the last 8 intervals,
  ; then every 8.
  playerStarIntervals = 20
  simTickCounter = 0
  Assert{MarioColourSetWanted{} = 2}
  simTickCounter = 2
  Assert{MarioColourSetWanted{} = 3}
  playerStarIntervals = 5
  simTickCounter = 2
  Assert{MarioColourSetWanted{} = 2}
  simTickCounter = 8
  Assert{MarioColourSetWanted{} = 3}
  playerStarIntervals = 0
  Assert{MarioColourSetWanted{} = 0}
  ; Every tick from 0 to 40, fast and slow, against the same formula written out here with
  ; MOD: a form the compiler gets wrong (the main project's BLITZ_CONVENTIONS note) shows as a mismatch.
  starMismatchCount.l = 0
  For starSweepPhase.w = 0 To 1
    If starSweepPhase = 0 Then playerStarIntervals = #STAR_FAST_INTERVALS
    If starSweepPhase = 1 Then playerStarIntervals = #STAR_FAST_INTERVALS - 1
    For starSweepTick.l = 0 To 40
      simTickCounter = starSweepTick
      starExpectedColour.w = 2 + ((starSweepTick/#STAR_FAST_TICKS) MOD 4)
      If starSweepPhase = 1 Then starExpectedColour = 2 + ((starSweepTick/#STAR_SLOW_TICKS) MOD 4)
      If MarioColourSetWanted{} <> starExpectedColour Then starMismatchCount = starMismatchCount + 1
    Next
  Next
  Assert{starMismatchCount = 0}
  simTickCounter = 0
  playerStarIntervals = 0
  ClearFloaters{}
  PoolInit{}
  BuildFlatMap{}
End Statement

;; The end of the level (smbdis 12167, 10452, 8634, 10412), through the real
;; UpdateLevelEnd{}. The slide and the walk are scenario 9 and the door.
Statement ScenarioLevelEnd{}
  SHARED playerState, playerHidden, playerX, endTask, hudTime, hudScore, lifeEvent
  SHARED fireworkActive()
  ; The pole's bands, from the cartridge's thresholds plus 16.
  Assert{PoleBandFor{40} = 0}
  Assert{PoleBandFor{60} = 1}
  Assert{PoleBandFor{100} = 2}
  Assert{PoleBandFor{130} = 3}
  Assert{PoleBandFor{170} = 4}
  ; Fireworks: the timer's last digit.
  Assert{FireworkCountForTime{121} = 1}
  Assert{FireworkCountForTime{123} = 3}
  Assert{FireworkCountForTime{126} = 6}
  Assert{FireworkCountForTime{127} = 0}
  ; The castle door hides him and starts the tasks, and not before.
  playerState = #PLAYER_ST_ENDWALK
  playerHidden = False
  endTask = 0
  ; The look's doorway (#LOOK_DOOR_DX, 8 px in under All-Stars), so the test holds in both looks.
  playerX = #CASTLE_DOOR_X + #LOOK_DOOR_DX - #CASTLE_STOP_DX - 1
  CheckCastleDoor{}
  Assert{playerHidden = False}
  playerX = #CASTLE_DOOR_X + #LOOK_DOOR_DX - #CASTLE_STOP_DX
  CheckCastleDoor{}
  Assert{playerHidden = True AND endTask = 1}
  ; The tasks: 123 on the timer is 3 fireworks, 123 x 50 and 3 x 500.
  hudTime = 123
  scoreBefore.l = hudScore
  lifeEvent = #LIFE_NONE
  endGuard.w = 0
  While lifeEvent = #LIFE_NONE AND endGuard < 1000
    UpdateLevelEnd{}
    endGuard = endGuard + 1
  Wend
  Assert{lifeEvent = #LIFE_COMPLETE}
  Assert{hudTime = 0}
  Assert{hudScore = scoreBefore + 123*#TIME_BONUS_POINTS + 3*#FIREWORK_POINTS}
  Assert{endTask = 5}
  Assert{fireworkActive(0) = False}
  playerState = #PLAYER_ST_FREE
  playerHidden = False
  endTask = 0
  lifeEvent = #LIFE_NONE
End Statement

;; The pipes and the bonus room (smbdis 12270, 5683, 5705, 5500). The rules and the
;; timers through the real functions; the reload and the palette need a screen and
;; are checked by eye.
Statement ScenarioBonusRoom{}
  SHARED currentArea, areaEvent, playerState, playerOnGround, playerButtons
  SHARED playerX, playerY, pipeTimer, pipeOccludeCols, mapBuffer(), metatileBuffer()
  SHARED areaPalette(), harnessAreaStatus, areaPipeExitX, areaPipeExitY, areaPipeExitW, areaPipeExitH
  ;; The shipped room: the harness read 1-1 and its room into slots 0 and 1 from their area files at start-up (scenario 53
  ;; uses them too, so this one must leave them alone), and the room's boxes are applied as the game does when the pipe is
  ;; entered. So the exit box, the map and the coins below are the room as built, and moving the pipe in Tiled moves the
  ;; test with it.
  Assert{harnessAreaStatus = 0}
  ApplyRoomBoxes{1}
  BuildFlatMap{}
  ; The way in: centred on the top of the marked pipe, Down, standing.
  currentArea = #AREA_MAIN
  areaEvent = 0
  playerState = #PLAYER_ST_FREE
  playerOnGround = True
  playerButtons = #MARIO_BTN_DOWN
  playerX = 920
  playerY = #PIPE_ENTRY_Y - #TILE
  Assert{PipeEntryReady{} = True}
  playerX = 905
  Assert{PipeEntryReady{} = False}
  playerX = 920
  playerButtons = 0
  Assert{PipeEntryReady{} = False}
  playerButtons = #MARIO_BTN_DOWN
  playerOnGround = False
  Assert{PipeEntryReady{} = False}
  ; The sink: 48 ticks at 1 a tick, then the area event.
  playerOnGround = True
  startY.w = playerY
  StartPipe{#PLAYER_ST_PIPE_DOWN}
  For sinkTick = 1 To #PIPE_TICKS
    UpdatePipe{}
  Next
  Assert{areaEvent = #AREA_EVENT_ENTER}
  Assert{playerY = startY + #PIPE_TICKS}
  areaEvent = 0
  ; The bonus map: 19 coins, a solid floor, and none of the main level.
  EnterSlotMaps{1}
  coinCount.w = 0
  For cellIndex = 0 To #MAP_CELLS - 1
    If mapBuffer(cellIndex) = #COIN_TILE_GID Then coinCount = coinCount + 1
  Next
  Assert{coinCount = 19}
  Assert{areaPipeExitW > 0 AND areaPipeExitH > 0}
  Assert{metatileBuffer(13*#MAP_W + 5) = #MT_GROUND}
  Assert{mapBuffer(5*#MAP_W + 100) = 0}
  ; The way out: right at the mouth of the exit pipe, on the floor.
  currentArea = #AREA_BONUS
  playerState = #PLAYER_ST_FREE
  playerOnGround = True
  playerButtons = #MARIO_BTN_RIGHT
  playerY = areaPipeExitY + areaPipeExitH - #TILE
  playerX = areaPipeExitX - #PROBE_SIDE_X2 - 1
  Assert{PipeExitReady{} = True}
  playerX = areaPipeExitX - #PROBE_SIDE_X2 - 6
  Assert{PipeExitReady{} = False}
  ; Into the pipe at half a pixel a tick, stopping in the mouth (his left at its left), and after the 48 ticks the way back.
  playerX = areaPipeExitX - #PROBE_SIDE_X2 - 1
  StartPipe{#PLAYER_ST_PIPE_SIDE}
  For sideTick = 1 To #PIPE_TICKS
    UpdatePipe{}
  Next
  Assert{areaEvent = #AREA_EVENT_RETURN}
  Assert{playerX = areaPipeExitX}
  areaEvent = 0
  ; Out of the other pipe: from below the screen, 1 a tick, free and standing on it.
  currentArea = #AREA_MAIN
  playerY = #RETURN_START_Y
  StartPipe{#PLAYER_ST_PIPE_UP}
  For riseTick = 1 To 120
    UpdatePipe{}
  Next
  Assert{playerState = #PLAYER_ST_FREE}
  Assert{playerY = #PIPE_UP_READY_Y - 1}
  ; The two areas' palettes differ at the sky pen.
  Assert{areaPalette(9) = 0 AND areaPalette(0) = 193}
  currentArea = #AREA_MAIN
  areaEvent = 0
  pipeOccludeCols = 0
  playerState = #PLAYER_ST_FREE
  playerButtons = 0
  BuildFlatMap{}
End Statement

;; The cover screens and the palette model (smbdis 1540, 1784, 2946). The state
;; machine and the pure palette function; the drawing and the display need a screen.
Statement ScenarioAreaBoxes{}
  SHARED currentArea, playerState, playerOnGround, playerButtons, playerX, playerY
  SHARED areaPipeExitX, areaPipeExitY, areaPipeExitH, areaPipeExitLink, areaBonusStartX, areaPipeEntryLink
  SHARED areaReturnX, harnessAreaStatus, goombaSpawnX(), slotCount, plantSpawnCount, plantSpawnX(), plantSpawnY(), currentLevel, areaWarpZoneX, warpPipeCount, warpLeftX, warpCameraLocked, cameraX
  SHARED areaScrollLockX, scrollLockLifted, areaCastleDoorX, areaFlagpoleX
  ; The loader and the object routine ran clean at start-up: both slots read, and no value differed from the
  ; compiled-in level.
  Assert{harnessAreaStatus = 0}
  Assert{slotCount = 2}
  ; 1-1 has no exit pipe: its box is nowhere, so Mario on the floor holding Right near x 200 starts nothing.
  ApplyPipeExitBox{0}
  Assert{areaPipeExitX = #AREA_BOX_NONE}
  Assert{areaPipeExitLink = 0}
  currentArea = #AREA_MAIN
  playerState = #PLAYER_ST_FREE
  playerOnGround = True
  playerButtons = #MARIO_BTN_RIGHT
  playerY = 192
  playerX = 200
  Assert{PipeExitReady{} = False}
  ; The room's exit: its box, and its link back to 1-1 (area 0) by entrance mode 2 at page 10.
  ApplyRoomBoxes{1}
  Assert{areaPipeExitX = 208}
  Assert{areaPipeExitLink = 2*32 + 10}
  Assert{areaBonusStartX = 24}
  currentArea = #AREA_BONUS
  playerY = areaPipeExitY + areaPipeExitH - #TILE
  playerX = areaPipeExitX - #PROBE_SIDE_X2 - 1
  Assert{PipeExitReady{} = True}
  ; Past the pipe's mouth (landing on another pipe at that height holding Right) it starts nothing.
  playerX = areaPipeExitX + 100
  Assert{PipeExitReady{} = False}
  playerX = areaPipeExitX - #PROBE_SIDE_X2 - 1
  ; Back in the level area, as RestartLevel{} and SwitchToLevelArea{} do it: the room's box is gone again.
  ApplyPipeExitBox{0}
  Assert{areaPipeExitX = #AREA_BOX_NONE}
  Assert{PipeExitReady{} = False}
  ; 1-1's own pipe leads into its room (area 1, slot 1) by mode 1 at page 0; 1-2's areas are not loaded.
  Assert{areaPipeEntryLink = 1*256 + 1*32}
  Assert{LevelSlotOfArea{areaPipeEntryLink/256} = 1}
  Assert{LevelSlotOfArea{3} = -1}
  ; The return pipes of 1-1 by page: 10 (from its room) and 11 (from 1-2); a page with none is not found.
  Assert{SelectAreaReturn{0, 10} = True}
  Assert{areaReturnX = 2616}
  Assert{SelectAreaReturn{0, 11} = True}
  Assert{areaReturnX = 2872}
  Assert{SelectAreaReturn{0, 3} = False}
  Assert{SelectAreaReturn{0, 10} = True}
  ; A Goomba group stands where the cartridge builds it, 48 px left of its entry (816, not 864).
  Assert{goombaSpawnX(2) = 816}
  ; 1-1 has no warp zone and no warp pipes.
  Assert{areaWarpZoneX = #AREA_BOX_NONE AND warpPipeCount = 0 AND areaScrollLockX = #AREA_BOX_NONE}
  ; A warp zone stops the camera at its room's page, centred in the view, once the view reaches its object.
  currentArea = #AREA_MAIN
  areaWarpZoneX = 2592
  warpPipeCount = 1
  warpLeftX = 2848
  cameraX = 2400
  CameraClamp{}
  Assert{cameraX = 2400 AND warpCameraLocked <> False}
  cameraX = 3000
  CameraClamp{}
  Assert{cameraX = 2816}
  areaWarpZoneX = #AREA_BOX_NONE
  warpPipeCount = 0
  warpCameraLocked = False
  cameraX = 0
  ; A castle's scroll lock (2-4's at x 2384) stops the view's right edge at its page's start (2304), until the axe lifts it.
  areaScrollLockX = 2384
  scrollLockLifted = False
  cameraX = 2300
  CameraClamp{}
  Assert{cameraX = 2304 - #VIEW_W}
  scrollLockLifted = True
  cameraX = 2300
  CameraClamp{}
  Assert{cameraX = 2300}
  areaScrollLockX = #AREA_BOX_NONE
  scrollLockLifted = False
  ;; A flagpole level's end: the NES's screen stops on the walk to the door with Mario 80 px from its left (the door at 3264: camera
  ;; 3184), which scrolls the pole off; ours stops with the pole's cell (3168) a tile in, 3152 (2026-11-07, the user's choice).
  cameraX = 3300
  CameraClamp{}
  Assert{areaCastleDoorX = 3264 AND areaFlagpoleX = 3172 AND cameraX = 3152}
  cameraX = 0
  ; 1-1 grows no Piranha Plants, but its last pipe does when the level is another (1-2's exit comes out of it).
  Assert{plantSpawnCount = 0}
  currentLevel = 1
  objectResult.w = ApplyAreaObjects{0}
  Assert{plantSpawnCount = 1 AND plantSpawnX(0) = 2872 AND plantSpawnY(0) = 176}
  currentLevel = 0
  objectResult = ApplyAreaObjects{0}
  Assert{plantSpawnCount = 0}
End Statement

;; A plant built at x 200 with its pipe's top at downY, Mario small on the floor at marioX.
Function.w PlaceTestPlant{marioX.w}
  SHARED playerInjuryIntervals, playerIsBig, playerStarIntervals
  PoolInit{}
  playerIsBig = False
  playerInjuryIntervals = 0
  playerStarIntervals = 0
  PlacePlayer{marioX, (#FLOOR_ROW - 1)*#TILE}
  UpdatePlayerBoundBox{}
  testPlant.w = PoolAlloc{}
  PoolInitPiranha{testPlant, 200, (#FLOOR_ROW - 2)*#TILE}
  Function Return testPlant
End Function

Function.w CountTestPlants{}
  SHARED objActive(), objType()
  plantsFound.w = 0
  For plantSlot = 0 To #MAX_OBJECTS - 1
    If objActive(plantSlot) = True AND objType(plantSlot) = #OBJ_PIRANHA Then plantsFound = plantsFound + 1
  Next
  Function Return plantsFound
End Function

;; The Piranha Plant (smbdis 8814, 10577, 11330, 11172), through the real UpdateObjects{}. The tick counter is odd where
;; contact must not happen and even where it must.
Statement ScenarioPiranha{}
  SHARED objX(), objY(), objState(), objAux(), objVelY(), objTouch(), objActive()
  SHARED playerState, playerStarIntervals, simTickCounter, cameraX, hudScore
  SHARED plantSpawnCount, plantSpawnX(), plantSpawnY(), plantSpawned()
  SHARED fireballActive(), fireballX(), fireballY(), fireballVelY(), fireballFractionY()
  SHARED fireballDirection(), fireballBounced()
  BuildFlatMap{}
  ClearFloaters{}
  cameraX = 0
  downY.w = (#FLOOR_ROW - 2)*#TILE
  upY.w = downY - #PLANT_RISE
  riseTicks.w = (#PLANT_RISE*16 + #ENEMY_WALK_SPEED - 1)/#ENEMY_WALK_SPEED
  ; With Mario far away it rises at once, in as many ticks as the pixels take at #ENEMY_WALK_SPEED, and waits at the top.
  plant.w = PlaceTestPlant{40}
  simTickCounter = 1
  For riseTick = 1 To riseTicks
    UpdateObjects{}
  Next
  Assert{objY(plant) = upY}
  Assert{objAux(plant) = #PLANT_WAIT_TICKS}
  For waitTick = 1 To #PLANT_WAIT_TICKS - 1
    UpdateObjects{}
  Next
  Assert{objY(plant) = upY AND objTouch(plant) = False}
  UpdateObjects{}
  Assert{objTouch(plant) = True AND objVelY(plant) > 0}
  ; Then it sinks, and waits at the bottom.
  For sinkTick = 1 To riseTicks - 1
    UpdateObjects{}
  Next
  Assert{objY(plant) = downY}
  Assert{objAux(plant) = #PLANT_WAIT_TICKS}
  ; Mario within 33 pixels across of it (either side) keeps it down; at 33 it comes up.
  plant = PlaceTestPlant{232}
  For nearTick = 1 To 100
    UpdateObjects{}
  Next
  Assert{objY(plant) = downY}
  plant = PlaceTestPlant{233}
  For farTick = 1 To 4
    UpdateObjects{}
  Next
  Assert{objY(plant) < downY}
  ; Touching it hurts a small Mario, wherever on its box, with no stomp.
  plant = PlaceTestPlant{40}
  objY(plant) = upY
  objAux(plant) = #PLANT_WAIT_TICKS
  PlacePlayer{200, upY + 8}
  UpdatePlayerBoundBox{}
  simTickCounter = 2
  UpdateObjects{}
  Assert{playerState = #PLAYER_ST_DYING}
  playerState = #PLAYER_ST_FREE
  ; The Starman knocks it off instead, for 200, and it falls from its down position, into its pipe.
  ClearFloaters{}
  plant = PlaceTestPlant{40}
  objY(plant) = upY
  objAux(plant) = #PLANT_WAIT_TICKS
  PlacePlayer{200, upY + 8}
  UpdatePlayerBoundBox{}
  playerStarIntervals = 5
  scoreBefore.l = hudScore
  simTickCounter = 2
  UpdateObjects{}
  StepFloaters{6}
  Assert{objState(plant) = #KOOPA_ST_KNOCKED}
  Assert{hudScore = scoreBefore + 200}
  Assert{objY(plant) = downY}
  playerStarIntervals = 0
  ; A fireball through it: the same.
  ClearFloaters{}
  plant = PlaceTestPlant{40}
  objY(plant) = upY
  objAux(plant) = #PLANT_WAIT_TICKS
  fireballActive(0) = #FIREBALL_FLYING
  fireballX(0) = 204
  fireballY(0) = upY + #SMALL_BOX_TOP
  fireballVelY(0) = 0
  fireballFractionY(0) = 0
  fireballDirection(0) = 1
  fireballBounced(0) = False
  scoreBefore = hudScore
  simTickCounter = 2
  UpdateFireballs{}
  StepFloaters{6}
  Assert{objState(plant) = #KOOPA_ST_KNOCKED}
  Assert{hudScore = scoreBefore + 200}
  Assert{fireballActive(0) = #FIREBALL_EXPLODING}
  fireballActive(0) = 0
  ; Built as its pipe comes into view, once.
  PoolInit{}
  plantSpawnCount = 2
  plantSpawnX(0) = 100
  plantSpawnY(0) = downY
  plantSpawnX(1) = 400
  plantSpawnY(1) = downY
  ArmPlants{0}
  ActivatePlants{}
  Assert{CountTestPlants{} = 1}
  cameraX = 420 - #VIEW_W
  ActivatePlants{}
  Assert{CountTestPlants{} = 2}
  ActivatePlants{}
  Assert{CountTestPlants{} = 2}
  ; A restart passes the plant wholly behind the view, but builds the one still in or ahead of it.
  PoolInit{}
  cameraX = 300
  ArmPlants{cameraX + #VIEW_W}
  ActivatePlants{}
  Assert{CountTestPlants{} = 1}
  Assert{plantSpawned(0) = True AND plantSpawned(1) = True}
  ; A new game passes none.
  PoolInit{}
  ArmPlants{0}
  ActivatePlants{}
  Assert{CountTestPlants{} = 2}
  ; Erased 16 px left of the screen, not before.
  plant = PlaceTestPlant{40}
  simTickCounter = 1
  objX(plant) = cameraX - 16
  UpdateObjects{}
  Assert{objActive(plant) = True}
  objX(plant) = cameraX - 17
  UpdateObjects{}
  Assert{objActive(plant) = False}
  plantSpawnCount = 0
  PoolInit{}
  cameraX = 0
  ClearFloaters{}
End Statement

;; A Koopa (green, or red when redKoopa is True) standing on the ledge map's floor at koopaX, walking in direction koopaDirection,
;; with a small Mario far off at marioX. Returns its pool slot.
Function.w PlaceLedgeKoopa{koopaX.w, koopaY.w, redKoopa.w, koopaDirection.w, marioX.w}
  SHARED simTickCounter, playerInjuryIntervals, playerIsBig, objDir()
  PoolInit{}
  playerIsBig = False
  playerInjuryIntervals = 0
  PlacePlayer{marioX, (#FLOOR_ROW - 1)*#TILE}
  UpdatePlayerBoundBox{}
  ledgeKoopa.w = PoolAlloc{}
  If redKoopa <> False
    PoolInitRedKoopa{ledgeKoopa, koopaX, koopaY}
  Else
    PoolInitKoopa{ledgeKoopa, koopaX, koopaY}
  EndIf
  objDir(ledgeKoopa) = koopaDirection
  Function Return ledgeKoopa
End Function

;; The Red Koopa (smbdis 8177 InitRedKoopa, 12572 ChkForRedKoopa), through the real UpdateObjects{}. The floor ends at column
;; 12, so its right edge is x 208, and a walker's middle passes it when its x reaches 200.
Statement ScenarioRedKoopa{}
  SHARED objX(), objY(), objState(), objDir(), objRed(), objGrounded(), objActive()
  SHARED playerSpeedY, simTickCounter, cameraX, hudScore
  SHARED koopaSpawnCount, koopaSpawnX(), koopaSpawnY(), koopaSpawnKind(), koopaSpawned()
  BuildLedgeMap{12}
  ClearFloaters{}
  cameraX = 0
  simTickCounter = 1
  floorTop.w = #FLOOR_ROW*#TILE - #KOOPA_H
  ; Walking right at the ledge, a red one turns round and stays on the floor; a green one walks off and falls.
  ; One at a time: two walkers that overlap turn round at once (EnemiesTurnAround{}).
  red.w = PlaceLedgeKoopa{150, floorTop, True, #MARIO_BTN_RIGHT, 40}
  For ledgeTick = 1 To 50*16/#ENEMY_WALK_SPEED + 20
    UpdateObjects{}
  Next
  Assert{objDir(red) = #MARIO_BTN_LEFT}
  Assert{objY(red) = floorTop}
  Assert{objGrounded(red) <> False}
  ; And it stays turned: not back and forth in place (at half a pixel a tick it is still past the edge on the next tick).
  stayedLeft.w = True
  For stayTick = 1 To 10
    UpdateObjects{}
    If objDir(red) <> #MARIO_BTN_LEFT Then stayedLeft = False
  Next
  Assert{stayedLeft = True}
  green.w = PlaceLedgeKoopa{150, floorTop, False, #MARIO_BTN_RIGHT, 40}
  For ledgeTick = 1 To 50*16/#ENEMY_WALK_SPEED + 20
    UpdateObjects{}
  Next
  Assert{objY(green) > floorTop}
  ; Built in the air, a red one falls to the floor first, then it is grounded and turns at the ledge.
  red = PlaceLedgeKoopa{100, floorTop - 40, True, #MARIO_BTN_RIGHT, 40}
  Assert{objGrounded(red) = False}
  For fallTick = 1 To 40
    UpdateObjects{}
  Next
  Assert{objY(red) = floorTop AND objGrounded(red) <> False}
  ; Stomped, it is a shell like a green one, and is not grounded (it is not walking).
  red = PlaceLedgeKoopa{100, floorTop, True, #MARIO_BTN_LEFT, 100}
  PlacePlayer{100, objY(red) - 4}
  playerSpeedY = 3
  UpdatePlayerBoundBox{}
  simTickCounter = 2
  UpdateObjects{}
  Assert{objState(red) = #KOOPA_ST_SHELL}
  UpdateObjects{}
  Assert{objGrounded(red) = False AND objRed(red) <> 0}
  ; With the floor gone from under it (a broken brick) it falls rather than turning in the air.
  BuildLedgeMap{12}
  red = PlaceLedgeKoopa{100, floorTop, True, #MARIO_BTN_LEFT, 40}
  For groundTick = 1 To 4
    UpdateObjects{}
  Next
  Assert{objGrounded(red) <> False}
  SetTestRun{#FLOOR_ROW, 0, 12, #MT_EMPTY}
  For gapTick = 1 To 20
    UpdateObjects{}
  Next
  Assert{objY(red) > floorTop}
  ; A spawn entry marked red builds a red one; an unmarked one a green one.
  PoolInit{}
  koopaSpawnCount = 2
  koopaSpawnX(0) = 100
  koopaSpawnY(0) = floorTop
  koopaSpawnKind(0) = 1
  koopaSpawnX(1) = 120
  koopaSpawnY(1) = floorTop
  koopaSpawnKind(1) = 0
  ArmKoopas{0}
  ActivateKoopas{}
  Assert{objRed(0) <> 0 AND objRed(1) = 0}
  Assert{objActive(0) = True AND objActive(1) = True}
  koopaSpawnCount = 0
  PoolInit{}
  simTickCounter = 1
  ClearFloaters{}
End Statement

;; A lift at liftX with its top at liftY, going liftDirection (1 up, 2 down, as the area file has it), and a small Mario standing free
;; at marioX, marioY (his top, with the feet 16 below), his box made. Returns the lift's slot. liftX is the lift's own x: one going up
;; or down is built from a data x #LIFT_SHIFT to its left (PosPlatform).
Function.w PlaceTestLift{liftX.w, liftY.w, liftDirection.w, marioX.w, marioY.w}
  SHARED playerState, playerIsBig, playerInjuryIntervals, playerSpeedY, playerSpeedX, playerOnGround
  PoolInit{}
  playerIsBig = False
  playerInjuryIntervals = 0
  PlacePlayer{marioX, marioY}
  playerState = #PLAYER_ST_FREE
  playerSpeedY = 0
  playerSpeedX = 0
  playerOnGround = False
  UpdatePlayerBoundBox{}
  testLift.w = PoolAlloc{}
  dataX.w = liftX
  If liftDirection = 1 OR liftDirection = 2 Then dataX = liftX - #LIFT_SHIFT
  PoolInitLift{testLift, dataX, liftY, liftDirection}
  Function Return testLift
End Function

Function.w CountTestLifts{}
  SHARED objActive(), objType()
  liftsFound.w = 0
  For liftSlot = 0 To #MAX_OBJECTS - 1
    If objActive(liftSlot) = True AND objType(liftSlot) = #OBJ_LIFT Then liftsFound = liftsFound + 1
  Next
  Function Return liftsFound
End Function

;; The large lift (smbdis 8944, 10974, 11709, 11760, 11846), through the real UpdateObjects{}.
Statement ScenarioLift{}
  SHARED objX(), objY(), objActive(), objVelY()
  SHARED playerX, playerY, playerSpeedY, playerOnGround, simTickCounter, cameraX
  SHARED liftSpawnCount, liftSpawnX(), liftSpawnY(), liftSpawnDir(), liftSpawned()
  SHARED playerScreenX, playerSpeedX, platformCarryX, cameraFractionX
  BuildFlatMap{}
  cameraX = 0
  simTickCounter = 1
  ; Landing on it: feet on its top, on the ground, no speed.
  lift.w = PlaceTestLift{100, 80, 2, 110, 64}
  UpdateObjects{}
  Assert{playerOnGround = True}
  Assert{playerY + #TILE = objY(lift)}
  Assert{playerSpeedY = 0}
  ; Carried down with it for a second.
  For rideTick = 1 To 60
    ; The engine makes his box in the tick before the objects, from where the lift left him.
    UpdatePlayerBoundBox{}
    UpdateObjects{}
  Next
  Assert{objY(lift) >= 80 + 50}
  Assert{playerY + #TILE = objY(lift)}
  ; Up to the wrap it carries him; the tick it wraps it lets go: he stays where it left him, to fall, not taken round the byte.
  lift = PlaceTestLift{100, 20, 1, 110, 4}
  For roofTick = 1 To 30
    UpdatePlayerBoundBox{}
    UpdateObjects{}
  Next
  Assert{objY(lift) >= 240}
  Assert{playerY + #TILE >= 0 AND playerY + #TILE < 4}
  ; The one-byte y wraps: down past 255 comes in at the top, up past 0 at the bottom.
  lift = PlaceTestLift{100, 250, 2, 40, (#FLOOR_ROW - 1)*#TILE}
  For wrapTick = 1 To 12
    UpdateObjects{}
  Next
  Assert{objY(lift) >= 0 AND objY(lift) < 16}
  lift = PlaceTestLift{100, 3, 1, 40, (#FLOOR_ROW - 1)*#TILE}
  For wrapTick = 1 To 12
    UpdateObjects{}
  Next
  Assert{objY(lift) >= 240}
  ; From below: his top within 4 px of its bottom going up ends the jump; deeper in the body it does not.
  lift = PlaceTestLift{100, 100, 2, 110, 107}
  playerSpeedY = -3
  UpdateObjects{}
  Assert{playerSpeedY = 1}
  lift = PlaceTestLift{100, 100, 2, 110, 100}
  playerSpeedY = -3
  UpdateObjects{}
  Assert{playerSpeedY = -3}
  ;; From the side: pushed out from the left edge and from the right. His feet 8 px into its top (y 92: his box's bottom 108, the
  ;; lift's top 100), past the landing window on both builds (#LIFT_LAND_WINDOW: NTSC 6, PAL 8; at y 90, 6 px in, PAL lands him).
  lift = PlaceTestLift{100, 100, 2, 88, 92}
  UpdateObjects{}
  Assert{playerX = 87}
  lift = PlaceTestLift{100, 100, 2, 140, 92}
  UpdateObjects{}
  Assert{playerX = 141}
  ; Erased 72 px left of the screen, not before.
  lift = PlaceTestLift{-72, 100, 2, 40, (#FLOOR_ROW - 1)*#TILE}
  UpdateObjects{}
  Assert{objActive(lift) = True}
  lift = PlaceTestLift{-73, 100, 2, 40, (#FLOOR_ROW - 1)*#TILE}
  UpdateObjects{}
  Assert{objActive(lift) = False}
  ; The platform that goes right (the sky bonus's): still until Mario stands on it, then it goes for good and carries him with it.
  lift = PlaceTestLift{100, 80, 3, 300, 64}
  For idleTick = 1 To 10
    UpdatePlayerBoundBox{}
    UpdateObjects{}
  Next
  Assert{objX(lift) = 100}
  PlacePlayer{110, 64}
  UpdatePlayerBoundBox{}
  UpdateObjects{}
  Assert{objX(lift) = 100 AND playerX = 110 AND playerOnGround = True}
  For rideTick = 1 To 60
    UpdatePlayerBoundBox{}
    UpdateObjects{}
  Next
  Assert{objX(lift) >= 100 + 55 AND objX(lift) <= 100 + 75}
  Assert{playerX - objX(lift) = 10}
  Assert{playerY + #TILE = objY(lift)}
  ; Without him it goes on.
  riddenX.w = objX(lift)
  PlacePlayer{300, 64}
  UpdatePlayerBoundBox{}
  For goneTick = 1 To 10
    UpdateObjects{}
  Next
  Assert{objX(lift) > riddenX + 8}
  ; The screen goes with the platform: what it carried him is added to the scroll even when he stands still, once he is past x 80 of the view.
  playerScreenX = 120
  playerSpeedX = 0
  platformCarryX = 1
  cameraX = 500
  CameraFollow{}
  Assert{cameraX = 501 AND platformCarryX = 0}
  playerScreenX = 40
  platformCarryX = 1
  CameraFollow{}
  Assert{cameraX = 501 AND platformCarryX = 0}
  cameraX = 0
  ; Erased 72 px right of the screen, not before.
  lift = PlaceTestLift{cameraX + #VIEW_W + 72, 100, 3, 40, (#FLOOR_ROW - 1)*#TILE}
  UpdateObjects{}
  Assert{objActive(lift) = True}
  lift = PlaceTestLift{cameraX + #VIEW_W + 73, 100, 3, 40, (#FLOOR_ROW - 1)*#TILE}
  UpdateObjects{}
  Assert{objActive(lift) = False}
  ; Built as the screen arrives, going the way the area says; one in view after a restart is built, one behind it is not.
  PoolInit{}
  liftSpawnCount = 2
  liftSpawnX(0) = 100
  liftSpawnY(0) = 80
  liftSpawnDir(0) = 1
  liftSpawnX(1) = 400
  liftSpawnY(1) = 120
  liftSpawnDir(1) = 2
  ArmLifts{0}
  ActivateLifts{}
  Assert{CountTestLifts{} = 1 AND objVelY(0) = -1}
  cameraX = 420 - #VIEW_W
  ActivateLifts{}
  Assert{CountTestLifts{} = 2 AND objVelY(1) = 1}
  ;; A restart or an arrival passes a lift whose data x is left of the NES's screen's right edge, as the walkers (PositionEnemyObj):
  ;; with the camera at 400 - #VIEW_W the view reaches the lift at 400 and the NES edge is at most 400, so the lift at 100 is passed and the one at 400 built; at 300 the edge is 556, both passed.
  PoolInit{}
  cameraX = 400 - #VIEW_W
  ArmLifts{cameraX + #NES_VIEW_W}
  ActivateLifts{}
  ; Built #LIFT_SHIFT right of its data's x, as the cartridge's large lifts (PosPlatform).
  Assert{liftSpawned(0) = True AND CountTestLifts{} = 1 AND objX(0) = 400 + #LIFT_SHIFT}
  PoolInit{}
  cameraX = 300
  ArmLifts{cameraX + #NES_VIEW_W}
  ActivateLifts{}
  Assert{liftSpawned(1) = True AND CountTestLifts{} = 0}
  liftSpawnCount = 0
  PoolInit{}
  cameraX = 0
End Statement

Statement ScenarioCover{}
  SHARED coverKind, coverTimer, coverNext, lifeEvent, hudScore, hudTopScore, allstarsSky(), coverClockPending
  Assert{CoverTicksFor{#COVER_LIVES} = 7*#INTERVAL_PERIOD}
  Assert{CoverTicksFor{#COVER_TIMEUP} = 7*#INTERVAL_PERIOD}
  Assert{CoverTicksFor{#COVER_GAMEOVER} = 18*#INTERVAL_PERIOD}
  Assert{CoverTicksFor{#COVER_BLANK} = #COVER_BLANK_TICKS}
  Assert{CoverTicksFor{#COVER_TITLE} = -1}
  ;; The time spent behind a cover before its first tick comes off its hold (since 2026-11-14), never below 1 tick; a cover
  ;; held until Return is left alone.
  Assert{CoverTicksLeft{147, 55} = 92}
  Assert{CoverTicksLeft{147, 0} = 147}
  Assert{CoverTicksLeft{147, 400} = 1}
  Assert{CoverTicksLeft{-1, 55} = -1}
  ; A cover ends when its time is up (set here by hand: no time behind it to take off).
  coverClockPending = False
  lifeEvent = #LIFE_NONE
  coverKind = #COVER_LIVES
  coverTimer = 2
  coverNext = #COVER_NONE
  UpdateCover{}
  Assert{coverKind = #COVER_LIVES}
  UpdateCover{}
  Assert{coverKind = #COVER_NONE}
  ; Game over ends in a new game, with its cover left up for the main loop to replace.
  coverKind = #COVER_GAMEOVER
  coverTimer = 1
  UpdateCover{}
  Assert{lifeEvent = #LIFE_NEWGAME}
  Assert{coverKind = #COVER_GAMEOVER}
  lifeEvent = #LIFE_NONE
  ; The title waits for Return.
  coverKind = #COVER_TITLE
  coverTimer = -1
  UpdateCover{}
  UpdateCover{}
  UpdateCover{}
  Assert{coverKind = #COVER_TITLE}
  coverKind = #COVER_NONE
  coverTimer = 0
  ; The palette model: the cover blacks pen 0, in either look.
  Assert{PaletteComponent{0, 0, 0, 0, #AREA_MAIN, True} = 0}
  ;; The rest is each look's own model (PaletteComponent{} hands the All-Stars look to AllStarsPaletteComponent{}), nine assertions in
  ;; each so the numbering is the same in both looks' results.
  If #LOOK_ALLSTARS = 0
    ; The NES look: the areas' pens; the cycle; Mario's set.
    Assert{PaletteComponent{0, 0, 0, 0, #AREA_MAIN, False} = 193}
    Assert{PaletteComponent{0, 0, 0, 0, #AREA_BONUS, False} = 0}
    Assert{PaletteComponent{1, 1, 0, 0, #AREA_BONUS, False} = 124}
    Assert{PaletteComponent{12, 0, 0, 0, #AREA_MAIN, False} = 230}
    Assert{PaletteComponent{15, 0, 0, 1, #AREA_MAIN, False} = 255}
    Assert{PaletteComponent{7, 1, 0, 0, #AREA_MAIN, False} = 148}
    ; The water's set (look 4, 2-2): pen 0 the water's blue, front and back; the brick pens the ground's; with no back, the back is the water.
    Assert{PaletteComponent{0, 2, 0, 0, 4, False} = 254 AND PaletteComponent{0, 0, 0, 0, 4, False} = 66}
    Assert{PaletteComponent{16, 0, 0, 0, 4, False} = 66 AND PaletteComponent{1, 0, 0, 0, 4, False} = 156}
    Assert{PaletteComponent{17, 0, 0, 0, 6, False} = 66}
  Else
    ;; The All-Stars look: each tile set's own pens (the sets' atlases' colours: the overground's pen 7 red 131 and white 249, the
    ;; underground's blue 120, the water's Bloober pinks), pen 0 the sky's first band, the water and the castle's wall; the back's pens
    ;; black under a cover, the HUD sheet's white under an overlay (the back is the page's canvas), and transparent over the water.
    Assert{PaletteComponent{0, 0, 0, 0, #AREA_MAIN, False} = allstarsSky(0)}
    Assert{PaletteComponent{7, 0, 0, 0, #AREA_MAIN, False} = 131 AND PaletteComponent{15, 0, 0, 0, #AREA_MAIN, False} = 249}
    Assert{PaletteComponent{7, 2, 0, 0, #AREA_BONUS, False} = 120}
    Assert{PaletteComponent{0, 0, 0, 0, 4, False} = 136 AND PaletteComponent{0, 2, 0, 0, 4, False} = 250}
    Assert{PaletteComponent{10, 0, 0, 0, 4, False} = 208 AND PaletteComponent{11, 2, 0, 0, 4, False} = 208}
    Assert{PaletteComponent{0, 0, 0, 0, 5, False} = 64}
    Assert{PaletteComponent{20, 0, 0, 0, #AREA_MAIN, True} = 0}
    Assert{PaletteComponent{31, 0, 0, 0, #AREA_MAIN, #PALETTE_COVER_OVERLAY} = 249}
    Assert{PaletteComponent{16, 0, 0, 0, 4, False} = 0}
  EndIf
  ; The best score only goes up.
  hudTopScore = 1000
  hudScore = 400
  UpdateTopScore{}
  Assert{hudTopScore = 1000}
  hudScore = 2500
  UpdateTopScore{}
  Assert{hudTopScore = 2500}
  hudScore = 0
  hudTopScore = 0
End Statement

;; Delta 8, the blocked-input mask, and the probe that can actually see it.
;;
;; The rule. The ROM ANDs a blocked direction out of Player_CollisionBits
;; (12345-12349) and that byte is ANDed into the joypad reads at 5982, 6048 and
;; 6228, so a direction blocked by a wall stops being read as input and the
;; acceleration never runs. The engine ports that as playerCollisionBits, written by
;; ImpedePlayerMove{} and consumed by ApplyCollisionButtonMask{}.
;;
;; Why you cannot check this by running into a wall. ImpedePlayerMove{} already
;; zeroes playerSpeedX on the hit, so Mario is stopped with or without the mask and
;; the screen looks identical. The plan asked for a trace, not a playtest, for that
;; reason.
;;
;; Why the acceleration subpixel is NOT the probe, which is what this scenario used
;; to assert and what left it red for a reason that had nothing to do with the mask.
;; playerMoveForceX is the obvious trace: ApplyHorizontalFriction{} adds
;; playerFrictionLow to it on every tick that reads a direction, so the theory was
;; that a masked frame is one where that addition never happens. It never happens,
;; and the subpixel still moves, because PrepareGroundMotion{} is a second writer and
;; it zeroes the subpixel on precisely the masked frames: no direction bit is held,
;; that is not equal to playerMovingDirection, and ImpedePlayerMove{} has already
;; dropped playerSpeedAbsolute to 0, which is under #MARIO_SPD_SKIDSTOP, so the
;; skid-stop branch fires. That is the ROM's own rule -- ProcSkid clears the
;; subpixel, see the main project's PLAYER_PHYSICS note "Speed reset (skid stop)" -- and it
;; fires exactly when the mask fires. So the accumulator alternates between +$e4 on
;; an unmasked tick and 0 on a masked one and never repeats a value within the cycle,
;; and "the subpixel did not move" is unreachable however correct the mask is. No
;; number of retries changes that; it needed a different observable.
;;
;; What is asserted instead: the mask byte, read on the tick that wrote it. On a
;; masked tick the byte must be exactly $fe -- RIGHT cleared, every other bit set.
;; The "at least one" half is impossible without the port, since unmasked the byte
;; is $ff on every tick and right is always read. The whole-byte half is the
;; mapping itself: 12345-12349 eor #$ff the caller's $02 selector (DoPlayerSideCheck,
;; 12031), so a right-wall stop clears exactly the right button and nothing else.
;;
;; 60 ticks is headroom, not a tuned number. The mask lasts one frame and the
;; collision is not every frame -- he rests 1-2 px clear of the face and re-collides
;; only on the ticks he closes that gap -- so most of those ticks are unmasked and
;; have to be, or the mask assertion would be measuring the wrong thing.
;;
;; It asserts a *necessary* condition, not the full rule: that a wall-blocked
;; direction stops being read, not that the masked frame then matches SMB1. Only the
;; before/after frame trace of SetupHorizontalLimits{} and ApplyHorizontalFriction{}
;; settles that, and it is still outstanding.
;;
;; Deliberately NOT asserted: that a leftward hold still walks Mario away from the
;; wall. The ROM's foot-hit mapping reads backwards -- a rightward step sets
;; Player_MovingDir = 1, which pushes him left and clears bit 0, the LEFT button --
;; so a literal port may legitimately pin him (the main project's PLAYER_HITBOX note section
;; 6). Asserting it would hard-code an unverified reading of a quirk the trace has
;; not settled. The jump assertion is the guard that is unambiguous instead: the mask
;; only ever clears the two direction bits, so a blanket clear of playerButtons would
;; take the jump too.
Statement ScenarioWallMask{}
  SHARED wallPinnedProbe, wallMaskedTicks, wallWrongMaskedTicks
  SHARED wallJumped, wallJumpStartY
  SHARED playerCollisionBits, playerX, playerY
  BuildFlatMap{}
  SetTestRun{#FLOOR_ROW - 1, #WALL_COLUMN, #MAP_W - 1, #MT_GROUND}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For reachTick = 0 To 199
    Tick{#MARIO_BTN_RIGHT + #MARIO_BTN_RUN}
  Next
  ; Precondition, so a mask byte cannot pass vacuously. Same two bounds
  ; ScenarioBoxSide{} uses: the probe rests against the face and never in it.
  wallPinnedProbe = playerX + #PROBE_SIDE_X2
  Assert{wallPinnedProbe >= #WALL_COLUMN*#TILE - 2}
  Assert{wallPinnedProbe <= #WALL_COLUMN*#TILE - 1}
  ;; The rule under test, sampled every tick rather than netted over the run, so a
  ;; single masked frame cannot hide behind a byte rewritten after it. The byte is
  ;; read after Tick{}, where it is still the one the last collision wrote.
  ;;
  ;; On a masked tick the byte must be exactly $fe: RIGHT cleared and every other
  ;; bit set. Comparing the whole byte rather than one bit is what makes this an
  ;; assertion about the mapping instead of about its absence -- it catches the two
  ;; directions being swapped ($fd for a right-wall stop), a mask that over-clears
  ;; ($fc, $c0, $00), and a blanket clear that would take the run and jump bits with
  ;; it. Those are all bugs this engine could grow without any other square moving.
  wallMaskedTicks = 0
  wallWrongMaskedTicks = 0
  For maskTick = 0 To 59
    Tick{#MARIO_BTN_RIGHT + #MARIO_BTN_RUN}
    If (playerCollisionBits AND #MARIO_BTN_RIGHT) = 0
      wallMaskedTicks = wallMaskedTicks + 1
      If playerCollisionBits <> Xor($ff, #MARIO_BTN_RIGHT)
        wallWrongMaskedTicks = wallWrongMaskedTicks + 1
      EndIf
    EndIf
  Next
  Assert{wallMaskedTicks > 0}
  Assert{wallWrongMaskedTicks = 0}
  ; The mask is direction-only: jumping while pinned must still work.
  wallJumpStartY = playerY
  wallJumped = False
  For jumpTick = 0 To 7
    Tick{#MARIO_BTN_JUMP}
    If playerY < wallJumpStartY Then wallJumped = True
  Next
  Assert{wallJumped = True}
End Statement

;; The flagpole: grab, slide, release, and a flag that finishes its own journey.
;;
;; Placed just left of the grab window with hold-right, so the grab is the real
;; one -- the ROM test is a window on the low nybble of X, and dropping him
;; straight into the middle of it would not prove the window is where it is.
;;
;; He is put on a step at row 10, so he grabs at y 144 and the band is the 400 one.
;; The slide is the cartridge's: he goes down 2 a tick and hangs at #POLE_STOP_Y,
;; the flag goes down 2 a tick (only while he slides) and the slide ends when it
;; reaches #POLE_FLAG_END_Y; then the 400 is added, the flag stays where it is and
;; he steps off the pole 14 px to the right into the end walk.
Statement ScenarioFlagpole{}
  SHARED poleGrabbed, poleFrameSeen, poleEnded, poleEndY, poleEndX
  SHARED poleFlagAtEnd, poleRegrabbed, poleBand
  SHARED playerState, playerY, playerFrame, flagY, flagState, flagX, hudScore
  SHARED playerX, playerScreenX, cameraX
  BuildFlatMap{}
  SetTestCell{10, #FLAGPOLE_X/#TILE, #MT_GROUND}
  PlacePlayer{(#FLAGPOLE_X/#TILE)*#TILE, 10*#TILE - #PROBE_FOOT_Y}
  ;; PlacePlayer{} puts the camera at 0, which is correct for #MARIO_START_X and
  ;; wrong here: UpdatePlayerCamera{} clamps playerX to cameraX + #VIEW_W - 16.
  ;; Advance the camera to where running there would have got it, and keep
  ;; playerScreenX consistent with it because UpdatePlayerCamera{} reads that
  ;; before it scrolls.
  cameraX = (#FLAGPOLE_X/#TILE)*#TILE - #MARIO_SCREEN_X
  playerScreenX = playerX - cameraX
  scoreBefore.l = hudScore
  poleGrabbed = False
  poleFrameSeen = False
  poleEnded = False
  poleEndY = 0
  poleEndX = 0
  poleFlagAtEnd = 0
  poleRegrabbed = False
  grabX.w = 0
  For poleTick = 0 To 119
    Tick{#MARIO_BTN_RIGHT}
    If playerState = #PLAYER_ST_POLE
      If poleGrabbed = False Then grabX = playerX
      poleGrabbed = True
      If playerFrame = #MARIO_F_CLIMB1 Then poleFrameSeen = True
      If playerFrame = #MARIO_F_CLIMB2 Then poleFrameSeen = True
    EndIf
    If poleEnded = False
      If poleGrabbed = True
        If playerState = #PLAYER_ST_ENDWALK
          poleEnded = True
          poleEndY = playerY
          poleEndX = playerX
          poleFlagAtEnd = flagY
        EndIf
      EndIf
    EndIf
    ;; Hold-right for the rest of the run: once he is off the pole it is spent and
    ;; he must not take hold again.
    If poleEnded = True
      If playerState = #PLAYER_ST_POLE Then poleRegrabbed = True
    EndIf
  Next
  Assert{poleGrabbed = True}
  ; The slide must use the pole frames, not the walk cycle.
  Assert{poleFrameSeen = True}
  Assert{poleEnded = True}
  Assert{poleRegrabbed = False}
  ; He hung at the cartridge's stop height, and stepped 14 px off the pole.
  Assert{poleEndY = #POLE_STOP_Y}
  Assert{poleEndX = grabX + #POLE_STEP_OFF_DX}
  ; The slide ended when the flag reached its end height, two a tick.
  Assert{poleFlagAtEnd >= #POLE_FLAG_END_Y AND poleFlagAtEnd <= #POLE_FLAG_END_Y + #FLAGPOLE_FLAG_STEP - 1}
  ; Grabbed at y 144: the 400 band, added at the end of the slide.
  Assert{hudScore = scoreBefore + 400}
  ; The flag's right edge sits on the shaft line, GID 104 at column 7-8.
  Assert{flagX + #FLAG_W - 1 = (#FLAGPOLE_X/#TILE)*#TILE + #FLAGPOLE_SHAFT_X}
End Statement

;; Grow and shrink.
;;
;; Two things are asserted, and the second is the one that matters. The resize
;; itself is bookkeeping -- state, a locked player, a flag that settles. The
;; collision consequence is the fidelity claim: from the ROM's two probe sets,
;; big and small share their feet and their 12-px width, and only the head row
;; moves, 14 px up. So the head probe is sampled while jumping, once per size.
Statement ScenarioResize{}
  SHARED resizeSawBig, resizeSawSmall, resizeTicks
  SHARED bigHeadProbe, smallHeadProbe
  SHARED playerState, playerIsBig, headProbeY
  SHARED worldFreezeTicks, playerSizeAnimTicks, playerSizeAnimGrow, hudTimeTicks
  BuildFlatMap{}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}

  ; Grow, and watch the lockout actually lock: the cartridge freezes the player
  ; while the graphics alternate, so the two sizes must both be seen mid-flight.
  StartResize{True}
  resizeSawBig = False
  resizeSawSmall = False
  For resizeTick = 0 To 59
    Tick{0}
    If playerIsBig = True Then resizeSawBig = True
    If playerIsBig = False Then resizeSawSmall = True
  Next
  Assert{resizeSawBig = True}
  Assert{resizeSawSmall = True}
  ; Settled: out of the resize state, and big, which is what was asked for.
  Assert{playerState = #PLAYER_ST_FREE}
  Assert{playerIsBig = True}

  ; Jump so CheckPlayerHead{} runs, then read the probe it resolved. No ceiling
  ; is needed: the point is which row the head is tested at, not that it hits
  ; anything.
  For jumpTick = 0 To 5
    Tick{#MARIO_BTN_JUMP}
  Next
  bigHeadProbe.w = headProbeY

  ; Shrink back and sample again. Same jump, same floor, so the only difference
  ; in the answer can be the size.
  StartResize{False}
  For resizeTick = 0 To 59
    Tick{0}
  Next
  Assert{playerIsBig = False}
  For jumpTick = 0 To 5
    Tick{#MARIO_BTN_JUMP}
  Next
  smallHeadProbe.w = headProbeY

  Assert{bigHeadProbe = #PROBE_TOP_Y_BIG}
  Assert{smallHeadProbe = #PROBE_TOP_Y}
  ; The delta, stated as the 14 px the ROM's probe sets differ by, so a future
  ; edit to either probe row has to be deliberate.
  Assert{bigHeadProbe = smallHeadProbe - 14}
  ;; The cartridge's counts (smbdis 5732, 5744: TimerControl from $ff). A grow holds him 59 ticks
  ;; and the world stands still the same time; a hit holds him 15, then he is free and small
  ;; while the world stands still 40 more.
  playerIsBig = False
  StartResize{True}
  For countTick = 1 To #GROW_FREEZE_TICKS - 1
    Tick{0}
  Next
  Assert{playerState = #PLAYER_ST_RESIZE AND worldFreezeTicks = 1}
  Tick{0}
  Assert{playerState = #PLAYER_ST_FREE AND worldFreezeTicks = 0 AND playerIsBig = True}
  StartResize{False}
  For countTick = 1 To #INJURY_HOLD_TICKS - 1
    Tick{0}
  Next
  Assert{playerState = #PLAYER_ST_RESIZE AND playerIsBig = True}
  Tick{0}
  Assert{playerState = #PLAYER_ST_FREE AND playerIsBig = False AND worldFreezeTicks = #INJURY_FREEZE_TICKS - #INJURY_HOLD_TICKS}
  Assert{playerSizeAnimTicks = #SIZE_ANIM_TICKS}
  For countTick = 1 To #INJURY_FREEZE_TICKS - #INJURY_HOLD_TICKS
    Tick{0}
  Next
  Assert{worldFreezeTicks = 0 AND playerSizeAnimTicks = 0}
  ;; The picture, step by step: growing small, big, small, big, small, big, big, small, big, big;
  ;; shrinking small and big in turn.
  playerSizeAnimGrow = True
  playerSizeAnimTicks = #SIZE_ANIM_TICKS
  growFirst.w = SizeAnimShowsBig{}
  playerSizeAnimTicks = #SIZE_ANIM_TICKS - 1*#SIZE_ANIM_STEP_TICKS
  growSecond.w = SizeAnimShowsBig{}
  playerSizeAnimTicks = #SIZE_ANIM_TICKS - 6*#SIZE_ANIM_STEP_TICKS
  growSeventh.w = SizeAnimShowsBig{}
  playerSizeAnimTicks = #SIZE_ANIM_TICKS - 7*#SIZE_ANIM_STEP_TICKS
  growEighth.w = SizeAnimShowsBig{}
  Assert{growFirst = False AND growSecond = True AND growSeventh = True AND growEighth = False}
  playerSizeAnimGrow = False
  playerSizeAnimTicks = #SIZE_ANIM_TICKS
  shrinkFirst.w = SizeAnimShowsBig{}
  playerSizeAnimTicks = #SIZE_ANIM_TICKS - 1*#SIZE_ANIM_STEP_TICKS
  shrinkSecond.w = SizeAnimShowsBig{}
  Assert{shrinkFirst = False AND shrinkSecond = True}
  playerSizeAnimTicks = 0
  ;; The game clock is one of the timers the master timer stops.
  hudTimeTicks = 0
  worldFreezeTicks = 5
  TickHudTimer{}
  Assert{hudTimeTicks = 0}
  worldFreezeTicks = 0
  TickHudTimer{}
  Assert{hudTimeTicks = 1}
  hudTimeTicks = 0
End Statement


;; A `?` block that carries a block-item marker releases the item when the
;; bump's bob settles, 16 frames after the head hit. The cell is read from the
;; generated table (never hardcoded), so the test fails if the level designer
;; forgot to mark a `?` block, and the table is empty.
;;
;; The `?` is placed at blockItemCell(0) in the test map's metatile buffer, so
;; the bump fires through the live CheckPlayerHead -> StartBlockBump ->
;; FinishBlockBump -> SpawnBlockItem path rather than a mock. The spawn tick is
;; the new assertion: the mushroom must not be armed on the head-hit tick, when
;; the block is still bobbing, and must be armed on the tick the bob settles.
Statement ScenarioBlockItem{}
  SHARED blockItemCell(), blockItemSprite()
  SHARED blockItemRow, blockItemCol
  SHARED objActive(), objType(), objX(), objY(), objSprite(), objVelY()
  SHARED objRiseRemaining(), simStepNumerator
  SHARED cameraX, playerX, playerScreenX
  SHARED blockBounceTimer, blockBumpActive
  SHARED bumpArmTick, bumpFinishTick, mushroomSpawnTick
  BuildFlatMap{}
  ; Read the first block-item cell from the generated table. An empty table
  ; leaves the defaults (0,0), which is far from any `?` block, so the bump
  ; never fires and the assertion fails fast.
  blockItemRow.w = blockItemCell(0)/#MAP_W
  blockItemCol.w = blockItemCell(0) MOD #MAP_W
  SetTestCell{blockItemRow, blockItemCol, #MT_QUESTION}
  ; Stand directly under the `?` block. The head probe at playerX + 8 lands
  ; inside the block's column, and a stationary slow jump rises 32 px in 8
  ; ticks -- enough to carry the probe from y 178 to y 146, inside the block's
  ; row at y 144-159.
  PlacePlayer{blockItemCol*#TILE, (#FLOOR_ROW - 1)*#TILE}
  ; PlacePlayer{} leaves cameraX at 0, which UpdatePlayerCamera{} clamps to,
  ; so the player is dragged back and the head probe never reaches the `?`
  ; block. Advance the camera to where running there would have left it, and
  ; keep playerScreenX consistent -- exactly as ScenarioFlagpole{} does.
  cameraX = blockItemCol*#TILE - #MARIO_SCREEN_X
  playerScreenX = playerX - cameraX
  bumpArmTick = -1
  bumpFinishTick = -1
  mushroomSpawnTick = -1
  ; The spawn is deferred to the settle, 16 frames after the arm tick, so the
  ; old bound of 19 ticks no longer reaches it.
  For jumpTick = 0 To 35
    Tick{#MARIO_BTN_JUMP}
    If blockBounceTimer = #MARIO_BLOCKBOUNCE
      If bumpArmTick < 0 Then bumpArmTick = jumpTick
    EndIf
    If blockBumpActive = False
      If bumpArmTick >= 0
        If bumpFinishTick < 0 Then bumpFinishTick = jumpTick
      EndIf
    EndIf
    If PoolTypeActive{#OBJ_MUSHROOM} >= 0
      If mushroomSpawnTick < 0 Then mushroomSpawnTick = jumpTick
    EndIf
    If PoolTypeActive{#OBJ_MUSHROOM} >= 0 Then jumpTick = 36
  Next
  mushroomSlot.w = PoolTypeActive{#OBJ_MUSHROOM}
  Assert{mushroomSlot >= 0}
  ; The spawn lands on the settle tick, not the head-hit tick: the block is
  ; still bobbing when his head meets it, and the item rises out of it only
  ; once the bob is over.
  Assert{mushroomSpawnTick = bumpFinishTick}
  Assert{mushroomSpawnTick > bumpArmTick}
  ; In the live UpdatePlayer{} the mushroom spawns this tick and is stepped on
  ; the same tick (player.blitz.ab3:596). Mirror that so the emergence is
  ; asserted after the first UpdateObjects{} step, not before.
  UpdateObjects{}
  ; Rise: one real second, on its own counter, ignoring gravity. First step:
  ; the 1/256 carry gains one rise step and no whole pixel yet, so the
  ; mushroom keeps the block's spawn pixel, and no walk, landing or pickup
  ; runs on a rise tick. The test does not call InitTimingClock{}, so
  ; simStepNumerator is the globals default 50: assert with the live global,
  ; not a literal.
  Assert{objY(mushroomSlot) = blockItemRow*#TILE}
  Assert{objVelY(mushroomSlot) = 0}
  Assert{objRiseRemaining(mushroomSlot) = simStepNumerator - 1}
  Assert{objX(mushroomSlot) = blockItemCol*#TILE}
  ; The rest of the rise, then the snap: the end of the rise lands the bottom
  ; exactly on the block's top, whatever the per-tick rounding left behind.
  For riseStep = 1 To simStepNumerator - 1
    UpdateObjects{}
  Next
  Assert{objY(mushroomSlot) = (blockItemRow*#TILE) - #TILE}
  Assert{objVelY(mushroomSlot) = 0}
  Assert{objRiseRemaining(mushroomSlot) = 0}
  ; Active: the counter reaches 0 inside the final rise tick, so that tick is
  ; already an active one: the snap lands the bottom on the block's top and
  ; the walk gate opens, so the mushroom has taken its first walk step by the
  ; end of the rise. While the foot probe is in the block's column the
  ; landing snap keeps the bottom on the block's top, one pixel a tick; seven
  ; more ticks walk it 8 px right in total, and on the eighth the foot probe
  ; leaves the block's column and the fall begins.
  For restTick = 1 To 7
    UpdateObjects{}
  Next
  Assert{objX(mushroomSlot) = blockItemCol*#TILE + 8}
  Assert{objY(mushroomSlot) = (blockItemRow*#TILE) - #TILE}
  ; Then the fall, from rest: gravity #MUSHROOM_GRAVITY (61/256 px/tick^2, the
  ; cartridge's $3d) reaches the cap of 768/256 on tick 13, the displacement at tick
  ; 16 is 30 px (the integrator's own arithmetic, worked out offline; it was 17 px
  ; under the old 32 and 512), and it keeps walking while it falls (16 more pixels).
  For fallTick = 1 To 16
    UpdateObjects{}
  Next
  Assert{objVelY(mushroomSlot) = #MUSHROOM_FALL_MAX}
  Assert{objY(mushroomSlot) = (blockItemRow*#TILE) - #TILE + 30 AND objX(mushroomSlot) = blockItemCol*#TILE + 24}
  ; ...and it lands on the flat test floor with velocity 0, still walking.
  For settleTick = 1 To 40
    UpdateObjects{}
  Next
  Assert{objY(mushroomSlot) = (#FLOOR_ROW*#TILE) - #TILE AND objVelY(mushroomSlot) = 0}
  ; The sprite resolves from item + palette via OBJECT_PALETTES, so the red
  ; variant is sprite 29 (checked against #MUSHROOM_SPRITE so the test follows
  ; the constant rather than retreading a magic number).
  Assert{objSprite(mushroomSlot) = #MUSHROOM_SPRITE}
End Statement

;; Scenario 13: the coin is released through SpawnBlockItem{}, the real release
;; path, so it is live while the mushroom block is bumped. Tick{} does not step
;; the objects, so the coin stays live until the scenario says otherwise, and the
;; mushroom has to be allowed out alongside it on the settle tick.
Statement ScenarioCoinThenMushroom{}
  SHARED blockItemCell(), blockItemSprite()
  SHARED blockItemRow, blockItemCol
  SHARED objActive(), objType()
  SHARED blockBounceTimer, blockBumpActive
  SHARED bumpArmTick, bumpFinishTick, mushroomSpawnTick
  SHARED cameraX, playerX, playerScreenX
  BuildFlatMap{}
  SpawnBlockItem{blockItemCell(1)}
  coinSlot.w = PoolTypeActive{#OBJ_COIN}
  Assert{coinSlot >= 0}
  blockItemRow.w = blockItemCell(0)/#MAP_W
  blockItemCol.w = blockItemCell(0) MOD #MAP_W
  SetTestCell{blockItemRow, blockItemCol, #MT_QUESTION}
  PlacePlayer{blockItemCol*#TILE, (#FLOOR_ROW - 1)*#TILE}
  cameraX = blockItemCol*#TILE - #MARIO_SCREEN_X
  playerScreenX = playerX - cameraX
  bumpArmTick = -1
  bumpFinishTick = -1
  mushroomSpawnTick = -1
  coinLiveAtSpawn.w = -1
  For jumpTick = 0 To 35
    Tick{#MARIO_BTN_JUMP}
    If blockBounceTimer = #MARIO_BLOCKBOUNCE
      If bumpArmTick < 0 Then bumpArmTick = jumpTick
    EndIf
    If blockBumpActive = False
      If bumpArmTick >= 0
        If bumpFinishTick < 0 Then bumpFinishTick = jumpTick
      EndIf
    EndIf
    If PoolTypeActive{#OBJ_MUSHROOM} >= 0
      If mushroomSpawnTick < 0
        mushroomSpawnTick = jumpTick
        coinLiveAtSpawn = PoolTypeActive{#OBJ_COIN}
      EndIf
      jumpTick = 36
    EndIf
  Next
  Assert{mushroomSpawnTick >= 0}
  Assert{mushroomSpawnTick = bumpFinishTick}
  Assert{coinLiveAtSpawn >= 0}
End Statement

;; Scenario 14: two coin blocks released back to back. Before the fix the
;; second release was dropped by the coin guard in SpawnBlockItem{}.
Statement ScenarioTwoCoins{}
  SHARED blockItemCell()
  SHARED objActive(), objType()
  coinCount.w = 0
  SpawnBlockItem{blockItemCell(1)}
  SpawnBlockItem{blockItemCell(2)}
  For poolSlot = 0 To #MAX_OBJECTS - 1
    If objActive(poolSlot) = True AND objType(poolSlot) = #OBJ_COIN
      coinCount = coinCount + 1
    EndIf
  Next
  Assert{coinCount = 2}
End Statement

;; Scenario 15: a mushroom is out, and a coin block is then released. The coin
;; must come out. A second mushroom block while the first is out replaces it, so
;; there is still exactly one mushroom (the cartridge's single power-up slot).
Statement ScenarioMushroomThenCoin{}
  SHARED blockItemCell()
  SHARED objActive(), objType()
  mushroomCount.w = 0
  coinCount.w = 0
  SpawnBlockItem{blockItemCell(0)}
  SpawnBlockItem{blockItemCell(1)}
  SpawnBlockItem{blockItemCell(0)}
  For poolSlot = 0 To #MAX_OBJECTS - 1
    If objActive(poolSlot) = True AND objType(poolSlot) = #OBJ_MUSHROOM
      mushroomCount = mushroomCount + 1
    EndIf
    If objActive(poolSlot) = True AND objType(poolSlot) = #OBJ_COIN
      coinCount = coinCount + 1
    EndIf
  Next
  Assert{coinCount = 1}
  Assert{mushroomCount = 1}
End Statement

;; Scenario 16: a mushroom is released, then the camera moves past it without
;; Mario collecting it. UpdateObjects{} must free it, so a second mushroom block
;; can release one.
Statement ScenarioMushroomLeaves{}
  SHARED blockItemCell(), blockItemRow, blockItemCol
  SHARED objActive(), objType(), objX(), objY()
  SHARED cameraX, simStepNumerator
  BuildFlatMap{}
  ; Keep Mario well away from the mushroom so a pickup cannot free it instead.
  PlacePlayer{0, (#FLOOR_ROW - 1)*#TILE}
  blockItemRow.w = blockItemCell(0)/#MAP_W
  blockItemCol.w = blockItemCell(0) MOD #MAP_W
  SpawnBlockItem{blockItemCell(0)}
  mushroomSlot.w = PoolTypeActive{#OBJ_MUSHROOM}
  Assert{mushroomSlot >= 0}
  ; Let the rise finish, then put the camera well past the mushroom's column.
  For riseStep = 1 To simStepNumerator + 1
    UpdateObjects{}
  Next
  cameraX = blockItemCol*#TILE + 128
  UpdateObjects{}
  mushroomGone.w = PoolTypeActive{#OBJ_MUSHROOM}
  Assert{mushroomGone = -1}
  SpawnBlockItem{blockItemCell(0)}
  mushroomAgain.w = PoolTypeActive{#OBJ_MUSHROOM}
  Assert{mushroomAgain >= 0}
End Statement

;; ---------------------------------------------------------------
;; Scenario 38: the star and the flower, and whether the fire button works
;; ---------------------------------------------------------------
;; Written 2026-10-11 to settle a report (the main project's journal notes): after taking the star and
;; then the flower, Mario showed fire colours and the fire button did nothing. It was
;; never reproduced. Every order of the two power-ups, driven through the real
;; UpdateObjects{}, UpdateResize{}, TryThrowFireball{}, UpdateFireballs{} and the interval
;; timers (WorldTick{} is the live order of those), and each time a throw is tried.
;; The last part is a real divergence this scenario found by reading the cartridge: a
;; power-up cannot be taken while Mario is frozen growing, because PlayerEnemyCollision
;; leaves unless the player routine is the normal one (smbdis 11301); ours could.

;; One sim tick, in the live order for what this scenario touches.
Statement WorldTick{buttons.w}
  SHARED playerState, playerButtons, simTickCounter
  If playerState = #PLAYER_ST_FREE
    playerButtons = buttons
    TryThrowFireball{}
  EndIf
  Tick{buttons}
  UpdateObjects{}
  UpdateFloaters{}
  UpdateFireballs{}
  UpdateIntervalTimers{}
  simTickCounter = simTickCounter + 1
End Statement

Statement IdleTicks{tickCount.w}
  For idleTick = 1 To tickCount
    WorldTick{0}
  Next
End Statement

;; A Mario on the floor and nothing else in the world.
Statement StartFireTest{startBig.w, startFire.w}
  SHARED playerIsBig, playerFire, playerStarIntervals, playerInjuryIntervals, fireballCounter
  SHARED fireballActive(), playerThrowTimer, simTickCounter, intervalPhase
  BuildFlatMap{}
  PoolInit{}
  ClearFloaters{}
  For clearBall = 0 To #FIREBALL_SLOTS - 1
    fireballActive(clearBall) = 0
  Next
  fireballCounter = 0
  playerThrowTimer = 0
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  playerIsBig = startBig
  playerFire = startFire
  playerStarIntervals = 0
  playerInjuryIntervals = 0
  simTickCounter = 0
  intervalPhase = 0
  UpdatePlayerBoundBox{}
End Statement

;; A power-up lying where Mario stands: #OBJ_MUSHROOM, #OBJ_FLOWER or #OBJ_STAR.
Statement DropItem{itemType.w}
  SHARED playerX, playerY, simStepNumerator, objType(), objRiseRemaining()
  itemSlot.w = PoolAlloc{}
  If itemType = #OBJ_STAR
    PoolInitBlockItem{itemSlot, playerX, playerY, #STAR_SPRITE_BASE, 0, simStepNumerator}
  Else
    PoolInitBlockItem{itemSlot, playerX, playerY, #MUSHROOM_SPRITE, 0, simStepNumerator}
  EndIf
  objType(itemSlot) = itemType
  objRiseRemaining(itemSlot) = 0
End Statement

;; Tick until the grow or the fire freeze is over (at most 300 ticks).
Function.w SettleResize{}
  SHARED playerState
  settleTicks.w = 0
  While playerState <> #PLAYER_ST_FREE AND settleTicks < 300
    WorldTick{0}
    settleTicks = settleTicks + 1
  Wend
  Function Return settleTicks
End Function

;; Press the fire button for a tick and let go for a tick: True if a ball was thrown.
Function.w TryFireballPress{}
  SHARED fireballCounter
  ballsBefore.w = fireballCounter
  WorldTick{#MARIO_BTN_FIRE}
  WorldTick{0}
  If fireballCounter > ballsBefore Then Function Return True
  Function Return False
End Function

Statement ScenarioStarFlowerFire{}
  SHARED playerIsBig, playerFire, playerState, playerStarIntervals, fireballCounter
  ;; A big Mario takes the star, then the flower (the reported order).
  StartFireTest{True, False}
  DropItem{#OBJ_STAR}
  WorldTick{0}
  DropItem{#OBJ_FLOWER}
  WorldTick{0}
  Assert{playerState = #PLAYER_ST_RESIZE}
  settled.w = SettleResize{}
  Assert{playerFire = True AND playerIsBig = True}
  ; The star is still running, and a throw works under it.
  Assert{playerStarIntervals > 0 AND TryFireballPress{} = True}
  For starTick = 1 To 800
    If playerStarIntervals > 0 Then WorldTick{0}
  Next
  Assert{playerStarIntervals = 0}
  Assert{playerFire = True AND playerIsBig = True}
  ; Five throws a second apart, the slots alternating and every one clear again.
  thrown.w = 0
  For throwNumber = 1 To 5
    IdleTicks{70}
    If TryFireballPress{} = True Then thrown = thrown + 1
  Next
  Assert{thrown = 5}
  ;; A small Mario takes the star, then the flower: he only grows (the cartridge's
  ;; flower is a mushroom to a small Mario), so there is still no fire.
  StartFireTest{False, False}
  DropItem{#OBJ_STAR}
  WorldTick{0}
  DropItem{#OBJ_FLOWER}
  WorldTick{0}
  settled = SettleResize{}
  Assert{playerIsBig = True AND playerFire = False}
  Assert{TryFireballPress{} = False}
  ;; The next flower is the fire, and then the button works.
  DropItem{#OBJ_FLOWER}
  WorldTick{0}
  settled = SettleResize{}
  Assert{playerFire = True AND playerIsBig = True}
  Assert{TryFireballPress{} = True}
  ;; Fire Mario takes the star: he keeps the fire, and throws during and after it.
  StartFireTest{True, True}
  DropItem{#OBJ_STAR}
  WorldTick{0}
  Assert{playerStarIntervals > 0 AND playerFire = True}
  Assert{TryFireballPress{} = True}
  For starTick = 1 To 800
    If playerStarIntervals > 0 Then WorldTick{0}
  Next
  IdleTicks{70}
  Assert{playerFire = True AND TryFireballPress{} = True}
  ;; A flower lying on a Mario who is mid-growth is not taken until the freeze is over
  ;; (smbdis 11301); then it is, and he is Fire Mario.
  StartFireTest{False, False}
  DropItem{#OBJ_MUSHROOM}
  WorldTick{0}
  Assert{playerState = #PLAYER_ST_RESIZE}
  DropItem{#OBJ_FLOWER}
  IdleTicks{4}
  Assert{PoolTypeActive{#OBJ_FLOWER} >= 0}
  settled = SettleResize{}
  Assert{playerFire = True AND playerIsBig = True}
  Assert{TryFireballPress{} = True}
  ; Leave a clean world for the next scenario.
  playerFire = False
  playerIsBig = False
  playerStarIntervals = 0
  PoolInit{}
  ClearFloaters{}
  BuildFlatMap{}
End Statement

;; ---------------------------------------------------------------
;; Scenario 39: the pause
;; ---------------------------------------------------------------
;; PauseRoutine (smbdis 851) and the sound engine's pause mode (15050 to 15099), driven
;; by hand: UpdatePause{} with the Start key as a parameter, SoundTick{} with the
;; hardware off.
Statement SoundTicks{tickCount.w}
  For soundTickNumber = 1 To tickCount
    SoundTick{}
  Next
End Statement

Statement ScenarioPause{}
  SHARED soundState(), apuState(), gamePaused, pauseTimer, pauseStartHeld, coverKind
  SHARED lifeEvent, areaEvent, flagState, castleEndTask, playerState
  ;; The engine: music running, then a pause.
  SoundReset{}
  soundState(#SS_ENABLED) = True
  SoundAreaMusic{#MUSIC_GROUND}
  SoundTicks{20}
  offsetBefore.w = soundState(#SS_MUSIC_OFFSET_SQUARE2)
  Assert{offsetBefore > 0}
  SoundPause{1}
  SoundTick{}
  Assert{soundState(#SS_PAUSE_MODE) = 1 AND soundState(#SS_PAUSE_BUFFER) = 1}
  Assert{apuState(#AP_CONTROL) = $84}
  frozenOffset.w = soundState(#SS_MUSIC_OFFSET_SQUARE2)
  SoundTicks{50}
  ;; The tone is over (42 ticks), the pause goes on silent, and the music has not moved.
  Assert{soundState(#SS_PAUSE_BUFFER) = 0 AND soundState(#SS_PAUSE_MODE) = 1}
  Assert{soundState(#SS_MUSIC_OFFSET_SQUARE2) = frozenOffset}
  Assert{apuState(#AP_LEVEL) = 0 AND apuState(16 + #AP_LEVEL) = 0 AND apuState(32 + #AP_LEVEL) = 0 AND apuState(48 + #AP_LEVEL) = 0}
  ;; The resume: its own tone, the music still held, then it goes on.
  SoundPause{2}
  SoundTick{}
  Assert{soundState(#SS_PAUSE_MODE) = 2}
  SoundTicks{30}
  Assert{soundState(#SS_MUSIC_OFFSET_SQUARE2) = frozenOffset}
  SoundTicks{20}
  Assert{soundState(#SS_PAUSE_MODE) = 0 AND soundState(#SS_PAUSE_BUFFER) = 0}
  SoundTicks{80}
  Assert{soundState(#SS_MUSIC_OFFSET_SQUARE2) <> frozenOffset}
  ;; The game: a fresh press pauses and asks for the tone.
  SoundReset{}
  coverKind = #COVER_NONE
  lifeEvent = #LIFE_NONE
  areaEvent = 0
  flagState = #FLAG_ST_IDLE
  castleEndTask = 0
  playerState = #PLAYER_ST_FREE
  gamePaused = False
  pauseTimer = 0
  pauseStartHeld = False
  UpdatePause{True}
  Assert{gamePaused = True AND soundState(#SS_PAUSE_QUEUE) = 1}
  ;; Held, no second toggle; a press inside the lockout does nothing.
  UpdatePause{True}
  UpdatePause{False}
  UpdatePause{True}
  Assert{gamePaused = True}
  ;; After the lockout, a release and a press resumes.
  For lockTick = 1 To #PAUSE_LOCKOUT_TICKS + 2
    UpdatePause{False}
  Next
  soundState(#SS_PAUSE_QUEUE) = 0
  UpdatePause{True}
  Assert{gamePaused = False AND soundState(#SS_PAUSE_QUEUE) = 2}
  ;; Not on a cover, and not with a Start that was already down.
  For lockTick = 1 To #PAUSE_LOCKOUT_TICKS + 2
    UpdatePause{False}
  Next
  coverKind = #COVER_LIVES
  UpdatePause{True}
  Assert{gamePaused = False}
  coverKind = #COVER_NONE
  UpdatePause{True}
  Assert{gamePaused = False}
  UpdatePause{False}
  UpdatePause{True}
  Assert{gamePaused = True}
  ;; The level's end, from the axe: the pause key still pauses (the way out of a castle's end to QUIT TO TITLE). Return no longer
  ;; pauses, and a CD32 pad's play is no longer read, so nothing needs keeping out then (LevelEndRunning{} went, 2026-11-10).
  playerState = #PLAYER_ST_AXE
  gamePaused = False
  pauseTimer = 0
  UpdatePause{False}
  UpdatePause{True}
  Assert{gamePaused = True}
  playerState = #PLAYER_ST_FREE
  coverKind = #COVER_NONE
  gamePaused = False
  pauseTimer = 0
  pauseStartHeld = False
  SoundReset{}
End Statement

;; ---------------------------------------------------------------
;; Scenario 40: a bumped block against what stands on it
;; ---------------------------------------------------------------
;; HandleEToBGCollision and SetStun (smbdis 12433, 12470): a Goomba on the cell is thrown
;; off with 100, a Koopa becomes a shell (100) that jumps, a shell hops, a mushroom jumps and
;; moves AWAY from Mario (whichever side it is on) and scores nothing; what is elsewhere or
;; above is not touched. Through the real UpdateObjects{}, with the cell set the way
;; StartBlockBump{} sets it.
Statement ScenarioBumpObjects{}
  SHARED hudScore, bumpObjectCell, objState(), objAux(), objY(), objX(), objVelX(), objVelY(), objDir()
  SHARED objType(), objRiseRemaining(), simStepNumerator, mapBuffer(), blockBumpActive, objFlipped()
  bumpColumn.w = 12
  bumpCell.w = #FLOOR_ROW*#MAP_W + bumpColumn
  floorY.w = (#FLOOR_ROW - 1)*#TILE
  ;; A Goomba on the cell.
  BuildFlatMap{}
  PoolInit{}
  ClearFloaters{}
  PlacePlayer{20, floorY}
  UpdatePlayerBoundBox{}
  goomba.w = PoolAlloc{}
  PoolInitGoomba{goomba, bumpColumn*#TILE + 4, floorY}
  scoreBefore.l = hudScore
  bumpObjectCell = bumpCell
  UpdateObjects{}
  StepFloaters{6}
  Assert{objState(goomba) = #GOOMBA_ST_KNOCKED}
  Assert{hudScore = scoreBefore + 100}
  Assert{bumpObjectCell = -1}
  Assert{objVelX(goomba) = #BUMP_THROW_SPEED_X}
  ;; A walking Koopa becomes a shell; a shell stays one; each gives 100.
  koopa.w = PlaceTestKoopa{bumpColumn*#TILE + 4, #KOOPA_ST_WALK, 20}
  ClearFloaters{}
  scoreBefore = hudScore
  bumpObjectCell = bumpCell
  UpdateObjects{}
  StepFloaters{6}
  Assert{objState(koopa) = #KOOPA_ST_SHELL AND objFlipped(koopa) = True}
  Assert{objAux(koopa) = #KOOPA_REVIVE_INTERVALS}
  Assert{hudScore = scoreBefore + 100}
  ; It jumps and slides away from Mario, then lands and stops.
  Assert{objVelY(koopa) < 0 AND objVelX(koopa) = #BUMP_THROW_SPEED_X}
  For shellTick = 1 To 60
    UpdateObjects{}
  Next
  Assert{objVelX(koopa) = 0 AND objVelY(koopa) = 0 AND objState(koopa) = #KOOPA_ST_SHELL}
  ; It stays on its back until its timer ends, then gets up the right way.
  objAux(koopa) = 0
  UpdateObjects{}
  Assert{objState(koopa) = #KOOPA_ST_WALK AND objFlipped(koopa) = False}
  shell.w = PlaceTestKoopa{bumpColumn*#TILE + 4, #KOOPA_ST_SHELL, 20}
  ClearFloaters{}
  scoreBefore = hudScore
  bumpObjectCell = bumpCell
  UpdateObjects{}
  StepFloaters{6}
  Assert{objState(shell) = #KOOPA_ST_SHELL}
  Assert{hudScore = scoreBefore + 100}
  ;; A Goomba on another cell, and one above the block, are left alone.
  PoolInit{}
  ClearFloaters{}
  PlacePlayer{20, floorY}
  UpdatePlayerBoundBox{}
  farGoomba.w = PoolAlloc{}
  PoolInitGoomba{farGoomba, (bumpColumn + 4)*#TILE + 4, floorY}
  highGoomba.w = PoolAlloc{}
  PoolInitGoomba{highGoomba, bumpColumn*#TILE + 4, floorY - 3*#TILE}
  bumpObjectCell = bumpCell
  UpdateObjects{}
  Assert{objState(farGoomba) = 0 AND objState(highGoomba) = 0}
  ;; A mushroom on it jumps (lifted 2 px, three pixels a tick up) and moves away from Mario,
  ;; whichever side it is on, and gives nothing; it comes down on the floor again.
  PoolInit{}
  ClearFloaters{}
  PlacePlayer{20, floorY}
  mushroomSlot.w = PoolAlloc{}
  PoolInitBlockItem{mushroomSlot, bumpColumn*#TILE + 4, floorY, #MUSHROOM_SPRITE, 0, simStepNumerator}
  objRiseRemaining(mushroomSlot) = 0
  objDir(mushroomSlot) = #MARIO_BTN_LEFT
  scoreBefore = hudScore
  BumpObjectsOn{bumpCell}
  StepFloaters{6}
  Assert{objY(mushroomSlot) = floorY - 2 AND objVelY(mushroomSlot) = #BUMP_JUMP_SPEED_Y}
  Assert{hudScore = scoreBefore}
  Assert{objDir(mushroomSlot) = #MARIO_BTN_RIGHT}
  highest.w = floorY
  startMushroomX.w = objX(mushroomSlot)
  For jumpTick = 1 To 12
    UpdateObjects{}
    If objY(mushroomSlot) < highest Then highest = objY(mushroomSlot)
  Next
  Assert{highest < floorY - 12 AND objX(mushroomSlot) > startMushroomX + 6}
  For jumpTick = 1 To 40
    UpdateObjects{}
  Next
  Assert{objY(mushroomSlot) = floorY AND objVelY(mushroomSlot) = 0}
  ; With Mario on its right it goes left: a mushroom walking toward him turns round.
  PoolInit{}
  PlacePlayer{300, floorY}
  mushroomSlot = PoolAlloc{}
  PoolInitBlockItem{mushroomSlot, bumpColumn*#TILE + 4, floorY, #MUSHROOM_SPRITE, 0, simStepNumerator}
  objRiseRemaining(mushroomSlot) = 0
  objDir(mushroomSlot) = #MARIO_BTN_RIGHT
  BumpObjectsOn{bumpCell}
  Assert{objDir(mushroomSlot) = #MARIO_BTN_LEFT}
  ;; StartBlockBump{} leaves the cell for it (BreakBrick{} does the same).
  savedGid.w = mapBuffer(bumpCell)
  StartBlockBump{bumpCell, #MT_BRICK, savedGid}
  Assert{bumpObjectCell = bumpCell}
  mapBuffer(bumpCell) = savedGid
  blockBumpActive = False
  bumpObjectCell = -1
  PoolInit{}
  ClearFloaters{}
  BuildFlatMap{}
End Statement

;; ---------------------------------------------------------------
;; Scenario 41: enemies that meet turn round
;; ---------------------------------------------------------------
;; EnemiesCollision and EnemyTurnAround (smbdis 11551, 11695): on every other tick, a pair
;; that overlaps turns, both of them, once until they part; not a finished enemy, not
;; one partly off screen, not a sliding shell. EnemiesTurnAround{} is called by hand with
;; simTickCounter set.
Statement ScenarioEnemyTurn{}
  SHARED simTickCounter, objDir(), objState(), objX(), cameraX
  floorY.w = (#FLOOR_ROW - 1)*#TILE
  BuildFlatMap{}
  PoolInit{}
  PlacePlayer{20, floorY}
  cameraX = 0
  leftSlot.w = PoolAlloc{}
  PoolInitGoomba{leftSlot, 200, floorY}
  objDir(leftSlot) = #MARIO_BTN_RIGHT
  rightSlot.w = PoolAlloc{}
  PoolInitGoomba{rightSlot, 210, floorY}
  objDir(rightSlot) = #MARIO_BTN_LEFT
  ; An even tick does nothing.
  simTickCounter = 2
  EnemiesTurnAround{}
  Assert{objDir(leftSlot) = #MARIO_BTN_RIGHT AND objDir(rightSlot) = #MARIO_BTN_LEFT}
  ; An odd tick turns both.
  simTickCounter = 3
  EnemiesTurnAround{}
  Assert{objDir(leftSlot) = #MARIO_BTN_LEFT AND objDir(rightSlot) = #MARIO_BTN_RIGHT}
  ; Still overlapping: not again.
  simTickCounter = 5
  EnemiesTurnAround{}
  Assert{objDir(leftSlot) = #MARIO_BTN_LEFT AND objDir(rightSlot) = #MARIO_BTN_RIGHT}
  ; Apart, then together again: they turn again.
  PoolFree{rightSlot}
  rightSlot = PoolAlloc{}
  PoolInitGoomba{rightSlot, 280, floorY}
  objDir(rightSlot) = #MARIO_BTN_LEFT
  EnemiesTurnAround{}
  objX(rightSlot) = 210
  objDir(leftSlot) = #MARIO_BTN_RIGHT
  simTickCounter = 7
  EnemiesTurnAround{}
  Assert{objDir(leftSlot) = #MARIO_BTN_LEFT AND objDir(rightSlot) = #MARIO_BTN_RIGHT}
  ; A Goomba and a shell lying down: the Goomba turns.
  PoolInit{}
  leftSlot = PoolAlloc{}
  PoolInitGoomba{leftSlot, 200, floorY}
  objDir(leftSlot) = #MARIO_BTN_RIGHT
  lying.w = PoolAlloc{}
  PoolInitKoopa{lying, 208, #FLOOR_ROW*#TILE - #KOOPA_H}
  objState(lying) = #KOOPA_ST_SHELL
  simTickCounter = 9
  EnemiesTurnAround{}
  Assert{objDir(leftSlot) = #MARIO_BTN_LEFT}
  ; A finished enemy, a sliding shell, and one partly off screen are not in it.
  PoolInit{}
  leftSlot = PoolAlloc{}
  PoolInitGoomba{leftSlot, 200, floorY}
  objDir(leftSlot) = #MARIO_BTN_RIGHT
  objState(leftSlot) = #GOOMBA_ST_KNOCKED
  rightSlot = PoolAlloc{}
  PoolInitGoomba{rightSlot, 208, floorY}
  objDir(rightSlot) = #MARIO_BTN_LEFT
  EnemiesTurnAround{}
  Assert{objDir(rightSlot) = #MARIO_BTN_LEFT}
  PoolInit{}
  leftSlot = PoolAlloc{}
  PoolInitGoomba{leftSlot, 200, floorY}
  objDir(leftSlot) = #MARIO_BTN_RIGHT
  sliding.w = PoolAlloc{}
  PoolInitKoopa{sliding, 208, #FLOOR_ROW*#TILE - #KOOPA_H}
  objState(sliding) = #KOOPA_ST_KICKED
  EnemiesTurnAround{}
  Assert{objDir(leftSlot) = #MARIO_BTN_RIGHT}
  PoolInit{}
  leftSlot = PoolAlloc{}
  PoolInitGoomba{leftSlot, #VIEW_W - 8, floorY}
  objDir(leftSlot) = #MARIO_BTN_RIGHT
  rightSlot = PoolAlloc{}
  PoolInitGoomba{rightSlot, #VIEW_W - 4, floorY}
  objDir(rightSlot) = #MARIO_BTN_LEFT
  EnemiesTurnAround{}
  Assert{objDir(leftSlot) = #MARIO_BTN_RIGHT AND objDir(rightSlot) = #MARIO_BTN_LEFT}
  simTickCounter = 0
  PoolInit{}
  BuildFlatMap{}
End Statement

;; ---------------------------------------------------------------
;; Scenario 42: the keyboard's two schemes, and the choices
;; ---------------------------------------------------------------
;; ActionButtonBits{} with the keys as parameters (the keyboard cannot be scripted), the
;; fireball reading the fire bit and not the run bit, and the KEYBOARD and JOYSTICK choices stepping round.
Statement ScenarioControls{}
  SHARED keyboardMode, joystickMode, playerFire, playerButtons, playerButtonsLast, fireballCounter
  SHARED fireballActive(), playerThrowTimer
  runAndFire.w = #MARIO_BTN_RUN + #MARIO_BTN_FIRE
  ;; Keyboard 2 key: either key is both.
  keyboardMode = #KEYBOARD_TWO_KEY
  Assert{ActionButtonBits{True, False} = runAndFire}
  Assert{ActionButtonBits{False, True} = runAndFire}
  Assert{ActionButtonBits{False, False} = 0}
  ;; Keyboard 3 key: the run key runs, the fire key fires, both do both.
  keyboardMode = #KEYBOARD_THREE_KEY
  Assert{ActionButtonBits{True, False} = #MARIO_BTN_RUN}
  Assert{ActionButtonBits{False, True} = #MARIO_BTN_FIRE}
  Assert{ActionButtonBits{True, True} = runAndFire}
  ;; The JOYSTICK choice does not change the keyboard's.
  joystickMode = #JOYSTICK_ONE_BUTTON
  Assert{ActionButtonBits{True, False} = #MARIO_BTN_RUN}
  ;; Each choice steps round its two, right and left, and wraps.
  keyboardMode = #KEYBOARD_TWO_KEY
  ChangeKeyboardMode{1}
  Assert{keyboardMode = #KEYBOARD_THREE_KEY}
  ChangeKeyboardMode{1}
  Assert{keyboardMode = #KEYBOARD_TWO_KEY}
  ChangeKeyboardMode{-1}
  Assert{keyboardMode = #KEYBOARD_THREE_KEY}
  joystickMode = #JOYSTICK_TWO_BUTTON
  ChangeJoystickMode{-1}
  Assert{joystickMode = #JOYSTICK_ONE_BUTTON}
  ChangeJoystickMode{1}
  Assert{joystickMode = #JOYSTICK_TWO_BUTTON}
  keyboardMode = #KEYBOARD_TWO_KEY
  ;; The fireball: the fire bit throws and the run bit alone does not.
  BuildFlatMap{}
  PoolInit{}
  ClearFloaters{}
  For clearBall = 0 To #FIREBALL_SLOTS - 1
    fireballActive(clearBall) = 0
  Next
  fireballCounter = 0
  playerThrowTimer = 0
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  playerFire = True
  playerButtons = #MARIO_BTN_RUN
  playerButtonsLast = 0
  TryThrowFireball{}
  Assert{fireballCounter = 0}
  playerButtons = #MARIO_BTN_FIRE
  TryThrowFireball{}
  Assert{fireballCounter = 1}
  playerButtons = 0
  playerButtonsLast = 0
  ;; The fire bit does not count as another button held for the run latch: with only fire held,
  ;; the "other buttons" test (everything but A) sees nothing.
  Assert{(#MARIO_BTN_FIRE AND ($7f - #MARIO_BTN_FIRE)) = 0}
  playerFire = False
  fireballCounter = 0
  For clearBall = 0 To #FIREBALL_SLOTS - 1
    fireballActive(clearBall) = 0
  Next
  keyboardMode = #KEYBOARD_TWO_KEY
  PoolInit{}
End Statement

;; ---------------------------------------------------------------
;; Scenario 43: the joysticks, both ports
;; ---------------------------------------------------------------
;; JoystickBitsFor{} with the stick and the buttons as parameters (a joystick cannot be scripted): what each JOYSTICK choice makes
;; of them; the joystick as UpdateJoystick{} leaves it read by ReadJoystickBits{}, ScreenStartDown{} and JoystickAxis{}; and an old
;; settings file's one controls number as the two choices.
Statement ScenarioJoystick{}
  SHARED joystickMode, joystickX, joystickY, joystickButtonBits
  runAndFire.w = #MARIO_BTN_RUN + #MARIO_BTN_FIRE
  ;; Two buttons (since 2026-11-10 the NES pad's way round): button 1 (the fire button, a pad's red) jumps, button 2 (blue) runs
  ;; and fires; the stick up is only up (the vine).
  Assert{JoystickBitsFor{#JOYSTICK_TWO_BUTTON, 0, 0, 1} = #MARIO_BTN_JUMP}
  Assert{JoystickBitsFor{#JOYSTICK_TWO_BUTTON, 0, 0, 2} = runAndFire}
  Assert{JoystickBitsFor{#JOYSTICK_TWO_BUTTON, 1, 0, 3} = #MARIO_BTN_RIGHT + #MARIO_BTN_JUMP + runAndFire}
  Assert{JoystickBitsFor{#JOYSTICK_TWO_BUTTON, 0, -1, 0} = #MARIO_BTN_UP}
  Assert{JoystickBitsFor{#JOYSTICK_TWO_BUTTON, -1, 1, 0} = #MARIO_BTN_LEFT + #MARIO_BTN_DOWN}
  ; One button: the stick up jumps (and is up), the button is a classic B, button 2 does nothing.
  Assert{JoystickBitsFor{#JOYSTICK_ONE_BUTTON, 0, -1, 0} = #MARIO_BTN_JUMP + #MARIO_BTN_UP}
  Assert{JoystickBitsFor{#JOYSTICK_ONE_BUTTON, 1, 0, 1} = #MARIO_BTN_RIGHT + runAndFire}
  Assert{JoystickBitsFor{#JOYSTICK_ONE_BUTTON, 0, 0, 2} = 0}
  ;; The joystick as read this frame: right and button 1 jump and walk, the buttons alone without the stick (the course clear),
  ;; button 1 starts, and the stick steers the menus.
  joystickMode = #JOYSTICK_TWO_BUTTON
  joystickX = 1
  joystickY = 0
  joystickButtonBits = 1
  Assert{ReadJoystickBits{True} = #MARIO_BTN_RIGHT + #MARIO_BTN_JUMP}
  Assert{ReadJoystickBits{False} = #MARIO_BTN_JUMP}
  Assert{ScreenStartDown{} <> False}
  Assert{JoystickAxis{#MENU_AXIS_HORIZONTAL} = 1}
  joystickY = -1
  Assert{JoystickAxis{#MENU_AXIS_VERTICAL} = -1}
  ; Button 2 alone is the screens' start too (since 2026-11-14).
  joystickButtonBits = 2
  Assert{ScreenStartDown{} <> False}
  joystickX = 0
  joystickY = 0
  joystickButtonBits = 0
  Assert{ReadJoystickBits{True} = 0}
  ;; An old settings file's controls number (SPARKYKEYS10 and before): only KEYBOARD 3 KEY gives 3 KEY, only JOY 1 BUTTON gives
  ;; 1 BUTTON; the CD32 pad (4) is 2 KEY and 2 BUTTON.
  Assert{OldControlsKeyboard{0} = #KEYBOARD_TWO_KEY AND OldControlsJoystick{0} = #JOYSTICK_TWO_BUTTON}
  Assert{OldControlsKeyboard{1} = #KEYBOARD_THREE_KEY AND OldControlsJoystick{1} = #JOYSTICK_TWO_BUTTON}
  Assert{OldControlsKeyboard{2} = #KEYBOARD_TWO_KEY AND OldControlsJoystick{2} = #JOYSTICK_ONE_BUTTON}
  Assert{OldControlsKeyboard{3} = #KEYBOARD_TWO_KEY AND OldControlsJoystick{3} = #JOYSTICK_TWO_BUTTON}
  Assert{OldControlsKeyboard{4} = #KEYBOARD_TWO_KEY AND OldControlsJoystick{4} = #JOYSTICK_TWO_BUTTON}
End Statement

;; ---------------------------------------------------------------
;; Scenario 44: redefinable keys
;; ---------------------------------------------------------------
;; The rules and tables the redefine screen uses, which need no keyboard: which keys no action may
;; take, the defaults, the names (all in the HUD font's letters, digits and dash), and what makes a
;; set of six usable. The scan, the screen and the file are proved in proofs/key-settings.ab3.
Statement ScenarioKeys{}
  SHARED keyMap(), redefineMap(), keyNames$(), keyActionNames$()
  ; The game's own keys, Caps Lock and anything out of range are refused; the rest are allowed.
  Assert{KeyAllowed{#RAW_KEY_ESC} = False AND KeyAllowed{#RAW_KEY_START} = False}
  Assert{KeyAllowed{#RAW_KEY_F1} = False AND KeyAllowed{#RAW_KEY_F2} = False AND KeyAllowed{#RAW_KEY_F3} = False AND KeyAllowed{#RAW_KEY_BIG} = False AND KeyAllowed{#RAW_KEY_F10} = False}
  Assert{KeyAllowed{$62} = False AND KeyAllowed{-1} = False AND KeyAllowed{#KEY_LAST + 1} = False}
  Assert{KeyAllowed{$31} <> False AND KeyAllowed{#RAW_KEY_JUMP} <> False AND KeyAllowed{#RAW_KEY_RALT} <> False}
  Assert{KeyAllowed{#KEY_LAST} <> False AND KeyAllowed{0} <> False AND KeyAllowed{$5a} <> False}
  ; The defaults are the keys the game has always had.
  SetDefaultKeys{}
  Assert{keyMap(#KEY_LEFT) = #RAW_KEY_LEFT AND keyMap(#KEY_RIGHT) = #RAW_KEY_RIGHT AND keyMap(#KEY_DOWN) = #RAW_KEY_DOWN}
  Assert{keyMap(#KEY_JUMP) = #RAW_KEY_JUMP AND keyMap(#KEY_RUN) = #RAW_KEY_RUN AND keyMap(#KEY_FIRE) = #RAW_KEY_ALT AND keyMap(#KEY_UP) = #RAW_KEY_UP}
  ; The pause is the eighth key, P (2026-11-08: Return no longer pauses).
  Assert{keyMap(#KEY_PAUSE) = #RAW_KEY_PAUSE AND KeyAllowed{#RAW_KEY_PAUSE} <> False}
  ; The defaults are a usable set; a repeat, a refused key or an out of range one is not.
  For index = 0 To #KEY_COUNT - 1
    redefineMap(index) = keyMap(index)
  Next
  Assert{KeysUsable{#KEY_COUNT} <> False}
  redefineMap(#KEY_FIRE) = redefineMap(#KEY_JUMP)
  Assert{KeysUsable{#KEY_COUNT} = False}
  redefineMap(#KEY_FIRE) = #RAW_KEY_START
  Assert{KeysUsable{#KEY_COUNT} = False}
  redefineMap(#KEY_FIRE) = $70
  Assert{KeysUsable{#KEY_COUNT} = False}
  redefineMap(#KEY_FIRE) = $31
  Assert{KeysUsable{#KEY_COUNT} <> False}
  ; The UP key is one of them: the same key as another action is refused, and a file from before it has a default for it.
  redefineMap(#KEY_UP) = redefineMap(#KEY_DOWN)
  Assert{KeysUsable{#KEY_COUNT} = False AND KeysUsable{#KEY_COUNT_OLD} <> False}
  ; Up may be the jump key (and only that one).
  redefineMap(#KEY_UP) = redefineMap(#KEY_JUMP)
  Assert{KeysUsable{#KEY_COUNT} <> False}
  redefineMap(#KEY_JUMP) = redefineMap(#KEY_DOWN)
  Assert{KeysUsable{#KEY_COUNT} = False}
  redefineMap(#KEY_JUMP) = #RAW_KEY_JUMP
  redefineMap(#KEY_UP) = #RAW_KEY_UP
  Assert{DefaultUpKey{#KEY_COUNT_OLD} = #RAW_KEY_UP}
  redefineMap(#KEY_JUMP) = #RAW_KEY_UP
  Assert{DefaultUpKey{#KEY_COUNT_OLD} = $3e}
  redefineMap(#KEY_FIRE) = $3e
  Assert{DefaultUpKey{#KEY_COUNT_OLD} = $3d}
  ;; The PAUSE key is one of them too: the same key as another action is refused, and a file from before it (seven keys) has a
  ;; default for it: P, or the next free one if an action has P.
  SetDefaultKeys{}
  For index = 0 To #KEY_COUNT - 1
    redefineMap(index) = keyMap(index)
  Next
  redefineMap(#KEY_PAUSE) = redefineMap(#KEY_JUMP)
  Assert{KeysUsable{#KEY_COUNT} = False AND KeysUsable{#KEY_COUNT_BEFORE_PAUSE} <> False}
  Assert{DefaultPauseKey{#KEY_COUNT_BEFORE_PAUSE} = #RAW_KEY_PAUSE}
  redefineMap(#KEY_FIRE) = #RAW_KEY_PAUSE
  Assert{DefaultPauseKey{#KEY_COUNT_BEFORE_PAUSE} = $41}
  redefineMap(#KEY_RUN) = $41
  Assert{DefaultPauseKey{#KEY_COUNT_BEFORE_PAUSE} = $42}
  ; A damaged line is not a number (Val would make it 0, the backquote key), and Right Alt is a
  ; second fire key only while no action has it.
  Assert{IsNumberText{"17"} <> False AND IsNumberText{""} = False AND IsNumberText{"LEFT"} = False AND IsNumberText{"-1"} = False AND IsNumberText{"1a"} = False}
  Assert{RightAltIsSpare{} <> False}
  keyMap(#KEY_JUMP) = #RAW_KEY_RALT
  Assert{RightAltIsSpare{} = False}
  SetDefaultKeys{}
  ; The names: letters, digits, function keys, modifiers, and a code with no name of its own.
  BuildKeyTables{}
  Assert{keyNames$($31) = "Z" AND keyNames$($10) = "Q" AND keyNames$($37) = "M"}
  Assert{keyNames$($01) = "1" AND keyNames$($0a) = "0" AND keyNames$($53) = "F4" AND keyNames$($59) = "F10"}
  Assert{keyNames$(#RAW_KEY_RUN) = "CTRL" AND keyNames$(#RAW_KEY_ALT) = "LALT" AND keyNames$(#RAW_KEY_JUMP) = "SPACE"}
  Assert{keyNames$($30) = "KEY 30" AND keyNames$($2a) = "KEY 2A"}
  Assert{keyActionNames$(#KEY_JUMP) = "JUMP" AND keyActionNames$(#KEY_FIRE) = "FIRE" AND keyActionNames$(#KEY_UP) = "UP" AND keyActionNames$(#KEY_PAUSE) = "PAUSE"}
  ; Every name is drawable: the HUD font has only digits, capitals, the dash, x and space.
  allDrawable.w = True
  For code = 0 To #KEY_LAST
    For charIndex = 1 To Len(keyNames$(code))
      If HudGlyphFor{Asc(Mid$(keyNames$(code), charIndex, 1))} < 0 AND Mid$(keyNames$(code), charIndex, 1) <> " " Then allDrawable = False
    Next
  Next
  Assert{allDrawable = True}
  SetDefaultKeys{}
End Statement

;; ---------------------------------------------------------------
;; Scenario 45: the crouch (the crouch plan (git history))
;; ---------------------------------------------------------------
;; The cartridge's rules (smbdis 5575, 5875, 6290, 11929): only a big Mario on the ground crouches,
;; Down clears the walking, a crouch jump stays crouched until he lands, a crouching Mario has the
;; small probes and box and cannot throw, and standing up under a one-tile ceiling puts his upper
;; side probes in it, which pushes him sideways: right from deep in a tunnel (the left probe is
;; tested first), left near the entrance (only the right probe is under the ceiling). The two
;; directions are read from the listing, so a red there is a finding about the reading.
Statement ScenarioCrouch{}
  SHARED playerIsBig, playerCrouching, playerX, playerSpeedX, playerOnGround, playerFire
  SHARED playerFrame, playerY, boundBoxTop, headProbeY, fireballCounter, playerButtons
  SHARED boundBoxLeft, boundBoxRight, boundBoxBottom
  SHARED playerButtonsLast, playerThrowTimer, fireballActive(), playerSpeedY
  BuildFlatMap{}
  PlacePlayer{112, (#FLOOR_ROW - 1)*#TILE}
  playerIsBig = True
  playerFire = False
  playerCrouching = False
  Tick{0}
  Tick{0}
  Assert{playerCrouching = False}
  Tick{#MARIO_BTN_DOWN}
  Assert{playerCrouching = True AND playerFrame = #MARIO_F_CROUCH}
  Assert{boundBoxTop = playerY + #BOUND_TOP}
  ; The crouch box is 12 wide and 12 tall, the standing big one 12 by 24.
  Assert{boundBoxRight - boundBoxLeft = 12 AND boundBoxBottom - boundBoxTop = 12}
  Tick{0}
  Assert{playerCrouching = False AND boundBoxTop = playerY + #BOUND_TOP_BIG}
  Assert{boundBoxRight - boundBoxLeft = 12 AND boundBoxBottom - boundBoxTop = 24}
  ; Down held with a direction: no walking.
  startX.w = playerX
  For crouchTick = 1 To 10
    Tick{#MARIO_BTN_DOWN + #MARIO_BTN_RIGHT}
  Next
  Assert{playerX = startX AND playerSpeedX = 0}
  ; A small Mario never crouches.
  playerIsBig = False
  Tick{#MARIO_BTN_DOWN}
  Assert{playerCrouching = False}
  playerIsBig = True
  Tick{0}
  ; A crouch jump stays crouched in the air, with the small head probe, and he stands on landing.
  Tick{#MARIO_BTN_DOWN}
  Tick{#MARIO_BTN_DOWN + #MARIO_BTN_JUMP}
  airborneCrouched.w = False
  crouchHeadProbe.w = 0
  For crouchTick = 1 To 70
    Tick{0}
    If playerOnGround = False AND playerCrouching = True
      airborneCrouched = True
      If playerSpeedY < 0 Then crouchHeadProbe = headProbeY
    EndIf
  Next
  Assert{airborneCrouched = True}
  Assert{crouchHeadProbe = #PROBE_TOP_Y}
  Assert{playerOnGround = True AND playerCrouching = False}
  ; No fireball while crouching, one when he stands.
  playerFire = True
  fireballCounter = 0
  playerThrowTimer = 0
  For clearBall = 0 To #FIREBALL_SLOTS - 1
    fireballActive(clearBall) = 0
  Next
  Tick{#MARIO_BTN_DOWN}
  playerButtons = #MARIO_BTN_DOWN + #MARIO_BTN_FIRE
  playerButtonsLast = 0
  TryThrowFireball{}
  Assert{fireballCounter = 0}
  Tick{0}
  playerButtons = #MARIO_BTN_FIRE
  playerButtonsLast = 0
  TryThrowFireball{}
  Assert{fireballCounter = 1}
  playerFire = False
  ; A one-tile tunnel under a ceiling three columns wide on each side of x = 112 (columns 5 to 9).
  ; He crouches outside it and is moved in, so standing up cannot push him before the test.
  SetTestRun{#FLOOR_ROW - 2, 5, 9, #MT_GROUND}
  PlacePlayer{40, (#FLOOR_ROW - 1)*#TILE}
  playerIsBig = True
  Tick{0}
  Tick{#MARIO_BTN_DOWN}
  playerX = 112
  For crouchTick = 1 To 10
    Tick{#MARIO_BTN_DOWN}
  Next
  Assert{playerCrouching = True AND playerX = 112}
  ; Let go in the middle: pushed right, a pixel a tick.
  For crouchTick = 1 To 12
    Tick{0}
  Next
  Assert{playerX >= 112 + 10}
  ; Let go just inside the left end (only his right probe is under the ceiling): pushed left.
  PlacePlayer{40, (#FLOOR_ROW - 1)*#TILE}
  playerIsBig = True
  Tick{0}
  Tick{#MARIO_BTN_DOWN}
  playerX = 72
  For crouchTick = 1 To 6
    Tick{#MARIO_BTN_DOWN}
  Next
  Assert{playerCrouching = True AND playerX = 72}
  For crouchTick = 1 To 10
    Tick{0}
  Next
  Assert{playerX < 72}
  playerCrouching = False
End Statement

;; ---------------------------------------------------------------
;; Scenario 46: falling before any jump
;; ---------------------------------------------------------------
;; The cartridge sets VerticalForceDown when an area starts (smbdis 2837), so a Mario who has not
;; jumped yet and walks off a ledge falls under gravity. Until 2026-10-13 InitPlayer{} set the fall
;; force to 0, which would have left him hanging in the air (the speed never grew).
Statement ScenarioFallInit{}
  SHARED playerOnGround, playerY, playerSpeedY, playerFallForce
  BuildLedgeMap{9}
  PlacePlayer{140, (#FLOOR_ROW - 1)*#TILE}
  Assert{playerFallForce = #MARIO_GRAV_FALL_INIT}
  startY.w = playerY
  leftGround.w = False
  fallTicks.w = 0
  walkTick.w = 0
  While fallTicks < 20 AND walkTick < 100
    Tick{#MARIO_BTN_RIGHT}
    walkTick = walkTick + 1
    If playerOnGround = False
      leftGround = True
      fallTicks = fallTicks + 1
    EndIf
  Wend
  Assert{leftGround = True}
  Assert{playerSpeedY > 0}
  Assert{playerY > startY + #TILE}
End Statement

;; ---------------------------------------------------------------
;; Scenario 47: jump forgiveness (buffering and coyote time)
;; ---------------------------------------------------------------
;; Not the cartridge's: the main project's PLAYER_PHYSICS note, "Jump forgiveness". Every other scenario runs
;; with both windows at 0 (the program sets them so before the first), which is the cartridge's
;; behaviour exactly; this one sets them, checks the edges of each window and puts them back.

;; Ticks from a jump on the flat floor (pressed on tick 0, then nothing) to the tick that lands.
Function.w FlightLength{}
  SHARED playerOnGround
  BuildFlatMap{}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  Tick{#MARIO_BTN_JUMP}
  flightTick.w = 0
  landedTick.w = 0
  While landedTick = 0 AND flightTick < 200
    flightTick = flightTick + 1
    Tick{0}
    If playerOnGround = True Then landedTick = flightTick
  Wend
  Function Return landedTick
End Function

;; The same jump with a second press pressBefore ticks before the landing tick (0 is the landing
;; tick itself, -1 the first tick on the ground), a single-tick tap. True if the tick after the
;; landing starts a jump.
Function.w BufferedJumpFires{landedTick.w, pressBefore.w}
  SHARED playerOnGround
  BuildFlatMap{}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For flightTick.w = 0 To landedTick
    buttonsNow.w = 0
    If flightTick = 0 Then buttonsNow = #MARIO_BTN_JUMP
    If flightTick = landedTick - pressBefore Then buttonsNow = #MARIO_BTN_JUMP
    Tick{buttonsNow}
  Next
  buttonsNow = 0
  If pressBefore = -1 Then buttonsNow = #MARIO_BTN_JUMP
  Tick{buttonsNow}
  firedNow.w = False
  If playerOnGround = False Then firedNow = True
  Function Return firedNow
End Function

;; Walk off the ledge, and press jump on the tick that is pressAt ticks after the last one on the
;; ground. True if he is rising after that tick.
Function.w CoyoteJumpFires{pressAt.w}
  SHARED playerOnGround, playerSpeedY
  BuildLedgeMap{9}
  PlacePlayer{140, (#FLOOR_ROW - 1)*#TILE}
  airTicks.w = 0
  risingNow.w = False
  For walkTick.w = 0 To 199
    If playerOnGround = False Then airTicks = airTicks + 1
    buttonsNow.w = #MARIO_BTN_RIGHT
    If airTicks = pressAt Then buttonsNow = #MARIO_BTN_RIGHT + #MARIO_BTN_JUMP
    Tick{buttonsNow}
    If airTicks = pressAt
      If playerSpeedY < 0 Then risingNow = True
      Function Return risingNow
    EndIf
  Next
  Function Return risingNow
End Function

;; Where a jump ends up ten ticks on, with the button tapped again mid-air at tick 2 (a press in
;; the rising phase) or not.
Function.w TenTicksOn{tapAgain.w}
  SHARED playerY
  BuildFlatMap{}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  For flightTick.w = 0 To 9
    buttonsNow.w = 0
    If flightTick = 0 Then buttonsNow = #MARIO_BTN_JUMP
    If flightTick = 2 AND tapAgain <> 0 Then buttonsNow = #MARIO_BTN_JUMP
    Tick{buttonsNow}
  Next
  Function Return playerY
End Function

; True if a setting's table row is off (0), then the given low, medium and high lengths.
Function.w WindowsAre{setting.w, lowTicks.w, mediumTicks.w, highTicks.w}
  SHARED forgivenessWindowTicks()
  tableOk.w = False
  If forgivenessWindowTicks(setting, #FORGIVENESS_OFF) = 0 AND forgivenessWindowTicks(setting, #FORGIVENESS_LOW) = lowTicks
    If forgivenessWindowTicks(setting, #FORGIVENESS_MEDIUM) = mediumTicks AND forgivenessWindowTicks(setting, #FORGIVENESS_HIGH) = highTicks Then tableOk = True
  EndIf
  Function Return tableOk
End Function

Statement ScenarioJumpForgiveness{}
  SHARED playerOnGround, jumpBufferWindow, coyoteWindow, settingsPath$, keyboardMode, joystickMode, keyMap()
  SHARED forgivenessLevel(), forgivenessWindowTicks(), soundPanNow, continuesChoice, paletteChoice, topScoreSaved
  landedTick.w = FlightLength{}
  ;; Window off: the cartridge. A fresh press on the first tick on the ground jumps; one a tick
  ;; before does not.
  jumpBufferWindow = 0
  Assert{BufferedJumpFires{landedTick, -1} = True}
  Assert{BufferedJumpFires{landedTick, 0} = False}
  ;; Window on: a press the window's last tick before the first grounded tick fires, one tick
  ;; more does not, and the plain press still does.
  jumpBufferWindow = #JUMP_BUFFER_TICKS
  Assert{BufferedJumpFires{landedTick, 0} = True}
  Assert{BufferedJumpFires{landedTick, #JUMP_BUFFER_TICKS - 1} = True}
  Assert{BufferedJumpFires{landedTick, #JUMP_BUFFER_TICKS} = False}
  Assert{BufferedJumpFires{landedTick, -1} = True}
  ;; A button held from the first press through the landing is not a fresh press: no second jump.
  BuildFlatMap{}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  heldLanded.w = False
  heldTick.w = 0
  While heldLanded = False AND heldTick < 200
    Tick{#MARIO_BTN_JUMP}
    heldTick = heldTick + 1
    If heldTick > 1 AND playerOnGround = True Then heldLanded = True
  Wend
  Tick{#MARIO_BTN_JUMP}
  Assert{heldLanded = True}
  Assert{playerOnGround = True}
  jumpBufferWindow = 0

  ;; Coyote time off: a press the first tick after the ledge does nothing; on, it jumps up to the
  ;; window's last tick and not after.
  coyoteWindow = 0
  Assert{CoyoteJumpFires{1} = False}
  coyoteWindow = #COYOTE_TICKS
  Assert{CoyoteJumpFires{1} = True}
  Assert{CoyoteJumpFires{#COYOTE_TICKS} = True}
  Assert{CoyoteJumpFires{#COYOTE_TICKS + 1} = False}
  ;; A tap in the rising phase of an ordinary jump is not a second jump.
  Assert{TenTicksOn{True} = TenTicksOn{False}}
  coyoteWindow = 0
  ;; The options page's levels: off is 0 (the cartridge), then the variant's low, medium and high
  ;; windows, medium being the lengths tested above.
  Assert{WindowsAre{#FORGIVENESS_BUFFER, #JUMP_BUFFER_LOW_TICKS, #JUMP_BUFFER_TICKS, #JUMP_BUFFER_HIGH_TICKS} = True}
  Assert{WindowsAre{#FORGIVENESS_COYOTE, #COYOTE_LOW_TICKS, #COYOTE_TICKS, #COYOTE_HIGH_TICKS} = True}

  ;; The settings file (SPARKYKEYS4): written and read back through RAM:, the way SaveSettingsNow{}
  ;; steps out to Amiga mode. The levels come back and the windows follow them.
  SetDefaultKeys{}
  savedKeyboardMode.w = keyboardMode
  savedJoystickMode.w = joystickMode
  savedPath$ = settingsPath$
  settingsPath$ = "RAM:sparky-test.settings"
  forgivenessLevel(#FORGIVENESS_BUFFER) = #FORGIVENESS_HIGH
  forgivenessLevel(#FORGIVENESS_COYOTE) = #FORGIVENESS_LOW
  ;; The continues choice (SPARKYKEYS9, the continues plan) comes back too: 10. So do a redefined PAUSE key (SPARKYKEYS10) and the two
  ;; controls choices (SPARKYKEYS11).
  keyMap(#KEY_PAUSE) = $18
  continuesChoice = 4
  keyboardMode = #KEYBOARD_THREE_KEY
  joystickMode = #JOYSTICK_ONE_BUTTON
  QAMIGA
  fileWritten.w = WriteSettings{}
  forgivenessLevel(#FORGIVENESS_BUFFER) = #FORGIVENESS_OFF
  forgivenessLevel(#FORGIVENESS_COYOTE) = #FORGIVENESS_OFF
  continuesChoice = #CONTINUES_DEFAULT
  keyMap(#KEY_PAUSE) = #RAW_KEY_PAUSE
  keyboardMode = #KEYBOARD_TWO_KEY
  joystickMode = #JOYSTICK_TWO_BUTTON
  LoadSettings{}
  BLITZ
  Assert{fileWritten <> False}
  Assert{keyMap(#KEY_PAUSE) = $18}
  Assert{keyboardMode = #KEYBOARD_THREE_KEY AND joystickMode = #JOYSTICK_ONE_BUTTON}
  joystickMode = #JOYSTICK_TWO_BUTTON
  keyMap(#KEY_PAUSE) = #RAW_KEY_PAUSE
  Assert{forgivenessLevel(#FORGIVENESS_BUFFER) = #FORGIVENESS_HIGH AND forgivenessLevel(#FORGIVENESS_COYOTE) = #FORGIVENESS_LOW}
  Assert{continuesChoice = 4}
  continuesChoice = #CONTINUES_DEFAULT
  Assert{jumpBufferWindow = #JUMP_BUFFER_HIGH_TICKS AND coyoteWindow = #COYOTE_LOW_TICKS}
  ;; A forgiveness level out of range spoils only its own section: the controls choice in the same
  ;; file still loads, and the levels stay as they were.
  QAMIGA
  If WriteFile(0, settingsPath$)
    FileOutput 0
    NPrint "SPARKYKEYS4"
    For keyIndex.w = 0 To #KEY_COUNT_OLD - 1
      NPrint keyMap(keyIndex)
    Next
    NPrint #OLD_CONTROLS_KEYS_SPLIT
    NPrint soundPanNow
    NPrint 0
    NPrint 4
    NPrint 4
    NPrint 3
    NPrint 9
    NPrint 9
    CloseFile 0
  EndIf
  keyboardMode = #KEYBOARD_TWO_KEY
  LoadSettings{}
  BLITZ
  Assert{keyboardMode = #KEYBOARD_THREE_KEY AND joystickMode = #JOYSTICK_TWO_BUTTON}
  Assert{forgivenessLevel(#FORGIVENESS_BUFFER) = #FORGIVENESS_HIGH AND forgivenessLevel(#FORGIVENESS_COYOTE) = #FORGIVENESS_LOW}
  ; A file from before the continues (this SPARKYKEYS4 one) leaves the choice as it was: NONE at start-up.
  Assert{continuesChoice = #CONTINUES_DEFAULT}
  Assert{jumpBufferWindow = #JUMP_BUFFER_HIGH_TICKS AND coyoteWindow = #COYOTE_LOW_TICKS}
  ;; The UP key: a file written now keeps a redefined one; a file from before it (six keys) loads with the default.
  keyMap(#KEY_UP) = $3e
  QAMIGA
  fileWritten = WriteSettings{}
  BLITZ
  keyMap(#KEY_UP) = #RAW_KEY_UP
  QAMIGA
  LoadSettings{}
  BLITZ
  Assert{fileWritten <> False AND keyMap(#KEY_UP) = $3e}
  QAMIGA
  If WriteFile(0, settingsPath$)
    FileOutput 0
    NPrint "SPARKYKEYS5"
    For keyIndex.w = 0 To #KEY_COUNT_OLD - 1
      NPrint keyMap(keyIndex)
    Next
    NPrint #OLD_CONTROLS_KEYS_SPLIT
    NPrint soundPanNow
    NPrint 0
    NPrint 4
    NPrint 4
    NPrint 3
    NPrint 1
    NPrint 1
    NPrint 0
    CloseFile 0
  EndIf
  keyMap(#KEY_UP) = $3e
  LoadSettings{}
  BLITZ
  Assert{keyMap(#KEY_UP) = #RAW_KEY_UP AND keyboardMode = #KEYBOARD_THREE_KEY}
  ;; A SPARKYKEYS9 file (seven keys, before the PAUSE key) loads with P for it; one whose fire key is P gets Backspace instead. Its
  ;; controls number, JOY 1 BUTTON, is KEYBOARD 2 KEY and JOYSTICK 1 BUTTON.
  QAMIGA
  If WriteFile(0, settingsPath$)
    FileOutput 0
    NPrint "SPARKYKEYS9"
    For keyIndex.w = 0 To #KEY_COUNT_BEFORE_PAUSE - 1
      If keyIndex = #KEY_FIRE
        NPrint #RAW_KEY_PAUSE
      Else
        NPrint keyMap(keyIndex)
      EndIf
    Next
    NPrint #OLD_CONTROLS_JOY_ONE
    NPrint soundPanNow
    NPrint 0
    NPrint 4
    NPrint 4
    NPrint 3
    NPrint 1
    NPrint 1
    NPrint 0
    NPrint paletteChoice
    NPrint topScoreSaved
    NPrint continuesChoice
    CloseFile 0
  EndIf
  keyMap(#KEY_PAUSE) = $18
  LoadSettings{}
  BLITZ
  Assert{keyMap(#KEY_FIRE) = #RAW_KEY_PAUSE AND keyMap(#KEY_PAUSE) = $41}
  Assert{keyboardMode = #KEYBOARD_TWO_KEY AND joystickMode = #JOYSTICK_ONE_BUTTON}
  QAMIGA
  KillFile settingsPath$
  BLITZ
  SetDefaultKeys{}
  settingsPath$ = savedPath$
  keyboardMode = savedKeyboardMode
  joystickMode = savedJoystickMode
  forgivenessLevel(#FORGIVENESS_BUFFER) = #FORGIVENESS_OFF
  forgivenessLevel(#FORGIVENESS_COYOTE) = #FORGIVENESS_OFF
  jumpBufferWindow = 0
  coyoteWindow = 0
End Statement

;; ---------------------------------------------------------------
;; Scenario 48: the jukebox page's use of the sound engine
;; ---------------------------------------------------------------
;; the jukebox plan. Opening the page keeps the game's engine state and starts a clean, enabled
;; engine; closing it puts the state back exactly, so the game's music goes on where it was, from a
;; running game, from a pause and from the title (which is silent otherwise). Driven by hand, the
;; hardware off.

;; A sum of every word the engine keeps, weighted by place: equal sums mean the same state.
Function.l EngineChecksum{}
  SHARED soundState(), apuState()
  sumNow.l = 0
  For stateIndex.w = 0 To #SS_COUNT
    sumNow = sumNow + (soundState(stateIndex) AND $ffff)*(stateIndex MOD 7 + 1)
  Next
  For stateIndex.w = 0 To 63
    sumNow = sumNow + (apuState(stateIndex) AND $ffff)*(stateIndex MOD 5 + 1)
  Next
  Function Return sumNow
End Function

Statement ScenarioJukeboxSound{}
  SHARED soundState(), apuState(), coverKind, soundJukeboxOn
  ;; The reference: the ground music for 180 ticks with no page.
  SoundReset{}
  soundState(#SS_ENABLED) = True
  SoundAreaMusic{#MUSIC_GROUND}
  SoundTicks{180}
  referenceSum.l = EngineChecksum{}
  ;; The same, with the page open from tick 120 to tick 210 of the run: another song and an effect
  ;; played on it, which must leave no trace.
  SoundReset{}
  soundState(#SS_ENABLED) = True
  SoundAreaMusic{#MUSIC_GROUND}
  SoundTicks{120}
  SoundJukeboxBegin{}
  Assert{soundJukeboxOn <> False AND soundState(#SS_AREA_MUSIC_BUFFER) = 0}
  SoundAreaMusic{#MUSIC_UNDERGROUND}
  SoundSquare1{#SFX_BIG_JUMP}
  loudSeen.w = False
  For tickNumber.w = 1 To 90
    SoundTick{}
    If apuState(#AP_LEVEL) + apuState(16 + #AP_LEVEL) + apuState(32 + #AP_LEVEL) > 0 Then loudSeen = True
  Next
  Assert{loudSeen <> False}
  SoundJukeboxEnd{}
  Assert{soundJukeboxOn = False}
  SoundTicks{60}
  Assert{EngineChecksum{} = referenceSum}
  ;; From a pause: the page plays an event tune although the game was paused, and the pause is
  ;; still on, the music held where it was, when the page closes.
  SoundReset{}
  soundState(#SS_ENABLED) = True
  SoundAreaMusic{#MUSIC_GROUND}
  SoundTicks{20}
  SoundPause{1}
  SoundTicks{51}
  Assert{soundState(#SS_PAUSE_MODE) = 1}
  frozenOffset.w = soundState(#SS_MUSIC_OFFSET_SQUARE2)
  SoundJukeboxBegin{}
  Assert{soundState(#SS_PAUSE_MODE) = 0}
  SoundEventMusic{#MUSIC_VICTORY}
  SoundTicks{20}
  Assert{soundState(#SS_EVENT_MUSIC_BUFFER) <> 0}
  SoundJukeboxEnd{}
  Assert{soundState(#SS_PAUSE_MODE) = 1 AND soundState(#SS_MUSIC_OFFSET_SQUARE2) = frozenOffset}
  ;; From the title, where the engine is silent: not while the page is up.
  coverKind = #COVER_TITLE
  SoundReset{}
  SoundFrame{}
  Assert{soundState(#SS_ENABLED) = False}
  SoundJukeboxBegin{}
  SoundFrame{}
  Assert{soundState(#SS_ENABLED) <> False}
  SoundJukeboxEnd{}
  coverKind = #COVER_NONE
  SoundReset{}
End Statement

;; ---------------------------------------------------------------
;; Scenario 49: variable jump height
;; ---------------------------------------------------------------
;; JumpSwimSub's cut (the main project's PLAYER_PHYSICS note, "Variable jump height"): while
;; Mario is rising, releasing A cuts the jump to the falling force once he has risen
;; a pixel, so a tap rises a fraction of a hold. Each tick is read on its own: the
;; falling force on a rising tick is only legal when A is not held in both frames.
Statement ScenarioVariableJump{}
  SHARED playerY, playerSpeedY, playerVerticalForce
  BuildFlatMap{}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  holdStartY.w = playerY
  holdTopY.w = playerY
  holdCut.w = False
  For holdTick = 1 To 80
    Tick{#MARIO_BTN_JUMP}
    If playerY < holdTopY Then holdTopY = playerY
    If playerSpeedY < 0
      If playerVerticalForce = #MARIO_GRAV_FALL_0 Then holdCut = True
    EndIf
  Next
  holdRise.w = holdStartY - holdTopY

  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  tapStartY.w = playerY
  tapTopY.w = playerY
  tapCut.w = False
  Tick{#MARIO_BTN_JUMP}
  For tapTick = 1 To 79
    Tick{0}
    If playerY < tapTopY Then tapTopY = playerY
    If playerSpeedY < 0
      If playerVerticalForce = #MARIO_GRAV_FALL_0 Then tapCut = True
    EndIf
  Next
  tapRise.w = tapStartY - tapTopY

  Assert{holdCut = False}
  Assert{tapCut = True}
  Assert{tapRise >= 1}
  Assert{holdRise > 2*tapRise}
End Statement

;; ---------------------------------------------------------------
;; Scenario 50: the land speed caps
;; ---------------------------------------------------------------
;; Walking tops out at #MARIO_MAX_WALK and holding B at #MARIO_MAX_RUN (notes:
;; the main project's PLAYER_PHYSICS note, "Speed caps"). Each is run from rest on the flat floor for long
;; enough to reach the cap, and the highest speed on any tick is kept. The caps
;; differ between the two variants, so the assertion is on the constant.
Statement ScenarioSpeedCaps{}
  SHARED playerSpeedX
  BuildFlatMap{}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  walkTop.w = 0
  For walkTick = 1 To 120
    Tick{#MARIO_BTN_RIGHT}
    If playerSpeedX > walkTop Then walkTop = playerSpeedX
  Next
  Assert{walkTop = #MARIO_MAX_WALK}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  runTop.w = 0
  For runTick = 1 To 120
    Tick{#MARIO_BTN_RIGHT + #MARIO_BTN_RUN}
    If playerSpeedX > runTop Then runTop = playerSpeedX
  Next
  Assert{runTop = #MARIO_MAX_RUN}
End Statement

;; ---------------------------------------------------------------
;; Scenario 51: the camera only scrolls forward
;; ---------------------------------------------------------------
;; Running right along the flat floor, cameraX never falls on any tick, and it does
;; not fall after Mario stops either. PlacePlayer{} leaves cameraX at 0, the start of
;; the level, so the run starts there.
Statement ScenarioCameraForward{}
  SHARED cameraX
  BuildFlatMap{}
  PlacePlayer{48, (#FLOOR_ROW - 1)*#TILE}
  lastCamera.w = cameraX
  cameraBack.w = 0
  For camTick = 1 To 200
    Tick{#MARIO_BTN_RIGHT + #MARIO_BTN_RUN}
    If cameraX < lastCamera Then cameraBack = cameraBack + 1
    lastCamera = cameraX
  Next
  cameraRunEnd.w = cameraX
  For camStop = 1 To 60
    Tick{0}
    If cameraX < lastCamera Then cameraBack = cameraBack + 1
    lastCamera = cameraX
  Next
  Assert{cameraRunEnd > 0}
  Assert{cameraBack = 0}
End Statement

;; ---------------------------------------------------------------
;; Scenario 52: the pause's lockout
;; ---------------------------------------------------------------
;; UpdatePause{} (life.blitz) after a press of the pause key: the game is paused and the lockout runs. A press in the
;; frame after, while the pause menu is coming up, must neither resume nor re-pause the game, and must not shorten the
;; lockout. On the pause menu a fresh press asks for the resume (pauseMenuResume, which UpdatePauseMenu{} acts on), and
;; on a page opened from it (the options) it does not. The keys themselves are read by PauseDown{}, which needs the
;; keyboard and so is not scripted here; this checks what UpdatePause{} does with the press.
Statement ScenarioPauseEscape{}
  SHARED gamePaused, pauseTimer, pauseStartHeld, coverKind, lifeEvent, areaEvent, flagState, castleEndTask, playerState
  SHARED overlayScreenWanted, redefineActive, pauseMenuResume
  flagState = #FLAG_ST_IDLE
  castleEndTask = 0
  playerState = #PLAYER_ST_FREE
  gamePaused = False
  pauseTimer = 0
  pauseStartHeld = False
  coverKind = #COVER_NONE
  lifeEvent = #LIFE_NONE
  areaEvent = 0
  UpdatePause{True}
  Assert{gamePaused = True}
  Assert{pauseTimer = #PAUSE_LOCKOUT_TICKS}
  UpdatePause{False}
  UpdatePause{True}
  Assert{gamePaused = True}
  Assert{pauseTimer = #PAUSE_LOCKOUT_TICKS - 2}
  For lockoutTick = 1 To #PAUSE_LOCKOUT_TICKS
    UpdatePause{False}
  Next
  Assert{pauseTimer = 0}
  UpdatePause{True}
  Assert{gamePaused = False}
  ; The pause menu up: a fresh press asks for the resume and leaves the pause to ResumeFromMenu{}.
  savedOverlayWanted.w = overlayScreenWanted
  UpdatePause{False}
  For lockoutTick = 1 To #PAUSE_LOCKOUT_TICKS
    UpdatePause{False}
  Next
  gamePaused = True
  pauseMenuResume = False
  redefineActive = False
  coverKind = #COVER_MENU
  overlayScreenWanted = #SCREEN_PAUSE
  UpdatePause{True}
  Assert{pauseMenuResume <> False AND gamePaused = True}
  ; On the options page opened from it, a press does nothing.
  pauseMenuResume = False
  overlayScreenWanted = #SCREEN_OPTIONS
  UpdatePause{False}
  UpdatePause{True}
  Assert{pauseMenuResume = False AND gamePaused = True}
  coverKind = #COVER_NONE
  overlayScreenWanted = savedOverlayWanted
  gamePaused = False
  pauseTimer = 0
  pauseStartHeld = False
End Statement

Statement ScenarioHudAway{}
  SHARED playerY, playerIsBig, playerSizeAnimTicks, coverKind, playerHidden
  savedCoverKind.w = coverKind
  savedPlayerY.w = playerY
  savedPlayerIsBig.w = playerIsBig
  savedSizeAnimTicks.w = playerSizeAnimTicks
  savedPlayerHidden.w = playerHidden
  playerIsBig = False
  playerSizeAnimTicks = 0
  playerHidden = False
  coverKind = #COVER_NONE
  ; Small: his top is playerY. Row #VIEW_TOP + #AWAY_LEAD is the first he may be on without the HUD going.
  playerY = 100
  Assert{PlayerTopRow{} = 100}
  Assert{HudAwayNeeded{} = False}
  playerY = #VIEW_TOP + #AWAY_LEAD
  Assert{HudAwayNeeded{} = False}
  playerY = #VIEW_TOP + #AWAY_LEAD - 1
  Assert{HudAwayNeeded{} = True}
  playerY = -10
  Assert{HudAwayNeeded{} = True}
  ; Big: his top is playerY less 16 (playerY is his feet less a tile for both sizes).
  playerIsBig = True
  playerY = #VIEW_TOP + #AWAY_LEAD + #TILE
  Assert{PlayerTopRow{} = #VIEW_TOP + #AWAY_LEAD}
  Assert{HudAwayNeeded{} = False}
  playerY = #VIEW_TOP + #AWAY_LEAD + #TILE - 1
  Assert{HudAwayNeeded{} = True}
  ; Not over a cover, and not while he is hidden.
  coverKind = #COVER_BLANK
  Assert{HudAwayNeeded{} = False}
  coverKind = #COVER_NONE
  playerHidden = True
  Assert{HudAwayNeeded{} = False}
  playerHidden = False
  Assert{HudAwayNeeded{} = True}
  playerIsBig = savedPlayerIsBig
  playerSizeAnimTicks = savedSizeAnimTicks
  playerHidden = savedPlayerHidden
  playerY = savedPlayerY
  coverKind = savedCoverKind
End Statement

Statement ScenarioNoLevelEnd{}
  SHARED areaFlagpoleX, areaCastleDoorX, playerState, playerX, playerHidden, endTask, flagState
  savedFlagpoleX.w = areaFlagpoleX
  savedCastleDoorX.w = areaCastleDoorX
  savedPlayerX.w = playerX
  savedFlagState.w = flagState
  playerHidden = False
  endTask = 0
  ; No flagpole: standing anywhere, even at the box's own x, grabs nothing.
  areaFlagpoleX = #AREA_BOX_NONE
  playerState = #PLAYER_ST_FREE
  flagState = #FLAG_ST_IDLE
  playerX = 100
  CheckFlagpole{}
  Assert{playerState = #PLAYER_ST_FREE}
  playerX = #AREA_BOX_NONE
  CheckFlagpole{}
  Assert{playerState = #PLAYER_ST_FREE}
  ; No castle door: walking off the pole hides nobody (a door at x 3264 and he at 100 would not either).
  areaCastleDoorX = #AREA_BOX_NONE
  playerState = #PLAYER_ST_ENDWALK
  playerX = 100
  CheckCastleDoor{}
  Assert{playerHidden = False AND endTask = 0}
  ; With a door he is hidden once his left edge reaches it, as before.
  areaCastleDoorX = 120
  playerX = 120 + #LOOK_DOOR_DX
  CheckCastleDoor{}
  Assert{playerHidden = True AND endTask = 1}
  playerHidden = False
  endTask = 0
  playerState = #PLAYER_ST_FREE
  areaFlagpoleX = savedFlagpoleX
  areaCastleDoorX = savedCastleDoorX
  playerX = savedPlayerX
  flagState = savedFlagState
End Statement

Statement ScenarioBackStrips{}
  SHARED backStrip(), sceneryBand(), currentAreaType, currentAreaScenery, backStampedKind
  savedStamped.w = backStampedKind
  savedAreaType.w = currentAreaType
  savedScenery.w = currentAreaScenery
  ; Stamped only for a kind that shows and is not there already.
  Assert{BackStripNeeded{#SCENERY_NONE, -1} = False}
  Assert{BackStripNeeded{#SCENERY_NONE, #SCENERY_HILLS} = False}
  Assert{BackStripNeeded{#SCENERY_HILLS, #SCENERY_HILLS} = False}
  Assert{BackStripNeeded{#SCENERY_HILLS, -1} = True}
  Assert{BackStripNeeded{#SCENERY_CLOUDS, #SCENERY_HILLS} = True}
  Assert{BackStripNeeded{#SCENERY_TREES, #SCENERY_CLOUDS} = True}
  ; Each kind has cells in the area table's strips, and none has none.
  cellsNone.w = 0
  cellsClouds.w = 0
  cellsHills.w = 0
  cellsTrees.w = 0
  bandRowsFilled.w = 0
  For backCell = 0 To #BACK_CELLS - 1
    If backStrip(#SCENERY_NONE*#BACK_CELLS + backCell) <> 0 Then cellsNone = cellsNone + 1
    If backStrip(#SCENERY_CLOUDS*#BACK_CELLS + backCell) <> 0 Then cellsClouds = cellsClouds + 1
    If backStrip(#SCENERY_HILLS*#BACK_CELLS + backCell) <> 0 Then cellsHills = cellsHills + 1
    If backStrip(#SCENERY_TREES*#BACK_CELLS + backCell) <> 0 Then cellsTrees = cellsTrees + 1
    ; Tile rows 5 to 9 are where the band split changes the back's speed: empty for the kinds that have one.
    backRow.w = backCell/#BACK_STRIP_W
    If backRow >= 5 AND backRow <= 9
      If backStrip(#SCENERY_HILLS*#BACK_CELLS + backCell) <> 0 OR backStrip(#SCENERY_TREES*#BACK_CELLS + backCell) <> 0 Then bandRowsFilled = bandRowsFilled + 1
    EndIf
  Next
  Assert{cellsNone = 0}
  Assert{cellsClouds > 0 AND cellsHills > 0 AND cellsTrees > 0}
  Assert{bandRowsFilled = 0}
  Assert{sceneryBand(#SCENERY_CLOUDS) = 0 AND sceneryBand(#SCENERY_HILLS) = 1 AND sceneryBand(#SCENERY_TREES) = 1}
  ; A ground area shows its back for every scenery but none.
  currentAreaType = #AREA_TYPE_GROUND
  currentAreaScenery = #SCENERY_NONE
  Assert{AreaLookIndex{} = 2}
  currentAreaScenery = #SCENERY_CLOUDS
  Assert{AreaLookIndex{} = 0}
  currentAreaScenery = #SCENERY_HILLS
  Assert{AreaLookIndex{} = 0}
  currentAreaScenery = #SCENERY_TREES
  Assert{AreaLookIndex{} = 0}
  currentAreaType = #AREA_TYPE_UNDERGROUND
  currentAreaScenery = #SCENERY_NONE
  Assert{AreaLookIndex{} = 3}
  ; A water area has its own set (bit 2) and shows its back, the surface strip.
  currentAreaType = #AREA_TYPE_WATER
  currentAreaScenery = #SCENERY_WATER
  Assert{AreaLookIndex{} = 4}
  ; A castle has its own set (bits 0 and 2) and no back.
  currentAreaType = #AREA_TYPE_CASTLE
  currentAreaScenery = #SCENERY_NONE
  Assert{AreaLookIndex{} = 7}
  currentAreaType = #AREA_TYPE_UNDERGROUND
  ; The overlay takes the back as a canvas and gives it up again: the bitmap then holds no kind, and an area with no scenery
  ; (whose back is hidden) stamps nothing, so the count stays as it is.
  currentAreaScenery = #SCENERY_NONE
  backStampedKind = #SCENERY_HILLS
  EnsureBackStrip{}
  Assert{backStampedKind = #SCENERY_HILLS}
  TakeBackAsCanvas{}
  Assert{backStampedKind = -1}
  backStampedKind = #SCENERY_TREES
  RestoreBackStrip{}
  Assert{backStampedKind = -1}
  backStampedKind = savedStamped
  currentAreaType = savedAreaType
  currentAreaScenery = savedScenery
End Statement

Statement ScenarioHudStamp{}
  ; Stale and the tall list wanted or on show: made.
  Assert{HudMirrorNeeded{True, True} = True}
  ; Fresh: not.
  Assert{HudMirrorNeeded{False, True} = False}
  ; The list not wanted and not on show: not, stale or not (it is made when the list is next wanted).
  Assert{HudMirrorNeeded{True, False} = False}
  Assert{HudMirrorNeeded{False, False} = False}
End Statement

;; A Paratroopa on the ledge map's floor at x 200 (it walks 120 px in the hop test, short of the map's left edge, which turns it), walking left, with small Mario far off to the right.
Function.w PlaceTestParatroopa{}
  SHARED simTickCounter, playerInjuryIntervals, playerIsBig, objDir()
  PoolInit{}
  playerIsBig = False
  playerInjuryIntervals = 0
  PlacePlayer{300, (#FLOOR_ROW - 1)*#TILE}
  UpdatePlayerBoundBox{}
  winged.w = PoolAlloc{}
  PoolInitParatroopa{winged, 200, #FLOOR_ROW*#TILE - #KOOPA_H}
  objDir(winged) = #MARIO_BTN_LEFT
  Function Return winged
End Function

Statement ScenarioParatroopa{}
  SHARED objX(), objY(), objState(), objDir(), objVelY(), objWinged(), objActive()
  SHARED playerSpeedY, simTickCounter, cameraX
  SHARED koopaSpawnCount, koopaSpawnX(), koopaSpawnY(), koopaSpawnKind(), koopaSpawned()
  BuildLedgeMap{40}
  ClearFloaters{}
  cameraX = 0
  simTickCounter = 1
  floorTop.w = #FLOOR_ROW*#TILE - #KOOPA_H
  ; It hops and keeps hopping, to the cartridge's height, walking left all the while and keeping its wings.
  hopper.w = PlaceTestParatroopa{}
  highest.w = floorTop
  hops.w = 0
  startX.w = objX(hopper)
  For hopTick = 1 To 240
    UpdateObjects{}
    If objY(hopper) < highest Then highest = objY(hopper)
    If objVelY(hopper) = #PARATROOPA_BOUNCE_VY Then hops = hops + 1
  Next
  Assert{hops >= 3}
  Assert{floorTop - highest >= 36 AND floorTop - highest <= 46}
  Assert{objWinged(hopper) <> 0 AND objState(hopper) = #KOOPA_ST_WALK}
  Assert{objX(hopper) < startX AND objDir(hopper) = #MARIO_BTN_LEFT}
  ; Stomped on the way down: no wings, a walking Koopa facing Mario's side (he is above it, to its left), Mario bounces, and it
  ; stays on the floor.
  hopper = PlaceTestParatroopa{}
  PlacePlayer{objX(hopper) - 10, objY(hopper) - 4}
  playerSpeedY = 3
  UpdatePlayerBoundBox{}
  simTickCounter = 2
  UpdateObjects{}
  Assert{objWinged(hopper) = 0 AND objState(hopper) = #KOOPA_ST_WALK}
  Assert{playerSpeedY = #STOMP_BOUNCE_SPEED_Y}
  Assert{objDir(hopper) = #MARIO_BTN_LEFT}
  PlacePlayer{300, (#FLOOR_ROW - 1)*#TILE}
  UpdatePlayerBoundBox{}
  settledY.w = objY(hopper)
  For stillTick = 1 To 30
    UpdateObjects{}
  Next
  Assert{objY(hopper) = settledY AND objWinged(hopper) = 0}
  ; A bump from below takes the wings: a shell, as a bumped Koopa is.
  hopper = PlaceTestParatroopa{}
  BumpObjectsOn{#FLOOR_ROW*#MAP_W + (objX(hopper) + 8)/#TILE}
  UpdateObjects{}
  Assert{objState(hopper) = #KOOPA_ST_SHELL AND objWinged(hopper) = 0}
  ; A winged spawn builds a Paratroopa, a green one a plain Koopa.
  PoolInit{}
  koopaSpawnCount = 2
  koopaSpawnX(0) = 100
  koopaSpawnY(0) = floorTop
  koopaSpawnKind(0) = #KOOPA_KIND_WINGED
  koopaSpawnX(1) = 120
  koopaSpawnY(1) = floorTop
  koopaSpawnKind(1) = #KOOPA_KIND_GREEN
  ArmKoopas{0}
  ActivateKoopas{}
  Assert{objWinged(0) <> 0 AND objWinged(1) = 0}
  Assert{objActive(0) = True AND objActive(1) = True}
  koopaSpawnCount = 0
  PoolInit{}
  simTickCounter = 1
  ClearFloaters{}
End Statement

;; A spring standing on the ledge map's floor at x 200, small Mario above it with his feet two pixels into its top and falling at one
;; pixel a tick, his box made. Returns the spring's slot.
Function.w PlaceTestSpring{}
  SHARED playerIsBig, playerInjuryIntervals, playerSpeedY, playerOnGround, playerButtons, playerButtonsLast, jumpspringAnimCtrl
  PoolInit{}
  playerIsBig = False
  playerInjuryIntervals = 0
  playerButtons = 0
  playerButtonsLast = 0
  springSlot.w = PoolAlloc{}
  PoolInitSpring{springSlot, 200, #FLOOR_ROW*#TILE - 2*#TILE}
  PlacePlayer{200, #FLOOR_ROW*#TILE - 2*#TILE - #TILE + 2}
  playerSpeedY = 1
  playerOnGround = False
  UpdatePlayerBoundBox{}
  Function Return springSlot
End Function

;; The squash from the landing tick to the release: the tick it is let go, and the speed he has then.
Function.w RunSpringSquash{pressTick.w}
  SHARED playerButtons, playerButtonsLast, jumpspringAnimCtrl, playerY
  For squashTick.w = 1 To 40
    playerButtons = 0
    playerButtonsLast = 0
    If squashTick = pressTick Then playerButtons = #MARIO_BTN_JUMP
    UpdateObjects{}
    If squashTick > 1 AND jumpspringAnimCtrl = 0 Then Function Return squashTick
  Next
  Function Return 0
End Function

Statement ScenarioJumpspring{}
  SHARED objX(), objY(), objAux(), objActive(), objType(), playerX, playerY, playerSpeedY, playerSpeedX, playerOnGround
  SHARED playerVerticalForce, jumpspringAnimCtrl, playerState, playerFallForce, playerButtons, playerButtonsLast, springLaunch
  SHARED springSpawnCount, springSpawnX(), springSpawnY(), springSpawned(), cameraX, simTickCounter, objDir()
  BuildLedgeMap{40}
  ClearFloaters{}
  cameraX = 0
  simTickCounter = 1
  springTop.w = #FLOOR_ROW*#TILE - 2*#TILE
  ; Landing: on its top (and the first step's two pixels down), held, the step 1.
  spring.w = PlaceTestSpring{}
  UpdateObjects{}
  Assert{jumpspringAnimCtrl = 1 AND objAux(spring) = 1}
  Assert{playerY = springTop - #TILE + #SPRING_MOVE AND playerSpeedY = 0 AND playerOnGround = True}
  ; Without the key: let go on the thirteenth tick, 6 px lower than he landed, at the variant's speed, with its rise force.
  spring = PlaceTestSpring{}
  releaseTick.w = RunSpringSquash{0}
  Assert{releaseTick = 13}
  Assert{playerY = springTop - #TILE + 6}
  Assert{playerSpeedY = #SPRING_FORCE AND playerVerticalForce = #SPRING_RISE_FORCE}
  Assert{playerOnGround = False AND jumpspringAnimCtrl = 0 AND objAux(spring) = 0}
  ; Then his gravity is the fall force of his last jump, the key held or not: only the first tick has the spring's own.
  playerFallForce = $90
  playerButtons = #MARIO_BTN_JUMP
  playerButtonsLast = #MARIO_BTN_JUMP
  SelectVerticalForce{}
  Assert{playerVerticalForce = #SPRING_RISE_FORCE}
  SelectVerticalForce{}
  Assert{playerVerticalForce = $90}
  playerOnGround = True
  SelectVerticalForce{}
  Assert{springLaunch = 0}
  playerOnGround = False
  ; The key down afresh after the first step: the higher bounce. In the first step it does not count.
  spring = PlaceTestSpring{}
  releaseTick = RunSpringSquash{6}
  Assert{releaseTick = 13 AND playerSpeedY = #SPRING_FORCE_A}
  spring = PlaceTestSpring{}
  releaseTick = RunSpringSquash{3}
  Assert{releaseTick = 13 AND playerSpeedY = #SPRING_FORCE}
  ; Rising (not falling) through its top is no landing.
  spring = PlaceTestSpring{}
  playerSpeedY = -2
  UpdateObjects{}
  Assert{jumpspringAnimCtrl = 0 AND objAux(spring) = 0}
  ; Its side is a wall: walking into it from the left pushes him back and stops him.
  spring = PlaceTestSpring{}
  PlacePlayer{200 - 12, #FLOOR_ROW*#TILE - #TILE}
  playerSpeedY = 0
  playerOnGround = True
  playerSpeedX = 16
  UpdatePlayerBoundBox{}
  pushedFrom.w = playerX
  UpdateObjects{}
  Assert{playerX < pushedFrom AND playerSpeedX = 0 AND jumpspringAnimCtrl = 0}
  ; A spawn entry builds one when its column comes into view, and not again.
  PoolInit{}
  springSpawnCount = 1
  springSpawnX(0) = 200
  springSpawnY(0) = springTop
  ArmSprings{0}
  ActivateSprings{}
  Assert{objActive(0) = True AND objType(0) = #OBJ_SPRING AND objX(0) = 200 AND objY(0) = springTop}
  ActivateSprings{}
  Assert{objActive(1) = False}
  ; Solid to the enemies, as the cartridge's two metatiles are: the box is the map's block, and nothing outside it is.
  BuildFlatMap{}
  Assert{EnemyMetatileAt{208, springTop + 4} = #MT_BLOCK AND EnemyMetatileAt{208, springTop + 31} = #MT_BLOCK}
  Assert{EnemyMetatileAt{199, springTop + 4} = #MT_EMPTY AND EnemyMetatileAt{216, springTop + 4} = #MT_EMPTY}
  Assert{EnemyMetatileAt{208, springTop - 1} = #MT_EMPTY}
  ; A Koopa walking right into it turns round.
  PoolInit{}
  walker.w = PlaceTestKoopa{170, #KOOPA_ST_WALK, 40}
  objDir(walker) = #MARIO_BTN_RIGHT
  turnedAt.w = -1
  For walkTick = 1 To 200
    If turnedAt < 0
      UpdateObjects{}
      If objDir(walker) = #MARIO_BTN_LEFT Then turnedAt = objX(walker)
    EndIf
  Next
  Assert{turnedAt >= 170 AND turnedAt + #KOOPA_W <= 200 + 2}
  springSpawnCount = 0
  PoolInit{}
  Assert{jumpspringAnimCtrl = 0}
  simTickCounter = 1
  ClearFloaters{}
End Statement

;; A vine in the column at x 160 from a block whose top is y 96, fully grown, and small Mario in the air at (x, y), facing right, his box made.
Statement PlaceTestVine{marioX.w, marioY.w}
  SHARED playerIsBig, playerInjuryIntervals, playerOnGround, playerSpeedY, playerFacing, playerFacingDirection
  SHARED vineColumnX, vineBaseY, vineHeight, vineTarget, playerClimbing, climbAutoUp, climbAreaChange
  SHARED climbDummyY, climbSideTimer, cameraX
  PoolInit{}
  playerIsBig = False
  playerInjuryIntervals = 0
  PlacePlayer{marioX, marioY}
  playerOnGround = False
  playerSpeedY = 0
  playerFacing = #MARIO_FACE_RIGHT
  playerFacingDirection = #MARIO_BTN_RIGHT
  cameraX = 0
  vineColumnX = 160
  vineBaseY = 96
  vineHeight = 96
  vineTarget = 96
  playerClimbing = False
  climbAutoUp = False
  climbAreaChange = False
  climbDummyY = 0
  climbSideTimer = 0
  UpdatePlayerBoundBox{}
End Statement

Statement ScenarioVine{}
  SHARED vineColumnX, vineBaseY, vineHeight, vineTarget, playerClimbing, climbAutoUp, climbAreaChange
  SHARED playerX, playerY, playerSpeedY, playerFacing, playerFacingDirection, simTickCounter, climbSideTimer
  SHARED blockItemCount, blockItemCell(), blockItemSprite(), objActive()
  BuildLedgeMap{40}
  ClearFloaters{}
  ; Growth: nothing before it starts, a pixel on the two ticks of four whose counter has bit 1 set, to the target and no further.
  vineColumnX = -1
  Assert{ClimbCellAt{160, 60} = False}
  vineColumnX = 160
  vineBaseY = 96
  vineHeight = 0
  vineTarget = 96
  For growTick = 0 To 63
    simTickCounter = growTick
    UpdateVine{}
  Next
  Assert{vineHeight = 32}
  For growTick = 64 To 399
    simTickCounter = growTick
    UpdateVine{}
  Next
  Assert{vineHeight = 96}
  ; The climbable cells: from 32 px high the cell a tile under the top, to the block; never above y 32.
  vineHeight = 31
  Assert{ClimbCellAt{165, 90} = False}
  vineHeight = 32
  Assert{ClimbCellAt{165, 90} <> False AND ClimbCellAt{165, 79} = False AND ClimbCellAt{165, 96} = False}
  vineHeight = 64
  Assert{VineClimbTop{} = 48}
  vineHeight = 96
  Assert{VineClimbTop{} = 32 AND ClimbCellAt{165, 32} <> False AND ClimbCellAt{165, 31} = False}
  Assert{ClimbCellAt{159, 60} = False AND ClimbCellAt{176, 60} = False}
  ; The grab: his right probe (13 across) in the middle of the column (6 to 9 of its 16) puts him on its left side, still.
  PlaceTestVine{154, 56}
  CheckVineGrab{}
  Assert{playerClimbing <> False AND playerX = 160 + #CLIMB_X_RIGHT}
  ; Outside the middle he does not (5 and 10 across), and the left probe of one facing left needs the same.
  PlaceTestVine{152, 56}
  CheckVineGrab{}
  Assert{playerClimbing = False}
  PlaceTestVine{157, 56}
  CheckVineGrab{}
  Assert{playerClimbing = False}
  PlaceTestVine{160 + 4, 56}
  playerFacing = #MARIO_FACE_LEFT
  playerFacingDirection = #MARIO_BTN_LEFT
  CheckVineGrab{}
  Assert{playerClimbing <> False AND playerX = 160 + #CLIMB_X_LEFT}
  ; Up: 1 px a tick, with the force $20 carried: seven ticks in eight, 14 px in 16.
  PlaceTestVine{154, 56}
  CheckVineGrab{}
  Tick{#MARIO_BTN_UP}
  Assert{playerY = 55}
  For upTick = 2 To 7
    Tick{#MARIO_BTN_UP}
  Next
  Assert{playerY = 49}
  Tick{#MARIO_BTN_UP}
  Assert{playerY = 49}
  For upTick = 9 To 16
    Tick{#MARIO_BTN_UP}
  Next
  Assert{playerY = 42 AND playerClimbing <> False}
  ; Down: 1 and the carry of the force $ff: one pixel the first tick, then two.
  Tick{#MARIO_BTN_DOWN}
  Assert{playerY = 43}
  Tick{#MARIO_BTN_DOWN}
  Assert{playerY = 45}
  For downTick = 3 To 10
    Tick{#MARIO_BTN_DOWN}
  Next
  Assert{playerY = 61}
  ; Nothing held: still.
  Tick{0}
  Assert{playerY = 61}
  ; The swap: right moves him 14 to the other side and turns him; the next one waits 24 ticks (a held key does not repeat it).
  playerX = 160 + #CLIMB_X_RIGHT
  playerFacing = #MARIO_FACE_RIGHT
  playerFacingDirection = #MARIO_BTN_RIGHT
  climbSideTimer = 0
  Tick{#MARIO_BTN_RIGHT}
  Assert{playerX = 160 + #CLIMB_X_LEFT AND playerFacingDirection = #MARIO_BTN_LEFT AND playerClimbing <> False}
  For holdTick = 1 To 20
    Tick{#MARIO_BTN_LEFT}
  Next
  Assert{playerX = 160 + #CLIMB_X_LEFT}
  Tick{0}
  Tick{#MARIO_BTN_LEFT}
  Assert{playerX = 160 + #CLIMB_X_RIGHT AND playerFacingDirection = #MARIO_BTN_RIGHT}
  ; The first swap after a grab waits out the timer (set afresh each tick off the vine): 23 ticks of it held change nothing, the 24th swaps.
  PlaceTestVine{154, 56}
  Tick{0}
  Assert{playerClimbing <> False AND playerX = 160 + #CLIMB_X_RIGHT}
  For waitTick = 1 To 23
    Tick{#MARIO_BTN_RIGHT}
  Next
  Assert{playerX = 160 + #CLIMB_X_RIGHT}
  Tick{#MARIO_BTN_RIGHT}
  Assert{playerX = 160 + #CLIMB_X_LEFT}
  ; Off the bottom of it he lets go and falls (the block is at y 96, so below that there is no cell).
  playerY = 90
  UpdatePlayerBoundBox{}
  Tick{#MARIO_BTN_DOWN}
  Tick{#MARIO_BTN_DOWN}
  Tick{#MARIO_BTN_DOWN}
  Assert{playerClimbing = False}
  ; At the top: above y 32 he is taken over, climbs on by himself, and at y -29 the area is to change.
  PlaceTestVine{154, 40}
  CheckVineGrab{}
  For topTick = 1 To 120
    If climbAreaChange = False Then Tick{#MARIO_BTN_UP}
  Next
  Assert{climbAutoUp <> False AND climbAreaChange <> False}
  Assert{playerY <= #CLIMB_AREA_Y AND playerY >= #CLIMB_AREA_Y - 1}
  ; A brick with a vine: its entry in the block-item table starts a vine on the brick's top, 96 px at most, and makes no power-up.
  PoolInit{}
  vineColumnX = -1
  keepCount.w = blockItemCount
  keepCell.w = blockItemCell(0)
  keepSprite.w = blockItemSprite(0)
  blockItemCount = 1
  blockItemCell(0) = 6*#MAP_W + 10
  blockItemSprite(0) = #VINE_SPRITE
  SpawnBlockItem{6*#MAP_W + 10}
  Assert{vineColumnX = 160 AND vineBaseY = 96 AND vineHeight = 0 AND vineTarget = #VINE_HEIGHT_FULL}
  Assert{objActive(0) = False}
  blockItemCount = keepCount
  blockItemCell(0) = keepCell
  blockItemSprite(0) = keepSprite
  ; Cleared for the next test.
  vineColumnX = -1
  climbAutoUp = False
  climbAreaChange = False
  playerClimbing = False
  simTickCounter = 1
End Statement

Statement ScenarioSkyBonus{}
  SHARED vineColumnX, vineBaseY, vineHeight, vineTarget, playerClimbing, climbAutoUp, climbAreaChange, vineWalkOut, areaIntroWalk, currentAreaType
  SHARED playerX, playerY, playerState, playerOnGround, playerFacing, simTickCounter, currentAreaCloud
  SHARED tableAreaCloud(), tableAreaVineLink(), tableAreaFallLink(), soundState()
  ; The links: out of 2-1 by the vine to the sky (mode 4, its page 0), out of the sky by the fall to 2-1 (mode 3, page 10), none elsewhere.
  Assert{tableAreaVineLink(#AID_WORLD2_1) = #AID_WORLD2_1_SKY*256 + #ARRIVE_VINE*32}
  Assert{tableAreaFallLink(#AID_WORLD2_1_SKY) = #AID_WORLD2_1*256 + #ARRIVE_DROP*32 + 10}
  Assert{tableAreaVineLink(#AID_WORLD1_1) = -1 AND tableAreaFallLink(#AID_WORLD1_1) = -1 AND tableAreaFallLink(#AID_WORLD2_1) = -1}
  Assert{tableAreaCloud(#AID_WORLD2_1_SKY) = 1 AND tableAreaCloud(#AID_WORLD2_1) = 0}
  ; The cloud music, and no pit death, in a cloud area.
  currentAreaCloud = 1
  QueueAreaMusic{}
  Assert{soundState(#SS_AREA_MUSIC_QUEUE) = #MUSIC_CLOUD}
  playerState = #PLAYER_ST_FREE
  playerY = 300
  CheckPitDeath{}
  Assert{playerState = #PLAYER_ST_FREE}
  currentAreaCloud = 0
  QueueAreaMusic{}
  Assert{soundState(#SS_AREA_MUSIC_QUEUE) = #MUSIC_GROUND}
  ; The water's music in a water area, and the pipe intro's in a pipe intro whatever its type (GetAreaMusic).
  currentAreaType = #AREA_TYPE_WATER
  QueueAreaMusic{}
  waterMusic.w = soundState(#SS_AREA_MUSIC_QUEUE)
  areaIntroWalk = True
  QueueAreaMusic{}
  Assert{waterMusic = #MUSIC_WATER AND soundState(#SS_AREA_MUSIC_QUEUE) = #MUSIC_PIPE_INTRO}
  areaIntroWalk = False
  currentAreaType = #AREA_TYPE_GROUND
  ; The way in: below the screen while the vine grows to its 96 px, then up it by himself to under y 153, then free and walking right.
  BuildLedgeMap{40}
  PoolInit{}
  PlacePlayer{#VINE_ENTRY_X, #VINE_ENTRY_Y}
  playerFacing = #MARIO_FACE_RIGHT
  playerState = #PLAYER_ST_VINE_ENTRY
  StartVine{#VINE_ENTRY_COLUMN_X, #VINE_ENTRY_Y, #VINE_HEIGHT_FULL}
  growTicks.w = 0
  For entryTick = 1 To 800
    simTickCounter = entryTick
    If playerState = #PLAYER_ST_VINE_ENTRY
      UpdateVineEntry{}
      If vineHeight < #VINE_HEIGHT_FULL Then growTicks = entryTick
    EndIf
  Next
  Assert{growTicks >= 190 AND growTicks <= 194}
  Assert{playerState = #PLAYER_ST_FREE AND vineWalkOut <> False AND playerClimbing = False}
  Assert{playerY < #VINE_ENTRY_STOP_Y AND playerY >= #VINE_ENTRY_STOP_Y - 2}
  Assert{playerX = #VINE_ENTRY_X AND vineColumnX = #VINE_ENTRY_COLUMN_X AND vineHeight = #VINE_HEIGHT_FULL}
  ; Cleared for the next test.
  vineColumnX = -1
  vineWalkOut = False
  playerClimbing = False
  playerState = #PLAYER_ST_FREE
  simTickCounter = 1
End Statement

Statement ScenarioPlayerClip{}
  ; Big Mario: a pair of slots for each row that can show, the first of them 0 and the last the pair before small Mario's.
  Assert{PlayerClipIndex{True, 1, 0} = 0 AND PlayerClipIndex{True, 1, 1} = 1}
  Assert{PlayerClipIndex{True, #PLAYER_CLIP_BIG_ROWS, 1} = 2*#PLAYER_CLIP_BIG_ROWS - 1}
  ; Small Mario: his rows after them, to the last slot.
  Assert{PlayerClipIndex{False, 1, 0} = 2*#PLAYER_CLIP_BIG_ROWS}
  Assert{PlayerClipIndex{False, #PLAYER_CLIP_SMALL_ROWS, 1} = #PLAYER_CLIP_SLOTS - 1}
  ; None shared, none out of range: every slot is wanted by exactly one case.
  slotsWanted.w = 0
  For clipSlot.w = 0 To #PLAYER_CLIP_SLOTS - 1
    wantedBy.w = 0
    For clipRows.w = 1 To #PLAYER_CLIP_BIG_ROWS
      For clipFacing.w = 0 To 1
        If PlayerClipIndex{True, clipRows, clipFacing} = clipSlot Then wantedBy = wantedBy + 1
      Next
    Next
    For clipRows = 1 To #PLAYER_CLIP_SMALL_ROWS
      For clipFacing = 0 To 1
        If PlayerClipIndex{False, clipRows, clipFacing} = clipSlot Then wantedBy = wantedBy + 1
      Next
    Next
    If wantedBy = 1 Then slotsWanted = slotsWanted + 1
  Next
  Assert{slotsWanted = #PLAYER_CLIP_SLOTS}
  ; The rows are the ones that can show (the cell less #AWAY_TOP and one), and the HUD's copy is wide enough for its clock.
  Assert{#PLAYER_CLIP_BIG_ROWS = 18 AND #PLAYER_CLIP_SMALL_ROWS = 2 AND #PLAYER_CLIP_SLOTS = 40}
  Assert{#HUD_STAMP_W >= #HUD_CLOCK_X + 3*8 + #SAFE_MARGIN}
End Statement

;; Scenario 66 (SWIM): swimming, folded from proofs/swim.ab3 (the main project's PLAYER_PHYSICS note, "Swimming"). The proof's seven
;; scripted runs through this harness's Tick{} (the live UpdatePlayer{}'s order, its water branch included) on the proof's
;; screen: the sea floor (rows 13 and 14) with a pit at columns 8 to 10 and its whirlpool (x 112, 64 wide), a pillar at
;; column 4, a ledge at row 6 (columns 13 to 17) and a wall at column 19. The expected values are the cartridge's arithmetic
;; worked by hand (a Python model of the routines, which matched the proof's traces tick for tick on PAL): NTSC with the
;; cartridge's numbers, PAL with the scaled set (the main project's PHYSICS_VARIANTS note). Both builds stop the rise at 0 under the ledge.
Function.w SwimPick{ntscValue.w, palValue.w}
  If #SIM_HZ = 50 Then Function Return palValue
  Function Return ntscValue
End Function

Statement SwimReset{startX.w, startY.w, fallForce.w}
  SHARED playerX, playerY, playerSpeedX, playerMoveForceX, playerFractionX, playerSpeedY, playerMoveForceY
  SHARED playerFractionY, playerOnGround, playerFallForce, playerVerticalForce, playerJumpOriginY, jumpSwimTimer
  SHARED playerButtons, playerButtonsLast, playerRunningSpeed, playerRunningTimer, whirlpoolFlag, whirlpoolTick
  SHARED playerState, playerFacingDirection, playerMovingDirection, playerCollisionBits, sideCollisionTimer, springLaunch
  ; No jumpspring latch carried in from an earlier scenario (it would take the rise force from the strokes).
  springLaunch = 0
  playerX = startX
  playerY = startY
  playerSpeedX = 0
  playerMoveForceX = 0
  playerFractionX = 0
  playerSpeedY = 0
  playerMoveForceY = 0
  playerFractionY = 0
  playerOnGround = False
  playerFallForce = fallForce
  playerVerticalForce = fallForce
  playerJumpOriginY = startY
  jumpSwimTimer = 0
  playerButtons = 0
  playerButtonsLast = 0
  playerRunningSpeed = 0
  playerRunningTimer = 0
  whirlpoolFlag = False
  whirlpoolTick = 0
  playerState = #PLAYER_ST_FREE
  playerFacingDirection = #MARIO_BTN_RIGHT
  playerMovingDirection = #MARIO_BTN_RIGHT
  playerCollisionBits = $ff
  sideCollisionTimer = 0
End Statement

;; One of the proof's runs, 64 ticks, Mario's x and y each tick into swimTraceX() and swimTraceY().
Statement SwimRun{swimRunIndex.w}
  SHARED swimTraceX(), swimTraceY(), playerX, playerY
  If swimRunIndex = 0 Then SwimReset{40, 64, #MARIO_GRAV_FALL_INIT}
  If swimRunIndex = 1 OR swimRunIndex = 2 Then SwimReset{40, 128, #SWIM_FALL_FORCE}
  If swimRunIndex = 3 Then SwimReset{40, 160, #SWIM_FALL_FORCE}
  If swimRunIndex = 4 Then SwimReset{136, 96, #SWIM_FALL_FORCE}
  If swimRunIndex = 5 Then SwimReset{40, 48, #SWIM_FALL_FORCE}
  If swimRunIndex = 6 Then SwimReset{232, 144, #SWIM_FALL_FORCE}
  For swimTick = 0 To 63
    swimButtons.w = 0
    If swimRunIndex = 1 AND swimTick = 0 Then swimButtons = #MARIO_BTN_JUMP
    If swimRunIndex = 2 Then swimButtons = #MARIO_BTN_JUMP
    If swimRunIndex = 3 OR swimRunIndex = 6
      If (swimTick AND 7) = 0 Then swimButtons = #MARIO_BTN_JUMP
    EndIf
    If swimRunIndex = 5
      If (swimTick AND 3) = 0 Then swimButtons = #MARIO_BTN_JUMP
    EndIf
    Tick{swimButtons}
    swimTraceX(swimTick) = playerX
    swimTraceY(swimTick) = playerY
  Next
End Statement

Function.w SwimTraceLowest{}
  SHARED swimTraceY()
  lowestY.w = swimTraceY(0)
  For traceIndex = 1 To 63
    If swimTraceY(traceIndex) < lowestY Then lowestY = swimTraceY(traceIndex)
  Next
  Function Return lowestY
End Function

Statement ScenarioSwim{}
  SHARED currentAreaType, whirlpoolLeftX(), whirlpoolWidth(), whirlpoolCount, swimTraceX(), swimTraceY()
  SHARED playerOnGround, playerState, cameraX
  ClearTestMap{}
  For swimColumn = 0 To 19
    If swimColumn < 8 OR swimColumn > 10
      SetTestCell{13, swimColumn, #MT_GROUND}
      SetTestCell{14, swimColumn, #MT_GROUND}
    EndIf
  Next
  For swimRow = 2 To 12
    SetTestCell{swimRow, 19, #MT_GROUND}
  Next
  For swimRow = 10 To 12
    SetTestCell{swimRow, 4, #MT_GROUND}
  Next
  For swimColumn = 13 To 17
    SetTestCell{6, swimColumn, #MT_GROUND}
  Next
  savedWhirlpools.w = whirlpoolCount
  whirlpoolLeftX(0) = 112
  whirlpoolWidth(0) = 64
  whirlpoolCount = 1
  currentAreaType = #AREA_TYPE_WATER
  cameraX = 0
  ; 0: sinking from rest with the area's start force, onto the floor.
  SwimRun{0}
  Assert{swimTraceY(15) = SwimPick{82, 113} AND swimTraceY(63) = 192}
  ; 1: one stroke, tapped: up, the top, and sinking again.
  SwimRun{1}
  Assert{swimTraceY(7) = SwimPick{117, 115}}
  Assert{swimTraceY(31) = SwimPick{99, 98}}
  Assert{swimTraceY(63) = SwimPick{111, 124}}
  ; 2: one stroke, held: the rise force while held, and no second stroke.
  SwimRun{2}
  Assert{swimTraceY(31) = SwimPick{105, 106}}
  ; 3: a stroke every 8 ticks climbs.
  SwimRun{3}
  Assert{swimTraceY(63) = SwimPick{72, 56}}
  ; 4: the whirlpool: to its middle (x 144) and down into the pit.
  SwimRun{4}
  Assert{swimTraceX(31) = 144 AND swimTraceY(31) = SwimPick{158, 164}}
  ; 5: strokes every 4 ticks at the surface do not lift him above it for long.
  SwimRun{5}
  Assert{SwimTraceLowest{} = SwimPick{30, 29} AND swimTraceY(63) = 32}
  ; 6: strokes under the ledge: the head stops him (speed 0, both builds).
  SwimRun{6}
  Assert{SwimTraceLowest{} = 108 AND swimTraceY(31) = SwimPick{114, 112}}
  ; Cleared for the next test.
  currentAreaType = #AREA_TYPE_GROUND
  whirlpoolCount = savedWhirlpools
  playerState = #PLAYER_ST_FREE
End Statement

;; Scenario 67 (BLOOBER): the Bloober (the main project's OBJECT_SYSTEM note, "The Bloober"), against the cartridge's arithmetic worked by
;; hand (a Python model of MoveBloober, ProcSwimmingB and the interval clock: NTSC the cartridge's numbers, PAL the scaled set). The
;; random register's sequence from its seed; one swim cycle with the random bits held so that it never aims afresh (so it goes left),
;; Mario well away, its interval timer counted by UpdateIntervalTimers{} as in the game (21 ticks an interval on NTSC, 18 on PAL); then
;; the Starman beats it and it falls.
Statement ScenarioBloober{}
  SHARED randomBits(), simTickCounter, objX(), objY(), objPopTimer(), objState()
  SHARED playerX, playerY, cameraX, intervalPhase, playerStarIntervals, playerInjuryIntervals, playerState, playerIsBig
  ; The register: 100 steps from the power-up seed.
  For randomIndex = 0 To 6
    randomBits(randomIndex) = 0
  Next
  randomBits(0) = $a5
  For randomStep = 1 To 100
    StepRandomBits{}
  Next
  Assert{randomBits(0) = 85 AND randomBits(1) = 53 AND randomBits(2) = 159 AND randomBits(6) = 180}
  ; One cycle, never aiming afresh.
  For randomIndex = 0 To 6
    randomBits(randomIndex) = $ff
  Next
  blooberSlot.w = PoolAlloc{}
  PoolInitBloober{blooberSlot, 100, 120}
  cameraX = 0
  playerX = 300
  playerY = 140
  playerIsBig = False
  playerState = #PLAYER_ST_FREE
  playerStarIntervals = 0
  playerInjuryIntervals = 0
  UpdatePlayerBoundBox{}
  intervalPhase = #INTERVAL_PERIOD - 1
  x15.w = 0
  y15.w = 0
  x31.w = 0
  y31.w = 0
  timer40.w = 0
  y63.w = 0
  For blooberTick = 0 To 95
    simTickCounter = blooberTick
    UpdateBloober{blooberSlot}
    UpdateIntervalTimers{}
    If blooberTick = 15
      x15 = objX(blooberSlot)
      y15 = objY(blooberSlot)
    EndIf
    If blooberTick = 31
      x31 = objX(blooberSlot)
      y31 = objY(blooberSlot)
    EndIf
    If blooberTick = 40 Then timer40 = objPopTimer(blooberSlot)
    If blooberTick = 63 Then y63 = objY(blooberSlot)
  Next
  ;; NTSC, the cartridge's: faster for 16 ticks, slower for 16 (24 px and 8 more left, 29 up), then a float down a pixel every other
  ;; tick. PAL, scaled: steps every 7 ticks at 19 sixteenths a speed, the float 10 sixteenths a tick.
  Assert{x15 = SwimPick{76, 73} AND y15 = SwimPick{96, 93}}
  Assert{x31 = SwimPick{68, 67} AND y31 = SwimPick{91, 93}}
  Assert{timer40 = SwimPick{2, 1} AND y63 = 107}
  Assert{objX(blooberSlot) = SwimPick{36, 34} AND objY(blooberSlot) = SwimPick{76, 82}}
  ; The Starman beats it: 2 px up, upside down, and it falls slowly from speed -1.
  playerStarIntervals = 10
  playerX = objX(blooberSlot)
  playerY = objY(blooberSlot) + 8
  UpdatePlayerBoundBox{}
  simTickCounter = 96
  beatenY.w = objY(blooberSlot)
  SmallBoxContact{blooberSlot}
  Assert{objState(blooberSlot) = #KOOPA_ST_KNOCKED AND objY(blooberSlot) = beatenY - 2 AND playerInjuryIntervals = 0}
  For blooberTick = 1 To 40
    UpdateBloober{blooberSlot}
  Next
  Assert{objY(blooberSlot) > beatenY}
  ; Cleared for the next test.
  PoolFree{blooberSlot}
  playerStarIntervals = 0
  playerState = #PLAYER_ST_FREE
  simTickCounter = 1
End Statement

;; Scenario 68 (FRENZY): the swimming Cheep-Cheep and its frenzy (the main project's OBJECT_SYSTEM note, "The Cheep-Cheep frenzy"), against the
;; cartridge's rules worked by hand. A start marker fires as the view reaches it; with the random bytes at 0 the heights go round
;; frenzyHeights() from the first, one Cheep-Cheep every #FRENZY_TICKS, red (world 1: the other way round from world 2), the third bobbing
;; (two swimmers were alive), no fourth (three swimmers); the swim's carried 256ths borrow a pixel on its first tick, so 64 ticks of grey
;; are 16 px on NTSC and 20 on PAL ($4d), of red 32 and 39 ($9a); the bob turns 15 px either side; a stop marker ends it.
Statement ScenarioFrenzy{}
  SHARED randomBits(), frenzyMarkX(), frenzyMarkKind(), frenzyMarkCount, frenzyKind, frenzyTimer
  SHARED objActive(), objType(), objX(), objY(), objAux(), objRed(), currentAreaType, cameraX, currentLevel
  SHARED playerX, playerY, playerState, playerStarIntervals, playerFacingDirection, bubbleX(), bubbleY(), airBubbleTimer
  savedMarks.w = frenzyMarkCount
  For randomIndex = 0 To 6
    randomBits(randomIndex) = 0
  Next
  currentAreaType = #AREA_TYPE_WATER
  currentLevel = 0
  cameraX = 0
  playerX = 2000
  playerY = 400
  playerState = #PLAYER_ST_FREE
  playerStarIntervals = 0
  UpdatePlayerBoundBox{}
  frenzyMarkX(0) = 100
  frenzyMarkKind(0) = #FRENZY_KIND_SWIMMING
  frenzyMarkX(1) = 500
  frenzyMarkKind(1) = #FRENZY_KIND_STOP
  frenzyMarkCount = 2
  ArmFrenzies{0}
  ; Three Cheep-Cheeps, the first at once, then one every #FRENZY_TICKS; no fourth.
  For frenzyTick = 1 To 4*(#FRENZY_TICKS + 1)
    UpdateFrenzy{}
  Next
  cheepCount.w = 0
  firstSlot.w = -1
  thirdSlot.w = -1
  For poolIndex = 0 To #MAX_OBJECTS - 1
    If objActive(poolIndex) = True AND objType(poolIndex) = #OBJ_CHEEP
      cheepCount = cheepCount + 1
      If objY(poolIndex) = $40 Then firstSlot = poolIndex
      If objY(poolIndex) = $90 Then thirdSlot = poolIndex
    EndIf
  Next
  Assert{frenzyKind = #FRENZY_KIND_SWIMMING AND cheepCount = 3}
  Assert{firstSlot >= 0 AND thirdSlot >= 0}
  Assert{objX(firstSlot) = #VIEW_W + #CHEEP_SPAWN_GAP AND objRed(firstSlot) = 1 AND objAux(firstSlot) = 0 AND objAux(thirdSlot) = 1}
  ; The swim: 64 ticks of grey and of red.
  PoolInit{}
  greySlot.w = PoolAlloc{}
  PoolInitCheep{greySlot, 200, 100, 0, 0, 0}
  redSlot.w = PoolAlloc{}
  PoolInitCheep{redSlot, 200, 140, 1, 0, 0}
  For swimTick = 1 To 64
    UpdateCheep{greySlot}
    UpdateCheep{redSlot}
  Next
  Assert{objX(greySlot) = 200 - SwimPick{16, 20} AND objX(redSlot) = 200 - SwimPick{32, 39}}
  ; The bob: up to 15 px above where it came in, then down to 15 below.
  PoolInit{}
  bobSlot.w = PoolAlloc{}
  PoolInitCheep{bobSlot, 300, 100, 0, 1, 0}
  lowestY.w = 100
  highestY.w = 100
  For bobTick = 1 To 400
    UpdateCheep{bobSlot}
    If objY(bobSlot) < lowestY Then lowestY = objY(bobSlot)
    If objY(bobSlot) > highestY Then highestY = objY(bobSlot)
  Next
  Assert{lowestY = 85 AND highestY = 115}
  ; The stop marker: the view reaches it, the frenzy ends, nothing more comes.
  PoolInit{}
  cameraX = 520 - #VIEW_W
  frenzyTimer = 0
  UpdateFrenzy{}
  cheepCount = 0
  For poolIndex = 0 To #MAX_OBJECTS - 1
    If objActive(poolIndex) = True AND objType(poolIndex) = #OBJ_CHEEP Then cheepCount = cheepCount + 1
  Next
  Assert{frenzyKind = #FRENZY_KIND_STOP AND cheepCount = 0}
  ;; A bubble: the last slot first, from his mouth (facing right, 9 px on and 8 up), the long timer for a random bit of 0, and its first
  ;; rise (fast: 255 256ths borrow a pixel at once; PAL's 306 two).
  ClearBubbles{}
  For randomIndex = 0 To 6
    randomBits(randomIndex) = 0
  Next
  playerX = 100
  playerY = 150
  playerFacingDirection = #MARIO_BTN_RIGHT
  UpdateBubbles{}
  Assert{bubbleX(2) = 109 AND bubbleY(2) = SwimPick{141, 140} AND bubbleY(1) = -1 AND airBubbleTimer = #BUBBLE_TICKS_LONG}
  ; Arriving in a water area: the arrival's own bubble, slot 0, at his mouth, and no other.
  ArmSwimmers{0, 0}
  Assert{bubbleX(0) = 109 AND bubbleY(0) = 142 AND bubbleY(2) = -1 AND airBubbleTimer = #BUBBLE_TICKS_LONG}
  ClearBubbles{}
  ; Cleared for the next test.
  PoolInit{}
  frenzyMarkCount = savedMarks
  ArmFrenzies{0}
  currentAreaType = #AREA_TYPE_GROUND
  cameraX = 0
End Statement

;; Scenario 69 (FLYING): the flying Cheep-Cheep and its frenzy (the main project's OBJECT_SYSTEM note, "The flying Cheep-Cheep"), against the
;; cartridge's arithmetic worked by tools/record/fly_cheep_model.py (NTSC the cartridge's numbers, PAL ours scaled): the launch from a set
;; register (Mario standing: the third byte's d1 sends it left, 80 px right of him), the arc's top and the erase below the screen, at
;; most three at once in the cartridge's slots 0 to 2, a stomp (moving down, and from 12 above), a side touch, and the stop marker.
Statement ScenarioFlying{}
  SHARED randomBits(), frenzyMarkX(), frenzyMarkKind(), frenzyMarkCount, frenzyKind, frenzyTimer
  SHARED objActive(), objType(), objX(), objY(), objAux(), objDir(), objVelX(), objVelY(), objState(), objPopTimer()
  SHARED cameraX, playerX, playerY, playerState, playerStarIntervals, playerInjuryIntervals, playerSpeedX, playerSpeedY
  SHARED simTickCounter, playerIsBig
  savedMarks.w = frenzyMarkCount
  playerIsBig = False
  randomBits(0) = 1
  randomBits(1) = 2
  randomBits(2) = 6
  For randomIndex = 3 To 6
    randomBits(randomIndex) = 0
  Next
  cameraX = 0
  playerX = 1000
  playerY = 400
  playerSpeedX = 0
  playerState = #PLAYER_ST_FREE
  playerStarIntervals = 0
  UpdatePlayerBoundBox{}
  frenzyMarkX(0) = 100
  frenzyMarkKind(0) = #FRENZY_KIND_FLYING
  frenzyMarkX(1) = 2000
  frenzyMarkKind(1) = #FRENZY_KIND_STOP
  frenzyMarkCount = 2
  ArmFrenzies{0}
  PoolInit{}
  UpdateFrenzy{}
  flySlot.w = -1
  flyCount.w = 0
  For poolIndex = 0 To #MAX_OBJECTS - 1
    If objActive(poolIndex) = True AND objType(poolIndex) = #OBJ_FLY_CHEEP
      flySlot = poolIndex
      flyCount = flyCount + 1
    EndIf
  Next
  Assert{frenzyKind = #FRENZY_KIND_FLYING AND flyCount = 1 AND frenzyTimer = SwimPick{32, 27}}
  Assert{objX(flySlot) = 1080 AND objVelX(flySlot) = SwimPick{-5, -6} AND objY(flySlot) = 248 AND objVelY(flySlot) = SwimPick{-5, -6} AND objAux(flySlot) = 0 AND objDir(flySlot) = #MARIO_BTN_LEFT}
  ; The arc: the first call only takes the new mark; the top on call 88 (PAL 74) at x 1052; freed on call 188 (PAL 158).
  topY.w = objY(flySlot)
  topCall.w = 0
  topX.w = 0
  freedCall.w = 0
  For flyCall = 1 To 220
    If freedCall = 0
      UpdateFlyCheep{flySlot}
      If objActive(flySlot) = False
        freedCall = flyCall
      Else
        If objY(flySlot) < topY
          topY = objY(flySlot)
          topCall = flyCall
          topX = objX(flySlot)
        EndIf
      EndIf
    EndIf
  Next
  Assert{topY = SwimPick{17, 16} AND topCall = SwimPick{88, 74} AND topX = 1052 AND freedCall = SwimPick{188, 158}}
  ; At most three: the frenzy alone (none moves) for long enough for many; the cartridge's slots 0, 1 and 2.
  PoolInit{}
  frenzyTimer = 0
  For frenzyTick = 1 To 600
    UpdateFrenzy{}
  Next
  flyCount = 0
  slotSum.w = 0
  For poolIndex = 0 To #MAX_OBJECTS - 1
    If objActive(poolIndex) = True AND objType(poolIndex) = #OBJ_FLY_CHEEP
      flyCount = flyCount + 1
      slotSum = slotSum + objAux(poolIndex)
    EndIf
  Next
  Assert{flyCount = 3 AND slotSum = 3}
  ;; Contact. A stomp moving down: 2 px up, stopped, Mario bounced at #FLY_CHEEP_STOMP_BOUNCE. From above while rising (his y, less
  ;; 16, plus 12 above its y): a stomp too. Level with it: a touch that hurts him (small: his death starts) and does not beat it.
  PoolInit{}
  cameraX = 900
  simTickCounter = 0
  playerInjuryIntervals = 0
  flySlot = PoolAlloc{}
  PoolInitFlyCheep{flySlot, 1000, 0, 0}
  objPopTimer(flySlot) = 0
  objY(flySlot) = 150
  playerY = 158
  playerSpeedY = 2
  UpdatePlayerBoundBox{}
  FlyCheepContact{flySlot}
  Assert{objState(flySlot) = #KOOPA_ST_KNOCKED AND objY(flySlot) = 148 AND objVelY(flySlot) = 0 AND playerSpeedY = #FLY_CHEEP_STOMP_BOUNCE}
  PoolInit{}
  flySlot = PoolAlloc{}
  PoolInitFlyCheep{flySlot, 1000, 0, 0}
  objPopTimer(flySlot) = 0
  objY(flySlot) = 150
  playerY = 150
  playerSpeedY = -1
  UpdatePlayerBoundBox{}
  FlyCheepContact{flySlot}
  Assert{objState(flySlot) = #KOOPA_ST_KNOCKED AND playerSpeedY = #FLY_CHEEP_STOMP_BOUNCE}
  PoolInit{}
  flySlot = PoolAlloc{}
  PoolInitFlyCheep{flySlot, 1000, 0, 0}
  objPopTimer(flySlot) = 0
  objY(flySlot) = 150
  playerY = 158
  playerSpeedY = 0
  playerStarIntervals = 0
  UpdatePlayerBoundBox{}
  FlyCheepContact{flySlot}
  Assert{objState(flySlot) <> #KOOPA_ST_KNOCKED AND playerState <> #PLAYER_ST_FREE}
  ; The stop marker: the view reaches it, the frenzy ends.
  PoolInit{}
  playerState = #PLAYER_ST_FREE
  cameraX = 2000
  UpdateFrenzy{}
  Assert{frenzyKind = #FRENZY_KIND_STOP}
  ; Cleared for the next test.
  PoolInit{}
  frenzyMarkCount = savedMarks
  cameraX = 0
End Statement

;; Scenario 70 (FIREBAR): the firebars (the main project's OBJECT_SYSTEM note, "The firebar"), against the cartridge's arithmetic worked by
;; tools/record/firebar_model.py (proofs/firebar.ab3 matched it tick for tick): each kind's spin state after 240 ticks from straight up (NTSC
;; the cartridge's speeds, PAL the listing's), the long bar's step over the level state, the balls' offsets (the quadrant fold and the
;; mirroring), and the touch: big and small Mario under an upright bar, small Mario 12 px to the side, and none with the Starman.
Statement ScenarioFirebar{}
  SHARED objVelX(), objVelY(), objX(), objY(), firebarBallX, firebarBallY
  SHARED playerX, playerY, playerIsBig, playerCrouching, playerState, playerStarIntervals, playerInjuryIntervals, cameraX
  PoolInit{}
  barSlot.w = PoolAlloc{}
  spinOk.w = True
  For kindIndex.w = 0 To 4
    PoolInitFirebar{barSlot, 0, 0, kindIndex}
    For spinTick = 1 To 240
      SpinFirebar{barSlot}
    Next
    wantHigh.w = 0
    If kindIndex = 0 Then wantHigh = SwimPick{5, 13}
    If kindIndex = 1 Then wantHigh = SwimPick{20, 30}
    If kindIndex = 2 Then wantHigh = SwimPick{26, 19}
    If kindIndex = 3 Then wantHigh = SwimPick{11, 1}
    If kindIndex = 4 Then wantHigh = SwimPick{7, 16}
    If objVelY(barSlot) <> wantHigh Then spinOk = False
  Next
  Assert{spinOk = True}
  ; The long bar steps over state 8.
  PoolInitFirebar{barSlot, 0, 0, #FIREBAR_LONG}
  objVelX(barSlot) = $f0
  objVelY(barSlot) = 7
  SpinFirebar{barSlot}
  Assert{objVelY(barSlot) = 9}
  ; The offsets: up, right, the long bar's end, and two folds.
  FirebarBallOffset{0, 4}
  upX.w = firebarBallX
  upY.w = firebarBallY
  FirebarBallOffset{8, 4}
  Assert{upX = 0 AND upY = -40 AND firebarBallX = 40 AND firebarBallY = 0}
  FirebarBallOffset{0, 10}
  longY.w = firebarBallY
  FirebarBallOffset{20, 2}
  foldX.w = firebarBallX
  foldY.w = firebarBallY
  FirebarBallOffset{12, 4}
  Assert{longY = -88 AND foldX = -16 AND foldY = 16 AND firebarBallX = 28 AND firebarBallY = 28}
  ;; The touch: a bar upright at (500, 100); Mario's x + 4 on its balls' x, his cartridge y 70 (playerY 86).
  PoolInitFirebar{barSlot, 496, 96, 0}
  cameraX = 400
  playerCrouching = False
  playerX = 496
  playerY = 86
  playerIsBig = True
  bigTouch.w = FirebarTouchesMario{barSlot}
  playerIsBig = False
  smallTouch.w = FirebarTouchesMario{barSlot}
  playerX = 508
  sideTouch.w = FirebarTouchesMario{barSlot}
  Assert{bigTouch = True AND smallTouch = True AND sideTouch = False}
  ; With the Starman a touch does nothing.
  playerX = 496
  playerState = #PLAYER_ST_FREE
  playerStarIntervals = 10
  playerInjuryIntervals = 0
  UpdateFirebar{barSlot}
  Assert{playerState = #PLAYER_ST_FREE AND playerInjuryIntervals = 0}
  playerStarIntervals = 0
  cameraX = 0
  PoolInit{}
End Statement

;; Scenario 71 (PODOBOO): the Podoboo (the main project's OBJECT_SYSTEM note, "The Podoboo"), against the cartridge's arithmetic (ImposeGravity as
;; FlyCheepGravity{}, worked in Python for both builds): built below the screen with its timer 1; a leap from random byte $5a (the wait 14
;; intervals, the top at y 82 on its 53rd tick, NTSC; PAL ours scaled, y 80 on the 45th); the Starman knocks it; a touch hurts small Mario.
Statement ScenarioPodoboo{}
  SHARED objX(), objY(), objVelY(), objState(), objPopTimer(), randomBits(), cameraX, simTickCounter
  SHARED playerX, playerY, playerIsBig, playerState, playerStarIntervals, playerInjuryIntervals
  PoolInit{}
  cameraX = 400
  playerX = 100
  playerY = 400
  playerState = #PLAYER_ST_FREE
  playerStarIntervals = 0
  playerIsBig = False
  UpdatePlayerBoundBox{}
  podobooSlot.w = PoolAlloc{}
  PoolInitPodoboo{podobooSlot, 500}
  Assert{objY(podobooSlot) = #PODOBOO_WAIT_Y AND objPopTimer(podobooSlot) = 1}
  For randomIndex = 1 To 4
    randomBits(randomIndex) = $5a
  Next
  objPopTimer(podobooSlot) = 0
  UpdatePodoboo{podobooSlot}
  Assert{objPopTimer(podobooSlot) = 14 AND objY(podobooSlot) = SwimPick{251, 250}}
  topY.w = objY(podobooSlot)
  topCall.w = 1
  For podobooCall = 2 To 120
    UpdatePodoboo{podobooSlot}
    If objY(podobooSlot) < topY
      topY = objY(podobooSlot)
      topCall = podobooCall
    EndIf
  Next
  Assert{topY = SwimPick{82, 80} AND topCall = SwimPick{53, 45}}
  ; The Starman: knocked, 2 px up, rising at the stun speed.
  simTickCounter = 0
  objState(podobooSlot) = 0
  objY(podobooSlot) = 150
  objVelY(podobooSlot) = -2
  playerX = 500
  playerY = 158
  playerStarIntervals = 10
  UpdatePlayerBoundBox{}
  PodobooContact{podobooSlot}
  Assert{objState(podobooSlot) = #KOOPA_ST_KNOCKED AND objY(podobooSlot) = 148 AND objVelY(podobooSlot) = #PODOBOO_STUN_SPEED}
  ; Without it, a touch hurts (small Mario: his death starts).
  objState(podobooSlot) = 0
  objY(podobooSlot) = 150
  playerStarIntervals = 0
  playerInjuryIntervals = 0
  PodobooContact{podobooSlot}
  Assert{playerState <> #PLAYER_ST_FREE AND objState(podobooSlot) = 0}
  playerState = #PLAYER_ST_FREE
  cameraX = 0
  PoolInit{}
End Statement

;; Scenario 72 (PLATFORMS): 2-4's small lifts and the swaying platform (the main project's OBJECT_SYSTEM note, "The lifts"): a small lift 12 px right
;; of its data's x, going up, its pair 128 px below (wrapping), Mario standing on the lower of the pair; the swaying platform's far left,
;; 53 px from where it starts, on its 110th tick (NTSC; PAL ours scaled, on the 93rd), worked in Python as XMovingPlatform's counters.
Statement ScenarioPlatforms{}
  SHARED objX(), objY(), objAux(), objVelY(), simTickCounter, cameraX
  SHARED playerX, playerY, playerState, playerSpeedY, playerOnGround, playerIsBig
  PoolInit{}
  cameraX = 1300
  playerState = #PLAYER_ST_FREE
  playerIsBig = False
  liftSlot.w = PoolAlloc{}
  PoolInitLift{liftSlot, 1360, 160, 4}
  Assert{objX(liftSlot) = 1372 AND objAux(liftSlot) = #LIFT_KIND_SMALL AND objVelY(liftSlot) = -1 AND LiftBoxTop{liftSlot, 1} = 32}
  ; Standing on the lower of the pair (its top at 168): put on it, on the ground.
  objY(liftSlot) = 40
  playerX = 1376
  playerY = 152
  playerSpeedY = 0
  playerOnGround = False
  UpdatePlayerBoundBox{}
  UpdateLift{liftSlot}
  Assert{playerOnGround = True AND playerY = LiftBoxTop{liftSlot, 1} - #TILE}
  ; The swaying platform: its far left and when.
  PoolInit{}
  cameraX = 2100
  playerX = 100
  playerY = 400
  UpdatePlayerBoundBox{}
  swaySlot.w = PoolAlloc{}
  PoolInitLift{swaySlot, 2208, 96, 6}
  leftmostX.w = 2208
  leftmostTick.w = 0
  For swayTick = 0 To SwimPick{239, 199}
    simTickCounter = swayTick
    UpdateLift{swaySlot}
    If objX(swaySlot) < leftmostX
      leftmostX = objX(swaySlot)
      leftmostTick = swayTick + 1
    EndIf
  Next
  Assert{objAux(swaySlot) = #LIFT_KIND_SWAY AND leftmostX = 2208 - 53 AND leftmostTick = SwimPick{110, 93} AND objX(swaySlot) = 2208}
  cameraX = 0
  PoolInit{}
End Statement

;; Scenario 73 (BOWSER): Bowser (the main project's OBJECT_SYSTEM note, "Bowser"), against BowserControl worked in Python as the port does it (its
;; random byte 0, Mario far to his left): built with 5 hit points, his first jump on tick 31 (PAL 26), his mouth first open on tick 223
;; (PAL 186, the same seconds); four fireballs leave him, the fifth makes him a knocked-off Koopa (world 2) or Goomba (world 1); the
;; Starman knocks him off.
Statement ScenarioBowser{}
  SHARED objType(), objX(), objY(), objState(), randomBits(), simTickCounter, currentLevel, cameraX
  SHARED bowserHitPoints, bowserOrigX, bowserBodyControls, frenzyKind, frenzyTimer, objActive()
  SHARED tableLevelWorld(), tableLevelNumber()
  SHARED playerX, playerY, playerState, playerStarIntervals, playerInjuryIntervals, playerIsBig
  PoolInit{}
  For randomIndex = 0 To 6
    randomBits(randomIndex) = 0
  Next
  currentLevel = 0
  cameraX = 2000
  playerX = 100
  playerY = 400
  playerState = #PLAYER_ST_FREE
  playerStarIntervals = 0
  playerIsBig = False
  UpdatePlayerBoundBox{}
  bowserSlot.w = PoolAlloc{}
  PoolInitBowser{bowserSlot, 2160, 128}
  Assert{objType(bowserSlot) = #OBJ_BOWSER AND bowserHitPoints = 5 AND bowserOrigX = 2160}
  firstJump.w = 0
  firstMouth.w = 0
  For bowserTick = 0 To 299
    simTickCounter = bowserTick
    UpdateBowser{bowserSlot}
    If firstJump = 0 AND objY(bowserSlot) < 128 Then firstJump = bowserTick + 1
    If firstMouth = 0 AND (bowserBodyControls AND 128) <> 0 Then firstMouth = bowserTick + 1
  Next
  Assert{firstJump = SwimPick{31, 26} AND firstMouth = SwimPick{223, 186}}
  ; Five fireballs: four leave him, the fifth makes him world 2's Koopa, knocked off.
  For hitIndex = 1 To 4
    BowserHit{bowserSlot}
  Next
  stillBowser.w = objType(bowserSlot)
  ; The castles' levels by their world and number, not their place in the table, which grows.
  castleOneFour.w = -1
  castleTwoFour.w = -1
  For tableIndex = 0 To #LEVEL_TABLE_COUNT - 1
    If tableLevelWorld(tableIndex) = 1 AND tableLevelNumber(tableIndex) = 4 Then castleOneFour = tableIndex
    If tableLevelWorld(tableIndex) = 2 AND tableLevelNumber(tableIndex) = 4 Then castleTwoFour = tableIndex
  Next
  Assert{castleOneFour >= 0 AND castleTwoFour >= 0}
  currentLevel = castleTwoFour
  BowserHit{bowserSlot}
  Assert{stillBowser = #OBJ_BOWSER AND objType(bowserSlot) = #OBJ_KOOPA AND objState(bowserSlot) = #KOOPA_ST_KNOCKED}
  ; World 1's fake (1-4) is a Goomba.
  PoolInit{}
  bowserSlot = PoolAlloc{}
  PoolInitBowser{bowserSlot, 2160, 128}
  currentLevel = castleOneFour
  For hitIndex = 1 To 5
    BowserHit{bowserSlot}
  Next
  Assert{objType(bowserSlot) = #OBJ_GOOMBA AND objState(bowserSlot) = #GOOMBA_ST_KNOCKED}
  ; The Starman: Mario on him, knocked off.
  PoolInit{}
  bowserSlot = PoolAlloc{}
  PoolInitBowser{bowserSlot, 2160, 128}
  playerX = 2162
  playerY = 136
  playerStarIntervals = 10
  UpdatePlayerBoundBox{}
  simTickCounter = 0
  BowserContact{bowserSlot}
  Assert{objState(bowserSlot) = #KOOPA_ST_KNOCKED}
  ; Knocked off, he falls out, and every object goes with him and the fire is over (KillAllEnemies).
  otherSlot.w = PoolAlloc{}
  PoolInitFlame{otherSlot, 2100, 144, 0}
  frenzyKind = #FRENZY_KIND_FLAME
  playerStarIntervals = 0
  playerX = 100
  playerY = 400
  UpdatePlayerBoundBox{}
  For fallTick = 0 To 299
    simTickCounter = fallTick
    If objActive(bowserSlot) = True AND objType(bowserSlot) = #OBJ_BOWSER Then UpdateBowser{bowserSlot}
  Next
  Assert{objActive(bowserSlot) = False AND objActive(otherSlot) = False AND frenzyKind = #FRENZY_KIND_STOP}
  frenzyKind = #FRENZY_KIND_STOP
  frenzyTimer = 0
  playerStarIntervals = 0
  currentLevel = 0
  cameraX = 0
  PoolInit{}
End Statement

;; Scenario 74 (FLAMES): Bowser's flame (the main project's OBJECT_SYSTEM note, "Bowser's flame"), against InitBowserFlame and ProcBowserFlame
;; worked in Python: with no Bowser the fire frenzy's flame comes past the view's right edge at its height, the timer the flame wait and
;; 32 (PAL 186); it goes left 5 px in 4 ticks (PAL 6); with Bowser it comes from his mouth and the frenzy stops, climbs to its height
;; and holds there; the Starman puts it out; Bowser's mouth shutting starts the fire (tick 255, PAL 213).
Statement ScenarioFlames{}
  SHARED objType(), objX(), objY(), objState(), randomBits(), simTickCounter, cameraX, frenzyKind, frenzyTimer
  SHARED bowserFlameTimerCtrl, bowserBodyControls, playerX, playerY, playerState, playerStarIntervals, playerIsBig, currentLevel
  PoolInit{}
  For randomIndex = 0 To 6
    randomBits(randomIndex) = 0
  Next
  currentLevel = 0
  playerX = 100
  playerY = 400
  playerState = #PLAYER_ST_FREE
  playerStarIntervals = 0
  playerIsBig = False
  UpdatePlayerBoundBox{}
  ; The fire frenzy: no Bowser, from the right, a gap past the view's edge (1688 on the 256 wide view; 1752 was the 320 view's).
  cameraX = 1400
  bowserFlameTimerCtrl = 0
  frenzyKind = #FRENZY_KIND_FLAME
  frenzyTimer = 0
  UpdateFlameFrenzy{}
  Assert{objType(0) = #OBJ_FLAME AND objX(0) = 1400 + #VIEW_W + #FLAME_SPAWN_GAP AND objY(0) = $90 AND frenzyTimer = SwimPick{223, 186} AND frenzyKind = #FRENZY_KIND_FLAME}
  For flameTick = 0 To 3
    simTickCounter = flameTick
    UpdateFlame{0}
  Next
  Assert{objX(0) = 1400 + #VIEW_W + #FLAME_SPAWN_GAP + SwimPick{-5, -6} AND objY(0) = $90}
  ; From Bowser's mouth: 14 px left of him and 8 below, up to $70 (random bits 2), the frenzy over.
  PoolInit{}
  For randomIndex = 0 To 6
    randomBits(randomIndex) = 2
  Next
  bowserSlot.w = PoolAlloc{}
  PoolInitBowser{bowserSlot, 2160, 128}
  cameraX = 2000
  frenzyKind = #FRENZY_KIND_FLAME
  frenzyTimer = 0
  UpdateFlameFrenzy{}
  flameSlot.w = bowserSlot + 1
  Assert{objType(flameSlot) = #OBJ_FLAME AND objX(flameSlot) = 2146 AND objY(flameSlot) = 136 AND frenzyKind = #FRENZY_KIND_STOP}
  For flameTick = 0 To 29
    simTickCounter = flameTick
    UpdateFlame{flameSlot}
  Next
  Assert{objX(flameSlot) = SwimPick{2108, 2101} AND objY(flameSlot) = $70}
  ; The Starman: Mario on it, it is put out.
  playerX = objX(flameSlot)
  playerY = objY(flameSlot)
  playerStarIntervals = 10
  UpdatePlayerBoundBox{}
  simTickCounter = 0
  FlameContact{flameSlot}
  Assert{objState(flameSlot) = #KOOPA_ST_KNOCKED}
  playerStarIntervals = 0
  playerX = 100
  playerY = 400
  UpdatePlayerBoundBox{}
  ; Bowser's mouth shutting puts the flame in the buffer.
  PoolInit{}
  For randomIndex = 0 To 6
    randomBits(randomIndex) = 0
  Next
  bowserSlot = PoolAlloc{}
  PoolInitBowser{bowserSlot, 2160, 128}
  frenzyKind = #FRENZY_KIND_STOP
  fireTick.w = 0
  For bowserTick = 0 To 299
    simTickCounter = bowserTick
    UpdateBowser{bowserSlot}
    If fireTick = 0 AND frenzyKind = #FRENZY_KIND_FLAME Then fireTick = bowserTick + 1
  Next
  Assert{fireTick = SwimPick{255, 213}}
  frenzyKind = #FRENZY_KIND_STOP
  frenzyTimer = 0
  cameraX = 0
  PoolInit{}
End Statement

;; Scenario 75 (AXE): the axe and the bridge (the main project's LEVEL_END note, "The castle's end"), against BridgeCollapse worked in Python: Mario
;; on the axe's cell stops the world and the axe goes; with Bowser standing and his feet's counter at 1 the first piece goes on the first
;; tick and the last (the fifteenth) on tick 57 (PAL 43, a piece every 3), when he drops; he is below #BOWSER_FALLEN_Y and every object
;; gone on tick 121 (PAL 101), the chain and the bridge's last piece blank; with no Bowser the collapse is over at once.
Statement ScenarioAxe{}
  SHARED mapBuffer(), metatileBuffer(), mapWidth, areaAxeX, areaAxeY, castleEndTask, bridgeCollapseStep, bowserFeetCounter
  SHARED objActive(), objState(), playerX, playerY, playerState, playerSpeedY, playerIsBig, playerStarIntervals
  BuildFlatMap{}
  PoolInit{}
  areaAxeX = 160
  areaAxeY = 128
  axeCell.w = (areaAxeY/#TILE)*mapWidth + areaAxeX/#TILE
  For pieceIndex = 0 To #BRIDGE_SEQUENCE - 1
    pieceCell.w = axeCell
    If pieceIndex = 1 Then pieceCell = axeCell + mapWidth - 1
    If pieceIndex >= 2 Then pieceCell = axeCell + 2*mapWidth - 1 - (pieceIndex - 2)
    mapBuffer(pieceCell) = 121
    metatileBuffer(pieceCell) = #MT_GROUND
  Next
  bowserSlot.w = PoolAlloc{}
  PoolInitBowser{bowserSlot, 100, 128}
  bowserFeetCounter = 1
  playerState = #PLAYER_ST_FREE
  playerStarIntervals = 0
  playerIsBig = False
  playerSpeedY = 0
  ; Big, against the axe's cell from the side with his head level with it: not taken (only the feet take it).
  playerIsBig = True
  playerX = 160 - #PROBE_FOOT_X2 - 1
  playerY = 128
  UpdatePlayerBoundBox{}
  castleEndTask = 0
  CheckAxe{}
  sideTaken.w = castleEndTask
  ; Small, coming down with his feet in it.
  playerIsBig = False
  playerX = 158
  playerY = 128 - #PROBE_FOOT_Y + 4
  UpdatePlayerBoundBox{}
  CheckAxe{}
  Assert{sideTaken = 0 AND playerState = #PLAYER_ST_AXE AND castleEndTask = #CASTLE_END_COLLAPSE AND mapBuffer(axeCell) = 0 AND metatileBuffer(axeCell) = #MT_EMPTY}
  dropTick.w = 0
  doneTick.w = 0
  For collapseTick = 1 To 200
    UpdateBridgeCollapse{}
    If dropTick = 0 AND objState(bowserSlot) = #BOWSER_ST_DROPPED Then dropTick = collapseTick
    If doneTick = 0 AND castleEndTask = #CASTLE_END_WALK Then doneTick = collapseTick
  Next
  Assert{dropTick = SwimPick{57, 43} AND doneTick = SwimPick{121, 101} AND objActive(bowserSlot) = False}
  lastCell.w = axeCell + 2*mapWidth - 1 - (#BRIDGE_PIECES - 1)
  Assert{mapBuffer(axeCell + mapWidth - 1) = 0 AND mapBuffer(lastCell) = 0 AND metatileBuffer(lastCell) = #MT_EMPTY}
  ; No Bowser: over at once.
  PoolInit{}
  castleEndTask = #CASTLE_END_COLLAPSE
  UpdateBridgeCollapse{}
  Assert{castleEndTask = #CASTLE_END_WALK}
  castleEndTask = 0
  bridgeCollapseStep = 0
  playerState = #PLAYER_ST_FREE
  areaAxeX = #AREA_BOX_NONE
  areaAxeY = #AREA_BOX_NONE
  BuildFlatMap{}
  PoolInit{}
End Statement

;; Scenario 76 (CASTLEWALK): after the bridge (the main project's LEVEL_END note, "The castle's end"), against SetupVictoryMode, PlayerVictoryWalk
;; and PrintVictoryMessages: with the view locked at 2304's edge the walk's destination is 2304 and Mario stops from 2400 (the page's
;; $60); the view scrolls on its own to the page; the second message comes 128 ticks after the first (PAL 107), and the next level
;; 382 ticks after it (PAL 321: the end timer at 256, then 6 intervals).
Statement ScenarioCastleWalk{}
  SHARED castleEndTask, castleWalkReady, castleWalkDestX, castleWalkStopX, castleTextWanted, castleMessageTicks, scrollLockLifted
  SHARED areaScrollLockX, cameraX, cameraFractionX, playerX, playerState, lifeEvent, simTickCounter
  BuildFlatMap{}
  PoolInit{}
  PlacePlayer{2260, (#FLOOR_ROW - 1)*#TILE}
  areaScrollLockX = 2384
  scrollLockLifted = False
  cameraX = 2304 - #VIEW_W
  cameraFractionX = 0
  castleEndTask = #CASTLE_END_WALK
  castleWalkReady = False
  castleTextWanted = 0
  UpdateCastleEnd{}
  Assert{playerState = #PLAYER_ST_ENDWALK AND scrollLockLifted <> False AND castleWalkDestX = 2304 AND castleWalkStopX = 2400}
  firstMessage.w = 0
  secondMessage.w = 0
  replayTick.w = 0
  For walkTick = 1 To 1500
    simTickCounter = walkTick
    If lifeEvent <> #LIFE_REPLAY
      UpdatePlayer{}
      UpdateCastleEnd{}
    EndIf
    If firstMessage = 0 AND castleTextWanted = 1 Then firstMessage = walkTick
    If secondMessage = 0 AND castleTextWanted = 2 Then secondMessage = walkTick
    If replayTick = 0 AND lifeEvent = #LIFE_REPLAY Then replayTick = walkTick
  Next
  Assert{cameraX = 2304 AND playerX >= 2400 AND playerX < 2448}
  Assert{firstMessage > 0 AND secondMessage - firstMessage = SwimPick{128, 107} AND replayTick - firstMessage = SwimPick{382, 321}}
  lifeEvent = #LIFE_NONE
  castleEndTask = 0
  castleWalkReady = False
  castleTextWanted = 0
  castleMessageTicks = 0
  playerState = #PLAYER_ST_FREE
  areaScrollLockX = #AREA_BOX_NONE
  scrollLockLifted = False
  cameraX = 0
  cameraFractionX = 0
  PoolInit{}
End Statement

;; Scenario 77 (VERTPLAT): 1-3's platform that moves up and down (the main project's OBJECT_SYSTEM note, "The platform that moves up and down"),
;; against tools/record/swing_model.py's trace 3 (the proof matched it tick for tick, proofs/vert-swing.ab3): built at y 96 its top is 96 and its
;; centre 160, and from y 160 both are 96; from 96 it swings down to 227 on its 159th tick and back up to 89 on its 324th, and is at 98
;; after 400 (PAL, ours scaled: 226 on the 135th, 92 on the 271st, 200); Mario standing on it is put on it.
Statement ScenarioVertPlatform{}
  SHARED objY(), objAux(), objVelY(), objFractionY(), objStartY(), objRiseTarget(), simTickCounter, cameraX
  SHARED playerX, playerY, playerState, playerSpeedY, playerOnGround, playerIsBig, boundBoxBottom
  PoolInit{}
  cameraX = 800
  playerState = #PLAYER_ST_FREE
  playerIsBig = False
  playerX = 100
  playerY = 400
  UpdatePlayerBoundBox{}
  liftSlot.w = PoolAlloc{}
  PoolInitLift{liftSlot, 880, 96, 7}
  Assert{objAux(liftSlot) = #LIFT_KIND_VERT AND objVelY(liftSlot) = 0 AND objStartY(liftSlot) = 96 AND objRiseTarget(liftSlot) = 160}
  lowSlot.w = PoolAlloc{}
  PoolInitLift{lowSlot, 960, 160, 7}
  Assert{objStartY(lowSlot) = 96 AND objRiseTarget(lowSlot) = 96}
  PoolFree{lowSlot}
  lowestY.w = 0
  lowestTick.w = 0
  highestY.w = 999
  highestTick.w = 0
  For swingTick = 0 To 399
    simTickCounter = swingTick
    UpdateLift{liftSlot}
    If objY(liftSlot) > lowestY
      lowestY = objY(liftSlot)
      lowestTick = swingTick + 1
    EndIf
    If swingTick >= 150 AND objY(liftSlot) < highestY
      highestY = objY(liftSlot)
      highestTick = swingTick + 1
    EndIf
  Next
  Assert{lowestY = SwimPick{227, 226} AND lowestTick = SwimPick{159, 135}}
  Assert{highestY = SwimPick{89, 92} AND highestTick = SwimPick{324, 271} AND objY(liftSlot) = SwimPick{98, 200}}
  ; Standing on it while it goes down: put on its top, on the ground.
  objY(liftSlot) = 150
  objVelY(liftSlot) = 1
  objFractionY(liftSlot) = 0
  playerX = 890
  playerY = 134
  playerSpeedY = 0
  playerOnGround = False
  UpdatePlayerBoundBox{}
  simTickCounter = 1
  UpdateLift{liftSlot}
  Assert{playerOnGround = True AND playerY = objY(liftSlot) - #TILE AND objY(liftSlot) > 150}
  ;; The landing window (#LIFT_LAND_WINDOW): his feet 7 px into an up lift's top land him on PAL, where one tick can carry them that
  ;; far (a fall of 6 and a lift of 2: he fell through 1-2's up lifts with the cartridge's 6), and not on NTSC, the cartridge's 6.
  PoolInit{}
  upSlot.w = PoolAlloc{}
  PoolInitLift{upSlot, 880, 150, 1}
  playerX = 902
  playerY = 100
  UpdatePlayerBoundBox{}
  feetBelowY.w = boundBoxBottom - playerY
  playerY = 150 + 7 - feetBelowY
  playerSpeedY = 0
  playerOnGround = False
  UpdatePlayerBoundBox{}
  UpdateLift{upSlot}
  Assert{playerOnGround = SwimPick{False, True}}
  playerOnGround = False
  cameraX = 0
  PoolInit{}
End Statement

;; Scenario 78 (REDPARA): 1-3's Red Paratroopa (the main project's OBJECT_SYSTEM note, "The Red Paratroopa"), against tools/record/swing_model.py's trace 0
;; (the proof matched it tick for tick): built at y 56 its top is 56 and its centre 104, from y 136 the centre is 104 too; from 56 it
;; swings down to 155 on its 179th tick and back up to 51 on its 363rd, and is at 65 after 450 (PAL, ours scaled: 153 on the 151st, 53 on
;; the 308th, 137), never moving sideways; stomped it loses its wings and is a red Koopa that walks off ledges, still, facing Mario.
Statement ScenarioRedParatroopa{}
  SHARED objX(), objY(), objState(), objDir(), objVelY(), objWinged(), objRed(), objStartY(), objRiseTarget(), simTickCounter, cameraX
  SHARED playerX, playerY, playerState, playerSpeedY, playerIsBig, playerStarIntervals
  PoolInit{}
  cameraX = 1000
  playerState = #PLAYER_ST_FREE
  playerIsBig = False
  playerStarIntervals = 0
  playerX = 100
  playerY = 400
  UpdatePlayerBoundBox{}
  paraSlot.w = PoolAlloc{}
  PoolInitRedParatroopa{paraSlot, 1184, 56}
  Assert{objWinged(paraSlot) = #WINGS_FLY AND objRed(paraSlot) = #RED_WALKS_OFF AND objDir(paraSlot) = #MARIO_BTN_LEFT}
  lowSlot.w = PoolAlloc{}
  PoolInitRedParatroopa{lowSlot, 1200, 136}
  Assert{objStartY(paraSlot) = 56 AND objRiseTarget(paraSlot) = 104 AND objStartY(lowSlot) = 136 AND objRiseTarget(lowSlot) = 104}
  PoolFree{lowSlot}
  lowestY.w = 0
  lowestTick.w = 0
  highestY.w = 999
  highestTick.w = 0
  movedSideways.w = False
  For swingTick = 0 To 449
    simTickCounter = swingTick
    UpdateKoopa{paraSlot}
    If objX(paraSlot) <> 1184 Then movedSideways = True
    If objY(paraSlot) > lowestY
      lowestY = objY(paraSlot)
      lowestTick = swingTick + 1
    EndIf
    If swingTick >= 200 AND objY(paraSlot) < highestY
      highestY = objY(paraSlot)
      highestTick = swingTick + 1
    EndIf
  Next
  Assert{lowestY = SwimPick{155, 153} AND lowestTick = SwimPick{179, 151} AND movedSideways = False}
  Assert{highestY = SwimPick{51, 53} AND highestTick = SwimPick{363, 308} AND objY(paraSlot) = SwimPick{65, 137}}
  ; The stomp: Mario to its right, coming down.
  playerX = 1190
  playerY = objY(paraSlot) - 20
  playerSpeedY = 256
  UpdatePlayerBoundBox{}
  StompKoopa{paraSlot}
  Assert{objWinged(paraSlot) = 0 AND objRed(paraSlot) = #RED_WALKS_OFF AND objState(paraSlot) = #KOOPA_ST_WALK AND objVelY(paraSlot) = 0 AND objDir(paraSlot) = #MARIO_BTN_RIGHT}
  playerSpeedY = 0
  cameraX = 0
  PoolInit{}
End Statement

;; Scenario 79 (WARP): 1-2's warp zone (the main project's AREAS note, "The warp zone"), against HandlePipeEntry: its three pipes as the map has
;; them (x 2848, 2912, 2976, their tops at 160, 48 tall; worlds 4, 3, 2). A world's first level is 2-1's place in the table for world
;; 2, none for 3 and 4; no warp pipe is enterable before the zone is reached; then the 2 pipe is, and the 4 and 3 are not; going down it
;; sinks the 48 ticks and asks for 2-1 (a course clear's level change), and stays down until that is handled.
Statement ScenarioWarp{}
  SHARED currentArea, areaEvent, lifeEvent, playerState, playerOnGround, playerButtons, playerX, playerY, pipeOccludeCols
  SHARED warpZoneState, warpPipeCount, warpPipeX(), warpPipeY(), warpPipeH(), warpPipeWorld(), warpPipeTaken, warpLevelTarget
  SHARED tableLevelWorld(), tableLevelNumber()
  worldTwoFirst.w = -1
  For tableIndex = 0 To #LEVEL_TABLE_COUNT - 1
    If tableLevelWorld(tableIndex) = 2 AND tableLevelNumber(tableIndex) = 1 Then worldTwoFirst = tableIndex
  Next
  Assert{worldTwoFirst >= 0 AND FirstLevelOfWorld{2} = worldTwoFirst AND FirstLevelOfWorld{3} = -1 AND FirstLevelOfWorld{4} = -1}
  warpPipeCount = 3
  For warpIndex = 0 To 2
    warpPipeX(warpIndex) = 2848 + warpIndex*64
    warpPipeY(warpIndex) = 160
    warpPipeH(warpIndex) = 48
    warpPipeWorld(warpIndex) = 4 - warpIndex
  Next
  currentArea = #AREA_MAIN
  areaEvent = 0
  lifeEvent = #LIFE_NONE
  warpPipeTaken = -1
  warpLevelTarget = -1
  playerState = #PLAYER_ST_FREE
  playerOnGround = True
  playerButtons = #MARIO_BTN_DOWN
  playerY = 160 - #TILE
  playerX = 2984
  warpZoneState = 0
  notYet.w = WarpPipeReady{}
  warpZoneState = 1
  pipeTwo.w = WarpPipeReady{}
  playerX = 2856
  pipeFour.w = WarpPipeReady{}
  playerX = 2920
  pipeThree.w = WarpPipeReady{}
  Assert{notYet = -1 AND pipeTwo = 2 AND pipeFour = -1 AND pipeThree = -1}
  ; Down the 2 pipe.
  playerX = 2984
  startY.w = playerY
  warpPipeTaken = WarpPipeReady{}
  StartPipe{#PLAYER_ST_PIPE_DOWN}
  For sinkTick = 1 To #PIPE_TICKS
    UpdatePipe{}
  Next
  Assert{lifeEvent = #LIFE_REPLAY AND warpLevelTarget = worldTwoFirst AND areaEvent = 0 AND playerY = startY + #PIPE_TICKS}
  UpdatePipe{}
  Assert{playerY = startY + #PIPE_TICKS AND areaEvent = 0}
  lifeEvent = #LIFE_NONE
  warpLevelTarget = -1
  warpPipeTaken = -1
  warpZoneState = 0
  warpPipeCount = 0
  playerState = #PLAYER_ST_FREE
  playerButtons = 0
  pipeOccludeCols = 0
End Statement

;; Scenario 80 (ORDER): the run from 1-1 (the worlds-1-and-2 plan, steps 6 and 7): following each level's next from the first, the
;; eight come in the cartridge's order, 1-1 to 1-4 and 2-1 to 2-4, and the last has none (the end screen, which is up until Return).
Statement ScenarioLevelOrder{}
  SHARED tableLevelWorld(), tableLevelNumber(), tableLevelNext()
  orderRight.w = True
  levelHere.w = 0
  ;; The world and number wanted at each step worked out first, the constant last and MOD, not AND: `1 + (stepIndex AND 3)` is the
  ;; shape OPTIMIZE 1 gets wrong (the main project's BLITZ_CONVENTIONS note), and it failed here on both builds.
  For stepIndex.w = 0 To 7
    wantWorld.w = stepIndex/4 + 1
    wantNumber.w = stepIndex MOD 4 + 1
    If levelHere < 0
      orderRight = False
    Else
      If tableLevelWorld(levelHere) <> wantWorld Then orderRight = False
      If tableLevelNumber(levelHere) <> wantNumber Then orderRight = False
      If stepIndex < 7 Then levelHere = tableLevelNext(levelHere)
    EndIf
  Next
  Assert{orderRight = True}
  Assert{#LEVEL_TABLE_COUNT = 8}
  Assert{levelHere >= 0 AND tableLevelNext(levelHere) = -1 AND CoverTicksFor{#COVER_END} = -1}
End Statement

;; Scenario 81 (PALETTE): the NES palette chosen (the main project's PALETTE note, "The NES palette chosen"; the palettes plan). Choice 1, YUV,
;; fills the tables by each slot's role: the sky $22 (9290FF), Mario's skin $27 (EA9E22), the glint's dark step $07 (561D00); the palette
;; page's mode shows the look's sky in pen 0 where the overlay's is black; choice 0 puts the art's own back (the sky c1e0fe, the skin
;; fecdc6); and the choice is written to the settings file and read back (SPARKYKEYS9 since 2026-11-08, SPARKYKEYS10 with the PAUSE key the same day), with the top score as last saved (2026-11-07):
;; a score raised by UpdateTopScore{} is not what the file gets until SaveTopScoreIfNew{} keeps it.
Statement ScenarioPalette{}
  SHARED atlasPalette(), areaPalette(), marioColour(), cycleColour(), paletteChoice, settingsPath$, debugMode, allstarsSky()
  SHARED hudScore, hudTopScore, topScoreSaved
  ApplyNesPalette{1}
  Assert{atlasPalette(0) = $92 AND atlasPalette(1) = $90 AND atlasPalette(2) = $ff AND areaPalette(0) = $92}
  Assert{marioColour(3) = $ea AND marioColour(4) = $9e AND marioColour(5) = $22 AND cycleColour(4*3) = $56}
  pageSky.w = PaletteComponent{0, 0, 0, 0, 0, #PALETTE_COVER_PAGE}
  overlaySky.w = PaletteComponent{0, 0, 0, 0, 0, #PALETTE_COVER_OVERLAY}
  ; The page's sky is the look's: the NES palette's in the NES look, the All-Stars sky in the All-Stars look (which has no palette page).
  pageSkyWanted.w = $92
  If #LOOK_ALLSTARS = 1 Then pageSkyWanted = allstarsSky(0)
  Assert{pageSky = pageSkyWanted AND overlaySky = 0}
  ApplyNesPalette{0}
  Assert{atlasPalette(0) = $c1 AND areaPalette(2) = $fe AND marioColour(3) = $fe AND marioColour(4) = $cd}
  ; Through the settings file, as scenario 48 does it.
  savedPath$ = settingsPath$
  settingsPath$ = "RAM:sparky-palette.settings"
  paletteChoice = 7
  savedTopScore.l = hudTopScore
  savedTopSaved.l = topScoreSaved
  savedScore.l = hudScore
  hudTopScore = 123450
  topScoreSaved = 123450
  hudScore = 200000
  UpdateTopScore{}
  Assert{hudTopScore = 200000 AND topScoreSaved = 123450}
  QAMIGA
  paletteWritten.w = WriteSettings{}
  paletteChoice = 0
  hudTopScore = 0
  topScoreSaved = 0
  LoadSettings{}
  BLITZ
  Assert{paletteWritten <> False AND paletteChoice = 7}
  Assert{hudTopScore = 123450 AND topScoreSaved = 123450}
  hudTopScore = savedTopScore
  topScoreSaved = savedTopSaved
  hudScore = savedScore
  paletteChoice = #PALETTE_DEFAULT
  settingsPath$ = savedPath$
  ;; The release's choices (the user's checklist, 2026-10-25: 1, 6, 8, 14, 15, 20, 21, 24, 25 and 30; the default 21, 3DS VC): outside
  ;; debug mode the page steps over the others, round the list; in debug mode it offers every one, "as drawn" too.
  savedDebug.w = debugMode
  debugMode = False
  releaseNext.w = NextPaletteChoice{21, 1}
  releaseBack.w = NextPaletteChoice{1, -1}
  releaseDrawn.w = PaletteChoiceAllowed{0}
  debugMode = True
  debugNext.w = NextPaletteChoice{21, 1}
  debugDrawn.w = PaletteChoiceAllowed{0}
  debugMode = savedDebug
  Assert{#PALETTE_DEFAULT = 21 AND releaseNext = 24 AND releaseBack = 30 AND releaseDrawn = False}
  Assert{debugNext = 22 AND debugDrawn <> False}
End Statement

;; Scenario 82 (CONTINUES): the rule of the continues plan (ours, not the cartridge's). A game over past the halfway point, then a continue:
;; the lives back, the score, the coins and the restart point as the death left them, one used. NONE leaves none; 2 leaves one after one;
;; INFINITE never runs out; the choice raised after one is used gives the rest at once (the used ones are counted, not a store); a choice
;; lowered below the used ones leaves none, not fewer. The new game's reset of the used count is RestartLevel{True}'s (seen in UAE).
Statement ScenarioContinues{}
  SHARED playerLives, lifeEvent, lifeStartCameraX, cameraX, hudScore, hudCoins, continuesChoice, continuesUsed
  BuildFlatMap{}
  PlacePlayer{100, (#FLOOR_ROW - 1)*#TILE}
  savedChoice.w = continuesChoice
  continuesUsed = 0
  continuesChoice = 0
  Assert{ContinuesLeft{} = 0}
  continuesChoice = 2
  Assert{ContinuesLeft{} = 2}
  ; The last life lost past the halfway point: game over, with the restart point noted.
  playerLives = 0
  hudScore = 12340
  hudCoins = 17
  cameraX = #HALFWAY_X + 40
  lifeEvent = #LIFE_NONE
  ResolveLifeLost{}
  Assert{lifeEvent = #LIFE_GAMEOVER AND playerLives = -1}
  ContinueGame{}
  Assert{playerLives = #LIVES_START AND continuesUsed = 1}
  Assert{hudScore = 12340 AND hudCoins = 17}
  Assert{lifeStartCameraX = #HALFWAY_X}
  Assert{ContinuesLeft{} = 1}
  ; Raised to 5 after one used: four left. Lowered to 1: none, never below 0.
  continuesChoice = 3
  Assert{ContinuesLeft{} = 4}
  continuesChoice = 1
  Assert{ContinuesLeft{} = 0}
  ContinueGame{}
  continuesChoice = 0
  Assert{ContinuesLeft{} = 0}
  ; INFINITE: no limit, however many are used.
  continuesChoice = 5
  continuesUsed = 99
  Assert{ContinuesLeft{} = #CONTINUES_INFINITE}
  ContinueGame{}
  Assert{ContinuesLeft{} = #CONTINUES_INFINITE AND playerLives = #LIVES_START}
  ; Leave the world as the other scenarios expect it.
  continuesChoice = savedChoice
  continuesUsed = 0
  playerLives = #LIVES_START
  lifeEvent = #LIFE_NONE
  lifeStartCameraX = 0
  cameraX = 0
  hudScore = 0
  hudCoins = 0
End Statement

Statement StartScenario{}
  SHARED scenario, assertIndex, assertResult(), previousY
  SHARED bumpHeadRow, bumpHeadColumn, stoppedY, riseEndSpeedY
  SHARED armSpeedY, armTimer, armClass, armGid
  SHARED midClass, midGid, finishClass, finishGid, finishTimer
  SHARED bumpFinished
  SHARED bumpArmTick, bumpFinishTick, mushroomSpawnTick
  SHARED postBumpY
  SHARED hoverTicks, pinnedRightProbe, cameraHeldTicks, hitTimerValue, hitTick
  SHARED wallPinnedProbe, wallMaskedTicks, wallWrongMaskedTicks
  SHARED wallJumped, wallJumpStartY
  SHARED poleGrabbed, poleFrameSeen, poleEnded, poleEndY
  SHARED poleEndX, poleFlagAtEnd, poleRegrabbed
  SHARED resizeSawBig, resizeSawSmall, resizeTicks
  SHARED bigHeadProbe, smallHeadProbe
  SHARED blockItemRow, blockItemCol, worldFreezeTicks, playerSizeAnimTicks
  SHARED objActive(), objType(), debrisActive(), debrisNextSet
  SHARED scenarioResult(), scenarioAssertCount(), scenarioCompleted()
  assertIndex = 0
  previousY = 0
  bumpHeadRow = 0
  bumpHeadColumn = 0
  stoppedY = 0
  riseEndSpeedY = 0
  armSpeedY = 0
  armTimer = 0
  armClass = 0
  armGid = 0
  midClass = 0
  midGid = 0
  finishClass = 0
  finishGid = 0
  finishTimer = 0
  bumpFinished = False
  bumpArmTick = -1
  bumpFinishTick = -1
  mushroomSpawnTick = -1
  postBumpY = 0
  hoverTicks = 0
  pinnedRightProbe = 0
  cameraHeldTicks = 0
  hitTimerValue = 0
  hitTick = 0
  wallPinnedProbe = 0
  wallMaskedTicks = 0
  wallWrongMaskedTicks = 0
  wallJumped = False
  wallJumpStartY = 0
  poleGrabbed = False
  poleFrameSeen = False
  poleEnded = False
  poleEndY = 0
  poleEndX = 0
  poleFlagAtEnd = 0
  poleRegrabbed = False
  resizeSawBig = False
  resizeSawSmall = False
  resizeTicks = 0
  bigHeadProbe = 0
  smallHeadProbe = 0
  blockItemRow = 0
  blockItemCol = 0
  worldFreezeTicks = 0
  playerSizeAnimTicks = 0
  PoolInit{}
  debrisActive(0) = False
  debrisActive(1) = False
  debrisNextSet = 0
  If scenario = 1 Then ScenarioRunLatch{}
  If scenario = 2 Then ScenarioCeiling{}
  If scenario = 3 Then ScenarioSideCollide{}
  If scenario = 4 Then ScenarioBoxSide{}
  If scenario = 5 Then ScenarioLeave{}
  If scenario = 6 Then ScenarioQuestionBlock{}
  If scenario = 7 Then ScenarioBrick{}
  If scenario = 8 Then ScenarioWallMask{}
  If scenario = 9 Then ScenarioFlagpole{}
  If scenario = 10 Then ScenarioResize{}
  If scenario = 11 Then ScenarioSideAway{}
  If scenario = 12 Then ScenarioBlockItem{}
  If scenario = 13 Then ScenarioCoinThenMushroom{}
  If scenario = 14 Then ScenarioTwoCoins{}
  If scenario = 15 Then ScenarioMushroomThenCoin{}
  If scenario = 16 Then ScenarioMushroomLeaves{}
  If scenario = 17 Then ScenarioBrickBreak{}
  If scenario = 18 Then ScenarioCoinAbove{}
  If scenario = 19 Then ScenarioCoinTouch{}
  If scenario = 20 Then ScenarioMultiCoin{}
  If scenario = 21 Then ScenarioCoinOnHit{}
  If scenario = 22 Then ScenarioEnemyContact{}
  If scenario = 23 Then ScenarioDeath{}
  If scenario = 24 Then ScenarioLives{}
  If scenario = 25 Then ScenarioTimeUp{}
  If scenario = 26 Then ScenarioGoombaWake{}
  If scenario = 27 Then ScenarioStompChain{}
  If scenario = 28 Then ScenarioCoinLife{}
  If scenario = 29 Then ScenarioMushroomScore{}
  If scenario = 30 Then ScenarioHiddenOneUp{}
  If scenario = 31 Then ScenarioKoopa{}
  If scenario = 32 Then ScenarioFireFlower{}
  If scenario = 33 Then ScenarioFireball{}
  If scenario = 34 Then ScenarioStarman{}
  If scenario = 35 Then ScenarioLevelEnd{}
  If scenario = 36 Then ScenarioBonusRoom{}
  If scenario = 37 Then ScenarioCover{}
  If scenario = 38 Then ScenarioStarFlowerFire{}
  If scenario = 39 Then ScenarioPause{}
  If scenario = 40 Then ScenarioBumpObjects{}
  If scenario = 41 Then ScenarioEnemyTurn{}
  If scenario = 42 Then ScenarioControls{}
  If scenario = 43 Then ScenarioJoystick{}
  If scenario = 44 Then ScenarioKeys{}
  If scenario = 45 Then ScenarioCrouch{}
  If scenario = 46 Then ScenarioFallInit{}
  If scenario = 47 Then ScenarioJumpForgiveness{}
  If scenario = 48 Then ScenarioJukeboxSound{}
  If scenario = 49 Then ScenarioVariableJump{}
  If scenario = 50 Then ScenarioSpeedCaps{}
  If scenario = 51 Then ScenarioCameraForward{}
  If scenario = 52 Then ScenarioPauseEscape{}
  If scenario = 53 Then ScenarioAreaBoxes{}
  If scenario = 54 Then ScenarioPiranha{}
  If scenario = 55 Then ScenarioRedKoopa{}
  If scenario = 56 Then ScenarioLift{}
  If scenario = 57 Then ScenarioHudAway{}
  If scenario = 58 Then ScenarioNoLevelEnd{}
  If scenario = 59 Then ScenarioBackStrips{}
  If scenario = 60 Then ScenarioHudStamp{}
  If scenario = 61 Then ScenarioPlayerClip{}
  If scenario = 62 Then ScenarioParatroopa{}
  If scenario = 63 Then ScenarioJumpspring{}
  If scenario = 64 Then ScenarioVine{}
  If scenario = 65 Then ScenarioSkyBonus{}
  If scenario = 66 Then ScenarioSwim{}
  If scenario = 67 Then ScenarioBloober{}
  If scenario = 68 Then ScenarioFrenzy{}
  If scenario = 69 Then ScenarioFlying{}
  If scenario = 70 Then ScenarioFirebar{}
  If scenario = 71 Then ScenarioPodoboo{}
  If scenario = 72 Then ScenarioPlatforms{}
  If scenario = 73 Then ScenarioBowser{}
  If scenario = 74 Then ScenarioFlames{}
  If scenario = 75 Then ScenarioAxe{}
  If scenario = 76 Then ScenarioCastleWalk{}
  If scenario = 77 Then ScenarioVertPlatform{}
  If scenario = 78 Then ScenarioRedParatroopa{}
  If scenario = 79 Then ScenarioWarp{}
  If scenario = 80 Then ScenarioLevelOrder{}
  If scenario = 81 Then ScenarioPalette{}
  If scenario = 82 Then ScenarioContinues{}
  scenarioAssertCount(scenario - 1) = assertIndex
  scenarioCompleted(scenario - 1) = True
  For resultIndex = 0 To assertIndex - 1
    scenarioResult((scenario - 1)*#MAX_ASSERTS + resultIndex) = assertResult(resultIndex)
  Next
End Statement

Statement AdvanceScenario{}
  SHARED scenario, scenarioTick
  scenarioTick = scenarioTick + 1
  If scenarioTick < #PROBE_TICKS Then Statement Return
  scenarioTick = 0
  scenario = scenario + 1
  If scenario > #SCENARIO_COUNT Then scenario = 1
  StartScenario{}
End Statement

Statement DrawProbe{}
  SHARED scenario, assertIndex, assertResult(), metatileBuffer(), playerX, playerY
  SHARED boundBoxLeft, boundBoxTop, boundBoxRight, boundBoxBottom, screenHeight
  Use BitMap 1
  Cls 0
  ;; Only the visible columns: the buffer is the whole 240-wide map, and
  ;; stamping all of it every frame is 3600 Boxf calls for nothing.
  For drawColumn = 0 To #VIEW_TILES_W - 1
    For drawRow = 0 To #MAP_H - 1
      If metatileBuffer(drawRow*#MAP_W + drawColumn) > 0
        Boxf drawColumn*#TILE, drawRow*#TILE, drawColumn*#TILE + #TILE - 1, drawRow*#TILE + #TILE - 1, 1
      EndIf
    Next
  Next
  Boxf playerX + #HITBOX_INSET, playerY + #PROBE_TOP_Y, playerX + #PROBE_SIDE_X2, playerY + #PROBE_FOOT_Y, 6
  Boxf boundBoxLeft, boundBoxTop, boundBoxRight, boundBoxBottom, 5
  Boxf playerX, playerY, playerX + #TILE - 1, playerY + #TILE - 1, 3
  For cell = 0 To #MAX_ASSERTS - 1
    cellPen = 4
    If cell < assertIndex Then cellPen = assertResult(cell)
    Boxf 4 + cell*26, screenHeight - 18, 4 + cell*26 + 21, screenHeight - 4, cellPen
  Next
  Boxf 4 + (scenario - 1)*28, screenHeight - 38, 4 + (scenario - 1)*28 + 23, screenHeight - 22, 5
End Statement

;; This is a batch test, not an interactive demo. Run every scenario once,
;; write the complete report, and terminate so the caller never has to guess
;; whether the last scenario has finished. AdvanceScenario{} and DrawProbe{}
;; remain above as optional visual-debug helpers when temporarily restoring the
;; old loop during interactive investigation.
; Every scenario runs with jump forgiveness off, which is the cartridge's own behaviour; scenario 47 sets its own windows.
jumpBufferWindow = 0
coyoteWindow = 0
For runScenario = 1 To #SCENARIO_COUNT
  scenario = runScenario
  StartScenario{}
Next

AMIGA
;; One results file for each physics variant in each look (run-tests compiles and runs all four, through run-tests-one): the sim rate
;; and the look name it, test-harness-results-<variant>-<look>.txt.
resultsVariant$ = "ntsc"
If #SIM_HZ = 50 Then resultsVariant$ = "pal"
resultsLook$ = "nes"
If #LOOK_ALLSTARS = 1 Then resultsLook$ = "allstars"
resultsPath$ = "sparky-dave:game/tests/test-harness-results-" + resultsVariant$ + "-" + resultsLook$ + ".txt"
If WriteFile(0, resultsPath$)
  FileOutput 0
  NPrint "Test harness results"
  NPrint "Physics variant: ", #SIM_HZ, " ticks a second"
  NPrint "Look: ", resultsLook$
  For reportScenario = 0 To #SCENARIO_COUNT - 1
    If scenarioCompleted(reportScenario) = True
      NPrint "Scenario", reportScenario + 1, ": COMPLETED"
      For reportAssertion = 0 To scenarioAssertCount(reportScenario) - 1
        reportValue = scenarioResult(reportScenario*#MAX_ASSERTS + reportAssertion)
        If reportValue = 3
          NPrint "  Assertion", reportAssertion + 1, ": PASS"
        Else
          If reportValue = 2
            NPrint "  Assertion", reportAssertion + 1, ": FAIL"
          Else
            NPrint "  Assertion", reportAssertion + 1, ": NO RESULT"
          EndIf
        EndIf
      Next
    Else
      NPrint "Scenario", reportScenario + 1, ": NOT RUN"
    EndIf
  Next
  CloseFile 0
EndIf
End
